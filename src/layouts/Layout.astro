---
import '../styles/global.css';
const { 
  title = "Phuc Loc Nguyen | Digital Marketing Specialist",
  description = "Digital Marketing Specialist based in Ho Chi Minh City. Helping brands grow through SEO, social media, paid ads, and full-funnel campaigns.",
  ogImage = "https://loc.digital/og-image.jpg",
  hideHeader = false,
  hideFooter = false,
  favicon
} = Astro.props;
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" style="background:#FAFAF7">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-visual">
  <meta name="description" content={description}>
  
  <!-- Open Graph / Social Media Thumbnail -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content="https://loc.digital/">
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <title>{title}</title>
  <meta name="theme-color" content="#FAFAF7">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta name="google-site-verification" content="tYabJCSeApR0trq6VL7V6_JKbEKbBnznDtNmvaBehfY" />
  
  {favicon ? (
    <link rel="icon" href={favicon} />
  ) : (
    <>
      <link id="dynamic-favicon" rel="icon" type="image/svg+xml" href="/favicon-active.svg" />
      <script is:inline>
        function syncFavicon() {
          const favicon = document.getElementById("dynamic-favicon");
          if (favicon) {
            favicon.href = document.hidden || !document.hasFocus()
              ? "/favicon-inactive.svg"
              : "/favicon-active.svg";
          }
        }

        document.addEventListener("visibilitychange", syncFavicon);
        window.addEventListener("focus", syncFavicon);
        window.addEventListener("blur", syncFavicon);
        syncFavicon();
      </script>
    </>
  )}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DYB5FLYNH4"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-DYB5FLYNH4');
  </script>

  <!-- Resource Hints: preconnect + dns-prefetch for external CDNs -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="//cdn.jsdelivr.net">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="dns-prefetch" href="//unpkg.com">

  <!-- Fonts: non-blocking load (media="print" trick avoids render-blocking) -->
  <link
    href="https://fonts.googleapis.com/css2?family=Imbue:opsz,wght@10..100,100..900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Mono:wght@400&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'">
  <!-- Fallback for no-JS -->
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Imbue:opsz,wght@10..100,100..900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Mono:wght@400&display=swap"
      rel="stylesheet">
  </noscript>

</head>

<body>
  <!-- ============================================================
       HEADER
  ============================================================ -->
  {!hideHeader && (
    <>
      <header id="site-header" class={`${pathname.startsWith('/photos') ? 'absolute-header' : ''} ${pathname.startsWith('/gallery') ? 'gallery-glass-header' : ''}`.trim()}>
        <div class="header-inner">
          <a href="/" class="header-name" aria-label="Phuc Loc Nguyen — back to home">
            <span class="n-keep">P</span><span class="n-collapse">huc</span><span class="n-collapse">&nbsp;</span><span
              class="n-keep">L</span><span class="n-collapse">oc</span>
          </a>

          <nav class="header-nav-desktop" aria-label="Main navigation">
            <ul>
              <li><a href="/about" class={pathname.startsWith('/about') ? 'active' : ''}>About</a></li>
              <li><a href="/work" class={pathname.startsWith('/work') ? 'active' : ''}>Work</a></li>
              <li><a href="/blog" class={pathname.startsWith('/blog') ? 'active' : ''}>Writing</a></li>
              <li><a href="/photos" class={pathname.startsWith('/photos') ? 'active' : ''}>Photos</a></li>
              <li><a href="/gear" class={pathname.startsWith('/gear') ? 'active' : ''}>Gear</a></li>
              <li><a href="/question" class={`ask-link ${pathname.startsWith('/question') ? 'active' : ''}`}>Ask ✦</a></li>
            </ul>
          </nav>

          <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="hamburger-line hamburger-line--top"></span>
            <span class="hamburger-line hamburger-line--mid"></span>
            <span class="hamburger-line hamburger-line--bottom"></span>
          </button>
        </div>
      </header>

      <!-- Mobile Backdrop -->
      <div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

      <!-- Mobile Menu -->
      <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
        <nav aria-label="Mobile navigation">
          <ul class="mobile-nav">
            <li><a href="/about" class={pathname.startsWith('/about') ? 'active' : ''}>About</a></li>
            <li><a href="/work" class={pathname.startsWith('/work') ? 'active' : ''}>Work</a></li>
            <li><a href="/blog" class={pathname.startsWith('/blog') ? 'active' : ''}>Writing</a></li>
            <li><a href="/photos" class={pathname.startsWith('/photos') ? 'active' : ''}>Photos</a></li>
            <li><a href="/gear" class={pathname.startsWith('/gear') ? 'active' : ''}>Gear</a></li>
            <li><a href="/question" class={pathname.startsWith('/question') ? 'active' : ''}>Ask ✦</a></li>
          </ul>
        </nav>
      </div>
    </>
  )}

  <!-- ============================================================
       PAGE TRANSITION OVERLAY
  ============================================================ -->
  <div id="page-transition" aria-hidden="true"></div>

  <slot />

  <!-- ============================================================
       FOOTER
  ============================================================ -->
  {!hideFooter && !pathname.startsWith('/gallery') && (
    <>
      <div class="footer-divider"></div>
      <div class="container">
        <footer class="footer r" aria-label="Footer">
          <div class="footer-contact">
            Let's connect —
            <button class="email-copy" id="copy-email" aria-label="Copy email address" data-tip="Copy">
              hi@loc.digital
            </button>
          </div>
          <ul class="footer-links">
            <li><a href="https://www.linkedin.com/in/phucloc" target="_blank" rel="noopener noreferrer"
                aria-label="LinkedIn">LinkedIn ↗</a></li>
            <li><a href="https://github.com/phucloc" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub ↗</a></li>
            <li><a href="https://phucloc.digital/resume" target="_blank" rel="noopener noreferrer"
                aria-label="Resume">Resume ↗</a></li>
            <li><a href="/rss.xml">RSS</a></li>
          </ul>
        </footer>
        <div class="colophon">
          <span>© 2026 Phuc Loc Nguyen</span>
          <span>Astro · Static HTML · WCAG 2.2 AA</span>
        </div>
      </div>
    </>
  )}

  <!-- Scripts -->
  <script is:inline>
    /* ── Page Transition ── */
    (function () {
      const overlay = document.getElementById('page-transition');

      // Fade OUT then navigate
      function navigateTo(href) {
        if (!overlay) { window.location.href = href; return; }
        overlay.classList.add('pt-leaving');
        setTimeout(() => { window.location.href = href; }, 480);
      }

      // Intercept ALL internal link clicks
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a');
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href) return;
        // Skip: external, hash-only, download, new tab, or modifier key held
        if (
          a.target === '_blank' ||
          a.rel?.includes('external') ||
          href.startsWith('http') ||
          href.startsWith('//') ||
          href.startsWith('mailto:') ||
          href.startsWith('tel:') ||
          href.startsWith('#') ||
          a.hasAttribute('download') ||
          e.metaKey || e.ctrlKey || e.shiftKey || e.altKey
        ) return;

        e.preventDefault();
        navigateTo(href);
      }, true);
    })();
  </script>

  <!-- Scripts -->
  <script is:inline>
    // Force scroll to top on load/refresh and disable browser scroll restoration
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    (function () {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = () => window.innerWidth < 768;

      /* ── Page load ── */
      window.addEventListener('DOMContentLoaded', () => {
        document.body.classList.add('ready');

        // Nav: drop from above (spring CSS handles overshoot)
        setTimeout(() => document.getElementById('site-header')?.classList.add('in'), 80);

        // Prepare typing effect for hero lines
        const heroLines = document.querySelectorAll('.hero-line');
        
        // Hero lines fade-in sequentially
        if (heroLines.length > 0) {
          heroLines.forEach((line, i) => {
            setTimeout(() => {
              line.classList.add('in');
            }, reduced ? (280 + i * 130) : (280 + i * 150));
          });
        }

        // Hero aside
        setTimeout(() => document.querySelector('.hero-aside')?.classList.add('in'), 1200);
      });

      /* ── IntersectionObserver: section reveals ── */
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.07, rootMargin: '0px 0px -36px 0px' });

      // Observe existing manual reveal elements
      document.querySelectorAll('.r, .toki-r').forEach(el => io.observe(el));

      // Auto-reveal: find all major content elements NOT already in a reveal or hero context
      const AUTO_REVEAL_SELECTORS = [
        'main section',
        'main article',
        'main h1:not(.hero-line)',
        'main h2',
        'main h3',
        'main p:not(.hero-line)',
        'main figure',
        'main picture',
        'main blockquote',
        'main .card',
        'main .gear-section',
        'main .gear-item',
        'main .timeline-row',
        'main .project-row',
        'main .writing-row',
        'main .sh',
        'main .about-layout',
        'main .about-photo',
        'main table',
        'footer',
      ].join(', ');

      document.querySelectorAll(AUTO_REVEAL_SELECTORS).forEach((el) => {
        // Skip if already has a reveal class or is inside hero
        if (
          el.classList.contains('r') ||
          el.classList.contains('toki-r') ||
          el.classList.contains('reveal') ||
          el.closest('.hero') ||
          el.closest('.hero-title') ||
          el.classList.contains('hero-line') ||
          el.classList.contains('hero-aside')
        ) return;

        el.classList.add('reveal');
        io.observe(el);
      });

      // Auto-stagger items inside reveal-group containers
      document.querySelectorAll('.reveal-group').forEach((group) => {
        Array.from(group.children).forEach((child) => {
          if (!child.classList.contains('reveal')) {
            child.classList.add('reveal');
            io.observe(child);
          }
        });
      });

      /* ── Scroll: nav bg + progress bar + parallax ── */
      const header = document.getElementById('site-header');
      const parallax = document.querySelectorAll('[data-parallax]');
      let ticking = false, idleTimer;

      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const sy = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;

          if (header) header.classList.toggle('is-scrolled', sy > 50);

          // Parallax gravity inversion
          if (!reduced && !isMobile()) {
            parallax.forEach(el => {
              const speed = parseFloat(el.dataset.parallax) || 0.1;
              const mid = el.getBoundingClientRect().top + el.offsetHeight / 2;
              el.style.transform = `translateY(${(mid - window.innerHeight / 2) * speed * -1}px)`;
            });
          }

          ticking = false;
        });
      }, { passive: true });

      /* ── Hamburger / mobile menu ── */
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-backdrop');
      let menuOpen = false, lockScrollY = 0;

      function toggleMenu() {
        menuOpen = !menuOpen;
        if (hamburger) {
          hamburger.setAttribute('aria-expanded', String(menuOpen));
          hamburger.classList.toggle('is-open', menuOpen);
        }
        if (mobileMenu) {
          mobileMenu.classList.toggle('is-open', menuOpen);
          mobileMenu.setAttribute('aria-hidden', String(!menuOpen));
        }
        if (backdrop) backdrop.classList.toggle('is-open', menuOpen);

        if (menuOpen) {
          lockScrollY = window.scrollY;
          document.body.style.cssText = `position:fixed;top:-${lockScrollY}px;width:100%;`;
        } else {
          document.body.style.cssText = '';
          window.scrollTo(0, lockScrollY);
        }
      }

      hamburger?.addEventListener('click', toggleMenu);
      backdrop?.addEventListener('click', () => menuOpen && toggleMenu());
      mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menuOpen && toggleMenu()));
      document.addEventListener('keydown', e => e.key === 'Escape' && menuOpen && toggleMenu());

      /* ── Smooth scroll for anchor links ── */
      document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach(a => {
        a.addEventListener('click', e => {
          const href = a.getAttribute('href');
          const isHomePage = window.location.pathname === '/' || window.location.pathname === '/index.html';
          if (href.startsWith('/#') && !isHomePage) return; // let it navigate natively
          
          const targetId = href.startsWith('/#') ? href.slice(1) : href;
          const t = document.querySelector(targetId);
          if (!t) return;
          e.preventDefault();
          window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 56, behavior: 'smooth' });
          if (menuOpen) toggleMenu(); // Close mobile menu on click
        });
      });

      /* ── Gallery arrows & Auto Scroll ── */
      const stripOuter = document.querySelector('.gallery-strip-outer');
      const arrowL = document.querySelector('.gallery-arrow--left');
      const arrowR = document.querySelector('.gallery-arrow--right');

      if (stripOuter && arrowL && arrowR) {
        // Prevent native drag behaviors on child elements
        stripOuter.querySelectorAll('a, img').forEach(el => {
          el.setAttribute('draggable', 'false');
        });

        const fadeR = stripOuter.parentElement.querySelector('.gallery-fade-right');
        const fadeL = stripOuter.parentElement.querySelector('.gallery-fade-left');

        let down = false;
        let isHovered = false;

        const updateArrows = () => {
          const half = stripOuter.scrollWidth / 2;
          if (half > 0) {
            if (stripOuter.scrollLeft >= half) {
              stripOuter.scrollLeft -= half;
            } else if (stripOuter.scrollLeft <= 2) {
              stripOuter.scrollLeft += half;
            }
          }
          arrowL.disabled = false;
          arrowR.disabled = false;
          fadeL?.classList.toggle('visible', true);
          if (fadeR) fadeR.style.opacity = '1';
        };

        const step = () => stripOuter.clientWidth * 0.7;
        arrowL.addEventListener('click', () => stripOuter.scrollBy({ left: -step(), behavior: 'smooth' }));
        arrowR.addEventListener('click', () => stripOuter.scrollBy({ left: step(), behavior: 'smooth' }));
        stripOuter.addEventListener('scroll', updateArrows, { passive: true });
        updateArrows();

        // Hover & Touch state monitoring for Auto-scroll pausing
        const wrapper = document.querySelector('.gallery-scroll-wrapper');
        if (wrapper) {
          wrapper.addEventListener('mouseenter', () => { isHovered = true; });
          wrapper.addEventListener('mouseleave', () => { isHovered = false; });
          stripOuter.addEventListener('touchstart', () => { isHovered = true; }, { passive: true });
          stripOuter.addEventListener('touchend', () => { isHovered = false; }, { passive: true });
        }

        // Auto scroll marquee loop
        const scrollSpeed = 0.5; // px per frame
        function tickAutoScroll() {
          if (!down && !isHovered) {
            const half = stripOuter.scrollWidth / 2;
            if (half > 0) {
              let nextScroll = stripOuter.scrollLeft + scrollSpeed;
              if (nextScroll >= half) {
                nextScroll -= half;
              }
              stripOuter.scrollLeft = nextScroll;
            }
          }
          requestAnimationFrame(tickAutoScroll);
        }

        // Start auto scroll after short delay
        setTimeout(() => {
          requestAnimationFrame(tickAutoScroll);
        }, 1000);

        // Drag-to-scroll (mouse only — touch uses native scroll which is smoother)
        let startX, startSL, vel = 0, lastX, lastT, rafG, rafMove;
        let isDragging = false;
        let pendingX = 0;

        // Prevent native image/link ghost drag
        stripOuter.addEventListener('dragstart', e => e.preventDefault());

        // Batch mousemove into rAF for smooth 60fps updates
        const applyMove = () => {
          if (!down) return;
          const x = pendingX;
          const dx = x - startX;
          if (Math.abs(dx) > 5) isDragging = true;
          stripOuter.scrollLeft = startSL - dx;
          const now = Date.now(), dt = now - lastT || 1;
          vel = (lastX - x) / dt;
          lastX = x;
          lastT = now;
          rafMove = 0;
        };

        stripOuter.addEventListener('mousedown', e => {
          if (e.button !== 0) return;
          down = true;
          isDragging = false;
          startX = e.pageX;
          startSL = stripOuter.scrollLeft;
          vel = 0;
          lastX = e.pageX;
          lastT = Date.now();
          cancelAnimationFrame(rafG);
          stripOuter.classList.add('is-dragging');
        });

        window.addEventListener('mousemove', e => {
          if (!down) return;
          e.preventDefault();
          pendingX = e.pageX;
          if (!rafMove) rafMove = requestAnimationFrame(applyMove);
        });

        window.addEventListener('mouseup', () => {
          if (!down) return;
          down = false;
          stripOuter.classList.remove('is-dragging');
          // Momentum glide
          const coast = () => {
            vel *= 0.95;
            stripOuter.scrollLeft += vel * 16;
            if (Math.abs(vel) > 0.03) rafG = requestAnimationFrame(coast);
          };
          if (Math.abs(vel) > 0.1) coast();
        });

        // Block click (PhotoSwipe) after a drag gesture
        stripOuter.addEventListener('click', e => {
          if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);
      }

      /* ── Email copy ── */
      const copyBtn = document.getElementById('copy-email');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('hi@loc.digital');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = 'hello@locnguyen.dev';
          ta.style.cssText = 'position:fixed;opacity:0;';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
        }
        copyBtn.dataset.tip = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => { copyBtn.classList.remove('copied'); copyBtn.dataset.tip = 'Copy'; }, 2200);
      });

    })();
  </script>

</body>

</html>
