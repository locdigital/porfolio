---
import '../styles/global.css';
const { title = "Phuc Loc Nguyen | Digital Marketing Specialist" } = Astro.props;
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" style="background:#FAFAF7">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-visual">
  <meta name="description"
    content="Digital Marketing Specialist based in Ho Chi Minh City. Helping brands grow through SEO, social media, paid ads, and full-funnel campaigns.">
  
  <!-- Open Graph / Social Media Thumbnail -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content="Digital Marketing Specialist based in Ho Chi Minh City. Helping brands grow through SEO, social media, paid ads, and full-funnel campaigns.">
  <meta property="og:image" content="https://loc.digital/og-image.jpg">
  <meta property="og:url" content="https://loc.digital/">
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content="Digital Marketing Specialist based in Ho Chi Minh City. Helping brands grow through SEO, social media, paid ads, and full-funnel campaigns.">
  <meta name="twitter:image" content="https://loc.digital/og-image.jpg">

  <title>{title}</title>
  <meta name="theme-color" content="#FAFAF7">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta name="google-site-verification" content="tYabJCSeApR0trq6VL7V6_JKbEKbBnznDtNmvaBehfY" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DYB5FLYNH4"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-DYB5FLYNH4');
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Imbue:opsz,wght@10..100,100..900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Mono:wght@400&display=swap"
    rel="stylesheet">

  <!-- PhotoSwipe CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.min.css">
</head>

<body>
  <!-- ============================================================
       HEADER
  ============================================================ -->
  <header id="site-header" class={`${pathname.startsWith('/photos') ? 'absolute-header' : ''} ${pathname.startsWith('/gallery') ? 'gallery-glass-header' : ''}`.trim()}>
    <div class="header-inner">
      <a href="/" class="header-name" aria-label="Phuc Loc Nguyen — back to home">
        <span class="n-keep">P</span><span class="n-collapse">huc</span><span class="n-collapse">&nbsp;</span><span
          class="n-keep">L</span><span class="n-collapse">oc</span>
      </a>

      <nav class="header-nav-desktop" aria-label="Main navigation">
        <ul>
          <li><a href="/about" class={pathname.startsWith('/about') ? 'active' : ''}>About</a></li>
          <li><a href="/#work">Experience</a></li>
          <li><a href="/photos" class={pathname.startsWith('/photos') ? 'active' : ''}>Photos</a></li>
          <li><a href="/#writing">Writing</a></li>
        </ul>
      </nav>

      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="hamburger-line hamburger-line--top"></span>
        <span class="hamburger-line hamburger-line--mid"></span>
        <span class="hamburger-line hamburger-line--bottom"></span>
      </button>
    </div>
  </header>

  <!-- Mobile Backdrop -->
  <div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ul class="mobile-nav">
        <li><a href="/about" class={pathname.startsWith('/about') ? 'active' : ''}>About</a></li>
        <li><a href="/#work">Experience</a></li>
        <li><a href="/photos" class={pathname.startsWith('/photos') ? 'active' : ''}>Photos</a></li>
        <li><a href="/#writing">Writing</a></li>
      </ul>
    </nav>
  </div>

  <slot />

  <!-- ============================================================
       FOOTER
  ============================================================ -->
  {!pathname.startsWith('/gallery') && (
    <>
      <div class="footer-divider"></div>
      <div class="container">
        <footer class="footer r" aria-label="Footer">
          <div class="footer-contact">
            Let's connect —
            <button class="email-copy" id="copy-email" aria-label="Copy email address" data-tip="Copy">
              hi@loc.digital
            </button>
          </div>
          <ul class="footer-links">
            <li><a href="https://www.linkedin.com/in/phucloc" target="_blank" rel="noopener noreferrer"
                aria-label="LinkedIn">LinkedIn ↗</a></li>
            <li><a href="https://github.com/phucloc" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub ↗</a></li>
            <li><a href="https://phucloc.digital/resume" target="_blank" rel="noopener noreferrer"
                aria-label="Resume">Resume ↗</a></li>
            <li><a href="/rss.xml">RSS</a></li>
          </ul>
        </footer>
        <div class="colophon">
          <span>© 2026 Phuc Loc Nguyen</span>
          <span>Astro · Static HTML · WCAG 2.2 AA</span>
        </div>
      </div>
    </>
  )}

  <!-- Scripts -->
  <script is:inline>
    (function () {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = () => window.innerWidth < 768;

      /* ── Page load ── */
      window.addEventListener('DOMContentLoaded', () => {
        document.body.classList.add('ready');

        // Nav: drop from above (spring CSS handles overshoot)
        setTimeout(() => document.getElementById('site-header')?.classList.add('in'), 80);

        // Prepare typing effect for hero lines
        const heroLines = document.querySelectorAll('.hero-line');
        
        // Helper to prepare DOM structure for a line
        function prepareTyping(element) {
          if (!element.getAttribute('aria-label')) {
            element.setAttribute('aria-label', element.textContent.trim());
          }
          element.setAttribute('aria-hidden', 'true');

          function processNode(node) {
            if (node.nodeType === Node.TEXT_NODE) {
              const text = node.textContent;
              if (!text.trim()) return document.createTextNode(text);

              const fragment = document.createDocumentFragment();
              const words = text.split(/(\s+)/);

              words.forEach(word => {
                if (/\s+/.test(word)) {
                  fragment.appendChild(document.createTextNode(word));
                } else {
                  const wordSpan = document.createElement('span');
                  wordSpan.className = 'word';
                  wordSpan.style.display = 'inline-block';
                  wordSpan.style.whiteSpace = 'nowrap';

                  word.split('').forEach(char => {
                    const charSpan = document.createElement('span');
                    charSpan.className = 'char';
                    charSpan.textContent = char;
                    charSpan.style.position = 'relative';
                    charSpan.style.display = 'inline-block';
                    charSpan.style.opacity = '0';
                    charSpan.style.transition = 'opacity 0.08s ease-out';
                    wordSpan.appendChild(charSpan);
                  });
                  fragment.appendChild(wordSpan);
                }
              });
              return fragment;
            } else if (node.nodeType === Node.ELEMENT_NODE) {
              const clonedElement = node.cloneNode(false);
              Array.from(node.childNodes).forEach(child => {
                clonedElement.appendChild(processNode(child));
              });
              return clonedElement;
            }
            return node.cloneNode(true);
          }

          const newFragment = document.createDocumentFragment();
          Array.from(element.childNodes).forEach(child => {
            newFragment.appendChild(processNode(child));
          });

          element.innerHTML = '';
          element.appendChild(newFragment);
        }

        // Initialize characters DOM for typing
        if (!reduced) {
          heroLines.forEach(prepareTyping);
        }

        // Type a single line
        function typeLine(line, speed = 35, callback) {
          const chars = line.querySelectorAll('.char');
          if (chars.length === 0) {
            line.classList.add('in'); // fallback if reduced motion or parser skipped
            if (callback) callback();
            return;
          }

          line.classList.add('in'); // start fly-up transition
          let index = 0;
          
          function next() {
            if (index < chars.length) {
              if (index > 0) {
                chars[index - 1].classList.remove('active-cursor');
              }
              chars[index].style.opacity = '1';
              chars[index].classList.add('active-cursor');
              index++;
              setTimeout(next, speed);
            } else {
              setTimeout(() => {
                chars[chars.length - 1].classList.remove('active-cursor');
                if (!reduced) setTimeout(() => line.classList.add('floating'), 500);
                if (callback) callback();
              }, 300);
            }
          }
          next();
        }

        // Trigger typing sequentially
        if (heroLines.length > 0) {
          if (reduced) {
            // No typing animation if prefers-reduced-motion is active
            heroLines.forEach((line, i) => {
              setTimeout(() => {
                line.classList.add('in');
              }, 280 + i * 130);
            });
          } else {
            // Type sequentially
            let lineIndex = 0;
            function typeNext() {
              if (lineIndex < heroLines.length) {
                typeLine(heroLines[lineIndex], 40, () => {
                  lineIndex++;
                  setTimeout(typeNext, 150);
                });
              }
            }
            // Start the sequence after header/nav initial animations
            setTimeout(typeNext, 280);
          }
        }

        // Hero aside
        setTimeout(() => document.querySelector('.hero-aside')?.classList.add('in'), 1200);
      });

      /* ── IntersectionObserver: section reveals ── */
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.07, rootMargin: '0px 0px -36px 0px' });
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      /* ── Scroll: nav bg + progress bar + parallax ── */
      const header = document.getElementById('site-header');
      const parallax = document.querySelectorAll('[data-parallax]');
      let ticking = false, idleTimer;

      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const sy = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;

          if (header) header.classList.toggle('is-scrolled', sy > 50);

          // Parallax gravity inversion
          if (!reduced && !isMobile()) {
            parallax.forEach(el => {
              const speed = parseFloat(el.dataset.parallax) || 0.1;
              const mid = el.getBoundingClientRect().top + el.offsetHeight / 2;
              el.style.transform = `translateY(${(mid - window.innerHeight / 2) * speed * -1}px)`;
            });
          }

          ticking = false;
        });
      }, { passive: true });

      /* ── Hamburger / mobile menu ── */
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-backdrop');
      let menuOpen = false, lockScrollY = 0;

      function toggleMenu() {
        menuOpen = !menuOpen;
        if (hamburger) {
          hamburger.setAttribute('aria-expanded', String(menuOpen));
          hamburger.classList.toggle('is-open', menuOpen);
        }
        if (mobileMenu) {
          mobileMenu.classList.toggle('is-open', menuOpen);
          mobileMenu.setAttribute('aria-hidden', String(!menuOpen));
        }
        if (backdrop) backdrop.classList.toggle('is-open', menuOpen);

        if (menuOpen) {
          lockScrollY = window.scrollY;
          document.body.style.cssText = `position:fixed;top:-${lockScrollY}px;width:100%;`;
        } else {
          document.body.style.cssText = '';
          window.scrollTo(0, lockScrollY);
        }
      }

      hamburger?.addEventListener('click', toggleMenu);
      backdrop?.addEventListener('click', () => menuOpen && toggleMenu());
      mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menuOpen && toggleMenu()));
      document.addEventListener('keydown', e => e.key === 'Escape' && menuOpen && toggleMenu());

      /* ── Smooth scroll for anchor links ── */
      document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach(a => {
        a.addEventListener('click', e => {
          const href = a.getAttribute('href');
          const isHomePage = window.location.pathname === '/' || window.location.pathname === '/index.html';
          if (href.startsWith('/#') && !isHomePage) return; // let it navigate natively
          
          const targetId = href.startsWith('/#') ? href.slice(1) : href;
          const t = document.querySelector(targetId);
          if (!t) return;
          e.preventDefault();
          window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 56, behavior: 'smooth' });
          if (menuOpen) toggleMenu(); // Close mobile menu on click
        });
      });

      /* ── Gallery arrows ── */
      const stripOuter = document.querySelector('.gallery-strip-outer');
      const arrowL = document.querySelector('.gallery-arrow--left');
      const arrowR = document.querySelector('.gallery-arrow--right');

      if (stripOuter && arrowL && arrowR) {
        // Prevent native drag behaviors on child elements
        stripOuter.querySelectorAll('a, img').forEach(el => {
          el.setAttribute('draggable', 'false');
        });

        const fadeR = stripOuter.parentElement.querySelector('.gallery-fade-right');
        const fadeL = stripOuter.parentElement.querySelector('.gallery-fade-left');

        const updateArrows = () => {
          const atStart = stripOuter.scrollLeft <= 4;
          const atEnd = stripOuter.scrollLeft >= stripOuter.scrollWidth - stripOuter.clientWidth - 4;
          arrowL.disabled = atStart;
          arrowR.disabled = atEnd;
          // Left fade: show only after scrolling away from start
          fadeL?.classList.toggle('visible', !atStart);
          // Right fade: hide when fully scrolled to end
          if (fadeR) fadeR.style.opacity = atEnd ? '0' : '1';
        };
        const step = () => stripOuter.clientWidth * 0.7;
        arrowL.addEventListener('click', () => stripOuter.scrollBy({ left: -step(), behavior: 'smooth' }));
        arrowR.addEventListener('click', () => stripOuter.scrollBy({ left: step(), behavior: 'smooth' }));
        stripOuter.addEventListener('scroll', updateArrows, { passive: true });
        updateArrows();

        // Drag-to-scroll (mouse only — touch uses native scroll which is smoother)
        let down = false, startX, startSL, vel = 0, lastX, lastT, rafG, rafMove;
        let isDragging = false;
        let pendingX = 0;

        // Prevent native image/link ghost drag
        stripOuter.addEventListener('dragstart', e => e.preventDefault());

        // Batch mousemove into rAF for smooth 60fps updates
        const applyMove = () => {
          if (!down) return;
          const x = pendingX;
          const dx = x - startX;
          if (Math.abs(dx) > 5) isDragging = true;
          stripOuter.scrollLeft = startSL - dx;
          const now = Date.now(), dt = now - lastT || 1;
          vel = (lastX - x) / dt;
          lastX = x;
          lastT = now;
          rafMove = 0;
        };

        stripOuter.addEventListener('mousedown', e => {
          if (e.button !== 0) return;
          down = true;
          isDragging = false;
          startX = e.pageX;
          startSL = stripOuter.scrollLeft;
          vel = 0;
          lastX = e.pageX;
          lastT = Date.now();
          cancelAnimationFrame(rafG);
          stripOuter.classList.add('is-dragging');
        });

        window.addEventListener('mousemove', e => {
          if (!down) return;
          e.preventDefault();
          pendingX = e.pageX;
          if (!rafMove) rafMove = requestAnimationFrame(applyMove);
        });

        window.addEventListener('mouseup', () => {
          if (!down) return;
          down = false;
          stripOuter.classList.remove('is-dragging');
          // Momentum glide
          const coast = () => {
            vel *= 0.95;
            stripOuter.scrollLeft += vel * 16;
            if (Math.abs(vel) > 0.03) rafG = requestAnimationFrame(coast);
          };
          if (Math.abs(vel) > 0.1) coast();
        });

        // Block click (PhotoSwipe) after a drag gesture
        stripOuter.addEventListener('click', e => {
          if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);
      }

      /* ── Email copy ── */
      const copyBtn = document.getElementById('copy-email');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('hi@loc.digital');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = 'hello@locnguyen.dev';
          ta.style.cssText = 'position:fixed;opacity:0;';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
        }
        copyBtn.dataset.tip = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => { copyBtn.classList.remove('copied'); copyBtn.dataset.tip = 'Copy'; }, 2200);
      });

    })();
  </script>

  <!-- PhotoSwipe -------------------------------------------- -->
  <script type="module" is:inline>
    import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.min.js';

    const lightbox = new PhotoSwipeLightbox({
      gallery: '[data-gallery]',
      children: 'a',
      pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.esm.min.js'),
      showHideAnimationType: 'zoom',
      bgOpacity: 0.95,
      padding: { top: 20, bottom: 40, left: 20, right: 20 },
      preloaderDelay: 0,
    });

    // Caption
    lightbox.on('uiRegister', () => {
      lightbox.pswp.ui.registerElement({
        name: 'caption', order: 9, isButton: false, appendTo: 'root',
        onInit: (el, pswp) => {
          el.style.cssText = 'position:absolute;bottom:0;left:0;right:0;padding:12px 20px;font-family:\'DM Mono\',monospace;font-size:11px;color:rgba(255,255,255,.55);text-align:center;letter-spacing:.06em;pointer-events:none;';
          pswp.on('change', () => { el.textContent = pswp.currSlide.data.element?.querySelector('img')?.alt || ''; });
        }
      });
    });

    lightbox.init();
  </script>
</body>

</html>
