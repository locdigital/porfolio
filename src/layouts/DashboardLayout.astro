---
import '../styles/global.css';
import '../styles/dashboard.css';
import '../styles/motion-tokens.css';
import '../styles/page-transitions.css';
import { ClientRouter } from 'astro:transitions';
import MacTitlebar from '../components/dashboard/MacTitlebar.astro';
import SiteHead from '../components/layout/SiteHead.astro';
import { appStylesForPath } from '../components/apps/app-styles';
import { WORKSPACE_WALLPAPER } from '../config/site';
import DashboardSidebar from '../components/dashboard/DashboardSidebar.astro';
import CommandSearch from '../components/dashboard/CommandSearch.astro';
import { DesktopShell } from '../components/desktop/DesktopShell';
import Heroicon from '../components/icons/Heroicon.astro';
import { ChevronRight } from '../components/icons/phosphor';
import { getUiCopy } from '../i18n/ui';
import { DEFAULT_DESCRIPTION, DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_ALT, PERSON_NAME, type BreadcrumbItem, type JsonLd } from "../lib/seo";

interface Props {
  title?: string;
  pageTitle?: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  currentPath?: string;
  maxWidthVariant?: 'default' | 'reading' | 'gallery';
  schema?: JsonLd | JsonLd[];
  pageType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  robots?: string;
  fullBleed?: boolean;
}

const copy = getUiCopy();

const {
  title = copy.workspaceTitle,
  pageTitle,
  description = DEFAULT_DESCRIPTION,
  breadcrumbs,
  currentPath = Astro.url.pathname,
  maxWidthVariant = 'default',
  schema = [],
  pageType = 'WebPage',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  ogType = 'website',
  author = PERSON_NAME,
  datePublished,
  dateModified,
  noindex = false,
  robots,
  fullBleed = false,
} = Astro.props;

const appStylesheets = appStylesForPath(currentPath);

const contentClass =
  maxWidthVariant === 'reading'
    ? 'workspace-content workspace-content--reading'
    : maxWidthVariant === 'gallery'
      ? 'workspace-content workspace-content--gallery'
      : 'workspace-content';

const mobileLabel = pageTitle || breadcrumbs?.[breadcrumbs.length - 1]?.label || copy.nav.overview;
const appLabel = 'workspace';
const windowTitle = copy.workspaceTitle;
const resumeHref = '/resume';
const privacyHref = '/privacy';
---

<!DOCTYPE html>
<html lang="en" data-desktop-app="workspace">
<head>
  <SiteHead
    title={title}
    siteName={copy.siteName}
    description={description}
    breadcrumbs={breadcrumbs}
    schema={schema}
    pageType={pageType}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    ogType={ogType}
    author={author}
    datePublished={datePublished}
    dateModified={dateModified}
    noindex={noindex}
    robots={robots}
  >
    <script is:inline slot="boot">
    document.documentElement.classList.add("js");
    const isEmbeddedWindow =
      window.self !== window.top || new URLSearchParams(window.location.search).get("embed") === "1";
    if (isEmbeddedWindow) {
      document.documentElement.classList.add("is-embedded-window");
    }
    if (window.matchMedia("(max-width: 768px)").matches) {
      document.documentElement.classList.add("mobile-lite");
    }
    if (!isEmbeddedWindow) {
      try {
        const app = document.documentElement.dataset.desktopApp || "workspace";
        const saved = JSON.parse(sessionStorage.getItem(`${app}-window-state`) || "null");
        if (saved && typeof saved === "object") {
          const closed = saved.closed === true;
          const minimized = !closed && saved.minimized === true;
          document.documentElement.classList.toggle("window-closed", closed);
          document.documentElement.classList.toggle("window-minimized", minimized);
          document.documentElement.classList.toggle("window-maximized", !closed && !minimized && saved.maximized === true);
        }
      } catch {}
    }
  </script>
    <ClientRouter fallback="swap" />
  </SiteHead>
</head>

<body>
  {/* CSS for an app the shell server-renders on this route. In <body> so it follows the
      bundle Astro appends to <head>; load-stylesheet.ts mirrors it into <head> on hydrate. */}
  {appStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
  <!-- Desktop wallpaper behind the application window. -->
  <div class="workspace-canvas">
    <div
      class="workspace-wallpaper"
      aria-hidden="true"
      transition:persist="workspace-wallpaper"
    >
      <picture class="workspace-wallpaper-picture">
        <source media="(min-width: 1024px)" srcset={WORKSPACE_WALLPAPER.src} type="image/webp" />
        <img
          class="workspace-wallpaper-image"
          alt=""
          width={WORKSPACE_WALLPAPER.width}
          height={WORKSPACE_WALLPAPER.height}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
        />
      </picture>
    </div>

    <div class="workspace-dock-persist" transition:persist="workspace-dock">
      <DesktopShell client:load initialPath={currentPath} />
    </div>

    <!-- Floating macOS-inspired Application Window -->
    <div class="mac-window-container">

      <!-- Desktop Window Titlebar (32px, white background, traffic lights) -->
      <MacTitlebar title={windowTitle} appLabel={appLabel} />

      <!-- Mobile Sticky Top Bar (< 1024px) -->
      <header class="mobile-topbar" aria-label={copy.navAriaLabel}>
        <div class="mobile-topbar-left">
          <button
            id="mobile-drawer-toggle"
            class="mobile-menu-btn"
            type="button"
            aria-label={copy.openNavMenu}
            aria-controls="dash-sidebar"
            aria-expanded="false"
          >
            <Heroicon name="bars-3" size={20} />
          </button>
          <span class="mobile-page-label">{mobileLabel}</span>
        </div>
      </header>

      <!-- Two-column Body: 232px Sidebar + Main Content -->
      <div class="workspace-body">

        <!-- Sidebar Navigation -->
        <DashboardSidebar currentPath={currentPath} />

        <!-- Main Workspace Document Surface -->
        <main
          id="main-content"
          class:list={["workspace-main", { "is-fullbleed": fullBleed }]}
          tabindex="-1"
          data-workspace-scroll
        >

          <div class:list={[contentClass, { "is-fullbleed": fullBleed }]}>
            <div class="workspace-doc-main">
              <!-- Optional Breadcrumbs if provided -->
              {breadcrumbs && breadcrumbs.length > 0 && (
                <nav class="dash-breadcrumbs" aria-label={copy.breadcrumbsAriaLabel}>
                  <ol>
                    {breadcrumbs.map((crumb, idx) => (
                      <li>
                        {idx > 0 && <span class="dash-crumb-sep"><ChevronRight size={12} aria-hidden="true" /></span>}
                        {crumb.href ? (
                          <a href={crumb.href} class="dash-crumb-link" data-astro-prefetch>
                            {crumb.label}
                          </a>
                        ) : (
                          <span class="dash-crumb-current" aria-current="page">
                            {crumb.label}
                          </span>
                        )}
                      </li>
                    ))}
                  </ol>
                </nav>
              )}

              <!-- Page Content Slot -->
              <slot />
            </div>

            {!fullBleed && (
              <footer class="workspace-doc-footer" aria-label={copy.footerAriaLabel}>
                <nav class="workspace-doc-footer-links" aria-label={copy.footerAriaLabel}>
                  <a href={resumeHref} class="dash-link" data-astro-prefetch>{copy.footerResumeLink}</a>
                  <span aria-hidden="true">·</span>
                  <a href={privacyHref} class="dash-link" data-astro-prefetch>{copy.footerPrivacyLink}</a>
                </nav>
                <p class="workspace-doc-footer-meta">{copy.footerCopyright(new Date().getFullYear())}</p>
              </footer>
            )}
          </div>
        </main>

      </div>

      <!-- Desktop resize handles (left/right/bottom edges, bottom-left/bottom-right corners) -->
      <div class="desktop-resize-handle desktop-resize-handle--w" data-window-resize="w" aria-hidden="true"></div>
      <div class="desktop-resize-handle desktop-resize-handle--e" data-window-resize="e" aria-hidden="true"></div>
      <div class="desktop-resize-handle desktop-resize-handle--s" data-window-resize="s" aria-hidden="true"></div>
      <div class="desktop-resize-handle desktop-resize-handle--sw" data-window-resize="sw" aria-hidden="true"></div>
      <div class="desktop-resize-handle desktop-resize-handle--se" data-window-resize="se" aria-hidden="true"></div>
    </div>

    <button
      class="workspace-window-restore"
      type="button"
      data-window-action="restore"
      aria-label={copy.openApp(appLabel)}
      title={copy.openApp(appLabel)}
      hidden
    >
      <span class="workspace-window-restore-icon" aria-hidden="true"></span>
      <span>{copy.openApp(appLabel)}</span>
    </button>

  </div>

  <CommandSearch />

  <script src="../scripts/dashboard.ts"></script>
</body>
</html>

<style>
  :global(html.is-embedded-window .workspace-wallpaper),
  :global(html.is-embedded-window .workspace-dock-persist),
  :global(html.is-embedded-window .desktop-titlebar),
  :global(html.is-embedded-window .desktop-resize-handle),
  :global(html.is-embedded-window .workspace-window-restore) {
    display: none !important;
  }

  :global(html.is-embedded-window .workspace-canvas) {
    padding: 0 !important;
    min-height: 100dvh !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    overflow: hidden !important;
    background: #ffffff !important;
  }

  :global(html.is-embedded-window .mac-window-container) {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    max-width: none !important;
    height: 100dvh !important;
    max-height: none !important;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    transform: none !important;
    display: flex !important;
  }

  :global(html.is-embedded-window .workspace-body) {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
  }

  :global(html.is-embedded-window .workspace-main) {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    padding-bottom: 32px !important;
  }

  .workspace-main.is-fullbleed {
    padding: 0;
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  @media (max-width: 1023px) {
    .workspace-main.is-fullbleed {
      height: calc(100dvh - var(--mobile-topbar-h, 56px) - env(safe-area-inset-top, 0px));
      flex: 0 0 auto;
    }

    :global(html.is-embedded-window) .workspace-main.is-fullbleed {
      height: 100dvh;
    }
  }

  .workspace-content.is-fullbleed {
    max-width: none;
    height: 100%;
    min-height: 0;
  }

  .workspace-content.is-fullbleed .workspace-doc-main {
    height: 100%;
    min-height: 0;
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
  }

  .workspace-doc-main {
    flex: 1 0 auto;
    min-width: 0;
    padding-bottom: var(--space-16);
  }

  .workspace-doc-footer {
    margin-top: 0;
    padding-top: var(--space-8);
    padding-bottom: var(--space-2);
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .workspace-doc-footer-links {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .workspace-doc-footer-meta {
    margin: 0;
  }

  @media (max-width: 640px) {
    .workspace-doc-footer {
      justify-content: center;
      text-align: center;
    }
  }
</style>
