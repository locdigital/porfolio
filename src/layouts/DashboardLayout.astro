---
import '../styles/global.css';
import '../styles/dashboard.css';
import '../styles/page-transitions.css';
import '../styles/content-colors.css';
import interLatinFont from '../assets/fonts/inter-latin-variable.woff2?url';
import { ViewTransitions } from 'astro:transitions';
import MacTitlebar from '../components/dashboard/MacTitlebar.astro';
import DashboardSidebar from '../components/dashboard/DashboardSidebar.astro';
import { AsciiArt } from '@/components/ui/sss';
import Heroicon from '../components/icons/Heroicon.astro';
import { ChevronRight } from '../components/icons/phosphor';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  PERSON_NAME,
  SITE_URL,
  absoluteUrl,
  breadcrumbListSchema,
  canonicalPath,
  canonicalUrl,
  graphSchema,
  pageSchema,
  safeJsonLd,
  type BreadcrumbItem,
  type JsonLd,
} from "../lib/seo";

interface Props {
  title?: string;
  pageTitle?: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  currentPath?: string;
  maxWidthVariant?: 'default' | 'reading' | 'gallery';
  schema?: JsonLd | JsonLd[];
  pageType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  robots?: string;
  lang?: 'en' | 'vi';
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = "Phuc Loc Nguyen — Workspace",
  pageTitle,
  description = DEFAULT_DESCRIPTION,
  breadcrumbs,
  currentPath = Astro.url.pathname,
  maxWidthVariant = 'default',
  schema = [],
  pageType = 'WebPage',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  ogType = 'website',
  author = PERSON_NAME,
  datePublished,
  dateModified,
  noindex = false,
  robots,
  lang = 'en',
  alternates,
} = Astro.props;

const canonicalHref = canonicalUrl(Astro.url.pathname);
const normalizedPath = canonicalPath(Astro.url.pathname);
const markdownPath = normalizedPath === "/" ? "/index.md" : `${normalizedPath}.md`;
const markdownUrl = new URL(markdownPath, SITE_URL).toString();
const resolvedOgImage = absoluteUrl(ogImage);
const robotsDirective = robots ?? (noindex ? "noindex, nofollow" : "index, follow");
const ogLocale = lang === "vi" ? "vi_VN" : "en_US";

const pageSchemas = (Array.isArray(schema) ? schema.flat() : [schema]).filter(Boolean);
const breadcrumbNode =
  !noindex && breadcrumbs && breadcrumbs.length > 0
    ? breadcrumbListSchema(breadcrumbs, canonicalHref)
    : null;
const hasExplicitWebPage = pageSchemas.some((node) => {
  const id = node?.["@id"];
  return typeof id === "string" && id.endsWith("#webpage");
});

const autoWebPageNode =
  !noindex && !hasExplicitWebPage
    ? pageSchema({
        url: canonicalHref,
        title,
        description,
        type: pageType,
        lang,
        primaryImageUrl: resolvedOgImage,
        datePublished,
        dateModified,
        breadcrumbId: breadcrumbNode?.["@id"] as string | undefined,
      })
    : null;

const graphNodes: JsonLd[] = [
  ...(autoWebPageNode ? [autoWebPageNode] : []),
  ...(breadcrumbNode ? [breadcrumbNode] : []),
  ...pageSchemas,
];
const jsonLd = !noindex ? safeJsonLd(graphSchema(graphNodes, { lang })) : "";

const hreflangLinks =
  alternates && alternates.length > 0
    ? alternates
    : [
        { hreflang: lang, href: canonicalHref },
        { hreflang: "x-default", href: canonicalHref },
      ];

const contentClass =
  maxWidthVariant === 'reading'
    ? 'workspace-content workspace-content--reading'
    : maxWidthVariant === 'gallery'
      ? 'workspace-content workspace-content--gallery'
      : 'workspace-content';

const mobileLabel = pageTitle || breadcrumbs?.[breadcrumbs.length - 1]?.label || "Workspace";
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-visual">
  <meta name="description" content={description}>
  <meta name="robots" content={robotsDirective}>
  {!noindex && author && <meta name="author" content={author} />}
  <meta name="is-agentic-site-type" content="business">

  <!-- Open Graph / Social Media -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={resolvedOgImage}>
  <meta property="og:image:alt" content={ogImageAlt}>
  {!noindex && <meta property="og:url" content={canonicalHref} />}
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content={ogLocale}>
  <meta property="og:site_name" content="Phuc Loc Nguyen — Workspace">
  {ogType === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
  {ogType === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
  {ogType === 'article' && author && <meta property="article:author" content={author} />}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={resolvedOgImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <title>{title}</title>
  <script is:inline>
    document.documentElement.classList.add("js");
    if (window.matchMedia("(max-width: 768px)").matches) {
      document.documentElement.classList.add("mobile-lite");
    }
  </script>
  <meta name="theme-color" content="#FFFFFF">
  {!noindex && (
    <>
      <link rel="canonical" href={canonicalHref} />
      {hreflangLinks.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))}
      <link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown version" />
    </>
  )}

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={interLatinFont} as="font" type="font/woff2" crossorigin />

  <ViewTransitions fallback="swap" />
  {!noindex && jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}

  <!-- Google Tag Manager / Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KMGLHHMB"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
  </script>
</head>

<body>
  <!-- Animated desktop wallpaper behind the application window. -->
  <div class="workspace-canvas">
    <div class="workspace-wallpaper" aria-hidden="true" transition:persist="workspace-wallpaper">
      <AsciiArt />
    </div>

    <!-- Floating macOS-inspired Application Window -->
    <div class="mac-window-container">

      <!-- Desktop Window Titlebar (44px, white background, traffic lights) -->
      <MacTitlebar title="Phuc Loc Nguyen — Workspace" currentPath={currentPath} />

      <!-- Mobile Sticky Top Bar (< 1024px) -->
      <header class="mobile-topbar" aria-label="Mobile Navigation Bar">
        <div class="mobile-topbar-left">
          <button
            id="mobile-drawer-toggle"
            class="mobile-menu-btn"
            aria-label="Open navigation menu"
            aria-controls="dash-sidebar"
            aria-expanded="false"
          >
            <Heroicon name="bars-3" size={20} />
          </button>
          <span class="mobile-page-label">{mobileLabel}</span>
        </div>
        <div class="mobile-topbar-right" style="display: flex; align-items: center; gap: 6px;"></div>
      </header>

      <!-- Two-column Body: 232px Sidebar + Main Content -->
      <div class="workspace-body">

        <!-- Sidebar Navigation -->
        <DashboardSidebar currentPath={currentPath} />

        <!-- Main Workspace Document Surface -->
        <main
          id="main-content"
          class="workspace-main"
          tabindex="-1"
          transition:name="workspace-document"
          transition:animate="initial"
        >

          <div class={contentClass}>
            <div class="workspace-doc-main">
              <!-- Optional Breadcrumbs if provided -->
              {breadcrumbs && breadcrumbs.length > 0 && (
                <nav class="dash-breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: var(--space-6);">
                  <ol style="display:flex;align-items:center;gap:0.4rem;list-style:none;margin:0;padding:0;font-size:var(--text-body-sm);color:var(--dash-muted);">
                    {breadcrumbs.map((crumb, idx) => (
                      <li style="display:inline-flex;align-items:center;gap:0.4rem;">
                        {idx > 0 && <span style="opacity:0.5;display:inline-flex;"><ChevronRight size={12} aria-hidden="true" /></span>}
                        {crumb.href ? (
                          <a href={crumb.href} style="color:inherit;" class="dash-crumb-link" data-astro-prefetch>
                            {crumb.label}
                          </a>
                        ) : (
                          <span style="color:var(--dash-text);font-weight:500;" aria-current="page">
                            {crumb.label}
                          </span>
                        )}
                      </li>
                    ))}
                  </ol>
                </nav>
              )}

              <!-- Page Content Slot -->
              <slot />
            </div>

            <footer class="workspace-doc-footer" aria-label="Footer">
              <p class="workspace-doc-footer-meta">© {new Date().getFullYear()} Phuc Loc Nguyen.</p>
            </footer>
          </div>
        </main>

      </div>
    </div>

  </div>

  <script src="../scripts/dashboard.ts"></script>
  <script>
    import { onPageLoad } from '../scripts/page-lifecycle';

    onPageLoad((signal) => {
      const video = document.querySelector<HTMLVideoElement>('.workspace-wallpaper video');
      if (!video) return;

      const still = window.matchMedia('(prefers-reduced-motion: reduce), (max-width: 1023px)');
      const syncPlayback = () => {
        if (still.matches) video.pause();
        else void video.play().catch(() => { /* The poster remains if autoplay is blocked. */ });
      };

      syncPlayback();
      still.addEventListener('change', syncPlayback, { signal });
    });
  </script>
</body>
</html>

<style>
  .workspace-doc-main {
    flex: 1 0 auto;
    min-width: 0;
    padding-bottom: var(--space-16);
  }

  .workspace-doc-footer {
    margin-top: 0;
    padding-top: var(--space-8);
    padding-bottom: var(--space-2);
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 16px 24px;
    font-size: var(--text-body);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .workspace-doc-footer-meta {
    margin: 0;
    color: var(--dash-muted);
    font-size: var(--text-body);
  }

  @media (max-width: 640px) {
    .workspace-doc-footer {
      justify-content: center;
      text-align: center;
    }
  }
</style>
