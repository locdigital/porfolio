---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { ArrowRight } from "../icons/phosphor";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import { getWritingEntries, writingCategorySlug } from "../../lib/writing";
import { canonicalUrl, collectionPageSchema } from "../../lib/seo";

interface Props { category?: string; }
const { category } = Astro.props;

const allEntries = await getWritingEntries();
const entries = category ? allEntries.filter(entry => entry.data.category === category) : allEntries;
const samplePreview = entries.length > 0 && entries.every(entry => entry.data.sample);
const featuredEntries = entries.slice(0, 2);
const timelineEntries = entries.slice(2);
const featuredFallbacks = [
  {
    src: "/assets/photos/sa-pa/DSC_6711.webp",
    alt: "Clouds drifting over the mountain valleys of Sa Pa, photographed by Phuc Loc Nguyen",
  },
  {
    src: "/assets/photos/singapore/singapore-23.webp",
    alt: "Supertree Grove glowing at night in Singapore, photographed by Phuc Loc Nguyen",
  },
];

function archiveDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "Asia/Ho_Chi_Minh",
  }).format(date);
}

const basePath = "/writing";
const homePath = "/";
const pageUrl = canonicalUrl(category ? `/writing/category/${writingCategorySlug(category)}` : basePath);
const linkableEntries = entries.filter(entry => entry.data.linkable !== false);
const writingSchema = collectionPageSchema({
  url: pageUrl,
  title: category ? `${category} — Writing — Phuc Loc Nguyen` : "Writing — Phuc Loc Nguyen",
  description: category ? `Articles about ${category} by Phuc Loc Nguyen.` : "Essays, field stories, and reflections on growth, career, and travel by Phuc Loc Nguyen.",
  items: linkableEntries.map((entry) => ({
    name: entry.data.title,
    url: `${basePath}/${entry.slug}`,
    description: entry.data.description,
    image: entry.data.coverImage?.src,
  })),
  breadcrumbId: `${pageUrl}#breadcrumbs`,
});
---

<DashboardLayout
  title={category ? `${category} — Writing — Phuc Loc Nguyen` : "Writing — Phuc Loc Nguyen"}
  pageTitle="Writing"
  description={category ? `Articles about ${category} by Phuc Loc Nguyen.` : "Essays, field stories, and reflections on marketing, career, and travel by Phuc Loc Nguyen."}
  breadcrumbs={[
    { label: "Personal", href: homePath },
    { label: "Writing", href: category ? basePath : undefined },
    ...(category ? [{ label: category }] : [])
  ]}
  maxWidthVariant="default"
  currentPath={Astro.url.pathname}
  schema={writingSchema}
>
  <header class="page-header">
    <h1 class="page-title">{category || "Writing"}</h1>
    <p class="page-lead">
      {category ? `${entries.length} ${entries.length === 1 ? "article" : "articles"} in this topic.` : "Essays and notes on performance, curiosity, career building, and travel."}
    </p>
    {samplePreview && (
      <p class="writing-preview-note">
        {category ? "Sample content, created to preview the writing layout." : "Three sample articles, created to preview the writing layout."}
      </p>
    )}
  </header>

  {entries.length > 0 ? (
    <>
      <section class="writing-featured" aria-label="Featured articles">
        {featuredEntries.map((entry, index) => {
          const isLinkable = entry.data.linkable !== false;
          const cover = entry.data.coverImage ?? featuredFallbacks[index];
          return (
            <article class="writing-featured-card">
              <div class="writing-card-hover" aria-hidden="true"></div>
              <div class="writing-featured-image">
                <ResponsiveImage
                  src={cover.src}
                  alt={cover.alt}
                  width={720}
                  height={405}
                  widths={[320, 480, 720, 960]}
                  sizes="(max-width: 720px) calc(100vw - 32px), 50vw"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  data-motion-share={isLinkable && entry.data.coverImage ? `writing-${entry.slug}` : undefined}
                  style={isLinkable && entry.data.coverImage ? "view-transition-class: workspace-shared-image" : undefined}
                />
              </div>
              <h2>
                {isLinkable ? (
                  <a href={`${basePath}/${entry.slug}`} class="writing-card-title-link" data-astro-prefetch>
                    <span class="writing-card-hit" aria-hidden="true"></span>
                    <span class="writing-card-title-text">{entry.data.title}</span>
                  </a>
                ) : (
                  <span class="writing-card-title-text">{entry.data.title}</span>
                )}
              </h2>
              <time datetime={entry.data.date.toISOString()}>{archiveDate(entry.data.date)}</time>
              {isLinkable && (
                <div class="writing-view-link" aria-hidden="true">
                  View post <ArrowRight size={15} strokeWidth={1.5} aria-hidden="true" />
                </div>
              )}
            </article>
          );
        })}
      </section>

      {timelineEntries.length > 0 && (
        <section class="writing-timeline" aria-label="More articles">
          {timelineEntries.map((entry) => {
            const isLinkable = entry.data.linkable !== false;
            return (
              <article class="writing-timeline-entry">
                <time datetime={entry.data.date.toISOString()}>{archiveDate(entry.data.date)}</time>
                <div class="writing-timeline-content">
                  <div class="writing-card-hover" aria-hidden="true"></div>
                  <h2>
                    {isLinkable ? (
                      <a href={`${basePath}/${entry.slug}`} class="writing-card-title-link" data-astro-prefetch>
                        <span class="writing-card-hit" aria-hidden="true"></span>
                        <span class="writing-card-title-text">{entry.data.title}</span>
                      </a>
                    ) : (
                      <span class="writing-card-title-text">{entry.data.title}</span>
                    )}
                  </h2>
                  <p>{entry.data.description}</p>
                  {isLinkable && (
                    <div class="writing-view-link" aria-hidden="true">
                      View post <ArrowRight size={15} strokeWidth={1.5} aria-hidden="true" />
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </section>
      )}
    </>
  ) : (
    <section class="writing-empty dash-prose" aria-labelledby="writing-empty-title">
      <h2 id="writing-empty-title" class="item-title">No posts yet.</h2>
      <p>There aren’t any published articles here yet.</p>
      <p>
        In the meantime, explore <a href="/work">selected work</a> or browse the <a href="/photos">photography archive</a>.
      </p>
    </section>
  )}
</DashboardLayout>

<style>
  .writing-preview-note {
    margin: 12px 0 0;
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
  }

  .writing-featured {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
    row-gap: 64px;
    margin-bottom: 80px;
    padding-top: 8px;
  }

  .writing-featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .writing-card-hover,
  .writing-card-hit {
    position: absolute;
    inset: -24px -16px;
    border-radius: 16px;
  }

  .writing-card-hover {
    pointer-events: none;
    z-index: 0;
    background: #f5f5f5;
    opacity: 0;
    transform: scale(0.95);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
                opacity 300ms ease;
  }

  .writing-card-hit {
    z-index: 20;
  }

  @media (min-width: 640px) {
    .writing-card-hover,
    .writing-card-hit {
      inset: -24px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-featured-card:hover .writing-card-hover,
    .writing-featured-card:focus-within .writing-card-hover,
    .writing-timeline-content:hover .writing-card-hover,
    .writing-timeline-content:focus-within .writing-card-hover {
      opacity: 1;
      transform: scale(1);
    }
  }

  .writing-featured-image {
    position: relative;
    z-index: 10;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: var(--dash-surface-subtle);
    margin-bottom: 20px;
  }

  .writing-featured-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .writing-featured-card h2,
  .writing-timeline-content h2 {
    margin: 0;
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-semibold);
    line-height: 1.45;
    letter-spacing: var(--tracking-subheading);
    color: var(--dash-text);
  }

  .writing-card-title-link {
    color: var(--dash-text);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .writing-card-title-link:hover,
  .writing-featured-card:hover .writing-card-title-link,
  .writing-featured-card:focus-within .writing-card-title-link,
  .writing-timeline-content:hover .writing-card-title-link,
  .writing-timeline-content:focus-within .writing-card-title-link {
    color: var(--dash-link-hover);
  }

  .writing-card-title-text {
    position: relative;
    z-index: 10;
  }

  .writing-timeline-entry > time,
  .writing-featured-card time {
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    font-variant-numeric: tabular-nums;
  }

  .writing-timeline-entry > time {
    padding-top: 2px;
  }

  .writing-featured-card time {
    position: relative;
    z-index: 10;
    display: block;
    margin-top: 8px;
  }

  .writing-view-link {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 16px;
    color: var(--dash-link-hover);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-compact);
  }

  .writing-timeline {
    display: flex;
    flex-direction: column;
    gap: 64px;
    border-left: var(--dash-border-width, 0.9px) solid var(--dash-border);
    padding-left: 24px;
  }

  .writing-timeline-entry {
    display: grid;
    grid-template-columns: minmax(140px, 172px) minmax(0, 1fr);
    gap: 16px 32px;
    align-items: start;
  }

  .writing-timeline-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .writing-timeline-content p {
    position: relative;
    z-index: 10;
    display: -webkit-box;
    overflow: hidden;
    margin: 8px 0 0;
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 720px) {
    .writing-featured {
      grid-template-columns: 1fr;
      row-gap: 48px;
      margin-bottom: 56px;
    }

    .writing-timeline {
      gap: 48px;
      padding-left: 20px;
    }

    .writing-timeline-entry {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
