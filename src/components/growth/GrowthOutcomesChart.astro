---
interface GrowthSeries {
  name: string;
  shortName: string;
  multiple: number;
  result: string;
  color: string;
  trajectory: number[];
}

const series: GrowthSeries[] = [
  {
    name: "TikTok Shop monthly revenue",
    shortName: "TikTok Shop revenue",
    multiple: 10,
    result: "10x+",
    color: "#2563eb",
    trajectory: [1, 1.6, 1.2, 2.8, 2.3, 5.1, 4.4, 7.5, 6.7, 10],
  },
  {
    name: "Website revenue",
    shortName: "Website revenue",
    multiple: 10,
    result: "10x",
    color: "#ef4444",
    trajectory: [1, 0.8, 1.7, 1.3, 2.9, 2.2, 4.8, 4.1, 7.1, 10],
  },
  {
    name: "POPS Vietnam monthly users",
    shortName: "POPS monthly users",
    multiple: 10,
    result: "10x YoY",
    color: "#f59e0b",
    trajectory: [1, 1.4, 1.1, 2.5, 2, 4.2, 3.5, 6.7, 6, 10],
  },
  {
    name: "Facebook revenue",
    shortName: "Facebook revenue",
    multiple: 4,
    result: "4x",
    color: "#8b5cf6",
    trajectory: [1, 1.3, 1, 1.8, 1.5, 2.6, 2.2, 3.4, 2.9, 4],
  },
  {
    name: "Monthly student enrollment",
    shortName: "Student enrollment",
    multiple: 3,
    result: "3x",
    color: "#10b981",
    trajectory: [1, 0.85, 1.3, 1.05, 1.7, 1.4, 2.2, 1.9, 2.6, 3],
  },
  {
    name: "SONY campaign engagement",
    shortName: "Campaign engagement",
    multiple: 1.05,
    result: "+5%",
    color: "#ec4899",
    trajectory: [1, 1.04, 0.98, 1.06, 1.01, 1.08, 1.03, 1.09, 1.02, 1.05],
  },
];

const chart = {
  left: 70,
  right: 820,
  top: 24,
  bottom: 304,
  max: 10,
};

const yFor = (value: number) =>
  chart.bottom - (Math.min(value, chart.max) / chart.max) * (chart.bottom - chart.top);

const gridValues = [0, 2, 4, 6, 8, 10];
const xFor = (index: number, total: number) =>
  chart.left + (index / (total - 1)) * (chart.right - chart.left);

const smoothPath = (values: number[]) => {
  const points = values.map((value, index) => ({
    x: xFor(index, values.length),
    y: yFor(value),
  }));

  if (points.length < 2) return "";

  let path = `M ${points[0].x} ${points[0].y}`;
  for (let index = 0; index < points.length - 1; index += 1) {
    const previous = points[index - 1] ?? points[index];
    const current = points[index];
    const next = points[index + 1];
    const afterNext = points[index + 2] ?? next;
    const control1X = current.x + (next.x - previous.x) / 6;
    const control1Y = current.y + (next.y - previous.y) / 6;
    const control2X = next.x - (afterNext.x - current.x) / 6;
    const control2Y = next.y - (afterNext.y - current.y) / 6;
    path += ` C ${control1X} ${control1Y} ${control2X} ${control2Y} ${next.x} ${next.y}`;
  }
  return path;
};

const phases = [
  { label: "Baseline", x: chart.left },
  { label: "Testing", x: xFor(3, 10) },
  { label: "Scaling", x: xFor(6, 10) },
  { label: "Result", x: chart.right },
];
---

<figure class="growth-chart-card dash-card" aria-labelledby="growth-chart-title growth-chart-description">
  <figcaption class="growth-chart-heading">
    <div>
      <p class="growth-chart-kicker">Selected portfolio outcomes</p>
      <h2 id="growth-chart-title" class="growth-chart-title">Growth across every project</h2>
    </div>
    <p id="growth-chart-description" class="growth-chart-description">
      One view of the testing dips, scaling phases, and verified outcomes across the portfolio.
    </p>
  </figcaption>

  <div class="growth-chart-scroll" tabindex="0" role="region" aria-label="Scrollable growth chart">
    <svg
      class="growth-chart"
      viewBox="0 0 900 370"
      role="img"
      aria-labelledby="growth-chart-svg-title growth-chart-svg-desc"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title id="growth-chart-svg-title">Indexed growth outcomes across six portfolio metrics</title>
      <desc id="growth-chart-svg-desc">
        An illustrative journey with rises and dips between the shared baseline and each documented result. TikTok Shop revenue, website revenue, and POPS monthly users reach ten times or more; Facebook revenue reaches four times; student enrollment reaches three times; and campaign engagement increases five percent.
      </desc>

      <defs>
        <linearGradient id="plot-wash" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#2563eb" stop-opacity="0.08" />
          <stop offset="0.52" stop-color="#8b5cf6" stop-opacity="0.025" />
          <stop offset="1" stop-color="#f59e0b" stop-opacity="0.08" />
        </linearGradient>
      </defs>

      <rect
        x={chart.left}
        y={chart.top}
        width={chart.right - chart.left}
        height={chart.bottom - chart.top}
        rx="12"
        fill="url(#plot-wash)"
        aria-hidden="true"
      />

      <text x="18" y="18" class="axis-title">Growth index</text>

      {gridValues.map((value) => {
        const y = yFor(value);
        return (
          <g aria-hidden="true">
            <line
              x1={chart.left}
              y1={y}
              x2={chart.right}
              y2={y}
              class:list={["grid-line", value === 0 && "grid-line--axis"]}
            />
            <text x="55" y={y + 4} text-anchor="end" class="axis-label">{value}x</text>
          </g>
        );
      })}

      <line
        x1={chart.left}
        y1={yFor(1)}
        x2={chart.right}
        y2={yFor(1)}
        class="baseline-line"
        aria-hidden="true"
      />
      <text x="78" y={yFor(1) - 9} class="baseline-label" aria-hidden="true">Shared baseline · 1x</text>

      {phases.slice(1, -1).map((phase) => (
        <line
          x1={phase.x}
          y1={chart.top}
          x2={phase.x}
          y2={chart.bottom}
          class="phase-line"
          aria-hidden="true"
        />
      ))}

      {series.map((item) => {
        const endX = xFor(item.trajectory.length - 1, item.trajectory.length);
        const endY = yFor(item.multiple);
        return (
          <g class="series" aria-label={`${item.name}: ${item.result}`}>
            <path
              d={smoothPath(item.trajectory)}
              stroke={item.color}
              class="series-line"
            />
            {item.trajectory.slice(1, -1).map((value, index) => (
              <circle
                cx={xFor(index + 1, item.trajectory.length)}
                cy={yFor(value)}
                r="1.5"
                fill={item.color}
                class="series-checkpoint"
              />
            ))}
            <circle cx={endX} cy={endY} r="4" fill={item.color} class="series-point" />
          </g>
        );
      })}

      {phases.map((phase) => (
        <text x={phase.x} y="336" text-anchor="middle" class="x-axis-label">{phase.label}</text>
      ))}
    </svg>
  </div>

  <ul class="growth-chart-legend" aria-label="Chart legend">
    {series.map((item) => (
      <li>
        <span class="legend-line" style={`--series-color: ${item.color}`} aria-hidden="true"></span>
        <span class="legend-name">{item.shortName}</span>
        <strong class="legend-value">{item.result}</strong>
      </li>
    ))}
  </ul>

  <p class="growth-chart-note">
    Source: published portfolio case-study outcomes. Intermediate movement is an illustrative performance journey—not reported monthly data; endpoints are the documented results.
  </p>
</figure>

<style>
  .growth-chart-card {
    padding: clamp(18px, 3vw, 28px);
    overflow: hidden;
  }

  .growth-chart-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.7fr);
    align-items: end;
    gap: 24px;
    margin-bottom: 18px;
  }

  .growth-chart-kicker {
    margin: 0 0 6px;
    color: var(--dash-accent);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .growth-chart-title {
    margin: 0;
    color: var(--dash-text);
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
  }

  .growth-chart-description {
    margin: 0;
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
  }

  .growth-chart-scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .growth-chart {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
    font-family: inherit;
  }

  .axis-title,
  .axis-label,
  .x-axis-label,
  .baseline-label {
    fill: var(--dash-muted);
    font-size: var(--text-caption);
  }

  .axis-title {
    font-weight: 650;
  }

  .x-axis-label,
  .baseline-label {
    font-weight: 600;
  }

  .grid-line {
    stroke: color-mix(in srgb, var(--dash-border) 74%, transparent);
    stroke-width: 1;
  }

  .grid-line--axis {
    stroke: var(--dash-muted);
  }

  .baseline-line {
    stroke: var(--dash-muted);
    stroke-width: 1;
    stroke-dasharray: 5 5;
    opacity: 0.55;
  }

  .phase-line {
    stroke: var(--dash-border);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    opacity: 0.7;
  }

  .series-line {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .series-checkpoint {
    opacity: 0.78;
  }

  .series-point {
    stroke: var(--dash-surface);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }

  .growth-chart-legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 18px;
    margin: 4px 0 0;
    padding: 18px 0 0;
    border-top: var(--dash-border-width, 1px) solid var(--dash-border);
    list-style: none;
  }

  .growth-chart-legend li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--dash-muted);
    font-size: var(--text-caption);
    line-height: 1.35;
  }

  .legend-line {
    height: 2px;
    border-radius: 999px;
    background: var(--series-color);
  }

  .legend-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .legend-value {
    color: var(--dash-text);
    font-variant-numeric: tabular-nums;
  }

  .growth-chart-note {
    margin: 16px 0 0;
    color: var(--dash-muted);
    font-size: var(--text-caption);
    line-height: var(--leading-body);
  }

  @media (max-width: 760px) {
    .growth-chart-heading {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .growth-chart-legend {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .growth-chart-card {
      padding: 16px;
    }

    .growth-chart-legend {
      grid-template-columns: 1fr;
    }
  }
</style>
