---
import { getCollection } from "astro:content";

interface PhotoCardAlbum {
  slug: string;
  category: string;
  title: string;
  subtitle: string;
  images: string[];
}

const photoEntries = await getCollection("photos");

const albumPool: PhotoCardAlbum[] = photoEntries
  .filter((entry) => entry.data.images && entry.data.images.length >= 3)
  .map((entry) => {
    const category = (entry.data.region || entry.data.country || "Photos").toUpperCase();
    const slug = entry.data.slug || entry.id;
    const title = entry.data.name || entry.data.location || slug;
    const count = entry.data.images.length;
    const country = entry.data.country || "";
    const subtitle =
      country && country.toUpperCase() !== category
        ? `${country} · ${count} photos`
        : `${count} photos`;

    return {
      slug,
      category,
      title,
      subtitle,
      images: entry.data.images.map((img) => img.src),
    };
  });

const initialAlbums = albumPool.slice(0, 6);
---

<section class="page-section photo-stack-section" aria-label="Random snapshots from Photos">
  <div class="psc-stage" data-photo-stack-stage>
    {initialAlbums.map((album, index) => (
      <div
        class="psc-card"
        style={`--card-idx: ${index};`}
        data-psc-card={index}
        aria-label={`${album.title} — ${album.subtitle}`}
      >
        <div class="psc-copy">
          <p class="psc-category" data-psc-category>{album.category}</p>
          <h3 class="psc-title" data-psc-title>{album.title}</h3>
          <p class="psc-subtitle" data-psc-subtitle>{album.subtitle}</p>
        </div>

        <div
          class="psc-stack"
          data-psc-stack
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label={`Preview ${album.title} photos`}
        >
          {album.images.slice(0, 3).map((src, imgIdx) => (
            <img
              src={src}
              alt={`${album.title} photo ${imgIdx + 1}`}
              loading="eager"
              decoding="async"
              class="psc-img"
              data-psc-img={imgIdx}
            />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline data-astro-rerun define:vars={{ albumPool }}>
  (() => {
    const randInt = (n) => {
      if (window.crypto && window.crypto.getRandomValues) {
        const buf = new Uint32Array(1);
        window.crypto.getRandomValues(buf);
        return buf[0] % n;
      }
      return Math.floor(Math.random() * n);
    };

    const shuffle = (arr) => {
      const copy = arr.slice();
      for (let i = copy.length - 1; i > 0; i -= 1) {
        const j = randInt(i + 1);
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    };

    const applyRandomPose = (stack) => {
      const imgs = Array.from(stack.querySelectorAll("[data-psc-img]"));
      if (imgs.length === 0) return;
      const section = stack.closest(".photo-stack-section");
      const compact = (section ? section.clientWidth : window.innerWidth) <= 720;
      const sx = compact ? 0.56 : 1;
      const sy = compact ? 0.68 : 1;
      const poses = shuffle([
        {
          tx: Math.round((-22 - Math.random() * 14) * sx),
          ty: Math.round((-12 - Math.random() * 12) * sy),
          rot: Number((-10 - Math.random() * 8).toFixed(1)),
          sc: Number((0.97 + Math.random() * 0.05).toFixed(2)),
        },
        {
          tx: Math.round((-8 + Math.random() * 16) * sx),
          ty: Math.round((-22 - Math.random() * 10) * sy),
          rot: Number((-6 + Math.random() * 12).toFixed(1)),
          sc: Number((1.01 + Math.random() * 0.04).toFixed(2)),
        },
        {
          tx: Math.round((22 + Math.random() * 14) * sx),
          ty: Math.round((-12 - Math.random() * 12) * sy),
          rot: Number((10 + Math.random() * 8).toFixed(1)),
          sc: Number((0.97 + Math.random() * 0.05).toFixed(2)),
        },
      ]);
      const delays = shuffle([0, 110, 220]);
      imgs.forEach((imgEl, i) => {
        const p = poses[i % poses.length];
        imgEl.style.setProperty("--tx", `${p.tx}px`);
        imgEl.style.setProperty("--ty", `${p.ty}px`);
        imgEl.style.setProperty("--rot", `${p.rot}deg`);
        imgEl.style.setProperty("--sc", `${p.sc}`);
        imgEl.style.setProperty("--delay", `${delays[i % delays.length]}ms`);
      });
    };

    const init = () => {
      const stage = document.querySelector("[data-photo-stack-stage]");
      if (!stage || stage.dataset.pscReady === "true") return;
      stage.dataset.pscReady = "true";

      const cards = Array.from(stage.querySelectorAll("[data-psc-card]"));
      if (cards.length === 0 || !Array.isArray(albumPool) || albumPool.length === 0) return;

      const selectedAlbums = shuffle(albumPool).slice(0, cards.length);
      let activeIndex = null;

      const syncActive = () => {
        cards.forEach((card, idx) => {
          const stack = card.querySelector("[data-psc-stack]");
          if (!stack) return;
          const active = idx === activeIndex;
          stack.classList.toggle("is-active", active);
          stack.setAttribute("aria-pressed", active ? "true" : "false");
        });
      };

      cards.forEach((card, idx) => {
        const album = selectedAlbums[idx];
        const stack = card.querySelector("[data-psc-stack]");
        if (album) {
          const catEl = card.querySelector("[data-psc-category]");
          const titleEl = card.querySelector("[data-psc-title]");
          const subEl = card.querySelector("[data-psc-subtitle]");
          if (catEl) catEl.textContent = album.category;
          if (titleEl) titleEl.textContent = album.title;
          if (subEl) subEl.textContent = album.subtitle;
          card.setAttribute("aria-label", `${album.title} — ${album.subtitle}`);
          if (stack) stack.setAttribute("aria-label", `Preview ${album.title} photos`);

          const pickedImgs = shuffle(album.images).slice(0, 3);
          const imgEls = Array.from(card.querySelectorAll("[data-psc-img]"));
          imgEls.forEach((imgEl, imgIdx) => {
            if (pickedImgs[imgIdx]) {
              imgEl.src = pickedImgs[imgIdx];
              imgEl.alt = `${album.title} photo ${imgIdx + 1}`;
            }
          });
        }

        if (!stack) return;
        applyRandomPose(stack);

        const toggle = () => {
          const willOpen = activeIndex !== idx;
          if (willOpen) applyRandomPose(stack);
          activeIndex = willOpen ? idx : null;
          syncActive();
        };

        stack.addEventListener("mouseenter", () => applyRandomPose(stack));
        stack.addEventListener("click", toggle);
        stack.addEventListener("mouseleave", () => {
          if (activeIndex === idx && window.matchMedia("(hover: hover)").matches) {
            activeIndex = null;
            syncActive();
          }
        });
        stack.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            toggle();
          }
        });
      });

      syncActive();
    };

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>

<style>
  .photo-stack-section {
    width: 100%;
    container-type: inline-size;
    overflow: visible;
  }

  .psc-stage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px 22px;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 32px;
  }

  .psc-card {
    position: relative;
    width: 100%;
    min-height: 278px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px 24px 0;
    border-radius: 14px;
    background: var(--dash-surface, #ffffff);
    border: 1px solid var(--dash-card-border, rgba(10, 10, 10, 0.08));
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.08),
      0 8px 10px -6px rgba(0, 0, 0, 0.05);
    cursor: default;
    user-select: none;
    overflow: visible;
  }

  .psc-card:has(.psc-stack:hover),
  .psc-card:has(.psc-stack.is-active) {
    z-index: 20;
  }

  .psc-copy {
    position: relative;
    z-index: 10;
    pointer-events: none;
  }

  .psc-category {
    margin: 0;
    font-size: var(--text-caption);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fog, #7d8187);
  }

  .psc-title {
    margin: 4px 0 0;
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--color-jet, #0a0a0a);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .psc-subtitle {
    margin: 4px 0 0;
    font-size: var(--text-body-sm);
    line-height: 1.4;
    color: var(--color-fog, #7d8187);
  }

  .psc-stack {
    position: relative;
    width: 100%;
    height: 152px;
    margin-top: 18px;
    cursor: pointer;
    pointer-events: auto;
  }

  .psc-stack::before {
    content: "";
    position: absolute;
    inset: -8px -18px -20px;
    z-index: 0;
  }

  .psc-stack:focus-visible {
    outline: 2px solid var(--dash-accent, #0075de);
    outline-offset: 6px;
    border-radius: 10px;
  }

  .psc-img {
    position: absolute;
    bottom: -16px;
    left: 50%;
    width: calc(100% - 14px);
    height: 144px;
    object-fit: cover;
    border-radius: 10px;
    border: 3px solid var(--dash-bg, #ffffff);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.08),
      0 10px 22px -4px rgba(0, 0, 0, 0.16),
      0 4px 10px rgba(0, 0, 0, 0.08);
    transform-origin: bottom center;
    transition:
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1) 0ms,
      box-shadow 0.38s cubic-bezier(0.22, 1, 0.36, 1) 0ms;
  }

  .psc-img[data-psc-img="0"] {
    z-index: 1;
    transform: translate(calc(-50% - 4px), 2px) rotate(-5deg) scale(0.97);
    --tx: -28px;
    --ty: -16px;
    --rot: -13deg;
    --sc: 0.99;
    --delay: 20ms;
  }

  .psc-img[data-psc-img="1"] {
    z-index: 2;
    transform: translate(-50%, 0px) rotate(0deg) scale(0.99);
    --tx: 0px;
    --ty: -26px;
    --rot: -1.5deg;
    --sc: 1.03;
    --delay: 110ms;
  }

  .psc-img[data-psc-img="2"] {
    z-index: 3;
    transform: translate(calc(-50% + 4px), 2px) rotate(5deg) scale(1);
    --tx: 28px;
    --ty: -14px;
    --rot: 12deg;
    --sc: 1;
    --delay: 200ms;
  }

  .psc-stack:hover .psc-img,
  .psc-stack.is-active .psc-img {
    transform: translate(calc(-50% + var(--tx, 0px)), var(--ty, -22px))
      rotate(var(--rot, 0deg)) scale(var(--sc, 1.02));
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.08),
      0 18px 36px -6px rgba(0, 0, 0, 0.22),
      0 6px 14px rgba(0, 0, 0, 0.1);
    transition:
      transform 0.62s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      box-shadow 0.54s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
  }

  @container (max-width: 720px) {
    .psc-stage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 14px;
      padding-bottom: 24px;
    }

    .psc-card {
      min-height: 238px;
      padding: 16px 16px 0;
    }

    .psc-stack {
      height: 122px;
      margin-top: 14px;
    }

    .psc-stack::before {
      inset: -8px -10px -16px;
    }

    .psc-img {
      bottom: -12px;
      width: calc(100% - 10px);
      height: 114px;
      border-width: 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .psc-img {
      transition: none;
    }
  }
</style>
