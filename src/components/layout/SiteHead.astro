---
/**
 * Document <head> shared by every layout: SEO + social metadata, JSON-LD graph,
 * icons, critical preloads and analytics. Layout-specific boot scripts go in the
 * `boot` slot (right after <title>); the default slot renders before JSON-LD.
 */
import interLatinFont from "../../assets/fonts/inter-latin-variable.woff2?url";
import { GTM_CONTAINER_ID, WORKSPACE_WALLPAPER } from "../../config/site";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  PERSON_NAME,
  SITE_URL,
  absoluteUrl,
  breadcrumbListSchema,
  canonicalPath,
  canonicalUrl,
  graphSchema,
  pageSchema,
  safeJsonLd,
  type BreadcrumbItem,
  type JsonLd,
} from "../../lib/seo";

interface Props {
  title: string;
  siteName: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  schema?: JsonLd | JsonLd[];
  pageType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  robots?: string;
}

const {
  title,
  siteName,
  description = DEFAULT_DESCRIPTION,
  breadcrumbs,
  schema = [],
  pageType = "WebPage",
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  ogType = "website",
  author = PERSON_NAME,
  datePublished,
  dateModified,
  noindex = false,
  robots,
} = Astro.props;

const canonicalHref = canonicalUrl(Astro.url.pathname);
const normalizedPath = canonicalPath(Astro.url.pathname);
const markdownPath = normalizedPath === "/" ? "/index.md" : `${normalizedPath}.md`;
const markdownUrl = new URL(markdownPath, SITE_URL).toString();
const resolvedOgImage = absoluteUrl(ogImage);
const robotsDirective = robots ?? (noindex ? "noindex, nofollow" : "index, follow");

const pageSchemas = (Array.isArray(schema) ? schema.flat() : [schema]).filter(Boolean);
const breadcrumbNode =
  !noindex && breadcrumbs && breadcrumbs.length > 0
    ? breadcrumbListSchema(breadcrumbs, canonicalHref)
    : null;
const hasExplicitWebPage = pageSchemas.some((node) => {
  const id = node?.["@id"];
  return typeof id === "string" && id.endsWith("#webpage");
});
const autoWebPageNode =
  !noindex && !hasExplicitWebPage
    ? pageSchema({
        url: canonicalHref,
        title,
        description,
        type: pageType,
        primaryImageUrl: resolvedOgImage,
        datePublished,
        dateModified,
        breadcrumbId: breadcrumbNode?.["@id"] as string | undefined,
      })
    : null;
const graphNodes: JsonLd[] = [
  ...(autoWebPageNode ? [autoWebPageNode] : []),
  ...(breadcrumbNode ? [breadcrumbNode] : []),
  ...pageSchemas,
];
const jsonLd = !noindex ? safeJsonLd(graphSchema(graphNodes)) : "";
const gtmSrc = `https://www.googletagmanager.com/gtm.js?id=${GTM_CONTAINER_ID}`;
// Classic (non-module) script so `gtag`/`dataLayer` stay global, as GTM expects.
const gtmBootstrap = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());
if(!window.__gtmQueued){window.__gtmQueued=true;var loadGtm=function(){var s=document.createElement('script');s.async=true;s.src=${JSON.stringify(gtmSrc)};document.head.appendChild(s);};
var scheduleGtm=function(){if('requestIdleCallback' in window)requestIdleCallback(loadGtm,{timeout:3000});else setTimeout(loadGtm,1500);};
if(document.readyState==='complete')scheduleGtm();else window.addEventListener('load',scheduleGtm,{once:true});}`;
const cfWebAnalyticsToken = (import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN || "").trim();
---

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-visual">
<meta name="description" content={description}>
<meta name="robots" content={robotsDirective}>
{!noindex && author && <meta name="author" content={author} />}
<meta name="is-agentic-site-type" content="business">

<!-- Open Graph / Social Media -->
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={resolvedOgImage}>
<meta property="og:image:alt" content={ogImageAlt}>
{!noindex && <meta property="og:url" content={canonicalHref} />}
<meta property="og:type" content={ogType}>
<meta property="og:locale" content="en_US">
<meta property="og:site_name" content={siteName}>
{ogType === "article" && datePublished && <meta property="article:published_time" content={datePublished} />}
{ogType === "article" && dateModified && <meta property="article:modified_time" content={dateModified} />}
{ogType === "article" && author && <meta property="article:author" content={author} />}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={resolvedOgImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>

<title>{title}</title>
<slot name="boot" />
<meta name="theme-color" content="#FFFFFF">
{!noindex && (
  <>
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown version" />
  </>
)}

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preload" href={interLatinFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={WORKSPACE_WALLPAPER.src} as="image" type="image/webp" media="(min-width: 1024px)" fetchpriority="high" />

<slot />
{!noindex && jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}

<!-- Google Tag Manager: queued immediately, script fetched once the page is idle so it
     never competes with first paint. The guard keeps client-side navigations from re-adding it. -->
<script is:inline set:html={gtmBootstrap}></script>
{cfWebAnalyticsToken && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: cfWebAnalyticsToken })}
  ></script>
)}
