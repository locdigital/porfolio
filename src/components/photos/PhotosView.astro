---
import Layout from "../../layouts/Layout.astro";
import { getPhotoLocations } from "../../lib/cms";
import { PHOTO_GRID_SIZES, optimizePhoto } from "../../lib/photo-assets";
import { generateSlug } from "../../lib/writing/slug";

export interface Props {
  activeSlug?: string;
}

export const prerender = true;

const { activeSlug } = Astro.props;
const sourceLocations = await getPhotoLocations();
const anchorFor = (loc: (typeof sourceLocations)[number]) =>
  generateSlug(loc.location || loc.name || loc.slug) || loc.slug;

const optimizedLocations = await Promise.all(
  sourceLocations.map(async (loc) => ({
    ...loc,
    anchorId: anchorFor(loc),
    photos: await Promise.all(
      loc.photos.map(async (photo) => {
        if (!photo.src.startsWith("/assets/photos/")) {
          return {
            ...photo,
            previewSrc: photo.src,
            previewSrcSet: "",
            webpSrcSet: "",
            previewSizes: PHOTO_GRID_SIZES,
            previewWidth: photo.w,
            previewHeight: photo.h,
            fullSrc: photo.src,
            fullWidth: photo.w,
            fullHeight: photo.h,
          };
        }

        return optimizePhoto(photo, {
          previewWidth: 720,
          previewWidths: [240, 400, 640, 960],
          previewSizes: PHOTO_GRID_SIZES,
          fullQuality: 78,
          withWebpFallback: true,
        });
      }),
    ),
  })),
);

const activeLocation =
  optimizedLocations.find(
    (l) => l.slug === activeSlug || l.anchorId === activeSlug
  ) || optimizedLocations[0];

const pageTitle = activeSlug && activeLocation
  ? `${activeLocation.name} Photos | Phuc Loc Nguyen`
  : "Photos | Phuc Loc Nguyen";

const photosHeadline = "Places I've <em>wandered.</em>";
type PhotoLocationView = Omit<Awaited<ReturnType<typeof getPhotoLocations>>[number], "photos"> & {
  photos?: unknown[];
};

function personalReflectionFor(loc: PhotoLocationView): string {
  if (loc.overview) {
    const paras = loc.overview.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
    if (paras.length > 0) {
      if (paras.length > 1 && (paras[0].length + paras[1].length < 420)) {
        return `${paras[0]} ${paras[1]}`;
      }
      return paras[0];
    }
  }
  return loc.description || loc.shortDescription || loc.introduction || "";
}
---

<Layout title={pageTitle}>

  <main class="gear-page photos-page">
    <div class="gear-container">
      <!-- PAGE HERO -->
      <section class="gear-hero photos-hero-copy about-reveal-hero toki-r" data-d="1" aria-label="Photos introduction">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">My photos</span>
        </div>
        <h1 class="gear-hero-title" set:html={photosHeadline} />
        <p class="gear-intro">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </p>
      </section>
    </div>

    <!-- QUICK NAV -->
    <div id="photos-nav-sentinel"></div>
    <div class="photos-nav-wrapper">
      <div class="container">
        <nav class="photos-nav" aria-label="Locations navigation">
          <div class="photos-nav-list">
            {optimizedLocations.map((loc) => {
              const isSelected = loc.slug === activeLocation.slug;
              return (
                <a
                  href={`/photos/${loc.slug}`}
                  class={`photos-nav-link ${isSelected ? 'active' : ''}`}
                  data-target={loc.anchorId}
                  data-slug={loc.slug}
                  aria-current={isSelected ? "true" : undefined}
                  aria-controls={loc.slug}
                >
                  {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
                </a>
              );
            })}
            <span class="photos-nav-active-line" aria-hidden="true"></span>
          </div>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {optimizedLocations.map((loc) => {
      const isSelected = loc.slug === activeLocation.slug;
      const personalNote = personalReflectionFor(loc);

      return (
        <section
          class={`loc-section ${isSelected ? 'active' : ''}`}
          id={loc.slug}
          data-slug={loc.slug}
          data-anchor={loc.anchorId}
          aria-label={`Photos from ${loc.name}`}
          hidden={!isSelected}
        >
          <div class="container">
            <header class="loc-editorial-header">
              <!-- Location title & short personal reflection -->
              <div class="loc-intro">
                <div class="loc-kicker-row">
                  <span class="loc-kicker-tag">{loc.name}</span>
                </div>
                <h2 class="loc-name">{loc.headline || loc.name}</h2>
                {personalNote && (
                  <p class="loc-reflection">{personalNote}</p>
                )}
              </div>
            </header>
          </div>

        <!-- Responsive Image Gallery (Efferd inspired) -->
        <div class="container">
          <div class="efferd-gallery" data-gallery={`gallery-${loc.slug}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => {
              const isTall = photo.previewHeight > photo.previewWidth;
              const captionText = ("caption" in photo && typeof photo.caption === "string") ? photo.caption : "";
              return (
                <div
                  class={`efferd-gallery-item ${isTall ? 'is-tall' : 'is-wide'}`}
                  data-pswp-width={photo.fullWidth}
                  data-pswp-height={photo.fullHeight}
                  aria-label={photo.alt}
                  style={`--photo-index: ${i};`}
                >
                  <div class="efferd-card-inner">
                    {photo.previewSrcSet ? (
                      <picture class="efferd-picture">
                        <source
                          type="image/avif"
                          srcset={photo.previewSrcSet}
                          sizes={photo.previewSizes}
                        />
                        {photo.webpSrcSet && (
                          <source
                            type="image/webp"
                            srcset={photo.webpSrcSet}
                            sizes={photo.previewSizes}
                          />
                        )}
                        <img
                          src={photo.previewSrc}
                          width={photo.previewWidth}
                          height={photo.previewHeight}
                          alt={photo.alt || `${loc.name} photo ${i + 1}`}
                          loading={isSelected && i < 4 ? "eager" : "lazy"}
                          decoding="async"
                          fetchpriority={isSelected && i < 2 ? "high" : "auto"}
                          class="efferd-img"
                          onerror="this.style.opacity='0'; this.closest('.efferd-card-inner').style.backgroundColor='#e5e7eb';"
                        />
                      </picture>
                    ) : (
                      <img
                        src={photo.previewSrc}
                        width={photo.previewWidth}
                        height={photo.previewHeight}
                        alt={photo.alt || `${loc.name} photo ${i + 1}`}
                        loading={isSelected && i < 4 ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={isSelected && i < 2 ? "high" : "auto"}
                        class="efferd-img"
                        onerror="this.style.opacity='0'; this.closest('.efferd-card-inner').style.backgroundColor='#e5e7eb';"
                      />
                    )}
                    {captionText && (
                      <div class="efferd-overlay" aria-hidden="true">
                        <span class="efferd-caption">{captionText}</span>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
      );
    })}

  </main>

</Layout>

<script>
  function initPhotoTabs() {
    const tablist = document.querySelector(".photos-nav-list");
    if (!(tablist instanceof HTMLElement) || tablist.dataset.tabsReady) return;
    tablist.dataset.tabsReady = "true";

    const tabs = Array.from(tablist.querySelectorAll<HTMLAnchorElement>(".photos-nav-link"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>(".loc-section"));
    const line = tablist.querySelector<HTMLElement>(".photos-nav-active-line");

    const moveLine = (tab: Element | null, immediate = false) => {
      if (!(line instanceof HTMLElement) || !(tab instanceof HTMLElement)) return;
      if (immediate) {
        const prevTransition = line.style.transition;
        line.style.transition = "none";
        line.style.width = `${tab.offsetWidth}px`;
        line.style.transform = `translateX(${tab.offsetLeft}px)`;
        void line.offsetWidth;
        line.style.transition = prevTransition;
      } else {
        line.style.width = `${tab.offsetWidth}px`;
        line.style.transform = `translateX(${tab.offsetLeft}px)`;
      }
    };

    const activate = (identifier?: string, updateUrl = false, smooth = true) => {
      const nextTab = tabs.find((tab) => (
        tab.getAttribute("data-slug") === identifier ||
        tab.getAttribute("data-target") === identifier ||
        tab.href.endsWith(`/photos/${identifier}`)
      )) || tabs.find((t) => t.classList.contains("active")) || tabs[0];

      const nextSlug = nextTab?.getAttribute("data-slug");
      const nextTarget = nextTab?.getAttribute("data-target");
      if (!nextTab || !nextSlug) return;

      const scrollX = window.scrollX;
      const scrollY = window.scrollY;

      tabs.forEach((tab) => {
        const isActive = tab === nextTab;
        tab.classList.toggle("active", isActive);
        tab.toggleAttribute("aria-current", isActive);
      });

      panels.forEach((panel) => {
        const isActive =
          panel.getAttribute("data-slug") === nextSlug ||
          panel.getAttribute("data-anchor") === nextTarget ||
          panel.id === nextSlug ||
          panel.id === nextTarget;

        if (isActive) {
          panel.removeAttribute("hidden");
          panel.classList.remove("active");
          void panel.offsetWidth; // Restart stagger reveal animation
          panel.classList.add("active");
        } else {
          panel.classList.remove("active");
          panel.setAttribute("hidden", "true");
        }
      });

      if (updateUrl && nextSlug) {
        const targetPath = `/photos/${nextSlug}`;
        if (window.location.pathname !== targetPath) {
          window.history.pushState({ slug: nextSlug }, "", targetPath);
        }
      }

      // Update page title dynamically
      const tabText = nextTab.textContent?.replace(/\s*\d+\s*$/, "").trim();
      if (tabText) {
        document.title = `${tabText} Photos | Phuc Loc Nguyen`;
      }

      moveLine(nextTab, !smooth);
      if (nextTab instanceof HTMLElement) {
        const left = nextTab.offsetLeft - (tablist.clientWidth - nextTab.offsetWidth) / 2;
        tablist.scrollTo({ left: Math.max(0, left), behavior: smooth ? "smooth" : "auto" });
      }
      requestAnimationFrame(() => window.scrollTo(scrollX, scrollY));
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        // Allow command/ctrl/middle click to open in new tab naturally
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        const slug = tab.getAttribute("data-slug") || tab.getAttribute("data-target");
        activate(slug || undefined, true, true);
      });
    });

    // Handle browser back and forward buttons
    window.addEventListener("popstate", () => {
      const parts = window.location.pathname.split("/").filter(Boolean);
      const slugFromPath = parts[0] === "photos" && parts[1] ? parts[1] : undefined;
      activate(slugFromPath, false, true);
    });

    // Handle legacy hash navigation like /photos#malacca
    if (window.location.hash) {
      const hashId = window.location.hash.slice(1);
      if (hashId) {
        // Convert /photos#malacca -> /photos/malacca
        const matchingTab = tabs.find((tab) =>
          tab.getAttribute("data-slug") === hashId ||
          tab.getAttribute("data-target") === hashId
        );
        const resolvedSlug = matchingTab?.getAttribute("data-slug") || hashId;
        window.history.replaceState({ slug: resolvedSlug }, "", `/photos/${resolvedSlug}`);
        activate(resolvedSlug, false, false);
      }
    } else {
      // Align indicator with current active tab on load
      const currentActive = tablist.querySelector(".photos-nav-link.active");
      if (currentActive) {
        moveLine(currentActive, true);
        if (currentActive instanceof HTMLElement) {
          const left = currentActive.offsetLeft - (tablist.clientWidth - currentActive.offsetWidth) / 2;
          tablist.scrollTo({ left: Math.max(0, left), behavior: "auto" });
        }
      }
    }

    window.addEventListener("resize", () => {
      moveLine(tablist.querySelector(".photos-nav-link.active"), true);
    });
  }

  function initGalleryInView() {
    const items = document.querySelectorAll(".efferd-gallery-item");
    if (!items.length) return;
    items.forEach((item) => item.classList.add("is-visible"));
  }

  document.addEventListener("astro:page-load", () => {
    initPhotoTabs();
    initGalleryInView();
  });
  initPhotoTabs();
  initGalleryInView();
</script>

<style>
  :global(.photos-page .reveal),
  :global(.photos-page .r),
  :global(.photos-page .toki-r),
  :global(.photos-page .animated-card),
  :global(.photos-page .reveal.in),
  :global(.photos-page .r.in),
  :global(.photos-page .toki-r.in),
  :global(.photos-page .animated-card.card-in) {
    filter: none !important;
  }

  /* ------ Page ------ */
  /* ------ Hero ------ */
  .photos-hero {
    padding: 80px 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: var(--type-display-xl);
    font-weight: 400;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-normal);
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 0;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: var(--type-body);
    color: var(--muted);
    max-width: 480px;
    line-height: var(--leading-body);
  }

  #photos-nav-sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
    opacity: 0;
  }

  /* ------ Nav wrapper ------ */
  .photos-nav-wrapper {
    position: relative;
    z-index: 5;
    background: transparent;
    padding: 12px 0 0;
    margin-bottom: 40px;
    margin-top: -1px;
    border-bottom: var(--dash-border-width, 0.9px) solid var(--divider, #00000014);
  }

  /* ------ Nav ------ */
  .photos-nav {
    border-bottom: none;
    padding-bottom: 0;
  }

  .photos-nav-list {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-y: none;
    scrollbar-width: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photos-nav-list:active { cursor: grabbing; }
  .photos-nav-list::-webkit-scrollbar { display: none; }

  /* Active underline */
  .photos-nav-active-line {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: var(--accent, #0075de);
    pointer-events: none;
    z-index: 2;
    left: 0;
    width: 0;
    transform: translateX(0);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
                width 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Tab links */
  .photos-nav-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    height: 36px;
    border-radius: 6px;
    font-size: var(--type-body);
    font-family: var(--sans);
    font-weight: 500;
    color: color-mix(in srgb, var(--text) 72%, var(--muted));
    text-decoration: none;
    white-space: nowrap;
    border: 0;
    background: transparent;
    transition: color 0.2s ease;
    cursor: pointer;
    user-select: none;
  }

  .photos-nav-link.active {
    color: var(--text);
  }

  .photos-nav-link:hover {
    color: var(--accent);
  }

  .photos-nav-count {
    color: inherit;
    font-size: var(--type-caption);
    font-family: var(--mono, monospace);
    opacity: 0.55;
    transform: translateY(-30%);
    display: inline-block;
  }

  /* ------ Location section ------ */
  .loc-section {
    --loc-prose-size: 0.875rem;
    --loc-prose-leading: 1.7;
    --loc-sidebar-size: 0.875rem;
    --loc-sidebar-leading: 1.65;
    --loc-prose-measure: 68ch;
    --loc-sidebar-measure: 34ch;
    --loc-heading-gap: var(--space-2);
    --loc-copy-gap: var(--space-3);
    --loc-rich-block-gap: 2rem;
    --loc-section-gap: var(--space-6);
    display: none;
    opacity: 1;
    overflow-anchor: none;
    padding: clamp(32px, 5.2vw, 52px) 0 clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
    content-visibility: visible;
  }

  .gear-page > .loc-section {
    content-visibility: visible;
  }

  .loc-section.active {
    display: block;
    opacity: 1;
    animation: photos-tab-in 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes photos-tab-in {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes efferdPhotoStaggerIn {
    0% {
      opacity: 0;
      transform: translateY(22px) scale(0.975);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  /* ------ Editorial Location Header ------ */
  .loc-editorial-header {
    margin-bottom: clamp(48px, 6.5vw, 80px);
  }

  .loc-intro {
    max-width: var(--loc-prose-measure);
    margin-bottom: 0;
  }

  .loc-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .loc-kicker-tag {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent, #0075de);
  }

  .loc-name {
    font-family: var(--serif);
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: var(--tracking-normal);
    color: var(--text);
    margin: 0 0 12px 0;
    text-wrap: balance;
  }

  .loc-reflection {
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--text) 78%, var(--muted));
    margin: 0;
    text-wrap: pretty;
  }

  /* ------ Efferd Image Gallery ------ */
  .efferd-gallery {
    column-count: 3;
    column-gap: 16px;
    margin-top: 0;
    width: 100%;
  }

  .efferd-gallery-item {
    break-inside: avoid;
    margin-bottom: 16px;
    opacity: 1;
    transform: none;
  }

  .efferd-gallery-item.photo-extra.hidden {
    display: none !important;
  }

  .efferd-gallery-item.is-visible {
    opacity: 1;
    transform: none;
  }

  .efferd-card-inner {
    position: relative;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 6%, transparent);
    box-shadow:
      0 4px 20px -2px rgba(0, 0, 0, 0.08),
      0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }

  .efferd-gallery-item:hover .efferd-card-inner {
    box-shadow:
      0 4px 20px -2px rgba(0, 0, 0, 0.08),
      0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent);
  }

  .efferd-picture {
    display: block;
    width: 100%;
  }

  .efferd-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    filter: none;
    backface-visibility: hidden;
  }

  .efferd-gallery-item:hover .efferd-img {
    transform: none;
  }

  .efferd-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 14px 16px;
  }

  .efferd-gallery-item:hover .efferd-overlay {
    opacity: 1;
  }

  .efferd-caption {
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.95);
    max-width: 100%;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
  }

  /* ------ Responsive ------ */
  @media (max-width: 1024px) {
    .efferd-gallery {
      column-count: 2;
      column-gap: 14px;
    }
  }

  @media (max-width: 768px) {
    .efferd-caption {
      display: none;
    }
  }

  @media (max-width: 640px) {
    :global(.mobile-bottom-nav) {
      display: none !important;
    }

    /* Single Column Full-Size Feed on Mobile (Pexels / Unsplash style) */
    .efferd-gallery {
      column-count: 1 !important;
      column-gap: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 16px !important;
    }

    .efferd-gallery-item {
      width: 100% !important;
      margin-bottom: 0 !important;
    }

    .efferd-card-inner {
      width: 100% !important;
      border-radius: 6px !important;
    }

    .efferd-img {
      width: 100% !important;
      height: auto !important;
      object-fit: cover !important;
    }

    .efferd-overlay {
      opacity: 1 !important;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0) 45%) !important;
    }

    .photos-nav-link {
      font-size: var(--type-caption);
    }

    .photos-nav-count {
      font-size: var(--type-caption);
    }
  }
</style>
