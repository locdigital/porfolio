---
import PhotosLayout from "../../layouts/PhotosLayout.astro";
import { getPhotoLocations } from "../../lib/content";
import GlassFolder from "../ui/GlassFolder";
import { optimizePhotos } from "../../lib/photo-assets";
import { canonicalUrl, collectionPageSchema } from "../../lib/seo";
import { parsePhotoCoords, resolvePhotoCoords } from "../../lib/photo-map-coords";
import { readPhotoExifCoordinates } from "../../lib/photo-exif";
import photoUpdates from "../../../data/photo-updates.json";
import { PHOTO_REGION_ORDER, resolvePhotoRegion } from "@/constants/regions";
import { getUiCopy } from "../../i18n/ui";

const photosUi = getUiCopy().photosUi;
const photosBasePath = "/photos";
const regionLabel = (region: string) => photosUi.regionLabels[region] ?? region;

const normalizeSearchServer = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[đĐ]/g, "d")
    .toLowerCase()
    .replace(/[-_/]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const safeInlineJson = (data: unknown) =>
  JSON.stringify(data).replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");

const updates = photoUpdates as Record<string, { updatedAt: string }>;
const updatedTime = (slug: string) => Date.parse(updates[slug]?.updatedAt ?? "") || 0;
const locations = (await getPhotoLocations()).sort(
  (a, b) => updatedTime(b.slug) - updatedTime(a.slug) || a.order - b.order,
);

const enhancedLocations = await Promise.all(
  locations.map(async (loc) => {
    const name = loc.name || loc.location;
    const region = resolvePhotoRegion(loc.country, loc.region);
    const displayRegion = regionLabel(region);
    const displayCountry = loc.country || "Vietnam";
    const displayHeadline = loc.headline || "";
    const displaySeoDescription = loc.seoDescription || displayHeadline;

    const photos = loc.photos || [];
    const photoCount = photos.length;
    const images = loc.images || [];
    const rawHero = loc.heroImage?.src || images[0]?.src || photos[0]?.src || "";
    const rawLeft = images[1]?.src || photos[1]?.src || rawHero;
    const rawRight = images[2]?.src || photos[2]?.src || rawHero;

    const previews = await optimizePhotos(
      [rawHero, rawLeft, rawRight].filter(Boolean).map((src) => ({
        src,
        alt: name,
        w: 320,
        h: 240,
      })),
      { previewWidth: 320, previewWidths: [320, 480] },
    );
    const previewImages = previews.map((photo) => photo.previewSrc);
    const heroPhoto = previewImages[0] || "";

    const sampleSource = photos.map((p, idx) => ({
      src: p.src,
      alt: p.alt || `${name} — frame ${idx + 1}`,
      w: p.w || 4,
      h: p.h || 5,
      title: p.title,
      caption: p.caption,
      location: p.location || name,
      capturedAt: p.capturedAt,
    }));

    const optimizedSample = await optimizePhotos(sampleSource, {
      previewWidth: 480,
      previewWidths: [320, 480, 768],
      previewSizes: "(max-width: 640px) 48vw, (max-width: 820px) 32vw, 20vw",
      fullWidth: 1600,
    });

    const dateLocale = "en-GB";
    const archiveFallbackLabel = "Archive";

    const formatMonthLabel = (timestamp: number) =>
      new Intl.DateTimeFormat(dateLocale, {
        month: "short",
        year: "numeric",
        timeZone: "Asia/Ho_Chi_Minh",
      }).format(new Date(timestamp));

    const formatDayLabel = (timestamp: number) =>
      new Intl.DateTimeFormat(dateLocale, {
        day: "numeric",
        timeZone: "Asia/Ho_Chi_Minh",
      }).format(new Date(timestamp));

    const getMonthSortKey = (timestamp: number) => {
      const parts = new Intl.DateTimeFormat("en-GB", {
        year: "numeric",
        month: "2-digit",
        timeZone: "Asia/Ho_Chi_Minh",
      }).formatToParts(new Date(timestamp));
      const y = Number(parts.find((p) => p.type === "year")?.value || 0);
      const m = Number(parts.find((p) => p.type === "month")?.value || 0);
      return y * 100 + m;
    };

    const ARCHIVE_YEAR_LABEL = "2026";
    const fallbackTs = updatedTime(loc.slug);
    const firstCapturedTs = Date.parse(sampleSource[0]?.capturedAt || "") || fallbackTs;
    const locDateLabel = firstCapturedTs ? formatMonthLabel(firstCapturedTs) : archiveFallbackLabel;
    const locYearLabel = ARCHIVE_YEAR_LABEL;

    return {
      ...loc,
      displayName: name,
      region,
      displayRegion,
      displayCountry,
      displayHeadline,
      displaySeoDescription,
      photoCount,
      updatedTimestamp: fallbackTs,
      capturedTimestamp: firstCapturedTs,
      dateLabel: locDateLabel,
      yearLabel: locYearLabel,
      previewImages,
      heroPhoto,
      samplePhotos: optimizedSample.map((photo, idx) => {
        const photoTs = Date.parse(sampleSource[idx]?.capturedAt || "") || firstCapturedTs;
        const rawSearch = `${name} ${region} ${displayRegion} ${displayCountry} ${sampleSource[idx]?.title || ""} ${sampleSource[idx]?.location || ""} ${loc.slug}`;
        return {
          ...photo,
          id: `${loc.slug}-${idx}`,
          detailId: `photo-${loc.slug}-${idx + 1}`,
          slug: loc.slug,
          albumName: name,
          region,
          displayRegion,
          country: displayCountry,
          albumCount: photoCount,
          title: sampleSource[idx]?.title || name,
          location: sampleSource[idx]?.location || name,
          capturedTimestamp: photoTs,
          monthSortKey: photoTs ? getMonthSortKey(photoTs) : 0,
          dateLabel: photoTs ? formatMonthLabel(photoTs) : archiveFallbackLabel,
          yearLabel: ARCHIVE_YEAR_LABEL,
          dayLabel: photoTs ? formatDayLabel(photoTs) : "",
          featured: idx === 0,
          normSearch: normalizeSearchServer(rawSearch),
        };
      }),
    };
  }),
);

type GridPhoto = (typeof enhancedLocations)[number]["samplePhotos"][number];

const tripsByYear = Array.from(
  [...enhancedLocations]
    .sort((a, b) => (b.capturedTimestamp || 0) - (a.capturedTimestamp || 0))
    .reduce((acc, loc) => {
      const year = loc.yearLabel || "Archive";
      const list = acc.get(year) || [];
      list.push(loc);
      acc.set(year, list);
      return acc;
    }, new Map<string, (typeof enhancedLocations)[number][]>()),
);

const allGridPhotos: GridPhoto[] = [];
const maxAlbumPhotos = Math.max(0, ...enhancedLocations.map((loc) => loc.samplePhotos.length));
for (let i = 0; i < maxAlbumPhotos; i++) {
  for (const loc of enhancedLocations) {
    const p = loc.samplePhotos[i];
    if (p) allGridPhotos.push(p);
  }
}

// Render first 36 photos in SSR HTML (round-robin covers all 25 destinations for fast paint & SEO).
// Remaining photos stream into shortest masonry columns via IntersectionObserver.
const INITIAL_SSR_COUNT = 36;
const initialGridPhotos = allGridPhotos.slice(0, INITIAL_SSR_COUNT);

const compactPhotosPayload = allGridPhotos.map((photo) => ({
  h: `${photosBasePath}/${photo.slug}#${photo.detailId}`,
  s: photo.slug,
  r: photo.region,
  a: photo.albumName,
  f: photo.featured ? 1 : 0,
  y: photo.yearLabel,
  d: photo.dateLabel,
  dy: photo.dayLabel,
  ts: photo.capturedTimestamp,
  ms: photo.monthSortKey,
  p: photo.previewSrc,
  ss: photo.previewSrcSet || "",
  w: photo.previewWidth,
  ht: photo.previewHeight,
  al: photo.alt,
  q: photo.normSearch,
}));

const totalPhotos = enhancedLocations.reduce((sum, loc) => sum + loc.photoCount, 0);
const availableRegions = PHOTO_REGION_ORDER.filter((r) =>
  enhancedLocations.some((l) => l.region === r),
);

const mapDestinations = (
  await Promise.all(
    enhancedLocations.map(async (loc) => {
      const photoLocations = (
        await Promise.all(
          (loc.photos || []).map(async (photo, index) => {
            const photoCoords =
              parsePhotoCoords(photo.latitude, photo.longitude) ||
              (await readPhotoExifCoordinates(photo.sourceSrc));
            if (!photoCoords) return null;
            const localizedPhoto = loc.samplePhotos[index];
            return {
              id: photo.id || `${loc.slug}-${index + 1}`,
              src: localizedPhoto?.previewSrc || photo.src,
              alt: localizedPhoto?.title || localizedPhoto?.alt || loc.displayName,
              lat: photoCoords.lat,
              lng: photoCoords.lng,
            };
          }),
        )
      ).filter((photo): photo is NonNullable<typeof photo> => photo !== null);
      const coords = resolvePhotoCoords(
        loc.slug,
        loc.latitude || photoLocations[0]?.lat,
        loc.longitude || photoLocations[0]?.lng,
      );
      if (!coords) return null;
      const pinThumb = loc.samplePhotos[0]?.previewSrc || loc.heroPhoto;
      return {
        slug: loc.slug,
        name: loc.displayName,
        region: loc.region,
        country: loc.displayCountry,
        headline: loc.displayHeadline,
        photoCount: loc.photoCount,
        heroPhoto: loc.heroPhoto,
        pinThumb,
        lat: coords.lat,
        lng: coords.lng,
        search: `${loc.displayName} ${loc.region} ${loc.displayRegion} ${loc.displayCountry} ${loc.displayHeadline} ${loc.slug}`,
        photoLocations,
      };
    }),
  )
).filter((item): item is NonNullable<typeof item> => item !== null);

const photosUrl = canonicalUrl(photosBasePath);
const photosSchema = collectionPageSchema({
  url: photosUrl,
  title: "Photography & Travel Journals — Phuc Loc Nguyen",
  description: photosUi.seoDescription(locations.length),
  items: enhancedLocations.map((loc) => ({
    name: loc.displayName,
    url: `${photosBasePath}/${loc.slug}`,
    description: loc.displaySeoDescription,
    image: loc.heroPhoto || undefined,
  })),
});

const scriptI18n = {
  basePath: photosBasePath,
  allItems: photosUi.allItems,
  allPhotos: photosUi.allPhotos,
  years: photosUi.years,
  months: photosUi.months,
  map: photosUi.map,
  trips: photosUi.trips,
  featured: photosUi.featured,
  albums: photosUi.albums,
  loadingMap: photosUi.loadingMap,
  emptyMap: "No photo locations are available yet.",
  initMapError: "The interactive map could not be initialized. Try again.",
  tripSingular: "Trip",
  tripPlural: "Trips",
  tripsByYearSuffix: "by Year",
  destinationsUnit: "Destinations",
  allYearsBack: "← All Years",
  allMonthsBack: "← All Months",
  openYearPrefix: "Open",
  photosUnit: "photos",
  itemsSuffix: "Items · Leica Q3, Nikon Zf & iPhone",
  archiveFallback: "Archive",
  regionLabels: photosUi.regionLabels,
};
---

<PhotosLayout
  title={photosUi.seoTitle}
  pageTitle={photosUi.pageTitle}
  description={photosUi.seoDescription(locations.length)}
  currentPath={photosBasePath}
  maxWidthVariant="gallery"
  fullBleed={true}
  schema={photosSchema}
>
  <div class="mp-app" id="mp-app" data-photos-i18n={JSON.stringify(scriptI18n)}>
    <!-- Sticky Photos Toolbar -->
    <div class="mp-toolbar" role="toolbar" aria-label={photosUi.toolbarAria}>
      <div class="mp-toolbar-left">
        <button
          type="button"
          id="mp-sidebar-toggle"
          class="mp-icon-btn"
          aria-label={photosUi.toggleSidebar}
          aria-pressed="true"
          title={photosUi.toggleSidebar}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M9 3v18" />
          </svg>
        </button>

        <div class="mp-zoom-control" aria-label={photosUi.thumbnailSizeAria}>
          <button type="button" id="mp-zoom-out" class="mp-zoom-btn" aria-label={photosUi.smallerThumbnails}>−</button>
          <input
            id="mp-zoom-slider"
            type="range"
            min="3"
            max="7"
            value="5"
            aria-label={photosUi.gridColumnsAria}
          />
          <button type="button" id="mp-zoom-in" class="mp-zoom-btn" aria-label={photosUi.largerThumbnails}>+</button>
        </div>
      </div>

      <div class="mp-segmented" id="mp-seg-library" role="tablist" aria-label={photosUi.timeViewAria}>
        <button type="button" class="mp-seg-btn" role="tab" aria-selected="false" data-seg="years">{photosUi.years}</button>
        <button type="button" class="mp-seg-btn" role="tab" aria-selected="false" data-seg="months">{photosUi.months}</button>
        <button type="button" class="mp-seg-btn is-active" role="tab" aria-selected="true" data-seg="all">{photosUi.allPhotos}</button>
      </div>

      <div class="mp-toolbar-right">
        <button
          type="button"
          id="mp-info-toggle"
          class="mp-icon-btn"
          aria-label={photosUi.showInfo}
          aria-pressed="false"
          title={photosUi.showInfo}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
          </svg>
        </button>

        <label class="mp-search">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="mp-search-input"
            type="search"
            placeholder={photosUi.searchPlaceholder}
            aria-label={photosUi.searchAria}
            autocomplete="off"
          />
        </label>
      </div>
    </div>

    <!-- 2-Column Body (Sticky Sidebar + Native Document Scroll Canvas) -->
    <div class="mp-body">
      <div class="mp-sidebar-backdrop" id="mp-sidebar-backdrop" hidden aria-hidden="true"></div>

      <!-- Left Sidebar -->
      <aside class="mp-sidebar" id="mp-sidebar" aria-label={photosUi.sidebarAria}>
        <div class="mp-sidebar-section">
          <div class="mp-sidebar-heading">{photosUi.sectionPhotos}</div>
          <button type="button" class="mp-nav-item is-active" data-nav="library">
            <svg width="16" height="13" viewBox="0 0 250 202" fill="none" aria-hidden="true">
              <path d="M30.3 26.4 159.8 4.6c12.7-2.2 24.8 6.4 27 19.1l2.9 17.1H87.3c-21.2 0-38.4 17.2-38.4 38.4v85.1c-10.5-.6-19.5-8.3-21.3-19.1L11.1 53.3C8.9 40.6 17.5 28.5 30.3 26.4Z" fill="#80B9FF"/>
              <rect x="59.6" y="51.4" width="179.1" height="139" rx="25" fill="#087BFA"/>
              <circle cx="120.2" cy="102.8" r="19.5" fill="#fff"/>
              <path d="m70.2 162.9 24-22.4c6-5.6 13.8-5.7 19.8-.3l16.4 14 37.1-33.7c7.2-6.5 15.4-5.3 22.5 1.3l38.8 34.5v8.6c0 8.9-7.2 16.1-16.1 16.1H86.2c-9 0-16-7.2-16-16.1v-2Z" fill="#fff"/>
            </svg>
            <span>{photosUi.library}</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="map">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
              <line x1="9" y1="3" x2="9" y2="18" />
              <line x1="15" y1="6" x2="15" y2="21" />
            </svg>
            <span>{photosUi.map}</span>
          </button>
        </div>

        <div class="mp-sidebar-section">
          <div class="mp-sidebar-heading">{photosUi.sectionCollections}</div>
          <button type="button" class="mp-nav-item" data-nav="trips">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            </svg>
            <span>{photosUi.trips}</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="featured">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            <span>{photosUi.featured}</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="albums">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
            </svg>
            <span>{photosUi.albums}</span>
          </button>
        </div>

        <div class="mp-sidebar-section">
          <div class="mp-sidebar-heading">{photosUi.sectionRegions}</div>
          {availableRegions.map((region) => (
            <button type="button" class="mp-nav-item" data-nav={`region:${region}`}>
              <svg width="16" height="14" viewBox="0 0 24 20" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="16" rx="3.2" stroke="currentColor" stroke-width="1.9" />
                <circle cx="8" cy="7.5" r="2.1" fill="currentColor" />
                <path d="M2.5 15.5 7 11.2c.7-.7 1.8-.7 2.5 0l2 1.9 3.6-4.1c.7-.8 1.9-.8 2.6 0l3.8 4.4V16a2 2 0 0 1-2 2H4.5a2 2 0 0 1-2-2v-.5Z" fill="currentColor" />
              </svg>
              <span>{regionLabel(region)}</span>
            </button>
          ))}
        </div>
      </aside>

      <!-- Main Gallery Canvas -->
      <section class="mp-canvas" id="mp-canvas" aria-label={photosUi.pageTitle}>
        <div class="mp-canvas-head">
          <div class="mp-canvas-title-wrap">
            <h1 id="mp-heading" class="mp-heading">{photosUi.allPhotos}</h1>
            <span id="mp-subheading" class="mp-subheading">
              {photosUi.subheading(locations.length)}
            </span>
          </div>

          <div class="mp-filter-wrap" id="mp-filter-wrap">
            <button
              type="button"
              id="mp-filter-trigger"
              class="mp-filter-pill"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span class="mp-filter-prefix">{photosUi.filterBy}</span>
              <strong id="mp-filter-label">{photosUi.allItems}</strong>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            <div id="mp-filter-menu" class="mp-popover-menu" role="menu" aria-label={photosUi.filterMenuAria} hidden>
              <button type="button" class="mp-menu-item is-selected" role="menuitemradio" aria-checked="true" data-filter-val="all" data-filter-text={photosUi.allItems}>
                <span class="mp-menu-check" aria-hidden="true">✓</span>
                <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="3" width="5" height="5" rx="1" />
                  <rect x="10" y="3" width="5" height="5" rx="1" />
                  <rect x="17" y="3" width="4" height="5" rx="1" />
                  <rect x="3" y="10" width="5" height="5" rx="1" />
                  <rect x="10" y="10" width="5" height="5" rx="1" />
                  <rect x="17" y="10" width="4" height="5" rx="1" />
                  <rect x="3" y="17" width="5" height="4" rx="1" />
                  <rect x="10" y="17" width="5" height="4" rx="1" />
                  <rect x="17" y="17" width="4" height="4" rx="1" />
                </svg>
                <span>{photosUi.allItems}</span>
              </button>

              <div class="mp-menu-divider" role="separator"></div>

              <button type="button" class="mp-menu-item" role="menuitemradio" aria-checked="false" data-filter-val="featured" data-filter-text={photosUi.featured}>
                <span class="mp-menu-check" aria-hidden="true">✓</span>
                <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <line x1="4" y1="6" x2="20" y2="6" />
                  <circle cx="9" cy="6" r="2" fill="currentColor" />
                  <line x1="4" y1="12" x2="20" y2="12" />
                  <circle cx="15" cy="12" r="2" fill="currentColor" />
                  <line x1="4" y1="18" x2="20" y2="18" />
                  <circle cx="10" cy="18" r="2" fill="currentColor" />
                </svg>
                <span>{photosUi.featured}</span>
              </button>

              <div class="mp-menu-divider" role="separator"></div>

              {availableRegions.map((region) => (
                <button
                  type="button"
                  class="mp-menu-item"
                  role="menuitemradio"
                  aria-checked="false"
                  data-filter-val={`region:${region}`}
                  data-filter-text={regionLabel(region)}
                >
                  <span class="mp-menu-check" aria-hidden="true">✓</span>
                  <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  <span>{regionLabel(region)}</span>
                </button>
              ))}

              <div class="mp-menu-divider" role="separator"></div>

              <div class="mp-menu-scroll">
                {enhancedLocations.map((loc) => (
                  <button
                    type="button"
                    class="mp-menu-item"
                    role="menuitemradio"
                    aria-checked="false"
                    data-filter-val={`album:${loc.slug}`}
                    data-filter-text={loc.displayName}
                  >
                    <span class="mp-menu-check" aria-hidden="true">✓</span>
                    <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                    </svg>
                    <span>{loc.displayName}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Photo Grid (All Photos / Years / Months / Featured / Regions) -->
        <div id="mp-grid-view" class="mp-grid-view">
          <div id="mp-time-bar" class="mp-time-bar" role="tablist" aria-label={photosUi.timeViewAria} hidden></div>
          <div id="mp-years-view" class="mp-years-view" hidden></div>
          <div id="mp-months-view" class="mp-months-view" hidden></div>
          <div id="mp-months-sentinel" class="mp-sentinel" aria-hidden="true" hidden></div>

          <div id="mp-grid" class="mp-grid" style="--mp-cols: 5;">
            {initialGridPhotos.map((photo, idx) => (
              <a href={`${photosBasePath}/${photo.slug}#${photo.detailId}`} class="mp-cell">
                <div class="mp-cell-media" style={`aspect-ratio: ${photo.previewWidth} / ${photo.previewHeight};`}>
                  <img
                    src={photo.previewSrc}
                    srcset={photo.previewSrcSet || undefined}
                    sizes={photo.previewSizes}
                    alt={photo.alt}
                    width={photo.previewWidth}
                    height={photo.previewHeight}
                    loading={idx < 12 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
                <div class="mp-cell-info">
                  <span>{photo.albumName}</span>
                </div>
              </a>
            ))}
          </div>
          <div id="mp-grid-sentinel" class="mp-sentinel" aria-hidden="true"></div>

          <div id="mp-empty" class="mp-empty" hidden>
            <p id="mp-empty-msg">{photosUi.emptyMsg}</p>
            <button type="button" id="mp-reset-btn" class="mp-reset-btn">{photosUi.showAllPhotos}</button>
          </div>
        </div>

        <!-- Trips Timeline View (grouped by year) -->
        <div id="mp-trips-view" class="mp-trips-view" hidden>
          {tripsByYear.map(([year, yearLocations]) => (
            <section class="mp-trip-year-group" data-trip-year={year}>
              <div class="mp-trip-year-head">
                <h2 class="mp-trip-year-title">{year}</h2>
                <span class="mp-trip-year-count" data-trip-year-count>{photosUi.tripUnit(yearLocations.length)}</span>
              </div>
              <div class="mp-trip-cards">
                {yearLocations.map((loc, tripIdx) => (
                  <a
                    href={`${photosBasePath}/${loc.slug}`}
                    class="mp-trip-card"
                    data-region={loc.region}
                    data-search={normalizeSearchServer(`${loc.displayName} ${loc.region} ${loc.displayRegion} ${loc.displayCountry} ${loc.dateLabel} ${loc.yearLabel} ${loc.displayHeadline} ${loc.slug}`)}
                  >
                    <img
                      src={loc.heroPhoto}
                      alt={loc.displayName}
                      class="mp-trip-card-img"
                      width="480"
                      height="300"
                      loading={tripIdx < 8 ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <div class="mp-trip-card-overlay">
                      <span class="mp-trip-card-meta">{loc.dateLabel} · {loc.displayRegion}</span>
                      <strong class="mp-trip-card-title">{loc.displayName}</strong>
                      <span class="mp-trip-card-count">{photosUi.photoCount(loc.photoCount)}</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <!-- Albums Folder View -->
        <div id="mp-albums-view" class="mp-albums-view" hidden>
          <div id="mp-folders-grid" class="glass-folder-grid">
            {enhancedLocations.map((loc) => {
              const folderProps = {
                label: loc.displayName,
                meta: photosUi.albumMeta(loc.photoCount, loc.displayRegion),
                image: loc.heroPhoto || undefined,
                art: "none" as const,
                files: loc.previewImages.map((image, index) => ({
                  name: `${loc.displayName} — ${index + 1}`,
                  image,
                  href: `${photosBasePath}/${loc.slug}`,
                })),
                href: `${photosBasePath}/${loc.slug}`,
                action: "none" as const,
                appear: false,
                defaultWidth: 204,
                eager: false,
              };
              return (
                <div
                  class="glass-folder-item"
                  data-region={loc.region}
                  data-search={normalizeSearchServer(`${loc.displayName} ${loc.region} ${loc.displayRegion} ${loc.displayCountry} ${loc.displayHeadline} ${loc.slug}`)}
                  data-href={`${photosBasePath}/${loc.slug}`}
                >
                  <GlassFolder {...folderProps} />
                </div>
              );
            })}
          </div>
        </div>

        <!-- Interactive Map View -->
        <div id="mp-map-view" class="mp-map-view" hidden>
          <div id="mp-map-canvas" class="mp-map-canvas" aria-label={photosUi.map}></div>

          <div id="mp-map-status" class="mp-map-status" role="status" aria-live="polite">
            <span data-map-status-copy>{photosUi.loadingMap}</span>
            <button type="button" data-map-retry hidden>{photosUi.tryAgain}</button>
          </div>

          <!-- Selected Destination Popover Card -->
          <div id="mp-map-card" class="mp-map-card" hidden>
            <button type="button" id="mp-map-card-close" class="mp-map-card-close" aria-label={photosUi.closePreview}>×</button>
            <img data-card-img src="" alt="" class="mp-map-card-img" loading="lazy" decoding="async" />
            <div class="mp-map-card-body">
              <div class="mp-map-card-title" data-card-title></div>
              <div class="mp-map-card-meta" data-card-meta></div>
              <p class="mp-map-card-headline" data-card-headline></p>
              <a data-card-link href={photosBasePath} class="mp-map-card-link">{photosUi.openAlbum}</a>
            </div>
          </div>

          <!-- Bottom-left Legal attribution -->
          <div class="mp-map-legal">
            <span>© OpenStreetMap contributors</span>
            <span aria-hidden="true">·</span>
            <a href="https://openfreemap.org/" target="_blank" rel="noopener noreferrer">OpenFreeMap</a>
            <span aria-hidden="true">·</span>
            <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">{photosUi.legal}</a>
          </div>

          <!-- Bottom-right Zoom Pill & Compass -->
          <div class="mp-map-controls" aria-label={photosUi.mapControlsAria}>
            <div class="mp-map-zoom-pill">
              <button type="button" id="mp-map-zoom-out" class="mp-map-ctrl-btn" aria-label={photosUi.zoomOut}>−</button>
              <span class="mp-map-zoom-sep" aria-hidden="true"></span>
              <button type="button" id="mp-map-zoom-in" class="mp-map-ctrl-btn" aria-label={photosUi.zoomIn}>+</button>
            </div>
            <button type="button" id="mp-map-compass" class="mp-map-compass" aria-label={photosUi.resetView} title={photosUi.resetView}>
              <svg width="26" height="26" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                <circle cx="18" cy="18" r="16.5" stroke="rgba(255,255,255,0.22)" stroke-width="1" />
                <path d="M18 3.5L20.2 8.5H15.8L18 3.5Z" fill="#ff453a" />
                <text x="18" y="22.5" text-anchor="middle" fill="#ffffff" font-size="12" font-weight="700" font-family="-apple-system, BlinkMacSystemFont, sans-serif">N</text>
              </svg>
            </button>
          </div>
        </div>

        <!-- Bottom Status Footer -->
        <footer class="mp-footer" aria-label={photosUi.pageTitle}>
          <strong id="mp-footer-count">{photosUi.footerSummary(totalPhotos, locations.length)}</strong>
          <span>{photosUi.footerGear}</span>
        </footer>
      </section>
    </div>

    <script is:inline type="application/json" id="mp-photos-data" set:html={safeInlineJson(compactPhotosPayload)} />
    <script is:inline type="application/json" id="mp-map-data" set:html={safeInlineJson(mapDestinations)} />
  </div>
</PhotosLayout>

