---
import { ChevronDown, Check } from "../icons/phosphor";

export interface DropdownOption {
  value: string;
  label: string;
  selected?: boolean;
}

interface Props {
  id: string;
  name: string;
  dataKey?: string;
  defaultLabel: string;
  header?: string;
  options?: DropdownOption[];
  disabled?: boolean;
  class?: string;
}

const {
  id,
  name,
  dataKey = name,
  defaultLabel,
  header,
  options = [],
  disabled = false,
  class: className = "",
} = Astro.props;

const selectedOption = options.find(opt => opt.selected);
const currentLabel = selectedOption ? selectedOption.label : defaultLabel;
const triggerId = `${id}-trigger`;
const menuId = `${id}-menu`;
---

<div
  class:list={["ui-dropdown", className]}
  data-dropdown={dataKey}
>
  <button
    type="button"
    class="ui-dropdown-trigger"
    id={triggerId}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={menuId}
    disabled={disabled}
    data-default-label={defaultLabel}
  >
    <span class="ui-dropdown-value" data-value-text>{currentLabel}</span>
    <ChevronDown
      className="ui-dropdown-arrow"
      size={13}
      strokeWidth={1.8}
      aria-hidden="true"
    />
  </button>

  <div
    class="ui-dropdown-menu"
    id={menuId}
    role="listbox"
    aria-labelledby={triggerId}
    tabindex="-1"
  >
    {header && <div class="ui-dropdown-header">{header}</div>}
    <div class="ui-dropdown-list" data-options-list>
      {options.map(opt => (
        <button
          type="button"
          class="ui-dropdown-item"
          role="option"
          aria-selected={opt.selected ? "true" : "false"}
          data-value={opt.value}
        >
          <span class="ui-dropdown-item-label">{opt.label}</span>
          {opt.selected && (
            <span class="ui-dropdown-item-check" aria-hidden="true">
              <Check size={14} strokeWidth={1.8} />
            </span>
          )}
        </button>
      ))}
    </div>
  </div>

  <select id={id} name={name} class="sr-only" tabindex="-1" disabled={disabled}>
    <option value="">{defaultLabel}</option>
    {options.map(opt => (
      <option value={opt.value} selected={opt.selected}>{opt.label}</option>
    ))}
  </select>
</div>

