---
import SelectWithSearch, {
  type SelectWithSearchOption,
} from "./select-with-search";

export interface DropdownOption extends SelectWithSearchOption {
  selected?: boolean;
}

interface Props {
  id: string;
  name: string;
  dataKey?: string;
  selectDataAttr?: string;
  label?: string;
  defaultLabel: string;
  searchPlaceholder?: string;
  emptyText?: string;
  header?: string;
  options?: DropdownOption[];
  allowDeselect?: boolean;
  disabled?: boolean;
  align?: "start" | "center" | "end";
  class?: string;
  triggerClassName?: string;
  contentClassName?: string;
}

const {
  id,
  name,
  dataKey = name,
  selectDataAttr,
  label,
  defaultLabel,
  searchPlaceholder = "Search...",
  emptyText = "No results found.",
  header,
  options = [],
  allowDeselect = true,
  disabled = false,
  align = "start",
  class: className = "",
  triggerClassName,
  contentClassName,
} = Astro.props;

const selectedOption = options.find((opt) => opt.selected);
const defaultValue =
  selectedOption?.value ?? (allowDeselect ? "" : (options[0]?.value ?? ""));

const normalizedOptions: SelectWithSearchOption[] = options.map(
  ({ value, label: optLabel, description, keywords, disabled: optDisabled }) => ({
    value,
    label: optLabel,
    description,
    keywords,
    disabled: optDisabled,
  }),
);
---

<SelectWithSearch
  client:load
  id={id}
  name={name}
  dataKey={dataKey}
  selectDataAttr={selectDataAttr}
  label={label}
  placeholder={defaultLabel}
  searchPlaceholder={searchPlaceholder}
  emptyText={emptyText}
  header={header}
  options={normalizedOptions}
  defaultValue={defaultValue}
  allowDeselect={allowDeselect}
  disabled={disabled}
  align={align}
  className={className}
  triggerClassName={triggerClassName}
  contentClassName={contentClassName}
/>
