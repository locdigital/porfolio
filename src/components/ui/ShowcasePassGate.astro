---
import { createHash } from "node:crypto";
import { LockIcon as Lock } from "@phosphor-icons/react";

interface Props {
  id: string;
  password: string | string[];
  storageKey?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  inputLabel?: string;
  placeholder?: string;
  buttonLabel?: string;
  successLabel?: string;
  errorMessage?: string;
}

const {
  id,
  password,
  storageKey = `${id}:unlocked`,
  inputLabel = "Access code",
  placeholder = "Enter access code",
  buttonLabel = "Unlock",
  successLabel = "Unlocked",
  errorMessage = "Incorrect access code. Please try again.",
} = Astro.props;

const title = "Private project details";
const description = "Campaign reports, visuals, and notes shared with authorized viewers.";
const passList = Array.isArray(password) ? password : [password];
const passwordHashes = passList.map((p) => createHash("sha256").update(p.trim().toLowerCase()).digest("hex"));
---

<section class="page-section showcase-pass-gate" id={id} data-showcase-pass-gate aria-labelledby={`${id}-title`}>
  <div class="showcase-pass-gate-layout" data-gate-panel>
    <div class="showcase-pass-gate-copy">
      <Lock className="showcase-pass-gate-icon" size={20} weight="regular" aria-hidden="true" />
      <div class="showcase-pass-gate-text">
        <h3 class="showcase-pass-gate-title" id={`${id}-title`}>{title}</h3>
        <p class="showcase-pass-gate-description">{description}</p>
        <p class="showcase-pass-gate-success" data-gate-success hidden>{successLabel}</p>
      </div>
    </div>

    <form class="showcase-pass-gate-form" data-gate-form>
      <label class="showcase-pass-gate-label" for={`${id}-input`}>{inputLabel}</label>
      <div class="showcase-pass-gate-row">
        <input
          id={`${id}-input`}
          class="showcase-pass-gate-input"
          data-gate-input
          type="password"
          autocomplete="off"
          inputmode="text"
          placeholder={placeholder}
          aria-invalid="false"
          aria-describedby={`${id}-error`}
        />
        <button class="showcase-pass-gate-button" type="submit">
          <span data-gate-button-label>{buttonLabel}</span>
        </button>
      </div>
      <p class="showcase-pass-gate-error" id={`${id}-error`} data-gate-error role="alert" aria-live="polite" hidden></p>
    </form>
  </div>

  <div class="showcase-pass-gate-reveal" data-gate-reveal hidden>
    <slot />
  </div>
</section>

<script is:inline define:vars={{ id, passwordHashes, storageKey, errorMessage }}>
  (() => {
    const root = document.getElementById(id);
    if (!root || root.dataset.gateReady === "true") return;

    root.dataset.gateReady = "true";

    const form = root.querySelector("[data-gate-form]");
    const input = root.querySelector("[data-gate-input]");
    const reveal = root.querySelector("[data-gate-reveal]");
    const success = root.querySelector("[data-gate-success]");
    const error = root.querySelector("[data-gate-error]");
    const button = form?.querySelector("button");
    const buttonLabel = button?.querySelector("[data-gate-button-label]");
    const initialButtonLabel = buttonLabel?.textContent || "Unlock";
    const initialPlaceholder = input?.getAttribute("placeholder") || "Enter access code";

    if (!form || !input || !reveal || !button) return;

    let isShowingError = false;
    let isSubmitting = false;

    const toHex = (buffer) =>
      Array.from(new Uint8Array(buffer))
        .map((byte) => byte.toString(16).padStart(2, "0"))
        .join("");

    const hash = async (value) => {
      if (!window.crypto?.subtle) return "";
      const bytes = new TextEncoder().encode(value);
      return toHex(await window.crypto.subtle.digest("SHA-256", bytes));
    };

    const unlock = () => {
      root.dataset.unlocked = "true";
      form.hidden = true;
      reveal.hidden = false;
      if (success) success.hidden = false;
    };

    const setLoading = (loading) => {
      isSubmitting = loading;
      button.disabled = loading;
      button.setAttribute("aria-busy", loading ? "true" : "false");
      root.dataset.loading = loading ? "true" : "false";
      if (buttonLabel) buttonLabel.textContent = loading ? "Checking..." : initialButtonLabel;
    };

    const resetErrorState = () => {
      if (!isShowingError) return;
      isShowingError = false;
      input.setAttribute("aria-invalid", "false");
      input.setAttribute("placeholder", initialPlaceholder);
      input.classList.remove("has-error", "is-shaking");
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    const showErrorState = () => {
      const message = errorMessage || "Incorrect access code. Please try again.";
      isShowingError = true;
      input.value = "";
      input.setAttribute("aria-invalid", "true");
      input.setAttribute("placeholder", message);
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
      input.classList.add("has-error");
      input.classList.remove("is-shaking");
      void input.offsetWidth;
      input.classList.add("is-shaking");
    };

    input.addEventListener("input", resetErrorState);
    input.addEventListener("keydown", (e) => {
      if (isShowingError && e.key !== "Enter") {
        resetErrorState();
      }
    });

    try {
      if (window.sessionStorage.getItem(storageKey) === "true") unlock();
    } catch {
      /* Ignore private browsing storage errors. */
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (isSubmitting) return;

      resetErrorState();
      setLoading(true);
      const rawVal = input.value.trim().toLowerCase();
      if (!rawVal) {
        showErrorState();
        setLoading(false);
        return;
      }

      const digest = await hash(rawVal);

      if (passwordHashes.includes(digest)) {
        try {
          window.sessionStorage.setItem(storageKey, "true");
        } catch {
          /* Unlocking still works even when storage is unavailable. */
        }
        unlock();
      } else {
        showErrorState();
        setLoading(false);
      }
    });
  })();
</script>

<style>
  .showcase-pass-gate {
    font-family: var(--sans);
    container-type: inline-size;
    padding: 24px;
    border: 1px solid #E6E6E3;
    border-width: 1px !important;
    border-style: solid;
    border-color: #E6E6E3;
    border-radius: 8px;
    background: #FFFFFF;
    box-shadow: none;
    overflow: hidden;
  }

  .showcase-pass-gate [hidden] {
    display: none !important;
  }

  .showcase-pass-gate-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 380px);
    gap: 32px;
    align-items: center;
    min-width: 0;
  }

  .showcase-pass-gate-copy {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .showcase-pass-gate-icon {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--dash-muted, #686863);
  }

  .showcase-pass-gate-text {
    min-width: 0;
  }

  .showcase-pass-gate-title {
    margin: 0;
    font-family: var(--sans);
    font-size: 16px !important;
    font-weight: 600 !important;
    line-height: 24px !important;
    color: var(--dash-text, #292927);
    letter-spacing: 0;
  }

  .showcase-pass-gate-description {
    max-width: 56ch;
    margin: 2px 0 0;
    font-family: var(--sans);
    font-size: 14px !important;
    font-weight: 400;
    line-height: 22px;
    color: var(--dash-muted, #686863);
  }

  .showcase-pass-gate :is(.showcase-pass-gate-description, #showcase-pass-gate-copy-size-override) {
    font-size: 14px !important;
  }

  .showcase-pass-gate-form {
    display: grid;
    gap: 6px;
    width: 100%;
    max-width: 380px;
    justify-self: end;
    min-width: 0;
  }

  .showcase-pass-gate-label {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--dash-muted, #686863);
  }

  .showcase-pass-gate-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
    min-width: 0;
  }

  .showcase-pass-gate-input {
    min-width: 0;
    flex: 1 1 auto;
    height: 40px;
    padding: 0 12px;
    border: 1px solid #CFCFCB;
    border-radius: 6px;
    outline: 0;
    background: #FFFFFF;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 20px;
    color: var(--dash-text, #292927);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .showcase-pass-gate-input::placeholder {
    color: var(--dash-placeholder, #73736D);
    opacity: 1;
  }

  .showcase-pass-gate-input:focus,
  .showcase-pass-gate-input:focus-visible {
    outline: 2px solid var(--dash-accent, #245D9F);
    outline-offset: 2px;
    border-color: var(--dash-accent, #245D9F);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--dash-accent, #245D9F) 18%, transparent);
  }

  .showcase-pass-gate-input.has-error {
    border-color: var(--state-error, #F64932);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--state-error, #F64932) 16%, transparent);
  }

  .showcase-pass-gate-input.has-error::placeholder {
    color: var(--state-error, #F64932);
  }

  .showcase-pass-gate-input.is-shaking {
    animation: gateInputShake 0.32s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes gateInputShake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-3px, 0, 0); }
    40%, 60% { transform: translate3d(3px, 0, 0); }
  }

  .showcase-pass-gate-button {
    display: inline-flex;
    flex: 0 0 auto;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    border: 1px solid var(--dash-primary, #292927);
    border-radius: 6px;
    background: var(--dash-primary, #292927);
    color: #FFFFFF;
    font-family: var(--sans);
    font-size: 14px !important;
    font-weight: 600;
    line-height: 20px;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, opacity 160ms ease;
  }

  .showcase-pass-gate-button:hover {
    background: var(--dash-primary-hover, #41413D);
    border-color: var(--dash-primary-hover, #41413D);
  }

  .showcase-pass-gate-button:focus-visible {
    outline: 2px solid var(--dash-accent, #245D9F);
    outline-offset: 2px;
  }

  .showcase-pass-gate-button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .showcase-pass-gate-success {
    margin: 6px 0 0;
    font-family: var(--sans);
    font-size: 12px !important;
    line-height: 16px;
    font-weight: 500;
    color: var(--state-success);
  }

  .showcase-pass-gate-error {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .showcase-pass-gate-reveal {
    grid-column: 1 / -1;
    margin-top: 24px;
    min-width: 0;
    animation: showcaseGateReveal 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes showcaseGateReveal {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @container (max-width: 760px) {
    .showcase-pass-gate-layout {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .showcase-pass-gate-form {
      grid-column: 1 / -1;
      max-width: none;
      justify-self: stretch;
    }
  }

  @media (max-width: 640px) {
    .showcase-pass-gate {
      padding: 20px;
    }

    .showcase-pass-gate-input,
    .showcase-pass-gate-button {
      height: 44px;
    }

    .showcase-pass-gate .showcase-pass-gate-input,
    .showcase-pass-gate .showcase-pass-gate-input::placeholder {
      font-size: 16px !important;
    }
  }

  @container (max-width: 440px) {
    .showcase-pass-gate-row {
      flex-direction: column;
    }

    .showcase-pass-gate-input,
    .showcase-pass-gate-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-pass-gate-reveal,
    .showcase-pass-gate-input.is-shaking {
      animation: none;
    }
  }
</style>
