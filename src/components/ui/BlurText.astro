---
interface Props {
  text: string;
  as?: "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  delay?: number;
  className?: string;
  animateBy?: "words" | "letters";
  direction?: "top" | "bottom";
  stepDuration?: number;
}

const {
  text = "",
  as = "p",
  delay = 60,
  className = "",
  animateBy = "words",
  direction = "top",
  stepDuration = 0.38,
} = Astro.props as Props;

const Tag = as;
const elements = animateBy === "words" ? text.split(" ") : text.split("");
---

<Tag class={`blur-text-container ${className}`} data-direction={direction} data-delay={delay} data-duration={stepDuration}>
  {elements.map((segment, index) => (
    <span 
      class="blur-text-word inline-block will-change-[transform,filter,opacity]"
      style={`--word-index: ${index}; --word-delay: ${index * delay}ms; --word-duration: ${stepDuration}s;`}
    >
      {segment === " " ? "\u00A0" : segment}
      {animateBy === "words" && index < elements.length - 1 && "\u00A0"}
    </span>
  ))}
</Tag>

<style>
  .blur-text-container {
    display: flex;
    flex-wrap: wrap;
  }
  
  .blur-text-word {
    opacity: 0;
  }

  /* Trigger animation when parent has .in-view class */
  .blur-text-container[data-direction="top"].in-view .blur-text-word {
    animation: blur-in-top var(--word-duration) cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--word-delay);
  }

  .blur-text-container[data-direction="bottom"].in-view .blur-text-word {
    animation: blur-in-bottom var(--word-duration) cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--word-delay);
  }

  @keyframes blur-in-top {
    0% {
      filter: blur(10px);
      opacity: 0;
      transform: translateY(-50px);
    }
    50% {
      filter: blur(5px);
      opacity: 0.5;
      transform: translateY(5px);
    }
    100% {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blur-in-bottom {
    0% {
      filter: blur(10px);
      opacity: 0;
      transform: translateY(50px);
    }
    50% {
      filter: blur(5px);
      opacity: 0.5;
      transform: translateY(-5px);
    }
    100% {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blur-text-word {
      opacity: 1;
      filter: none;
      transform: none;
    }
    .blur-text-container.in-view .blur-text-word {
      animation: none;
    }
  }
</style>

<script>
  function setupBlurTextObservers() {
    const containers = document.querySelectorAll('.blur-text-container');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05 });

    containers.forEach((el) => observer.observe(el));
  }

  // Set up observers immediately and on Astro page loads (view transitions)
  setupBlurTextObservers();
  document.addEventListener('astro:page-load', setupBlurTextObservers);
</script>
