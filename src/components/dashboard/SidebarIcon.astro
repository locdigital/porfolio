---
import { SF_SIDEBAR_ICONS, type SidebarIconName } from "../icons/sf-sidebar";

interface Props {
  name: SidebarIconName;
}

const { name } = Astro.props;
const innerHtml = SF_SIDEBAR_ICONS[name] ?? "";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="17"
  height="17"
  fill="none"
  stroke="currentColor"
  stroke-width="1.95"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`dash-nav-icon sf-icon sf-icon-${name}`}
  aria-hidden="true"
  focusable="false"
  set:html={innerHtml}
/>
