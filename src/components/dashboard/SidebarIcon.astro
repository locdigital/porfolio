---
import { Majesticon, type MajesticonName } from "../icons/majesticons";

interface Props {
  name: MajesticonName;
}

const { name } = Astro.props;
const simplePaths: Partial<Record<MajesticonName, string>> = {
  "map-marker": "M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  "note-text": "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2ZM7 8h10M7 12h10M7 16h6",
  image: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm-2 13 5-5 4 4 3-3 6 6M8 7h.01",
  monitor: "M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm8 13v4m-4 0h8",
  mail: "M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM3 6l9 7 9-7",
};
const path = simplePaths[name];
---

{path ? (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="dash-nav-icon" aria-hidden="true" focusable="false">
    <path d={path} />
  </svg>
) : (
  <Majesticon name={name} size={16} strokeWidth={1.8} className="dash-nav-icon" aria-hidden="true" focusable="false" />
)}
