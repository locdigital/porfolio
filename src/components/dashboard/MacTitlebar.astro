---
import { getUiCopy } from "../../i18n/ui";

interface Props {
  appLabel?: string;
  title?: string;
}

const {
  appLabel = "workspace",
  title,
} = Astro.props;

const copy = getUiCopy();
const resolvedTitle = title ?? copy.workspaceTitle;
---

<header class="desktop-titlebar" aria-label={copy.windowControls.titleBarAria}>
  <!-- Functional macOS-style window controls. -->
  <div class="mac-traffic-lights" aria-label={copy.windowControls.controlsAria}>
    <button
      class="mac-dot mac-dot-close"
      type="button"
      data-window-action="close"
      aria-label={copy.windowControls.close(appLabel)}
      title={copy.windowControls.close(appLabel)}
    >
      <svg class="mac-control-icon" viewBox="0 0 48 48" aria-hidden="true">
        <use href="/assets/icons/all-three.svg#window-close"></use>
      </svg>
    </button>
    <button
      class="mac-dot mac-dot-minimize"
      type="button"
      data-window-action="minimize"
      aria-label={copy.windowControls.minimize(appLabel)}
      aria-pressed="false"
      title={copy.windowControls.minimize(appLabel)}
    >
      <svg class="mac-control-icon" viewBox="0 0 48 48" aria-hidden="true">
        <use href="/assets/icons/all-three.svg#window-minimize"></use>
      </svg>
    </button>
    <button
      class="mac-dot mac-dot-maximize"
      type="button"
      data-window-action="maximize"
      aria-label={copy.windowControls.maximize(appLabel)}
      aria-pressed="false"
      title={copy.windowControls.maximize(appLabel)}
    >
      <svg class="mac-control-icon" viewBox="0 0 48 48" aria-hidden="true">
        <use href="/assets/icons/all-three.svg#window-maximize"></use>
      </svg>
    </button>
  </div>

  <!-- Centered Workspace Title -->
  <div class="desktop-titlebar-title">
    <span>{resolvedTitle}</span>
  </div>
</header>
