---
interface Props {
  appLabel?: string;
  title?: string;
  locale?: string;
  currentPath?: string;
}

const {
  appLabel = "workspace",
  title = "Phuc Loc Nguyen — Workspace",
} = Astro.props;
---

<header class="desktop-titlebar" aria-label="Application Window Title Bar">
  <!-- Functional macOS-style window controls. -->
  <div class="mac-traffic-lights" aria-label="Window controls">
    <button
      class="mac-dot mac-dot-close"
      type="button"
      data-window-action="close"
      aria-label={`Close ${appLabel}`}
      title={`Close ${appLabel}`}
    >
      <svg class="mac-control-icon" viewBox="0 0 48 48" aria-hidden="true">
        <use href="/assets/icons/all-three.svg#window-close"></use>
      </svg>
    </button>
    <button
      class="mac-dot mac-dot-minimize"
      type="button"
      data-window-action="minimize"
      aria-label={`Minimize ${appLabel}`}
      aria-pressed="false"
      title={`Minimize ${appLabel}`}
    >
      <svg class="mac-control-icon" viewBox="0 0 48 48" aria-hidden="true">
        <use href="/assets/icons/all-three.svg#window-minimize"></use>
      </svg>
    </button>
    <button
      class="mac-dot mac-dot-maximize"
      type="button"
      data-window-action="maximize"
      aria-label={`Maximize ${appLabel}`}
      aria-pressed="false"
      title={`Maximize ${appLabel}`}
    >
      <svg class="mac-control-icon" viewBox="0 0 48 48" aria-hidden="true">
        <use href="/assets/icons/all-three.svg#window-maximize"></use>
      </svg>
    </button>
  </div>

  <!-- Centered Workspace Title -->
  <div class="desktop-titlebar-title">
    <span>{title}</span>
  </div>
</header>
