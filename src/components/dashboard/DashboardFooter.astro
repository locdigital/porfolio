---
import { ArrowUpRightIcon as ArrowUpRight } from "@phosphor-icons/react";
---

<footer class="dash-footer" style="padding-top: var(--space-8); margin-top: var(--space-12); border-top: 1px solid var(--dash-border); font-size: 0.8125rem; color: var(--dash-muted);">
  <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4);">
    <div>
      <span style="font-weight: 500; color: var(--dash-text);">Phuc Loc Nguyen</span>
      <span style="margin: 0 6px; opacity: 0.4;">·</span>
      <span>Senior Performance Marketing Executive</span>
    </div>

    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
      <a href="/work" class="dash-link" style="color: inherit;">Work</a>
      <a href="/experience" class="dash-link" style="color: inherit;">Experience</a>
      <a href="/services" class="dash-link" style="color: inherit;">Services</a>
      <a href="/photos" class="dash-link" style="color: inherit;">Photos</a>
      <a href="/contact" class="dash-link" style="color: inherit;">Contact</a>
      <a href="/classic" class="dash-link" style="color: var(--dash-accent); display: inline-flex; align-items: center; gap: 2px;">
        <span>Classic view</span>
        <ArrowUpRight size={12} aria-hidden="true" />
      </a>
    </div>

    <div style="font-size: 0.75rem; opacity: 0.8;">
      © 2026 loc.digital · Saigon, Vietnam
    </div>
  </div>
</footer>
