---
import avatar from "../../assets/avatar.webp";
import Heroicon from "../icons/Heroicon.astro";
import type { HeroiconName } from "../icons/heroicons";

interface Props {
  currentPath?: string;
  locale?: string;
}

const {
  currentPath = Astro.url.pathname,
} = Astro.props;

const normalizePath = (path: string) => {
  if (path === "/" || path === "") return "/";
  return path.endsWith("/") ? path.slice(0, -1) : path;
};

const activePath = normalizePath(currentPath);

interface NavItem {
  label: string;
  href: string;
  icon: HeroiconName;
  iconSrc?: string;
  exact?: boolean;
}

interface NavSection {
  group: string;
  items: NavItem[];
}

const navSections: NavSection[] = [
  {
    group: "Workspace",
    items: [
      { label: "About",
        href: "/about",
        icon: "finger-print",
        iconSrc: "https://is1-ssl.mzstatic.com/image/thumb/Features211/v4/78/61/b9/7861b9d5-8999-25f6-303d-08bf6112f2ce/f26de0fd-1ba0-4cbf-8c76-33fb0fbfeb16.png/40x40bb.webp",
      },
      { label: "Work", href: "/work", icon: "work-stack" },
      { label: "Services", href: "/services", icon: "cog-8-tooth" },
    ],
  },
  {
    group: "Personal",
    items: [
      { label: "Writing", href: "/writing", icon: "journal" },
      { label: "Growth Hub", href: "/growth", icon: "rocket-launch" },
      { label: "Gear", href: "/gear", icon: "game-controller" },
    ],
  },
];

const isItemActive = (href: string, exact?: boolean) => {
  const normHref = normalizePath(href);
  if (exact || normHref === "/") {
    return activePath === normHref;
  }
  return activePath === normHref || activePath.startsWith(`${normHref}/`);
};

const isCurrentPage = (href: string) => activePath === normalizePath(href);
---

<!-- Mobile Drawer Backdrop -->
<div id="dash-drawer-backdrop" class="dash-drawer-backdrop" aria-hidden="true"></div>

<!-- Sidebar Container -->
<aside id="dash-sidebar" class="workspace-sidebar" aria-label="Workspace Navigation">
  <div class="workspace-sidebar-inner">
    
    <div>
      <!-- Top Identity Block -->
      <div class="dash-sidebar-header">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <a href="/" class="dash-user-row" aria-label="Phuc Loc Nguyen Home" aria-current={isCurrentPage("/") ? "page" : undefined} data-astro-prefetch="hover">
            <img 
              src={avatar.src}
              alt="Nguyen Phuc Loc" 
              class="dash-user-avatar"
              width="28"
              height="28"
              decoding="async"
            />
            <div>
              <div class="dash-user-name">Phuc Loc Nguyen</div>
              <div class="dash-user-meta">Personal workspace</div>
            </div>
          </a>

          <!-- Mobile Close Button -->
          <button 
            id="dash-drawer-close" 
            class="mobile-menu-btn" 
            aria-label="Close navigation menu"
          >
            <Heroicon name="x-mark" size={18} />
          </button>
        </div>
      </div>

      <!-- Navigation Sections -->
      <nav aria-label="Workspace Pages">
        {navSections.map((section) => (
          <div class="dash-nav-group">
            <div class="dash-nav-heading">{section.group}</div>
            <ul class="dash-nav-list" aria-label={section.group}>
              {section.items.map((item) => {
                const active = isItemActive(item.href, item.exact);
                const current = isCurrentPage(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      class={`dash-nav-link ${active ? "active" : ""}`}
                      aria-current={current ? "page" : undefined}
                      data-astro-prefetch="hover"
                    >
                      <div class="dash-nav-link-left">
                        {item.iconSrc ? (
                          <span
                            class="dash-nav-icon dash-nav-icon--mask"
                            style={`--icon-src: url(${item.iconSrc});`}
                            aria-hidden="true"
                          />
                        ) : (
                          <Heroicon name={item.icon} size={16} class="dash-nav-icon" />
                        )}
                        <span>{item.label}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>
    </div>

  </div>
</aside>
