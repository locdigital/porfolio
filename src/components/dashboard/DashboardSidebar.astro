---
import avatar from "../../assets/avatar.webp";
import SidebarIcon from "./SidebarIcon.astro";
import { 
  X,
  LinkedIn,
  Instagram,
  Pexels,
  type MajesticonName,
} from "../icons/majesticons";

interface Props {
  currentPath?: string;
  locale?: string;
}

const {
  currentPath = Astro.url.pathname,
} = Astro.props;

const normalizePath = (path: string) => {
  if (path === "/" || path === "") return "/";
  return path.endsWith("/") ? path.slice(0, -1) : path;
};

const activePath = normalizePath(currentPath);

interface NavItem {
  label: string;
  href: string;
  icon: MajesticonName;
  exact?: boolean;
}

interface NavSection {
  group: string;
  items: NavItem[];
}

const navSections: NavSection[] = [
  {
    group: "Workspace",
    items: [
      { label: "Overview", href: "/", icon: "home-simple", exact: true },
      { label: "About", href: "/about", icon: "user" },
      { label: "Work", href: "/work", icon: "suitcase" },
      { label: "Services", href: "/services", icon: "layout-grid-2" },
    ],
  },
  {
    group: "Personal",
    items: [
      { label: "Writing", href: "/writing", icon: "note-text" },
      { label: "Photography", href: "/photos", icon: "image" },
      { label: "Gear", href: "/gear", icon: "monitor" },
      { label: "Contact", href: "/contact", icon: "mail" },
    ],
  },
];

const isItemActive = (href: string, exact?: boolean) => {
  const normHref = normalizePath(href);
  if (exact || normHref === "/") {
    return activePath === normHref;
  }
  return activePath.startsWith(normHref);
};

const isCurrentPage = (href: string) => activePath === normalizePath(href);
---

<!-- Mobile Drawer Backdrop -->
<div id="dash-drawer-backdrop" class="dash-drawer-backdrop" aria-hidden="true"></div>

<!-- Sidebar Container -->
<aside id="dash-sidebar" class="workspace-sidebar" aria-label="Workspace Navigation">
  <div class="workspace-sidebar-inner">
    
    <div>
      <!-- Top Identity Block -->
      <div class="dash-sidebar-header">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <a href="/" class="dash-user-row" aria-label="Phuc Loc Nguyen Home">
            <img 
              src={avatar.src}
              alt="Nguyen Phuc Loc" 
              class="dash-user-avatar"
              width="28"
              height="28"
              decoding="async"
            />
            <div>
              <div class="dash-user-name">Phuc Loc Nguyen</div>
              <div class="dash-user-meta">Personal workspace</div>
            </div>
          </a>

          <!-- Mobile Close Button -->
          <button 
            id="dash-drawer-close" 
            class="mobile-menu-btn" 
            aria-label="Close navigation menu"
            style="display:none;"
          >
            <X size={18} />
          </button>
        </div>
      </div>

      <!-- Navigation Sections -->
      <nav aria-label="Workspace Pages">
        {navSections.map((section) => (
          <div class="dash-nav-group">
            <div class="dash-nav-heading">{section.group}</div>
            <ul class="dash-nav-list" aria-label={section.group}>
              {section.items.map((item) => {
                const active = isItemActive(item.href, item.exact);
                const current = isCurrentPage(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      class={`dash-nav-link ${active ? "active" : ""}`}
                      aria-current={current ? "page" : undefined}
                      data-astro-prefetch
                    >
                      <div class="dash-nav-link-left">
                        <SidebarIcon name={item.icon} />
                        <span>{item.label}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- Sidebar Footer -->
    <div class="dash-sidebar-footer">
      <!-- Saigon Timezone -->
      <div style="margin-bottom:var(--space-2);">
        <span style="font-size:var(--text-micro);color:var(--dash-muted);">Saigon · GMT+7</span>
      </div>

      <!-- Direct Email Link -->
      <div>
        <a 
          href="mailto:hi@loc.digital" 
          class="dash-sidebar-email"
        >
          hi@loc.digital
        </a>
      </div>

      <!-- Social Links Row -->
      <div style="display:flex;align-items:center;gap:12px;margin-top:4px;">
        <a 
          href="https://www.linkedin.com/in/phucloc" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="color:var(--dash-muted);text-decoration:none;"
          title="LinkedIn"
          aria-label="LinkedIn Profile"
        >
          <LinkedIn size={16} strokeWidth={1.8} className="dash-social-icon" aria-hidden="true" focusable="false" />
        </a>
        <a 
          href="https://www.instagram.com/henrygoodkid" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="color:var(--dash-muted);text-decoration:none;"
          title="Instagram"
          aria-label="Instagram Profile"
        >
          <Instagram size={16} strokeWidth={1.8} className="dash-social-icon" aria-hidden="true" focusable="false" />
        </a>
        <a 
          href="https://www.pexels.com/@henrygoodkid" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="color:var(--dash-muted);text-decoration:none;"
          title="Pexels Photography"
          aria-label="Pexels Photography"
        >
          <Pexels size={16} strokeWidth={1.8} className="dash-social-icon" aria-hidden="true" focusable="false" />
        </a>
      </div>
    </div>

  </div>
</aside>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";

  onPageLoad(() => {
    const closeBtn = document.getElementById("dash-drawer-close");
    const sidebar = document.getElementById("dash-sidebar");
    if (!sidebar) return;

    if (window.innerWidth < 1024 && closeBtn) {
      closeBtn.style.display = "flex";
    }
  });
</script>
