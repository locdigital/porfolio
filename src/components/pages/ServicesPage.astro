</DashboardLayout>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const scroller = document.querySelector<HTMLElement>("[data-capabilities-scroller]");
    const previous = document.querySelector<HTMLButtonElement>("[data-capabilities-previous]");
    const next = document.querySelector<HTMLButtonElement>("[data-capabilities-next]");

    if (!scroller || !previous || !next) return;

    const getScrollStep = () => {
      const card = scroller.querySelector<HTMLElement>(".service-capability-card");
      const gap = Number.parseFloat(getComputedStyle(scroller).columnGap || "0");
      return (card?.getBoundingClientRect().width ?? scroller.clientWidth * 0.85) + gap;
    };

    const updateNavigation = () => {
      const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
      previous.disabled = scroller.scrollLeft <= 2;
      next.disabled = scroller.scrollLeft >= maxScrollLeft - 2;
    };

    previous.addEventListener("click", () => {
      scroller.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    }, { signal });

    next.addEventListener("click", () => {
      scroller.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    }, { signal });

    scroller.addEventListener("scroll", updateNavigation, { passive: true, signal });
    window.addEventListener("resize", updateNavigation, { passive: true, signal });
    updateNavigation();
  });
</script>

