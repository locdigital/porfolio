---
import Layout from "../layouts/Layout.astro";
import { Download } from "lucide-react";

export const prerender = true;

const pageTitle = "Download Extension | Agent by Henry";
const downloadUrl = "/downloads/workflow-extension.zip";
---

<Layout
  title={pageTitle}
  hideHeader={true}
  hideFooter={true}
>
  <main class="min-h-screen flex items-center justify-center px-4 py-8 bg-[#FAF8EE]">
    <div class="w-full max-w-sm bg-white border border-[#E5E5E0] rounded-xl p-6 shadow-sm font-medium text-[#1C1917]">
      
      <!-- TITLE & SUBTITLE -->
      <h1 class="text-lg font-medium text-[#1C1917] tracking-tight mb-1 text-center">
        Agent by Henry
      </h1>
      <p class="text-xs font-normal text-[#78716C] mb-5 text-center leading-relaxed">
        Tiện ích mở rộng nội bộ hỗ trợ quy trình làm việc (Manifest V3)
      </p>

      <!-- DOWNLOAD BUTTON -->
      <a 
        href={downloadUrl} 
        download="extension.zip"
        class="flex items-center justify-center gap-2 w-full bg-[#1C1917] hover:bg-black text-white py-2.5 px-4 rounded-lg text-sm font-medium transition-colors"
      >
        <Download className="w-4 h-4" />
        <span>Tải file ZIP</span>
      </a>

    </div>
  </main>
</Layout>
