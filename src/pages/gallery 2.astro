---
import Layout from "../layouts/Layout.astro";
import { locations } from "../lib/locations";
import { MASONRY_GRID_SIZES, optimizePhotos } from "../lib/photo-assets";

// Flatten all photos from all locations
const allPhotos = locations.flatMap(loc =>
  loc.photos.map((photo, i) => ({
    ...photo,
    alt: `${loc.name} — photo ${i + 1}`
  }))
);

// Deduplicate photos by src
const uniqueRawPhotos = Array.from(
  new Map(allPhotos.map(p => [p.src, p])).values()
);

const uniquePhotos = await optimizePhotos(uniqueRawPhotos, {
  previewWidth: 520,
  previewWidths: [240, 360, 520, 760],   // tighter — masonry columns max ~520px each
  previewSizes: MASONRY_GRID_SIZES,
  fullQuality: 75,
  withWebpFallback: true,
});
---

<Layout title="Gallery — Phuc Loc Nguyen">
  <main class="gallery-page">
    <div id="gallery-grid" class="gallery-grid"></div>
    <div id="loading-trigger" style="height:1px;width:100%;"></div>
  </main>

  <!-- Auto-scroll toggle button -->
  <button id="scroll-toggle" class="hidden" aria-label="Toggle auto scroll" title="Click to pause / resume auto scroll"></button>

  <style>
    /* Hide scrollbar on gallery page only */
    :global(html), :global(body) {
      scrollbar-width: none;        /* Firefox */
      -ms-overflow-style: none;     /* IE / Edge legacy */
    }
    :global(html)::-webkit-scrollbar,
    :global(body)::-webkit-scrollbar {
      display: none;                /* Chrome / Safari / Opera */
    }

    .gallery-page {
      min-height: 100vh;
      background: #fdfdfd;
      padding: 8px;
      padding-top: 80px;
      width: 100%;
      margin: 0;
    }

    .gallery-grid {
      display: flex;
      gap: 3px;
      width: 100%;
      align-items: flex-start;
    }

    :global(.gallery-col) {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    :global(.gal-item) {
      width: 100%;
      overflow: hidden;
      border-radius: 4px;
      background: #ddd;
    }

    /* The aspect-ratio box — padding-bottom locks each image to its real ratio */
    :global(.gal-item .ratio-box) {
      position: relative;
      width: 100%;
      height: 0;
      overflow: hidden;
    }

    :global(.gal-item .ratio-box img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    :global(.gal-item:hover .ratio-box img) {
      transform: scale(1.04);
    }

    /* Auto-scroll toggle dot button */
    #scroll-toggle {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 200;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: none;
      background: #0075de;
      cursor: pointer;
      padding: 0;
      box-shadow: 0 0 0 3px rgba(0, 117, 222, 0.25);
      transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.15s ease;
      animation: pulse 2s ease-in-out infinite;
    }

    #scroll-toggle.hidden {
      opacity: 0;
      pointer-events: none;
    }

    #scroll-toggle:hover {
      transform: scale(1.35);
      box-shadow: 0 0 0 5px rgba(0, 117, 222, 0.2);
    }

    /* Paused state — muted grey dot */
    #scroll-toggle.paused {
      background: rgba(180, 180, 180, 0.6);
      box-shadow: 0 0 0 3px rgba(180, 180, 180, 0.15);
      animation: none;
    }

    #scroll-toggle.paused:hover {
      box-shadow: 0 0 0 5px rgba(180, 180, 180, 0.2);
    }

    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 3px rgba(0, 117, 222, 0.25); }
      50%       { box-shadow: 0 0 0 6px rgba(0, 117, 222, 0.08); }
    }
  </style>

  <script is:inline define:vars={{ uniquePhotos }}>
    (function () {
      var photos = uniquePhotos;
      var grid = document.getElementById('gallery-grid');
      var trigger = document.getElementById('loading-trigger');
      var cols = 6;
      var colEls = [];
      var colH = [];   // logical height tracker (sum of h/w ratios)

      function numCols() {
        var w = window.innerWidth;
        if (w < 600) return 2;
        if (w < 900) return 3;
        if (w < 1200) return 4;
        return 6;
      }

      function initCols() {
        if (!grid) return;
        grid.innerHTML = '';
        colEls = [];
        colH = [];
        cols = numCols();
        for (var i = 0; i < cols; i++) {
          var c = document.createElement('div');
          c.className = 'gallery-col';
          grid.appendChild(c);
          colEls.push(c);
          colH.push(0);
        }
      }

      function addPhotos(list) {
        for (var i = 0; i < list.length; i++) {
          var photo = list[i];

          // find shortest column
          var min = 0;
          for (var j = 1; j < cols; j++) {
            if (colH[j] < colH[min]) min = j;
          }

          var pw = photo.w || 1280;
          var ph = photo.h || 853;
          var ratio = ph / pw;                    // e.g. portrait → 1.5, landscape → 0.667
          var pb = (ratio * 100).toFixed(3) + '%'; // padding-bottom %

          var item = document.createElement('div');
          item.className = 'gal-item';

          var box = document.createElement('div');
          box.className = 'ratio-box';
          box.style.paddingBottom = pb;          // ← this locks in natural height

          var img = document.createElement('img');
          img.src = photo.previewSrc;
          img.srcset = photo.previewSrcSet;
          img.sizes = photo.previewSizes;
          img.alt = photo.alt;
          img.loading = 'lazy';
          img.decoding = 'async';
          img.width = photo.previewWidth;
          img.height = photo.previewHeight;

          box.appendChild(img);
          item.appendChild(box);
          colEls[min].appendChild(item);

          colH[min] += ratio;   // accumulate logical height
        }
      }

      // Run immediately (script is deferred by is:inline)
      initCols();
      addPhotos(photos);

      // Infinite scroll
      if (trigger) {
        var io = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            addPhotos(photos);
          }
        }, { rootMargin: '800px' });
        io.observe(trigger);
      }

      // Responsive reflow
      var resizeT;
      window.addEventListener('resize', function () {
        clearTimeout(resizeT);
        resizeT = setTimeout(function () {
          var n = numCols();
          if (n !== cols) {
            initCols();
            addPhotos(photos);
          }
        }, 250);
      });

      /* ── Infinite Auto-scroll ─────────────────────────────────────
         • Drifts down at ~0.8 px/frame — never stops on its own
         • Uses virtualY accumulator to avoid sub-pixel rounding issues
         • behavior:'instant' bypasses CSS scroll-behavior:smooth
         • Only pauses briefly (1.5s) when user actively wheels/touches
         • prefers-reduced-motion: fully disabled
      ──────────────────────────────────────────────────────────── */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var SPEED = 0.8;       // px per rAF frame (~48 px/s at 60 fps)
      var virtualY = 0;      // sub-pixel accumulator
      var paused = false;
      var btn = document.getElementById('scroll-toggle');

      // Bypass CSS scroll-behavior:smooth
      document.documentElement.style.scrollBehavior = 'auto';

      function tick() {
        if (!paused) {
          virtualY += SPEED;
          window.scrollTo({ top: Math.floor(virtualY), behavior: 'instant' });
        }
        requestAnimationFrame(tick);
      }

      // Click dot → toggle pause / resume
      if (btn) {
        btn.addEventListener('click', function () {
          paused = !paused;
          if (paused) {
            btn.classList.add('paused');
            btn.title = 'Click to resume auto scroll';
          } else {
            // Sync virtualY so we resume from current position
            virtualY = window.scrollY;
            btn.classList.remove('paused');
            btn.title = 'Click to pause auto scroll';
          }
        });
      }

      // Start after first paint
      setTimeout(function () {
        virtualY = window.scrollY;
        requestAnimationFrame(tick);
        if (btn) btn.classList.remove('hidden');
      }, 600);
    })();
  </script>
</Layout>
