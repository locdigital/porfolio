  },
  {
    company: "Đi Làm Đừng Đi Lầm",
    role: "Co-Founder & Community Lead",
    period: "2023 — Present",
    type: "Career Guidance Community",
    location: "Vietnam",
    description: "Co-led a career community for early professionals, shaping content, audience growth, and practical guidance around first jobs and workplace decisions.",
    achievements: [
      "Scaled community to 1,000,000+ members within 12 months.",
