    title: "Analytics & Tracking Architecture",
    items: ["GA4 Server-Side GTM", "Custom Event Schema", "Looker Studio Dashboards", "Attribution Modeling", "Funnel Drop-off Auditing"]
  },
  {
    title: "Conversion Rate Optimization (CRO)",
    items: ["Astro/React Headless Landing Pages", "Cart Drawer Optimization", "A/B Testing Loops", "Creative Angle Testing", "Checkout Friction Elimination"]
  },
  {
    title: "Community & Creator Strategy",
    items: ["KOC/Creator Booking Briefs", "Viral Organic Loops", "Advocacy & Forum Seeding", "Sentiment Management", "Campus Partnership Outreach"]
