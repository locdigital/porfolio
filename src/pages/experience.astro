];
---

<DashboardLayout
  title="Experience — Phuc Loc Nguyen"
  pageTitle="Experience"
  description="Career timeline, employment history, and technical competencies of Nguyen Phuc Loc across 8 companies and platforms."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Experience" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Experience</h1>
    <p class="page-lead">
      A chronological record of performance marketing, technical SEO, and community leadership roles across Southeast Asia.
    </p>

    <!-- Academic Honors Callout -->
    <div class="dash-callout">
      <div class="dash-callout-icon">
        <GraduationCap size={18} aria-hidden="true" />
      </div>
      <div class="dash-callout-content">
        <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
          <div style="font-weight: 600; color: var(--dash-text);">FPT University (Đại học FPT)</div>
          <span style="font-size: 0.75rem; color: var(--dash-muted);">2019 — 2023 · Ho Chi Minh City</span>
        </div>
        <div style="font-size: 0.8125rem; font-weight: 500; color: var(--dash-accent); margin: 2px 0 6px;">
          Bachelor of Digital Marketing · Graduated with Honors (Tốt nghiệp Loại Xuất sắc)
        </div>
        <p style="margin: 0; font-size: 0.8125rem; color: var(--dash-muted); line-height: 1.55;">
          Cumulative GPA: <strong style="color: var(--dash-text);">9.4 / 10</strong>. Specialization in digital marketing economics, customer acquisition modeling, and media data analytics.
        </p>
      </div>
    </div>
  </header>

  <!-- Employment Timeline -->
  <section id="career-timeline" class="page-section" aria-label="Chronological Employment History">
    <h2 class="section-title">Career timeline</h2>

    <div style="display: flex; flex-direction: column; gap: var(--space-8);">
      {experiences.map((exp) => (
        <article style="border-bottom: 1px solid var(--dash-border); padding-bottom: var(--space-6);">
          <!-- Top Row: Role, Company, Period -->
          <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 4px;">
            <div>
              <span style="font-size: 1.0625rem; font-weight: 600; color: var(--dash-text);">{exp.role}</span>
              <span style="color: var(--dash-muted); margin: 0 4px;">·</span>
              <span style="font-size: 0.9375rem; font-weight: 500; color: var(--dash-text);">{exp.company}</span>
            </div>
            <span style="font-size: 0.8125rem; color: var(--dash-muted); white-space: nowrap;">{exp.period}</span>
          </div>

          <div style="font-size: 0.75rem; color: var(--dash-muted); margin-bottom: 10px;">
            {exp.type} · {exp.location}
          </div>

          <!-- Description -->
          <p style="font-size: 0.875rem; line-height: 1.6; color: var(--dash-text); margin: 0 0 12px;">
            {exp.description}
          </p>

          <!-- Key Achievements -->
          <div style="margin-bottom: 12px; padding: 10px 14px; background: var(--dash-surface-subtle); border-radius: var(--radius-control); border: 1px solid var(--dash-border);">
            <div style="font-size: 0.75rem; font-weight: 600; color: var(--dash-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.04em;">
              Notable contributions
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
              {exp.achievements.map((ach) => (
                <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.8125rem; line-height: 1.5; color: var(--dash-text);">
                  <span class="dash-bullet" aria-hidden="true"></span>
                  <span>{ach}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tools Tags -->
          <div style="display: flex; flex-wrap: wrap; gap: 4px;">
            {exp.tools.map((t) => (
              <span class="dash-tag">{t}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Core Competencies -->
  <section id="skill-clusters" class="page-section" aria-label="Core Competencies">
    <h2 class="section-title">Specialized skill clusters</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
      {skillClusters.map((cluster) => (
        <div class="dash-card" style="padding: 16px;">
          <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--dash-text); margin: 0 0 10px;">
            {cluster.title}
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
            {cluster.items.map((item) => (
              <li style="display: flex; align-items: center; gap: 6px; font-size: 0.8125rem; color: var(--dash-muted);">
                <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--dash-control-border);"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</DashboardLayout>
