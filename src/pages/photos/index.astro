---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../../lib/content";
import GlassFolder from "../../components/ui/GlassFolder";
import { optimizePhotos } from "../../lib/photo-assets";
import { canonicalUrl, collectionPageSchema } from "../../lib/seo";
import photoUpdates from "../../../data/photo-updates.json";

export const prerender = true;

const updates = photoUpdates as Record<string, { updatedAt: string }>;
const updatedTime = (slug: string) => Date.parse(updates[slug]?.updatedAt ?? "") || 0;
const locations = (await getPhotoLocations()).sort((a, b) =>
  updatedTime(b.slug) - updatedTime(a.slug) || a.order - b.order
);

const regionLabels: Record<string, string> = {
  "Northern Vietnam": "North",
  "Central Highlands": "Highlands",
  "Central Vietnam": "Central",
  "South Central Coast": "Central",
  "Southern Vietnam": "South",
  "Mekong Delta": "South",
  "Miền Bắc": "North",
  "Tây Nguyên": "Highlands",
  "Miền Trung": "Central",
  "Nam Trung Bộ": "Central",
  "Miền Nam": "South",
  "Tây Nam Bộ": "South",
};

const regionGroupLabels: Record<string, string> = {
  "Northern Vietnam": "Northern Vietnam",
  "Central Vietnam": "Central Vietnam",
  "South Central Coast": "South Central Coast",
  "Central Highlands": "Central Highlands",
  "Southern Vietnam": "Southern Vietnam",
  "Mekong Delta": "Mekong Delta",
};

const enhancedLocations = await Promise.all(locations.map(async (loc) => {
  const region = loc.country && loc.country !== "Vietnam"
    ? "International"
    : regionLabels[loc.region || ""] || "Vietnam";

  const directoryGroup = loc.country && loc.country !== "Vietnam"
    ? "Southeast Asia (Outside Vietnam)"
    : regionGroupLabels[loc.region || ""] || "Vietnam";

  const photoCount = loc.photos?.length || 0;
  const images = loc.images || [];
  const rawHero = loc.heroImage?.src || images[0]?.src || "";
  const rawLeft = images[1]?.src || rawHero;
  const rawRight = images[2]?.src || images[0]?.src || rawHero;
  const previews = await optimizePhotos([rawHero, rawLeft, rawRight].filter(Boolean).map((src) => ({
    src,
    alt: "",
    w: 480,
    h: 360,
  })), {
    previewWidth: 480,
    previewWidths: [480],
  });
  const previewImages = previews.map((photo) => photo.previewSrc);
  const heroPhoto = previewImages[0] || "";

  return {
    ...loc,
    region,
    directoryGroup,
    photoCount,
    previewImages,
    heroPhoto,
  };
}));

const photosUrl = canonicalUrl("/photos");
const photosSchema = collectionPageSchema({
  url: photosUrl,
  title: "Photography & Travel Journals — Phuc Loc Nguyen",
  description: `First-hand travel photography and destination notes across ${locations.length} destinations in Vietnam and Southeast Asia.`,
  items: enhancedLocations.map((loc) => ({
    name: loc.name || loc.location,
    url: `/photos/${loc.slug}`,
    description: loc.seoDescription || loc.headline,
    image: loc.heroPhoto || undefined,
  })),
  breadcrumbId: `${photosUrl}#breadcrumbs`,
});
---

<DashboardLayout
  title="Photography — Phuc Loc Nguyen"
  pageTitle="Photography"
  description={`First-hand travel photography and field notes across ${locations.length} destinations in Vietnam and Southeast Asia: mountain passes, karst rivers, coastal towns, and street scenes.`}
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Photography" }]}
  maxWidthVariant="default"
  schema={photosSchema}
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Photography</h1>
    <p class="page-lead">
      Shot on whatever was in my pocket—Leica Q3, Nikon Zf, or iPhone. Visual notes and first-hand field reflections across {locations.length} destinations in Vietnam and Southeast Asia.
    </p>
  </header>

  <!-- Photos Views Container -->
  <div id="photos-views-wrapper" class="photos-views-wrapper">
    <!-- Glass folders show actual album previews between the panels. -->
    <div id="photos-grid" class="glass-folder-grid">
      {enhancedLocations.map((loc, idx) => {
        const folderProps = {
          label: loc.name || loc.location,
          meta: `${loc.photoCount} photos · ${loc.region}`,
          image: loc.heroPhoto || undefined,
          art: "none" as const,
          files: loc.previewImages.map((image, index) => ({
            name: `${loc.name || loc.location} — ${index + 1}`,
            image,
            href: `/photos/${loc.slug}`,
          })),
          href: `/photos/${loc.slug}`,
          action: "none" as const,
          appear: false,
          defaultWidth: 212,
          eager: idx < 8,
        };
        return (
          <div class="glass-folder-item" data-region={loc.region} data-href={`/photos/${loc.slug}`}>
            <GlassFolder {...folderProps} />
          </div>
        );
      })}
    </div>
  </div>
</DashboardLayout>

<style>
  .section-header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: var(--space-2);
  }

  .glass-folder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 48px 32px;
    padding: 16px 8px 52px;
  }

  .glass-folder-item {
    min-width: 0;
    position: relative;
  }

  .glass-folder-item:hover,
  .glass-folder-item:focus-within {
    z-index: 1;
  }

  .destination-groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .destination-group-card {
    padding: 18px 20px;
  }

  .destination-group-title {
    margin: 0 0 12px;
    font-size: var(--text-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    color: var(--dash-text);
  }

  .destination-group-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .destination-group-item {
    padding-top: 10px;
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .destination-group-item:first-child {
    padding-top: 0;
    border-top: none;
  }

  .destination-item-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .destination-item-link {
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    color: var(--dash-text);
  }

  .destination-item-count {
    font-size: var(--text-caption);
    color: var(--dash-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .destination-item-headline {
    margin: 2px 0 0;
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .destination-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }

  /* Mobile: keep the same GlassFolder grid in a 2-column layout. */
  @media (max-width: 768px) {
    .glass-folder-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
      padding: 8px 0 40px;
    }
  }

  @media (max-width: 359px) {
    .glass-folder-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const grid = document.getElementById("photos-grid");
    if (!grid) return;

    const FOLDER_BASE_WIDTH = 340;
    const items = Array.from(grid.querySelectorAll<HTMLElement>(".glass-folder-item"));

    const setFolderOpen = (root: HTMLElement, open: boolean) => {
      if (open) root.setAttribute("data-open", "true");
      else root.removeAttribute("data-open");

      const hit = root.querySelector<HTMLButtonElement>(".gf-hit");
      hit?.setAttribute("aria-expanded", String(open));

      const files = root.querySelector<HTMLElement>(".gf-files");
      if (files) files.inert = !open;
    };

    const closeAll = (except?: HTMLElement) => {
      items.forEach((item) => {
        const root = item.querySelector<HTMLElement>(".gf-root");
        if (root && root !== except && root.hasAttribute("data-open")) {
          setFolderOpen(root, false);
        }
      });
    };

    const ro = typeof ResizeObserver !== "undefined"
      ? new ResizeObserver((entries) => {
          for (const entry of entries) {
            const w = entry.contentRect.width;
            if (w > 0) {
              (entry.target as HTMLElement).style.setProperty("--gf-k", String(w / FOLDER_BASE_WIDTH));
            }
          }
        })
      : null;

    items.forEach((item) => {
      const root = item.querySelector<HTMLElement>(".gf-root");
      const hit = item.querySelector<HTMLButtonElement>(".gf-hit");
      const href = item.dataset.href;
      if (!root) return;

      const w = root.clientWidth;
      if (w > 0) root.style.setProperty("--gf-k", String(w / FOLDER_BASE_WIDTH));
      ro?.observe(root);

      let raf = 0;
      let px = 0;
      let py = 0;
      const write = () => {
        raf = 0;
        root.style.setProperty("--gf-px", px.toFixed(3));
        root.style.setProperty("--gf-py", py.toFixed(3));
      };

      root.addEventListener("pointermove", (e) => {
        if (e.pointerType === "touch") return;
        const r = root.getBoundingClientRect();
        if (!r.width || !r.height) return;
        px = ((e.clientX - r.left) / r.width) * 2 - 1;
        py = ((e.clientY - r.top) / r.height) * 2 - 1;
        if (!raf) raf = requestAnimationFrame(write);
      }, { signal });

      root.addEventListener("pointerleave", () => {
        px = 0;
        py = 0;
        if (!raf) raf = requestAnimationFrame(write);
      }, { signal });

      hit?.addEventListener("click", () => {
        const isOpen = root.hasAttribute("data-open");
        if (isOpen && href && window.matchMedia("(hover: none)").matches) {
          window.location.href = href;
          return;
        }
        closeAll(root);
        setFolderOpen(root, !isOpen);
      }, { signal });

      hit?.addEventListener("dblclick", () => {
        if (href) window.location.href = href;
      }, { signal });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAll();
    }, { signal });

    document.addEventListener("pointerdown", (e) => {
      const target = e.target as Node | null;
      if (target && !grid.contains(target)) {
        closeAll();
      } else if (target) {
        const openRoot = grid.querySelector<HTMLElement>(".gf-root[data-open]");
        if (openRoot && !openRoot.contains(target)) {
          setFolderOpen(openRoot, false);
        }
      }
    }, { signal });

    signal.addEventListener("abort", () => {
      ro?.disconnect();
    }, { once: true });
  });
</script>
