---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../../lib/cms";

export const prerender = true;

const locations = await getPhotoLocations();

// Group destinations by region:
const enhancedLocations = locations.map((loc) => {
  let region = "Vietnam";
  const slug = loc.slug;

  if (["singapore", "melaka", "kuala-lumpur", "bali", "thai-lan", "bangkok"].includes(slug)) {
    region = "International";
  } else if (["ha-giang"].includes(slug)) {
    region = "North";
  } else if (["da-lat", "bu-gia-map-dak-nong"].includes(slug)) {
    region = "Highlands";
  } else if (["hue", "da-nang", "hoi-an", "quy-nhon", "phu-yen", "nha-trang", "phu-quy-mui-ne"].includes(slug)) {
    region = "Central";
  } else {
    region = "South";
  }

  const cover = loc.heroImage?.src || loc.photos?.[0]?.src || "/og-image.jpg";
  const photoCount = loc.photos?.length || 0;

  return {
    ...loc,
    region,
    cover,
    photoCount
  };
});
---

<DashboardLayout
  title="Photography — Phuc Loc Nguyen"
  pageTitle="Photography"
  description="Visual records and field notes across Southeast Asia and Vietnam: landscapes, local scenes, and quiet travel moments."
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Photography" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Photography</h1>
    <p class="page-lead">
      Shot on whatever was in my pocket—Leica Q3, Nikon Zf, or iPhone. Visual notes and field reflections across {locations.length} destinations.
    </p>

    <!-- Regional Filter Chips -->
    <div 
      class="dash-filter-bar" 
      role="toolbar" 
      aria-label="Filter photo galleries by region"
      style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding-top: 4px;"
    >
      <button class="dash-filter-chip active" data-region="all" aria-pressed="true">All places ({locations.length})</button>
      <button class="dash-filter-chip" data-region="International" aria-pressed="false">International</button>
      <button class="dash-filter-chip" data-region="Central" aria-pressed="false">Central Coast</button>
      <button class="dash-filter-chip" data-region="Highlands" aria-pressed="false">Highlands & Trails</button>
      <button class="dash-filter-chip" data-region="North" aria-pressed="false">Northern Peaks</button>
      <button class="dash-filter-chip" data-region="South" aria-pressed="false">Mekong & Islands</button>
    </div>
  </header>

  <!-- Photo Albums Grid -->
  <div 
    id="photos-grid" 
    style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px;"
  >
    {enhancedLocations.map((loc) => (
      <article 
        class="dash-card photo-card-item" 
        data-region={loc.region}
        style="padding: 10px; display: flex; flex-direction: column; justify-content: space-between;"
      >
        <div>
          <!-- 4:3 Cover Preview -->
          <a 
            href={`/photos/${loc.slug}`} 
            style="display: block; aspect-ratio: 4/3; border-radius: 6px; overflow: hidden; background: #EFEFED; border: 1px solid var(--dash-border); margin-bottom: 10px; position: relative;"
          >
            <img 
              src={loc.cover} 
              alt={loc.name || loc.location} 
              style="width: 100%; height: 100%; object-fit: cover;"
              loading="lazy"
            />
            <span style="position: absolute; bottom: 6px; right: 6px; background: rgba(0, 0, 0, 0.65); color: #fff; font-size: 0.6875rem; padding: 2px 6px; border-radius: 3px; font-variant-numeric: tabular-nums;">
              {loc.photoCount} photos
            </span>
          </a>

          <!-- Title -->
          <h2 class="item-title" style="margin: 4px 0 6px;">
            <a href={`/photos/${loc.slug}`} style="color: var(--dash-text); text-decoration: none;">
              {loc.name || loc.location}
            </a>
          </h2>

          <!-- Headline -->
          <p style="font-size: 0.8125rem; line-height: 1.5; color: var(--dash-muted); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            {loc.headline}
          </p>
        </div>

        <div style="border-top: 1px solid var(--dash-border); margin-top: 10px; padding-top: 8px; text-align: right;">
          <a 
            href={`/photos/${loc.slug}`} 
            class="dash-link"
            style="font-size: 0.75rem; font-weight: 500;"
          >
            View gallery →
          </a>
        </div>
      </article>
    ))}
  </div>
</DashboardLayout>

<script is:inline>
  function setupPhotoFilters() {
    const filterButtons = document.querySelectorAll(".dash-filter-chip");
    const photoItems = document.querySelectorAll(".photo-card-item");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const region = btn.getAttribute("data-region") || "all";
        
        photoItems.forEach((item) => {
          const itemRegion = item.getAttribute("data-region");
          if (region === "all" || itemRegion === region) {
            item.style.display = "flex";
          } else {
            item.style.display = "none";
          }
        });

        filterButtons.forEach((b) => {
          const isMatch = b === btn;
          b.classList.toggle("active", isMatch);
          b.setAttribute("aria-pressed", isMatch ? "true" : "false");
        });
      });
    });
  }

  document.addEventListener("astro:page-load", setupPhotoFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupPhotoFilters();
  }
</script>
