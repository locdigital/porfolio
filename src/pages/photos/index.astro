---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../../lib/cms";
import { Folder } from "../../components/icons/majesticons";
import ResponsiveImage from "../../components/ui/ResponsiveImage.astro";
import { optimizePhotos } from "../../lib/photo-assets";
import photoUpdates from "../../../data/photo-updates.json";

export const prerender = true;

const updates = photoUpdates as Record<string, { updatedAt: string }>;
const updatedTime = (slug: string) => Date.parse(updates[slug]?.updatedAt ?? "") || 0;
const locations = (await getPhotoLocations()).sort((a, b) =>
  updatedTime(b.slug) - updatedTime(a.slug) || a.order - b.order
);
const emptyPreviewImage = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'%3E%3C/svg%3E";

// Group destinations by region:
const enhancedLocations = await Promise.all(locations.map(async (loc) => {
  const regionLabels: Record<string, string> = {
    "Northern Vietnam": "North",
    "Central Highlands": "Highlands",
    "Central Vietnam": "Central",
    "South Central Coast": "Central",
    "Southern Vietnam": "South",
    "Mekong Delta": "South",
    "Miền Bắc": "North",
    "Tây Nguyên": "Highlands",
    "Miền Trung": "Central",
    "Nam Trung Bộ": "Central",
    "Miền Nam": "South",
    "Tây Nam Bộ": "South",
  };
  const region = loc.country && loc.country !== "Vietnam"
    ? "International"
    : regionLabels[loc.region || ""] || "Vietnam";

  const photoCount = loc.photos?.length || 0;
  const images = loc.images || [];
  const rawHero = loc.heroImage?.src || images[0]?.src || "";
  const rawLeft = images[1]?.src || rawHero;
  const rawRight = images[2]?.src || images[0]?.src || rawHero;
  const previews = await optimizePhotos([rawHero, rawLeft, rawRight].filter(Boolean).map((src) => ({
    src,
    alt: "",
    w: 240,
    h: 180,
  })), {
    previewWidth: 240,
    previewWidths: [240],
  });
  const previewImages = previews.map((photo) => photo.previewSrc);

  const heroPhoto = previewImages[0] || "";
  const leftPhoto = previewImages[1] || heroPhoto;
  const rightPhoto = previewImages[2] || heroPhoto;

  return {
    ...loc,
    region,
    photoCount,
    previewImages,
    heroPhoto,
    leftPhoto,
    rightPhoto,
  };
}));
---

<DashboardLayout
  title="Photography — Phuc Loc Nguyen"
  pageTitle="Photography"
  description="Visual records and field notes across Southeast Asia and Vietnam: landscapes, local scenes, and quiet travel moments."
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Photography" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Photography</h1>
    <p class="page-lead">
      Shot on whatever was in my pocket—Leica Q3, Nikon Zf, or iPhone. Visual notes and field reflections across {locations.length} destinations.
    </p>
  </header>

  <!-- Photos Views Container (Desktop: Grid, Mobile: List) -->
  <div id="photos-views-wrapper" class="photos-views-wrapper">
    <!-- 1. Manila Folder Grid View -->
    <div id="photos-grid" class="folder-grid">
      {enhancedLocations.map((loc) => (
        <div class="folder-item" data-region={loc.region}>
          <a
            href={`/photos/${loc.slug}`}
            class="folder-wrapper"
            data-folder-preview
            aria-label={`Open ${loc.name || loc.location} gallery`}
          >
            <!-- 3D MACOS FOLDER COMPONENT -->
            <div class="folder" data-folder-surface>
              <!-- 1. BACK FOLDER FLAP (Behind cards) -->
              <div class="folder-back" aria-hidden="true"></div>

              <!-- 2. FAN OF 3 PHOTO CARDS (Inside folder pocket) -->
              {loc.heroPhoto && (
                <div class="folder-cards" aria-hidden="true">
                  <div class="folder-card folder-card--left">
                    <img
                      src={emptyPreviewImage}
                      data-src={loc.leftPhoto}
                      width={240}
                      height={180}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                  <div class="folder-card folder-card--right">
                    <img
                      src={emptyPreviewImage}
                      data-src={loc.rightPhoto}
                      width={240}
                      height={180}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                  <div class="folder-card folder-card--center">
                    <img
                      src={emptyPreviewImage}
                      data-src={loc.heroPhoto}
                      width={240}
                      height={180}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                </div>
              )}

              <!-- 3. FRONT FOLDER FLAP (In front of cards) -->
              <div class="folder-front" aria-hidden="true"></div>
            </div>

            <!-- LOCATION NAME -->
            <div class="folder-caption">
              <span class="folder-title">{loc.name || loc.location}</span>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- 2. Clean List View -->
    <div id="photos-list" class="photos-list-container">
      <div class="photos-list-wrapper">
        {enhancedLocations.map((loc) => (
          <a
            href={`/photos/${loc.slug}`}
            class="photo-list-row"
            data-region={loc.region}
            aria-label={`Open ${loc.name || loc.location} gallery`}
          >
            <div class="photo-list-main">
              {loc.heroPhoto ? (
                <span class="photo-list-thumb" aria-hidden="true">
                  <ResponsiveImage
                    src={loc.photos[0]?.src || ""}
                    width={96}
                    height={96}
                    widths={[48, 96]}
                    sizes="48px"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : (
                <span class="photo-list-icon" aria-hidden="true">
                  <Folder size={17} aria-hidden="true" />
                </span>
              )}
              <div class="photo-list-info">
                <div class="photo-list-title-wrap">
                  <span class="photo-list-title">{loc.name || loc.location}</span>
                  <span class="dash-tag photo-list-tag">{loc.region}</span>
                </div>
                {loc.headline && (
                  <span class="photo-list-headline">{loc.headline}</span>
                )}
              </div>
            </div>

            <div class="photo-list-meta">
              <span class="photo-list-count">{loc.photoCount} photos</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .folder-wrapper {
    cursor: pointer;
  }

  /* ── 5-COLUMN MANILA FOLDER GRID (Default on Desktop) ── */
  .folder-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-column-gap: 16px;
    grid-row-gap: 48px;
    padding: 16px 0 52px;
  }

  .folder-grid .folder-item {
    justify-content: flex-start;
  }

  @media (max-width: 960px) {
    .folder-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-column-gap: 16px;
      grid-row-gap: 44px;
    }
  }

  @media (max-width: 768px) {
    .folder-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-column-gap: 16px;
      grid-row-gap: 40px;
    }
  }

  @media (max-width: 520px) {
    .folder-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-column-gap: 14px;
      grid-row-gap: 36px;
      padding-top: 0;
    }
  }

  @media (max-width: 340px) {
    .folder-grid {
      grid-template-columns: 1fr;
      grid-row-gap: 32px;
    }
  }

  /* ── LIST VIEW STYLING (Default on Mobile, Hidden on Desktop) ── */
  .photos-list-container {
    display: none;
    padding: 0 0 48px;
  }

  /* Mobile default: show list view instead of folder grid. */
  @media (max-width: 768px) {
    .folder-grid {
      display: none;
    }

    .photos-list-container {
      display: block;
    }
  }

  .photos-list-wrapper {
    display: flex;
    flex-direction: column;
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    border-radius: 10px;
    background: var(--dash-surface);
    overflow: hidden;
  }

  .photo-list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
    text-decoration: none !important;
    color: inherit;
    cursor: pointer;
    transition: background 140ms ease;
  }

  .photo-list-row:last-child {
    border-bottom: none;
  }

  .photo-list-row:hover {
    background: var(--dash-hover);
  }

  .photo-list-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .photo-list-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--dash-accent); /* macOS folder blue tone */
    flex-shrink: 0;
  }

  .photo-list-thumb {
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    overflow: hidden;
    flex: 0 0 48px;
    background: var(--dash-surface-subtle);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .photo-list-thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .photo-list-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .photo-list-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .photo-list-title {
    font-family: var(--font-family-base);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--dash-text);
    line-height: var(--leading-snug);
    transition: color 140ms ease;
  }

  .photo-list-row:hover .photo-list-title {
    color: var(--dash-accent);
  }

  .photo-list-tag {
    font-size: var(--text-micro);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .photo-list-headline {
    font-size: var(--text-caption);
    color: var(--dash-muted);
    line-height: var(--leading-compact);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 58ch;
  }

  .photo-list-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .photo-list-count {
    font-size: var(--text-caption);
    color: var(--dash-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .photo-list-headline {
      max-width: 32ch;
    }
  }

  @media (max-width: 540px) {
    .photo-list-row {
      padding: 10px 12px;
      gap: 10px;
    }

    .photo-list-main {
      gap: 10px;
    }

    .photo-list-headline {
      display: none;
    }

    .photo-list-thumb {
      width: 44px;
      height: 44px;
      flex-basis: 44px;
      border-radius: 7px;
    }
  }
</style>

<script>
  import "../../scripts/folder-previews";
</script>
