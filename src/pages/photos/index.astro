---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../../lib/cms";
import { Folder } from "../../components/icons/majesticons";

export const prerender = true;

const locations = await getPhotoLocations();
const emptyPreviewImage = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'%3E%3C/svg%3E";

// Group destinations by region:
const enhancedLocations = locations.map((loc) => {
  let region = "Vietnam";
  const slug = loc.slug;

  if (["singapore", "melaka", "kuala-lumpur", "bali", "thai-lan", "bangkok"].includes(slug)) {
    region = "International";
  } else if (["ha-giang"].includes(slug)) {
    region = "North";
  } else if (["da-lat", "bu-gia-map-dak-nong"].includes(slug)) {
    region = "Highlands";
  } else if (["hue", "da-nang", "hoi-an", "quy-nhon", "phu-yen", "nha-trang", "phu-quy-mui-ne"].includes(slug)) {
    region = "Central";
  } else {
    region = "South";
  }

  const photoCount = loc.photos?.length || 0;
  const previewImages = (loc.photos ?? [])
    .map((photo) => photo.src)
    .filter(Boolean)
    .slice(0, 24);

  const heroPhoto = previewImages[0] || "";
  const leftPhoto = previewImages[1] || heroPhoto;
  const rightPhoto = previewImages[2] || previewImages[1] || heroPhoto;

  return {
    ...loc,
    region,
    photoCount,
    previewImages,
    heroPhoto,
    leftPhoto,
    rightPhoto,
  };
});
---

<DashboardLayout
  title="Photography — Phuc Loc Nguyen"
  pageTitle="Photography"
  description="Visual records and field notes across Southeast Asia and Vietnam: landscapes, local scenes, and quiet travel moments."
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Photography" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Photography</h1>
    <p class="page-lead">
      Shot on whatever was in my pocket—Leica Q3, Nikon Zf, or iPhone. Visual notes and field reflections across {locations.length} destinations.
    </p>
  </header>

  <!-- Photos Views Container (Desktop: Grid, Mobile: List) -->
  <div id="photos-views-wrapper" class="photos-views-wrapper">
    <!-- 1. Manila Folder Grid View -->
    <div id="photos-grid" class="folder-grid">
      {enhancedLocations.map((loc) => (
        <div class="folder-item" data-region={loc.region}>
          <a
            href={`/photos/${loc.slug}`}
            class="folder-wrapper"
            data-preview-images={JSON.stringify(loc.previewImages)}
            aria-label={`Open ${loc.name || loc.location} gallery`}
          >
            <!-- 3D MACOS FOLDER COMPONENT -->
            <div class="folder" data-folder-surface>
              <!-- 1. BACK FOLDER FLAP (Behind cards) -->
              <div class="folder-back" aria-hidden="true"></div>

              <!-- 2. FAN OF 3 PHOTO CARDS (Inside folder pocket) -->
              {loc.heroPhoto && (
                <div class="folder-cards" aria-hidden="true">
                  <div class="folder-card folder-card--left">
                    <img
                      src={emptyPreviewImage}
                      data-src={loc.leftPhoto}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                  <div class="folder-card folder-card--right">
                    <img
                      src={emptyPreviewImage}
                      data-src={loc.rightPhoto}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                  <div class="folder-card folder-card--center">
                    <img
                      src={emptyPreviewImage}
                      data-src={loc.heroPhoto}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                </div>
              )}

              <!-- 3. FRONT FOLDER FLAP (In front of cards) -->
              <div class="folder-front" aria-hidden="true"></div>
            </div>

            <!-- LOCATION NAME -->
            <div class="folder-caption">
              <span class="folder-title">{loc.name || loc.location}</span>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- 2. Clean List View -->
    <div id="photos-list" class="photos-list-container">
      <div class="photos-list-wrapper">
        {enhancedLocations.map((loc) => (
          <a
            href={`/photos/${loc.slug}`}
            class="photo-list-row"
            data-region={loc.region}
            aria-label={`Open ${loc.name || loc.location} gallery`}
          >
            <div class="photo-list-main">
              {loc.heroPhoto ? (
                <span class="photo-list-thumb" aria-hidden="true">
                  <img
                    src={loc.heroPhoto}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : (
                <span class="photo-list-icon" aria-hidden="true">
                  <Folder size={17} aria-hidden="true" />
                </span>
              )}
              <div class="photo-list-info">
                <div class="photo-list-title-wrap">
                  <span class="photo-list-title">{loc.name || loc.location}</span>
                  <span class="dash-tag photo-list-tag">{loc.region}</span>
                </div>
                {loc.headline && (
                  <span class="photo-list-headline">{loc.headline}</span>
                )}
              </div>
            </div>

            <div class="photo-list-meta">
              <span class="photo-list-count">{loc.photoCount} photos</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  /* Reduce gap below header to album content to ~16-24px (20px) */
  .page-header {
    margin-bottom: 20px;
  }

  .folder-wrapper {
    cursor: pointer;
  }

  /* ── 5-COLUMN MANILA FOLDER GRID (Default on Desktop) ── */
  .folder-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-column-gap: 20px;
    grid-row-gap: 48px;
    padding: 0 0 52px;
  }

  @media (max-width: 960px) {
    .folder-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-column-gap: 18px;
      grid-row-gap: 44px;
    }
  }

  @media (max-width: 768px) {
    .folder-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-column-gap: 16px;
      grid-row-gap: 40px;
    }
  }

  @media (max-width: 520px) {
    .folder-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-column-gap: 14px;
      grid-row-gap: 36px;
      padding-top: 0;
    }
  }

  @media (max-width: 340px) {
    .folder-grid {
      grid-template-columns: 1fr;
      grid-row-gap: 32px;
    }
  }

  /* ── HOVER BRIDGE (Keeps folder open while admiring fanned cards) ── */
  .folder-wrapper::before {
    content: "";
    position: absolute;
    top: -85px;
    left: -32px;
    right: -32px;
    bottom: 0;
    pointer-events: none;
    z-index: 10;
  }

  .folder-wrapper:hover::before,
  .folder-wrapper:focus-visible::before {
    pointer-events: auto;
  }

  /* ── 3-CARD FAN OUT PHOTO SYSTEM ── */
  .folder-cards {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .folder-card {
    --card-radius: 8px;
    --card-inset: 3px;
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: clamp(84px, 22vw, 100px);
    aspect-ratio: 4 / 3;
    padding: var(--card-inset);
    background: #ffffff;
    border: var(--dash-border-width, 0.9px) solid var(--dash-border, #00000014);
    border-radius: var(--card-radius);
    box-shadow:
      0 12px 28px -4px rgba(0, 0, 0, 0.16),
      0 4px 10px rgba(0, 0, 0, 0.08);
    transform-origin: bottom center;
    opacity: 0;
    filter: blur(2px);
    pointer-events: none;
    will-change: transform, opacity, filter;
    transition:
      transform 320ms var(--ease-smooth-out),
      opacity 220ms var(--ease-smooth-out),
      filter 220ms var(--ease-smooth-out),
      box-shadow 320ms var(--ease-smooth-out);
  }

  .folder-card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: max(0px, calc(var(--card-radius) - var(--card-inset)));
  }

  /* Resting: tucked inside the folder pocket between back and front flaps */
  .folder-card--left,
  .folder-card--center,
  .folder-card--right {
    transform: translate(-50%, 16px) scale(0.72) rotate(0deg);
    opacity: 0;
    filter: blur(2px);
  }

  /* 1. Center Card: jumps out tallest from inside the folder */
  .folder-card--center {
    z-index: 3;
  }

  .folder-wrapper:hover .folder-card--center,
  .folder-wrapper:focus-visible .folder-card--center {
    transform: translate(-50%, -64px) rotate(-1.5deg);
    opacity: 1;
    filter: blur(0px);
    box-shadow:
      0 18px 36px -6px rgba(0, 0, 0, 0.22),
      0 6px 14px rgba(0, 0, 0, 0.1);
    transition:
      transform 520ms var(--ease-smooth-out) 20ms,
      opacity 260ms var(--ease-smooth-out) 20ms,
      filter 260ms var(--ease-smooth-out) 20ms,
      box-shadow 520ms var(--ease-smooth-out) 20ms;
  }

  /* 2. Left Card: jumps out and fans to the left */
  .folder-card--left {
    z-index: 2;
  }

  .folder-wrapper:hover .folder-card--left,
  .folder-wrapper:focus-visible .folder-card--left {
    transform: translate(calc(-50% - 30px), -50px) rotate(-15deg) scale(0.96);
    opacity: 1;
    filter: blur(0px);
    transition:
      transform 540ms var(--ease-smooth-out) 60ms,
      opacity 260ms var(--ease-smooth-out) 60ms,
      filter 260ms var(--ease-smooth-out) 60ms;
  }

  /* 3. Right Card: jumps out and fans to the right */
  .folder-card--right {
    z-index: 2;
  }

  .folder-wrapper:hover .folder-card--right,
  .folder-wrapper:focus-visible .folder-card--right {
    transform: translate(calc(-50% + 30px), -46px) rotate(13deg) scale(0.96);
    opacity: 1;
    filter: blur(0px);
    transition:
      transform 560ms var(--ease-smooth-out) 100ms,
      opacity 260ms var(--ease-smooth-out) 100ms,
      filter 260ms var(--ease-smooth-out) 100ms;
  }

  /* Stacking priority when hovered */
  .folder-item:hover,
  .folder-wrapper:hover,
  .folder-wrapper:focus-visible {
    z-index: 25;
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-card {
      transition: none !important;
    }
    .folder-wrapper:hover .folder-card--left,
    .folder-wrapper:focus-visible .folder-card--left {
      transform: translate(calc(-50% - 30px), -50px) rotate(-15deg) scale(0.96);
    }
    .folder-wrapper:hover .folder-card--right,
    .folder-wrapper:focus-visible .folder-card--right {
      transform: translate(calc(-50% + 30px), -46px) rotate(13deg) scale(0.96);
    }
    .folder-wrapper:hover .folder-card--center,
    .folder-wrapper:focus-visible .folder-card--center {
      transform: translate(-50%, -64px) rotate(-1.5deg);
    }
  }

  /* ── LIST VIEW STYLING (Default on Mobile, Hidden on Desktop) ── */
  .photos-list-container {
    display: none;
    padding: 0 0 48px;
  }

  /* Mobile default: show list view instead of folder grid. */
  @media (max-width: 768px) {
    .folder-grid {
      display: none;
    }

    .photos-list-container {
      display: block;
    }
  }

  .photos-list-wrapper {
    display: flex;
    flex-direction: column;
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    border-radius: 10px;
    background: var(--dash-surface);
    overflow: hidden;
  }

  .photo-list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
    text-decoration: none !important;
    color: inherit;
    cursor: pointer;
    transition: background 140ms ease;
  }

  .photo-list-row:last-child {
    border-bottom: none;
  }

  .photo-list-row:hover {
    background: var(--dash-hover);
  }

  .photo-list-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .photo-list-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--dash-accent); /* macOS folder blue tone */
    flex-shrink: 0;
  }

  .photo-list-thumb {
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    overflow: hidden;
    flex: 0 0 48px;
    background: var(--dash-surface-subtle);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .photo-list-thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .photo-list-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .photo-list-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .photo-list-title {
    font-family: var(--font-sans);
    font-size: 0.875rem; /* 14px compact */
    font-weight: 600;
    color: var(--dash-text);
    line-height: 1.35;
    transition: color 140ms ease;
  }

  .photo-list-row:hover .photo-list-title {
    color: var(--dash-accent);
  }

  .photo-list-tag {
    font-size: 0.6875rem; /* 11px */
    padding: 1px 6px;
    border-radius: 4px;
  }

  .photo-list-headline {
    font-size: 0.8125rem; /* 13px */
    color: var(--dash-muted);
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 58ch;
  }

  .photo-list-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .photo-list-count {
    font-size: 0.75rem; /* 12px */
    color: var(--dash-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .photo-list-headline {
      max-width: 32ch;
    }
  }

  @media (max-width: 540px) {
    .photo-list-row {
      padding: 10px 12px;
      gap: 10px;
    }

    .photo-list-main {
      gap: 10px;
    }

    .photo-list-headline {
      display: none;
    }

    .photo-list-thumb {
      width: 44px;
      height: 44px;
      flex-basis: 44px;
      border-radius: 7px;
    }
  }
</style>

<script is:inline>
  function setupPhotoExperience() {
    // Clear older persisted manual view state. Layout is CSS-only:
    // desktop grid, mobile list.
    try {
      localStorage.removeItem("photos_view_preference");
      sessionStorage.removeItem("photos_view_override");
    } catch (_) {}

    if (window.matchMedia("(max-width: 768px)").matches) return;

    // 1. Folder Hover Preview Cycling
    document.querySelectorAll(".folder-wrapper[data-preview-images]").forEach((wrapper) => {
      if (wrapper.dataset.previewReady === "true") return;
      wrapper.dataset.previewReady = "true";

      let images = [];
      try {
        images = JSON.parse(wrapper.dataset.previewImages || "[]");
      } catch (_) {}

      if (images.length < 4) return;

      const centerImg = wrapper.querySelector(".folder-card--center img");
      const leftImg = wrapper.querySelector(".folder-card--left img");
      const rightImg = wrapper.querySelector(".folder-card--right img");
      if (!centerImg || !leftImg || !rightImg) return;

      const hydratePreviewImage = (img) => {
        const previewSrc = img.dataset.src;
        if (previewSrc && img.getAttribute("src") !== previewSrc) {
          img.src = previewSrc;
        }
      };

      hydratePreviewImage(centerImg);
      hydratePreviewImage(leftImg);
      hydratePreviewImage(rightImg);

      const preloadImage = (src) => {
        if (!src) return Promise.resolve();
        const img = new Image();
        img.src = src;
        if (img.decode) {
          return img.decode().catch(() => {});
        }
        return new Promise((resolve) => {
          img.onload = resolve;
          img.onerror = resolve;
        });
      };

      images.slice(0, 6).forEach((src) => {
        preloadImage(src);
      });

      // On pointerleave, prep the next set of distinct images for the next time the folder opens
      let currentIndex = 0;
      wrapper.addEventListener("pointerleave", () => {
        currentIndex = (currentIndex + 3) % images.length;
        const nextCenter = images[currentIndex];
        const nextLeft = images[(currentIndex + 1) % images.length];
        const nextRight = images[(currentIndex + 2) % images.length];

        Promise.all([
          preloadImage(nextCenter),
          preloadImage(nextLeft),
          preloadImage(nextRight),
        ]).then(() => {
          centerImg.src = nextCenter;
          leftImg.src = nextLeft;
          rightImg.src = nextRight;
        });
      });
    });

    // Remove legacy persistent view state now that the layout switcher is gone.
    try {
      localStorage.removeItem("photos_view_preference");
      sessionStorage.removeItem("photos_view_override");
    } catch (_) {}
  }

  document.addEventListener("astro:page-load", setupPhotoExperience);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupPhotoExperience();
  }
</script>
