    if (!app) return;

    const canvasEl = document.getElementById("mp-canvas");
    const grid = document.getElementById("mp-grid");
    const gridView = document.getElementById("mp-grid-view");
    const yearsView = document.getElementById("mp-years-view");
    const monthsView = document.getElementById("mp-months-view");
    const albumsView = document.getElementById("mp-albums-view");
    const tripsView = document.getElementById("mp-trips-view");
    const mapView = document.getElementById("mp-map-view");
    const mapStatus = document.getElementById("mp-map-status");
    const mapStatusCopy = mapStatus?.querySelector<HTMLElement>("[data-map-status-copy]");
    const mapRetry = mapStatus?.querySelector<HTMLButtonElement>("[data-map-retry]");
    const canvasHead = document.querySelector<HTMLElement>(".mp-canvas-head");
    const footerEl = document.querySelector<HTMLElement>(".mp-footer");
    const segLibrary = document.getElementById("mp-seg-library");
    const timeBar = document.getElementById("mp-time-bar");
    const emptyEl = document.getElementById("mp-empty");
    const headingEl = document.getElementById("mp-heading");
    const subheadingEl = document.getElementById("mp-subheading");
    const filterWrap = document.getElementById("mp-filter-wrap");
    const filterTrigger = document.getElementById("mp-filter-trigger");
    const filterMenu = document.getElementById("mp-filter-menu");
    const filterLabel = document.getElementById("mp-filter-label");
    const filterMenuItems = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-val]"));
    const searchInput = document.getElementById("mp-search-input") as HTMLInputElement | null;
    const zoomSlider = document.getElementById("mp-zoom-slider") as HTMLInputElement | null;
    const zoomOutBtn = document.getElementById("mp-zoom-out");
    const zoomInBtn = document.getElementById("mp-zoom-in");
    const sidebarToggle = document.getElementById("mp-sidebar-toggle");
    const sidebarBackdrop = document.getElementById("mp-sidebar-backdrop");
    const infoToggle = document.getElementById("mp-info-toggle");
    const resetBtn = document.getElementById("mp-reset-btn");
    const mobileSidebarMq = window.matchMedia("(max-width: 820px)");

    const closeMobileSidebar = () => {
      app.classList.remove("mobile-sidebar-open");
      if (sidebarBackdrop) sidebarBackdrop.hidden = true;
      if (mobileSidebarMq.matches) {
        sidebarToggle?.setAttribute("aria-pressed", "false");
      }
    };

    const segButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("#mp-seg-library .mp-seg-btn"));
    const navButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".mp-nav-item"));
    const cells = Array.from(document.querySelectorAll<HTMLElement>(".mp-cell"));
    const folderItems = Array.from(document.querySelectorAll<HTMLElement>(".glass-folder-item"));
    const tripGroups = Array.from(document.querySelectorAll<HTMLElement>(".mp-trip-year-group"));

    let activeNav = "library";
    let activeFilter = "all";
    let activeQuery = "";
    let activeSeg: "all" | "years" | "months" = "all";
    let activeTimeValue = "all";
    let activeMapMode: MapMode = "map";
    let mapDestinations: MapDestination[] = [];
    let mapController: PhotosMapController | null = null;

    const setMapStatus = (state: "loading" | "ready" | "error" | "empty", message?: string) => {
      if (!mapView || !mapStatus) return;
      mapView.dataset.mapState = state;
      mapStatusCopy && (mapStatusCopy.textContent = message || (state === "loading" ? "Loading map…" : ""));
      mapRetry?.toggleAttribute("hidden", state !== "error");
      mapStatus.hidden = state === "ready";
    };

    const rawDestinations = mapView?.dataset.destinations;
    if (rawDestinations) {
      try {
        mapDestinations = JSON.parse(rawDestinations) as MapDestination[];
      } catch {
        mapDestinations = [];
      }
    }

    let mapLoading = false;
    const loadMap = async () => {
      if (mapLoading || mapController || !mapView) return;
      if (!mapDestinations.length) {
        setMapStatus("empty", "No photo locations are available yet.");
        return;
      }
      mapLoading = true;
      setMapStatus("loading", "Loading map…");
      try {
        const { createPhotosMap } = await import("../../scripts/photos-map");
        if (signal.aborted || activeNav !== "map") return;
        mapController = createPhotosMap({
          container: mapView,
          destinations: mapDestinations,
          onStateChange: setMapStatus,
          signal,
        });
        signal.addEventListener("abort", () => mapController?.destroy(), { once: true });
        applyState();
      } catch (err) {
        console.error("[photos-map] Failed to initialize map:", err);
        setMapStatus("error", "The interactive map could not be initialized. Try again.");
      } finally {
        mapLoading = false;
      }
    };

    mapRetry?.addEventListener("click", () => {
      if (mapController) mapController.retry();
      else void loadMap();
    }, { signal });

    const normalizeText = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[đĐ]/g, "d")
        .toLowerCase()
        .replace(/[-_/]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    const compileQuery = (rawQuery: string) => {
      const normQ = normalizeText(rawQuery);
      if (!normQ) return null;
      const tokens = normQ.split(" ").filter(Boolean);
      const aliasTarget = REGION_ALIASES[normQ] ? normalizeText(REGION_ALIASES[normQ]) : "";
      const compactAlias = aliasTarget ? aliasTarget.replace(/\s+/g, "") : "";
      return { tokens, aliasTarget, compactAlias };
    };

    const matchesCompiledQuery = (
      normHaystack: string,
      compactHaystack: string,
      compiled: ReturnType<typeof compileQuery>,
    ) => {
      if (!compiled) return true;
      if (compiled.tokens.every((token) => normHaystack.includes(token) || compactHaystack.includes(token))) {
        return true;
      }
      if (compiled.aliasTarget) {
        return normHaystack.includes(compiled.aliasTarget) || compactHaystack.includes(compiled.compactAlias);
      }
      return false;
    };

    const indexedCells = cells.map((el) => {
      const slug = el.dataset.slug || "";
      const region = el.dataset.region || "";
      const rawSearch = el.dataset.search || `${el.dataset.album || ""} ${region} ${el.dataset.title || ""} ${el.dataset.location || ""} ${slug}`;
      const normSearch = normalizeText(rawSearch);
      const img = el.querySelector<HTMLImageElement>("img");
      return {
        el,
        href: el.getAttribute("href") || `/photos/${slug}`,
        slug,
        region,
        albumLabel: el.dataset.albumLabel || "",
        featured: el.dataset.featured === "1",
        year: el.dataset.year || "Archive",
        date: el.dataset.date || "Archive",
        day: el.dataset.day || "",
        capturedTs: Number(el.dataset.capturedTs || 0),
        monthSort: Number(el.dataset.monthSort || 0),
        previewSrc: el.dataset.preview || img?.getAttribute("src") || "",
        previewSrcSet: el.dataset.srcset || img?.getAttribute("srcset") || "",
        alt: img?.getAttribute("alt") || el.dataset.title || "",
        normSearch,
        compactSearch: normSearch.replace(/\s+/g, ""),
      };
    });

    const indexedFolders = folderItems.map((el) => {
      const normSearch = normalizeText(el.dataset.search || el.dataset.album || "");
      return {
        el,
        region: el.dataset.region || "",
        normSearch,
        compactSearch: normSearch.replace(/\s+/g, ""),
      };
    });

    const indexedTripGroups = tripGroups.map((group) => ({
      group,
      countEl: group.querySelector<HTMLElement>("[data-trip-year-count]"),
      cards: Array.from(group.querySelectorAll<HTMLElement>(".mp-trip-card")).map((card) => {
        const normSearch = normalizeText(card.dataset.search || card.dataset.album || "");
        return {
          el: card,
          region: card.dataset.region || "",
          normSearch,
          compactSearch: normSearch.replace(/\s+/g, ""),
        };
      }),
    }));

    const indexedMapDestinations = mapDestinations.map((d) => {
      const normSearch = normalizeText(d.search);
      return {
        slug: d.slug,
        normSearch,
        compactSearch: normSearch.replace(/\s+/g, ""),
      };
    });

    const availableRegionNames = navButtons
      .map((btn) => btn.dataset.nav || "")
      .filter((nav) => nav.startsWith("region:"))
      .map((nav) => nav.slice(7));
    const availableAlbumSlugs = filterMenuItems
      .map((item) => item.dataset.filterVal || "")
      .filter((val) => val.startsWith("album:"))
      .map((val) => val.slice(6));
    const availableYears = Array.from(
      new Set(indexedCells.map((item) => item.year).filter(Boolean)),
    );
    const availableMonths = Array.from(
      new Set(indexedCells.map((item) => item.date).filter(Boolean)),
    );

    const syncUrlFromState = () => {
      const nextHash = getPhotosLibraryHash({
        nav: activeNav,
        seg: activeSeg,
        timeValue: activeTimeValue,
        filter: activeFilter,
      });
      const currentUrl = new URL(window.location.href);
      const nextLocalUrl = `${currentUrl.pathname}${currentUrl.search}${nextHash}`;
      if (`${window.location.pathname}${window.location.search}${window.location.hash}` !== nextLocalUrl) {
        window.history.replaceState(window.history.state, "", nextLocalUrl);
      }
      const cleanUrl = new URL(nextLocalUrl, window.location.origin);
      cleanUrl.searchParams.delete("embed");
      const publicUrl = `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`;
      window.dispatchEvent(new CustomEvent("photos:url-change", { detail: { url: publicUrl } }));
      if (window.self !== window.top) {
        window.parent.postMessage({ type: "photos:url-change", url: publicUrl }, window.location.origin);
      }
    };

    const syncFilterControls = () => {
      let labelText = "All Items";
      filterMenuItems.forEach((btn) => {
        const selected = (btn.dataset.filterVal || "all") === activeFilter;
        btn.classList.toggle("is-selected", selected);
        btn.setAttribute("aria-checked", String(selected));
        if (selected && btn.dataset.filterText) {
          labelText = btn.dataset.filterText;
        }
      });
      if (filterLabel) filterLabel.textContent = labelText;
    };

    const syncSegControls = () => {
      segButtons.forEach((btn) => {
        const isCurrent = ((btn.dataset.seg as "all" | "years" | "months") || "all") === activeSeg;
        btn.classList.toggle("is-active", isCurrent);
        btn.setAttribute("aria-selected", String(isCurrent));
      });
    };

    const applyHashFromLocation = () => {
      const parsed = parsePhotosLibraryHash(window.location.hash, {
        availableRegions: availableRegionNames,
        availableAlbumSlugs,
        availableTimeValues: { years: availableYears, months: availableMonths },
      });
      activeNav = parsed.nav;
      activeSeg = parsed.seg;
      activeTimeValue = parsed.timeValue;
      activeFilter = parsed.filter;
      syncSegControls();
      syncFilterControls();
    };

    let suppressUrlSync = false;

    const applyState = () => {
      if (!suppressUrlSync) {
        syncUrlFromState();
      }
      const compiledQ = compileQuery(activeQuery);
      const isMapNav = activeNav === "map";
      const isMapCanvas = isMapNav;
      const isTripsMode = !isMapNav && activeNav === "trips";
      const isAlbumsMode = !isMapNav && activeNav === "albums";

      const isCuratedTimeView = !isMapNav && !isTripsMode && !isAlbumsMode && (activeSeg === "years" || activeSeg === "months");

      app.classList.toggle("is-map-mode", isMapNav);
      app.classList.toggle("is-map-canvas", isMapCanvas);
      app.classList.toggle("is-curated-time", isCuratedTimeView);
      segLibrary?.classList.toggle("is-slot-hidden", isMapNav);
      segLibrary?.setAttribute("aria-hidden", String(isMapNav));
      if (filterWrap) filterWrap.hidden = isMapNav;
      if (canvasHead) canvasHead.hidden = isMapCanvas;
      if (footerEl) footerEl.hidden = isMapCanvas;
      if (mapView) mapView.hidden = !isMapCanvas;

      navButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.nav === activeNav);
      });

      if (isMapNav) {
        void loadMap();
        const matchingSlugs = compiledQ
          ? new Set(
              indexedMapDestinations
                .filter((d) => matchesCompiledQuery(d.normSearch, d.compactSearch, compiledQ))
                .map((d) => d.slug),
            )
          : null;
        mapController?.setMode(activeMapMode);
        mapController?.setVisible(isMapCanvas);
        mapController?.setFilteredSlugs(matchingSlugs);

        if (isMapCanvas) {
          if (gridView) gridView.hidden = true;
          if (tripsView) tripsView.hidden = true;
          if (albumsView) albumsView.hidden = true;
          return;
        }
      } else {
        mapController?.setVisible(false);
      }

      if (gridView) gridView.hidden = isTripsMode || isAlbumsMode;
      if (tripsView) tripsView.hidden = !isTripsMode;
      if (albumsView) albumsView.hidden = !isAlbumsMode;

      if (isTripsMode) {
        let visibleTrips = 0;
        const filterRegion = activeFilter.startsWith("region:") ? activeFilter.slice(7) : null;
        indexedTripGroups.forEach(({ group, countEl, cards }) => {
          let groupVisible = 0;
          cards.forEach((card) => {
            const matchFilter = !filterRegion || card.region === filterRegion;
            const show = matchFilter && matchesCompiledQuery(card.normSearch, card.compactSearch, compiledQ);
            if (card.el.hidden !== !show) card.el.hidden = !show;
            if (show) {
              groupVisible++;
              visibleTrips++;
            }
          });
          if (group.hidden !== (groupVisible === 0)) group.hidden = groupVisible === 0;
          if (countEl) {
            countEl.textContent = `${groupVisible} ${groupVisible === 1 ? "Trip" : "Trips"}`;
          }
        });
        if (headingEl) headingEl.textContent = "Trips";
        if (subheadingEl) subheadingEl.textContent = `${visibleTrips} ${visibleTrips === 1 ? "Trip" : "Trips"} by Year`;
        return;
      }

      if (isAlbumsMode) {
        let visibleAlbums = 0;
        const filterRegion = activeFilter.startsWith("region:") ? activeFilter.slice(7) : null;
        indexedFolders.forEach((item) => {
          const matchFilter = !filterRegion || item.region === filterRegion;
          const show = matchFilter && matchesCompiledQuery(item.normSearch, item.compactSearch, compiledQ);
          if (item.el.hidden !== !show) item.el.hidden = !show;
          if (show) visibleAlbums++;
        });
        if (headingEl) headingEl.textContent = "Albums";
        if (subheadingEl) subheadingEl.textContent = `${visibleAlbums} Destinations`;
        return;
      }

      // Remove any previously injected time group headers
      grid?.querySelectorAll(".mp-group-header").forEach((el) => el.remove());

      const navRegion = activeNav.startsWith("region:") ? activeNav.slice(7) : null;
      const filterRegion = activeFilter.startsWith("region:") ? activeFilter.slice(7) : null;
      const filterAlbum = activeFilter.startsWith("album:") ? activeFilter.slice(6) : null;

      const baseMatchedCells: typeof indexedCells = [];
      indexedCells.forEach((item) => {
        let matchNav = true;
        if (activeNav === "featured") matchNav = item.featured;
        else if (navRegion) matchNav = item.region === navRegion;

        let matchFilter = true;
        if (activeFilter === "featured") matchFilter = item.featured;
        else if (filterRegion) matchFilter = item.region === filterRegion;
        else if (filterAlbum) matchFilter = item.slug === filterAlbum;

        const show = matchNav && matchFilter && matchesCompiledQuery(item.normSearch, item.compactSearch, compiledQ);
        if (show) {
          baseMatchedCells.push(item);
        } else if (!item.el.hidden) {
          item.el.hidden = true;
        }
      });

      let visibleCount = 0;

      const renderMonthsBento = (items: typeof indexedCells) => {
        if (!monthsView) return;
        const grouped = new Map<string, { sortKey: number; items: typeof indexedCells }>();
        items.forEach((item) => {
          const existing = grouped.get(item.date);
          if (existing) {
            existing.items.push(item);
          } else {
            grouped.set(item.date, { sortKey: item.monthSort, items: [item] });
          }
        });

        const sortedMonths = Array.from(grouped.entries()).sort((a, b) => b[1].sortKey - a[1].sortKey);
        const frag = document.createDocumentFragment();

        sortedMonths.forEach(([monthLabel, group]) => {
          const section = document.createElement("section");
          section.className = "mp-month-section";

          const heading = document.createElement("h2");
          heading.className = "mp-month-title";
          heading.textContent = monthLabel;
          section.appendChild(heading);

          const bento = document.createElement("div");
          bento.className = "mp-month-bento";

          const ordered = [...group.items].sort(
            (a, b) => a.capturedTs - b.capturedTs || Number(b.featured) - Number(a.featured),
          );
          const hasHero = ordered.length >= 3;

          ordered.forEach((photo, idx) => {
            const card = document.createElement("a");
            card.href = photo.href;
            card.className = `mp-month-card${hasHero && idx === 0 ? " mp-month-card--hero" : ""}`;
            card.setAttribute("aria-label", `${photo.albumLabel || photo.alt} (${monthLabel})`);

            const img = document.createElement("img");
            img.src = photo.previewSrc;
            if (photo.previewSrcSet) img.srcset = photo.previewSrcSet;
            img.sizes = hasHero && idx === 0 ? "(max-width: 640px) 66vw, 760px" : "(max-width: 640px) 33vw, 380px";
            img.alt = photo.alt;
            img.className = "mp-month-card-img";
            img.loading = idx < 6 ? "eager" : "lazy";
            img.decoding = "async";
            card.appendChild(img);

            if (photo.day) {
              const dayBadge = document.createElement("span");
              dayBadge.className = "mp-month-card-day";
              dayBadge.textContent = photo.day;
              card.appendChild(dayBadge);
            }

            if (photo.albumLabel) {
              const info = document.createElement("div");
              info.className = "mp-month-card-info";
              info.textContent = photo.albumLabel;
              card.appendChild(info);
            }

            bento.appendChild(card);
          });

          section.appendChild(bento);
          frag.appendChild(section);
        });

        monthsView.replaceChildren(frag);
      };

      const renderYearsCards = (items: typeof indexedCells) => {
        if (!yearsView) return;
        const grouped = new Map<string, typeof indexedCells>();
        items.forEach((item) => {
          const list = grouped.get(item.year) || [];
          list.push(item);
          grouped.set(item.year, list);
        });

        // Chronological ascending (e.g. 2023 | 2024 / 2025 | 2026) like macOS Photos
        const sortedYears = Array.from(grouped.entries()).sort((a, b) => a[0].localeCompare(b[0]));

        const gridEl = document.createElement("div");
        gridEl.className = "mp-years-grid";

        sortedYears.forEach(([yearLabel, yearItems]) => {
          const cover = yearItems.find((item) => item.featured) ?? yearItems[0];
          const card = document.createElement("button");
          card.type = "button";
          card.className = "mp-year-card";
          card.setAttribute("aria-label", `Open ${yearLabel} (${yearItems.length} photos)`);
          card.addEventListener("click", () => {
            activeTimeValue = yearLabel;
            if (canvasEl) canvasEl.scrollTop = 0;
            applyState();
          });

          if (cover) {
            const img = document.createElement("img");
            img.src = cover.previewSrc;
            if (cover.previewSrcSet) img.srcset = cover.previewSrcSet;
            img.sizes = "(max-width: 640px) 48vw, 560px";
            img.alt = `${yearLabel} — ${cover.albumLabel || cover.alt}`;
            img.className = "mp-year-card-img";
            img.loading = "eager";
            img.decoding = "async";
            card.appendChild(img);
          }

          const title = document.createElement("span");
          title.className = "mp-year-card-title";
          title.textContent = yearLabel;
          card.appendChild(title);

          gridEl.appendChild(card);
        });

        yearsView.replaceChildren(gridEl);
      };

      if (activeSeg === "years") {
        const yearCounts = new Map<string, number>();
        baseMatchedCells.forEach((item) => {
          yearCounts.set(item.year, (yearCounts.get(item.year) || 0) + 1);
        });

        if (activeTimeValue !== "all" && !yearCounts.has(activeTimeValue)) {
          activeTimeValue = "all";
        }

        if (grid) grid.hidden = true;

        if (activeTimeValue === "all") {
          if (timeBar) timeBar.hidden = true;
          if (monthsView) monthsView.hidden = true;
          if (yearsView) yearsView.hidden = baseMatchedCells.length === 0;
          renderYearsCards(baseMatchedCells);
          visibleCount = baseMatchedCells.length;
        } else {
          if (yearsView) yearsView.hidden = true;
          const filteredYearItems = baseMatchedCells.filter((item) => item.year === activeTimeValue);
          visibleCount = filteredYearItems.length;

          if (timeBar) {
            timeBar.hidden = yearCounts.size === 0;
            const frag = document.createDocumentFragment();
            const allBtn = document.createElement("button");
            allBtn.type = "button";
            allBtn.className = "mp-time-pill";
            allBtn.innerHTML = `<span>← All Years</span><span class="mp-time-pill-count">${baseMatchedCells.length}</span>`;
            allBtn.addEventListener("click", () => {
              activeTimeValue = "all";
              if (canvasEl) canvasEl.scrollTop = 0;
              applyState();
            });
            frag.appendChild(allBtn);

            Array.from(yearCounts.entries())
              .sort((a, b) => a[0].localeCompare(b[0]))
              .forEach(([yearKey, count]) => {
                const pill = document.createElement("button");
                pill.type = "button";
                pill.className = `mp-time-pill${activeTimeValue === yearKey ? " is-active" : ""}`;
                pill.innerHTML = `<span>${yearKey}</span><span class="mp-time-pill-count">${count}</span>`;
                pill.addEventListener("click", () => {
                  activeTimeValue = yearKey;
                  if (canvasEl) canvasEl.scrollTop = 0;
                  applyState();
                });
                frag.appendChild(pill);
              });
            timeBar.replaceChildren(frag);
          }

          if (monthsView) monthsView.hidden = visibleCount === 0;
          renderMonthsBento(filteredYearItems);
        }
      } else if (activeSeg === "months") {
        const monthMap = new Map<string, { count: number; sortKey: number }>();
        baseMatchedCells.forEach((item) => {
          const existing = monthMap.get(item.date);
          if (existing) existing.count++;
          else monthMap.set(item.date, { count: 1, sortKey: item.monthSort });
        });

        if (activeTimeValue !== "all" && !monthMap.has(activeTimeValue)) {
          activeTimeValue = "all";
        }

        if (grid) grid.hidden = true;
        if (yearsView) yearsView.hidden = true;

        const filteredMonthItems =
          activeTimeValue === "all"
            ? baseMatchedCells
            : baseMatchedCells.filter((item) => item.date === activeTimeValue);
        visibleCount = filteredMonthItems.length;

        if (timeBar) {
          timeBar.hidden = activeTimeValue === "all";
          if (activeTimeValue !== "all") {
            const frag = document.createDocumentFragment();
            const allBtn = document.createElement("button");
            allBtn.type = "button";
            allBtn.className = "mp-time-pill";
            allBtn.innerHTML = `<span>← All Months</span><span class="mp-time-pill-count">${baseMatchedCells.length}</span>`;
            allBtn.addEventListener("click", () => {
              activeTimeValue = "all";
              if (canvasEl) canvasEl.scrollTop = 0;
              applyState();
            });
            frag.appendChild(allBtn);

            Array.from(monthMap.entries())
              .sort((a, b) => b[1].sortKey - a[1].sortKey)
              .forEach(([monthKey, meta]) => {
                const pill = document.createElement("button");
                pill.type = "button";
                pill.className = `mp-time-pill${activeTimeValue === monthKey ? " is-active" : ""}`;
                pill.innerHTML = `<span>${monthKey}</span><span class="mp-time-pill-count">${meta.count}</span>`;
                pill.addEventListener("click", () => {
                  activeTimeValue = monthKey;
                  if (canvasEl) canvasEl.scrollTop = 0;
                  applyState();
                });
                frag.appendChild(pill);
              });
            timeBar.replaceChildren(frag);
          }
        }

        if (monthsView) monthsView.hidden = visibleCount === 0;
        renderMonthsBento(filteredMonthItems);
      } else {
        if (grid) grid.hidden = false;
        if (yearsView) yearsView.hidden = true;
        if (monthsView) monthsView.hidden = true;
        if (timeBar && !timeBar.hidden) timeBar.hidden = true;
        baseMatchedCells.forEach((item) => {
          if (item.el.hidden) item.el.hidden = false;
          visibleCount++;
        });
      }

      if (emptyEl) emptyEl.hidden = visibleCount > 0;

      const navLabels: Record<string, string> = {
        library:
          activeSeg === "years"
            ? activeTimeValue === "all"
              ? "Years"
              : activeTimeValue
            : activeSeg === "months"
              ? activeTimeValue === "all"
                ? "Months"
                : activeTimeValue
              : "All Photos",
        map: "Map",
        featured: "Featured",
      };
      if (headingEl) {
        headingEl.textContent = navRegion || navLabels[activeNav] || "All Photos";
      }
      if (subheadingEl) {
        subheadingEl.textContent = `${visibleCount} Items · Leica Q3, Nikon Zf & iPhone`;
      }
    };

    const ZOOM_STORAGE_KEY = "mp-photos-cols";
    const SIDEBAR_STORAGE_KEY = "mp-photos-sidebar-collapsed";

    // Restore sidebar collapsed state
    try {
      const savedCollapsed = localStorage.getItem(SIDEBAR_STORAGE_KEY);
      if (savedCollapsed === "1") {
        app.classList.add("sidebar-collapsed");
        sidebarToggle?.setAttribute("aria-pressed", "false");
      }
    } catch {}

    // Sidebar toggle
    sidebarToggle?.addEventListener(
      "click",
      () => {
        if (mobileSidebarMq.matches) {
          const open = app.classList.toggle("mobile-sidebar-open");
          if (sidebarBackdrop) sidebarBackdrop.hidden = !open;
          sidebarToggle.setAttribute("aria-pressed", String(open));
          return;
        }
        const collapsed = app.classList.toggle("sidebar-collapsed");
        sidebarToggle.setAttribute("aria-pressed", String(!collapsed));
        try {
          localStorage.setItem(SIDEBAR_STORAGE_KEY, collapsed ? "1" : "0");
        } catch {}
      },
      { signal },
    );

    sidebarBackdrop?.addEventListener("click", closeMobileSidebar, { signal });
    mobileSidebarMq.addEventListener("change", () => closeMobileSidebar(), { signal });

    // Info overlay toggle
    infoToggle?.addEventListener(
      "click",
      () => {
        const active = app.classList.toggle("show-info");
        infoToggle.classList.toggle("is-active", active);
        infoToggle.setAttribute("aria-pressed", String(active));
      },
      { signal },
    );

    // Zoom slider: left (−) = more columns / smaller photos, right (+) = fewer columns / larger photos
    const MIN_COLS = 3;
    const MAX_COLS = 7;
    const sliderToCols = (sliderVal: number) => MAX_COLS + MIN_COLS - sliderVal;
    const colsToSlider = (cols: number) => MAX_COLS + MIN_COLS - cols;

    let zoomRaf = 0;
    let lastCols = 5;
    const setCols = (val: number, persist = true) => {
      const clamped = Math.max(MIN_COLS, Math.min(MAX_COLS, val));
      if (zoomSlider) zoomSlider.value = String(colsToSlider(clamped));
      if (clamped !== lastCols) {
        lastCols = clamped;
        if (zoomRaf) cancelAnimationFrame(zoomRaf);
        zoomRaf = requestAnimationFrame(() => {
          zoomRaf = 0;
          grid?.style.setProperty("--mp-cols", String(clamped));
        });
      }
      if (persist) {
        try {
          localStorage.setItem(ZOOM_STORAGE_KEY, String(clamped));
        } catch {}
      }
    };
    signal.addEventListener("abort", () => {
      if (zoomRaf) cancelAnimationFrame(zoomRaf);
    }, { once: true });

    try {
      const savedCols = Number(localStorage.getItem(ZOOM_STORAGE_KEY));
      if (Number.isFinite(savedCols) && savedCols >= MIN_COLS && savedCols <= MAX_COLS) {
        setCols(savedCols, false);
      }
    } catch {}

    zoomSlider?.addEventListener("input", () => setCols(sliderToCols(Number(zoomSlider.value))), { signal });
    zoomOutBtn?.addEventListener("click", () => setCols(lastCols + 1), { signal });
    zoomInBtn?.addEventListener("click", () => setCols(lastCols - 1), { signal });

    // Segmented control (Years | Months | All Photos)
    segButtons.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          const nextSeg = (btn.dataset.seg as "all" | "years" | "months") || "all";
          if (nextSeg !== activeSeg) {
            activeSeg = nextSeg;
            activeTimeValue = "all";
          }
          segButtons.forEach((b) => {
            b.classList.toggle("is-active", b === btn);
            b.setAttribute("aria-selected", String(b === btn));
          });
          if (activeNav === "trips" || activeNav === "albums") {
            activeNav = "library";
          }
          if (canvasEl) canvasEl.scrollTop = 0;
          applyState();
        },
        { signal },
      );
    });

    // Sidebar navigation
    navButtons.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          const nextNav = btn.dataset.nav || "library";
          const changed = nextNav !== activeNav;
          activeNav = nextNav;
          closeMobileSidebar();
          if (changed && canvasEl) canvasEl.scrollTop = 0;
          applyState();
        },
        { signal },
      );
    });

    const closeFilterMenu = () => {
      if (!filterMenu || !filterTrigger) return;
      filterMenu.hidden = true;
      filterTrigger.setAttribute("aria-expanded", "false");
    };

    filterTrigger?.addEventListener(
      "click",
      (e) => {
        e.stopPropagation();
        if (!filterMenu) return;
        const nextOpen = filterMenu.hidden;
        filterMenu.hidden = !nextOpen;
        filterTrigger.setAttribute("aria-expanded", String(nextOpen));
      },
      { signal },
    );

    filterMenuItems.forEach((item) => {
      item.addEventListener(
        "click",
        () => {
          activeFilter = item.dataset.filterVal || "all";
          if (filterLabel) filterLabel.textContent = item.dataset.filterText || "All Items";
          filterMenuItems.forEach((btn) => {
            const selected = btn === item;
            btn.classList.toggle("is-selected", selected);
            btn.setAttribute("aria-checked", String(selected));
          });
          closeFilterMenu();
          applyState();
        },
        { signal },
      );
    });

    document.addEventListener(
      "click",
      (e) => {
        if (filterMenu && !filterMenu.hidden && !filterWrap?.contains(e.target as Node)) {
          closeFilterMenu();
        }
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape" && filterMenu && !filterMenu.hidden) {
          closeFilterMenu();
        }
      },
      { signal },
    );

    let searchRaf = 0;
    searchInput?.addEventListener(
      "input",
      () => {
        activeQuery = searchInput.value;
        if (searchRaf) cancelAnimationFrame(searchRaf);
        searchRaf = requestAnimationFrame(() => {
          searchRaf = 0;
          applyState();
        });
      },
      { signal },
    );
    signal.addEventListener("abort", () => {
      if (searchRaf) cancelAnimationFrame(searchRaf);
    }, { once: true });

    resetBtn?.addEventListener(
      "click",
      () => {
        activeNav = "library";
        activeFilter = "all";
        activeQuery = "";
        if (filterLabel) filterLabel.textContent = "All Items";
        filterMenuItems.forEach((btn) => {
          const selected = btn.dataset.filterVal === "all";
          btn.classList.toggle("is-selected", selected);
          btn.setAttribute("aria-checked", String(selected));
        });
        if (searchInput) searchInput.value = "";
        applyState();
      },
      { signal },
    );

    // GlassFolder interactions for Trips / Albums
    const foldersGrid = document.getElementById("mp-folders-grid");
    if (foldersGrid) {
      const FOLDER_BASE_WIDTH = 340;
      const setFolderOpen = (root: HTMLElement, open: boolean) => {
        if (open) root.setAttribute("data-open", "true");
        else root.removeAttribute("data-open");
        root.querySelector<HTMLButtonElement>(".gf-hit")?.setAttribute("aria-expanded", String(open));
        const files = root.querySelector<HTMLElement>(".gf-files");
        if (files) files.inert = !open;
      };

      const closeAllFolders = (except?: HTMLElement) => {
        folderItems.forEach((item) => {
          const root = item.querySelector<HTMLElement>(".gf-root");
          if (root && root !== except && root.hasAttribute("data-open")) {
            setFolderOpen(root, false);
          }
        });
      };

      const needsScaleFallback =
        typeof CSS === "undefined" || !CSS.supports("transform", "scale(calc(100cqw / 340px))");
      const ro =
        needsScaleFallback && typeof ResizeObserver !== "undefined"
          ? new ResizeObserver((entries) => {
              for (const entry of entries) {
                const w = entry.contentRect.width;
                if (w > 0) {
                  (entry.target as HTMLElement).style.setProperty("--gf-k", String(w / FOLDER_BASE_WIDTH));
                }
              }
            })
          : null;

      folderItems.forEach((item) => {
        const root = item.querySelector<HTMLElement>(".gf-root");
        const hit = item.querySelector<HTMLButtonElement>(".gf-hit");
        const href = item.dataset.href;
        if (!root) return;

        ro?.observe(root);

        hit?.addEventListener(
          "click",
          () => {
            const isOpen = root.hasAttribute("data-open");
            if (!isOpen) {
              closeAllFolders(root);
              setFolderOpen(root, true);
            } else if (href) {
              void navigate(href);
            }
          },
          { signal },
        );
      });

      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as HTMLElement | null;
          if (!target?.closest(".glass-folder-item")) closeAllFolders();
        },
        { signal },
      );

      signal.addEventListener("abort", () => ro?.disconnect());
    }

    window.addEventListener(
      "hashchange",
      () => {
        suppressUrlSync = true;
        applyHashFromLocation();
        applyState();
        suppressUrlSync = false;
        syncUrlFromState();
      },
      { signal },
    );

    applyHashFromLocation();
    applyState();
  });
</script>
