---
import PhotosLayout from "../../layouts/PhotosLayout.astro";
import { getPhotoLocations } from "../../lib/content";
import GlassFolder from "../../components/ui/GlassFolder";
import { optimizePhotos } from "../../lib/photo-assets";
import { canonicalUrl, collectionPageSchema } from "../../lib/seo";
import { resolvePhotoCoords } from "../../lib/photo-map-coords";
import photoUpdates from "../../../data/photo-updates.json";
import { PHOTO_REGION_ORDER, resolvePhotoRegion } from "@/constants/regions";

export const prerender = true;

const updates = photoUpdates as Record<string, { updatedAt: string }>;
const updatedTime = (slug: string) => Date.parse(updates[slug]?.updatedAt ?? "") || 0;
const locations = (await getPhotoLocations()).sort(
  (a, b) => updatedTime(b.slug) - updatedTime(a.slug) || a.order - b.order,
);

const PHOTOS_PER_ALBUM_PREVIEW = 6;

const enhancedLocations = await Promise.all(
  locations.map(async (loc) => {
    const name = loc.name || loc.location;
    const region = resolvePhotoRegion(loc.country, loc.region);

    const photos = loc.photos || [];
    const photoCount = photos.length;
    const images = loc.images || [];
    const rawHero = loc.heroImage?.src || images[0]?.src || photos[0]?.src || "";
    const rawLeft = images[1]?.src || photos[1]?.src || rawHero;
    const rawRight = images[2]?.src || photos[2]?.src || rawHero;

    const previews = await optimizePhotos(
      [rawHero, rawLeft, rawRight].filter(Boolean).map((src) => ({
        src,
        alt: name,
        w: 480,
        h: 360,
      })),
      { previewWidth: 480, previewWidths: [480] },
    );
    const previewImages = previews.map((photo) => photo.previewSrc);
    const heroPhoto = previewImages[0] || "";

    const sampleSource = photos.slice(0, PHOTOS_PER_ALBUM_PREVIEW).map((p, idx) => ({
      src: p.src,
      alt: p.alt || `${name} — frame ${idx + 1}`,
      w: p.w || 4,
      h: p.h || 5,
      title: p.title,
      caption: p.caption,
      location: p.location || name,
      capturedAt: p.capturedAt,
    }));

    const optimizedSample = await optimizePhotos(sampleSource, {
      previewWidth: 480,
      previewWidths: [160, 240, 320, 480],
      previewSizes: "(max-width: 640px) 33vw, (max-width: 1024px) 22vw, 15vw",
      fullWidth: 1600,
    });

    const ts = updatedTime(loc.slug);
    const dateLabel = ts
      ? new Intl.DateTimeFormat("en-GB", {
          month: "short",
          year: "numeric",
          timeZone: "Asia/Ho_Chi_Minh",
        }).format(new Date(ts))
      : "Archive";

    return {
      ...loc,
      displayName: name,
      region,
      photoCount,
      updatedTimestamp: ts,
      dateLabel,
      yearLabel: ts ? String(new Date(ts).getFullYear()) : "Archive",
      previewImages,
      heroPhoto,
      samplePhotos: optimizedSample.map((photo, idx) => ({
        ...photo,
        id: `${loc.slug}-${idx}`,
        detailId: `photo-${loc.slug}-${idx + 1}`,
        slug: loc.slug,
        albumName: name,
        region,
        country: loc.country || "Vietnam",
        albumCount: photoCount,
        title: sampleSource[idx]?.title || name,
        caption: sampleSource[idx]?.caption || "",
        location: sampleSource[idx]?.location || name,
        dateLabel,
        yearLabel: ts ? String(new Date(ts).getFullYear()) : "Archive",
        featured: idx === 0,
        recent: updatedTime(loc.slug) > 0,
      })),
    };
  }),
);

type GridPhoto = (typeof enhancedLocations)[number]["samplePhotos"][number];

const tripsByYear = Array.from(
  enhancedLocations.reduce((acc, loc) => {
    const year = loc.yearLabel || "Archive";
    const list = acc.get(year) || [];
    list.push(loc);
    acc.set(year, list);
    return acc;
  }, new Map<string, (typeof enhancedLocations)[number][]>()),
);
const allGridPhotos: GridPhoto[] = [];
for (let i = 0; i < PHOTOS_PER_ALBUM_PREVIEW; i++) {
  for (const loc of enhancedLocations) {
    const p = loc.samplePhotos[i];
    if (p) allGridPhotos.push(p);
  }
}

const totalPhotos = enhancedLocations.reduce((sum, loc) => sum + loc.photoCount, 0);
const availableRegions = PHOTO_REGION_ORDER.filter((r) =>
  enhancedLocations.some((l) => l.region === r),
);

const mapDestinations = enhancedLocations
  .map((loc) => {
    const coords = resolvePhotoCoords(loc.slug, loc.latitude, loc.longitude);
    if (!coords) return null;
    return {
      slug: loc.slug,
      name: loc.displayName,
      region: loc.region,
      country: loc.country || "Vietnam",
      headline: loc.headline || "",
      photoCount: loc.photoCount,
      heroPhoto: loc.heroPhoto,
      previewImages: loc.previewImages,
      lat: coords.lat,
      lng: coords.lng,
      search: `${loc.displayName} ${loc.region} ${loc.country || "Vietnam"} ${loc.headline || ""} ${loc.slug}`,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);

const photosUrl = canonicalUrl("/photos");
const photosSchema = collectionPageSchema({
  url: photosUrl,
  title: "Photography & Travel Journals — Phuc Loc Nguyen",
  description: `First-hand travel photography and destination notes across ${locations.length} destinations in Vietnam and Southeast Asia.`,
  items: enhancedLocations.map((loc) => ({
    name: loc.displayName,
    url: `/photos/${loc.slug}`,
    description: loc.seoDescription || loc.headline,
    image: loc.heroPhoto || undefined,
  })),
});
---

<PhotosLayout
  title="Photos — Photography"
  pageTitle="Photos"
  description={`First-hand travel photography and field notes across ${locations.length} destinations in Vietnam and Southeast Asia: mountain passes, karst rivers, coastal towns, and street scenes.`}
  maxWidthVariant="gallery"
  fullBleed={true}
  schema={photosSchema}
>
  <div class="mp-app" id="mp-app">
    <!-- Top macOS Photos Toolbar -->
    <header class="mp-toolbar" aria-label="Photos toolbar">
      <div class="mp-toolbar-left">
        <button
          type="button"
          id="mp-sidebar-toggle"
          class="mp-icon-btn"
          aria-label="Toggle sidebar"
          aria-pressed="true"
          title="Toggle Sidebar"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M9 3v18" />
          </svg>
        </button>

        <div class="mp-zoom-control" aria-label="Thumbnail size">
          <button type="button" id="mp-zoom-out" class="mp-zoom-btn" aria-label="Smaller thumbnails">−</button>
          <input
            id="mp-zoom-slider"
            type="range"
            min="3"
            max="9"
            value="6"
            aria-label="Grid columns"
          />
          <button type="button" id="mp-zoom-in" class="mp-zoom-btn" aria-label="Larger thumbnails">+</button>
        </div>
      </div>

      <div class="mp-segmented" id="mp-seg-library" role="tablist" aria-label="Time & Library view">
        <button type="button" class="mp-seg-btn" role="tab" aria-selected="false" data-seg="years">Years</button>
        <button type="button" class="mp-seg-btn" role="tab" aria-selected="false" data-seg="months">Months</button>
        <button type="button" class="mp-seg-btn is-active" role="tab" aria-selected="true" data-seg="all">All Photos</button>
      </div>

      <div class="mp-toolbar-right">
        <button
          type="button"
          id="mp-info-toggle"
          class="mp-icon-btn"
          aria-label="Show photo info overlay"
          aria-pressed="false"
          title="Show Info"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
          </svg>
        </button>

        <label class="mp-search">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="mp-search-input"
            type="search"
            placeholder="Search"
            aria-label="Search photos and albums"
            autocomplete="off"
          />
        </label>
      </div>
    </header>

    <!-- 2-Column macOS Photos Body -->
    <div class="mp-body">
      <div class="mp-sidebar-backdrop" id="mp-sidebar-backdrop" hidden aria-hidden="true"></div>
      <!-- Left Sidebar -->
      <aside class="mp-sidebar" id="mp-sidebar" aria-label="Photos Library Navigation">
        <div class="mp-sidebar-section">
          <div class="mp-sidebar-heading">Photos</div>
          <button type="button" class="mp-nav-item is-active" data-nav="library">
            <svg width="16" height="13" viewBox="0 0 250 202" fill="none" aria-hidden="true">
              <path d="M30.3 26.4 159.8 4.6c12.7-2.2 24.8 6.4 27 19.1l2.9 17.1H87.3c-21.2 0-38.4 17.2-38.4 38.4v85.1c-10.5-.6-19.5-8.3-21.3-19.1L11.1 53.3C8.9 40.6 17.5 28.5 30.3 26.4Z" fill="#80B9FF"/>
              <rect x="59.6" y="51.4" width="179.1" height="139" rx="25" fill="#087BFA"/>
              <circle cx="120.2" cy="102.8" r="19.5" fill="#fff"/>
              <path d="m70.2 162.9 24-22.4c6-5.6 13.8-5.7 19.8-.3l16.4 14 37.1-33.7c7.2-6.5 15.4-5.3 22.5 1.3l38.8 34.5v8.6c0 8.9-7.2 16.1-16.1 16.1H86.2c-9 0-16-7.2-16-16.1v-2Z" fill="#fff"/>
            </svg>
            <span>Library</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="map">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
              <line x1="9" y1="3" x2="9" y2="18" />
              <line x1="15" y1="6" x2="15" y2="21" />
            </svg>
            <span>Map</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="recent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 5H6.5A2.5 2.5 0 0 0 4 7.5v10A2.5 2.5 0 0 0 6.5 20h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M15 5h2.5A2.5 2.5 0 0 1 20 7.5v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M12 2.5v10m0 0-3-3m3 3 3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="17.5" cy="17.5" r="4.8" fill="currentColor" />
              <path d="M17.5 15.1v2.4h2" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Recently Saved</span>
          </button>
        </div>

        <div class="mp-sidebar-section">
          <div class="mp-sidebar-heading">Collections</div>
          <button type="button" class="mp-nav-item" data-nav="trips">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            </svg>
            <span>Trips</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="featured">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            <span>Featured</span>
          </button>
          <button type="button" class="mp-nav-item" data-nav="albums">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
            </svg>
            <span>Albums</span>
          </button>
        </div>

        <div class="mp-sidebar-section">
          <div class="mp-sidebar-heading">Regions</div>
          {availableRegions.map((region) => (
            <button type="button" class="mp-nav-item" data-nav={`region:${region}`}>
              <svg width="16" height="14" viewBox="0 0 24 20" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="16" rx="3.2" stroke="currentColor" stroke-width="1.9" />
                <circle cx="8" cy="7.5" r="2.1" fill="currentColor" />
                <path d="M2.5 15.5 7 11.2c.7-.7 1.8-.7 2.5 0l2 1.9 3.6-4.1c.7-.8 1.9-.8 2.6 0l3.8 4.4V16a2 2 0 0 1-2 2H4.5a2 2 0 0 1-2-2v-.5Z" fill="currentColor" />
              </svg>
              <span>{region}</span>
            </button>
          ))}
        </div>
      </aside>

      <!-- Main Scrollable Canvas -->
      <section class="mp-canvas" id="mp-canvas" aria-label="Photo gallery" data-workspace-scroll>
        <!-- Sticky Frosted Header Bar (like macOS Photos date/filter overlay) -->
        <div class="mp-canvas-head">
          <div class="mp-canvas-title-wrap">
            <h1 id="mp-heading" class="mp-heading">All Photos</h1>
            <span id="mp-subheading" class="mp-subheading">
              {locations.length} Destinations · Leica Q3, Nikon Zf &amp; iPhone
            </span>
          </div>

          <div class="mp-filter-wrap" id="mp-filter-wrap">
            <button
              type="button"
              id="mp-filter-trigger"
              class="mp-filter-pill"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span class="mp-filter-prefix">Filter By:</span>
              <strong id="mp-filter-label">All Items</strong>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            <div id="mp-filter-menu" class="mp-popover-menu" role="menu" aria-label="Filter items" hidden>
              <button type="button" class="mp-menu-item is-selected" role="menuitemradio" aria-checked="true" data-filter-val="all" data-filter-text="All Items">
                <span class="mp-menu-check" aria-hidden="true">✓</span>
                <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="3" width="5" height="5" rx="1" />
                  <rect x="10" y="3" width="5" height="5" rx="1" />
                  <rect x="17" y="3" width="4" height="5" rx="1" />
                  <rect x="3" y="10" width="5" height="5" rx="1" />
                  <rect x="10" y="10" width="5" height="5" rx="1" />
                  <rect x="17" y="10" width="4" height="5" rx="1" />
                  <rect x="3" y="17" width="5" height="4" rx="1" />
                  <rect x="10" y="17" width="5" height="4" rx="1" />
                  <rect x="17" y="17" width="4" height="4" rx="1" />
                </svg>
                <span>All Items</span>
              </button>

              <div class="mp-menu-divider" role="separator"></div>

              <button type="button" class="mp-menu-item" role="menuitemradio" aria-checked="false" data-filter-val="featured" data-filter-text="Featured">
                <span class="mp-menu-check" aria-hidden="true">✓</span>
                <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <line x1="4" y1="6" x2="20" y2="6" />
                  <circle cx="9" cy="6" r="2" fill="currentColor" />
                  <line x1="4" y1="12" x2="20" y2="12" />
                  <circle cx="15" cy="12" r="2" fill="currentColor" />
                  <line x1="4" y1="18" x2="20" y2="18" />
                  <circle cx="10" cy="18" r="2" fill="currentColor" />
                </svg>
                <span>Featured</span>
              </button>

              <button type="button" class="mp-menu-item" role="menuitemradio" aria-checked="false" data-filter-val="recent" data-filter-text="Recently Saved">
                <span class="mp-menu-check" aria-hidden="true">✓</span>
                <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <circle cx="9" cy="9" r="2" />
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                </svg>
                <span>Recently Saved</span>
              </button>

              <div class="mp-menu-divider" role="separator"></div>

              {availableRegions.map((region) => (
                <button
                  type="button"
                  class="mp-menu-item"
                  role="menuitemradio"
                  aria-checked="false"
                  data-filter-val={`region:${region}`}
                  data-filter-text={region}
                >
                  <span class="mp-menu-check" aria-hidden="true">✓</span>
                  <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  <span>{region}</span>
                </button>
              ))}

              <div class="mp-menu-divider" role="separator"></div>

              <div class="mp-menu-scroll">
                {enhancedLocations.map((loc) => (
                  <button
                    type="button"
                    class="mp-menu-item"
                    role="menuitemradio"
                    aria-checked="false"
                    data-filter-val={`album:${loc.slug}`}
                    data-filter-text={loc.displayName}
                  >
                    <span class="mp-menu-check" aria-hidden="true">✓</span>
                    <svg class="mp-menu-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                    </svg>
                    <span>{loc.displayName}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Photo Grid (All Photos / Years / Months / Favorites / Regions) -->
        <div id="mp-grid-view" class="mp-grid-view">
          <div id="mp-time-bar" class="mp-time-bar" role="tablist" aria-label="Filter by time period" hidden></div>
          <div id="mp-grid" class="mp-grid" style="--mp-cols: 6;">
            {allGridPhotos.map((photo, idx) => (
              <a
                href={`/photos/${photo.slug}#${photo.detailId}`}
                class="mp-cell"
                data-id={photo.id}
                data-index={idx}
                data-slug={photo.slug}
                data-region={photo.region}
                data-album={photo.albumName.toLowerCase()}
                data-album-label={photo.albumName}
                data-date={photo.dateLabel}
                data-year={photo.yearLabel}
                data-featured={photo.featured ? "1" : "0"}
                data-recent={photo.recent ? "1" : "0"}
                data-full={photo.fullSrc}
                data-title={photo.title}
                data-location={photo.location}
                data-caption={photo.caption}
                data-search={`${photo.albumName} ${photo.region} ${photo.country} ${photo.title} ${photo.location} ${photo.caption} ${photo.slug}`}
              >
                <div class="mp-cell-media">
                  <img
                    src={photo.previewSrc}
                    srcset={photo.previewSrcSet || undefined}
                    sizes={idx < 6 ? photo.previewSizes : `auto, ${photo.previewSizes}`}
                    alt={photo.alt}
                    width={photo.previewWidth}
                    height={photo.previewHeight}
                    loading={idx < 6 ? "eager" : "lazy"}
                    decoding="async"
                    data-motion-share={photo.detailId}
                    style="view-transition-class: workspace-shared-image"
                  />
                </div>
                <div class="mp-cell-info">
                  <span>{photo.albumName}</span>
                </div>
              </a>
            ))}
          </div>

          <div id="mp-empty" class="mp-empty" hidden>
            <p id="mp-empty-msg">No photos match your filter.</p>
            <button type="button" id="mp-reset-btn" class="mp-reset-btn">Show All Photos</button>
          </div>
        </div>

        <!-- Trips Timeline View (grouped by year) -->
        <div id="mp-trips-view" class="mp-trips-view" hidden>
          {tripsByYear.map(([year, yearLocations]) => (
            <section class="mp-trip-year-group" data-trip-year={year}>
              <div class="mp-trip-year-head">
                <h2 class="mp-trip-year-title">{year}</h2>
                <span class="mp-trip-year-count" data-trip-year-count>{yearLocations.length} {yearLocations.length === 1 ? "Trip" : "Trips"}</span>
              </div>
              <div class="mp-trip-cards">
                {yearLocations.map((loc) => (
                  <a
                    href={`/photos/${loc.slug}`}
                    class="mp-trip-card"
                    data-region={loc.region}
                    data-album={loc.displayName.toLowerCase()}
                    data-search={`${loc.displayName} ${loc.region} ${loc.country || "Vietnam"} ${loc.dateLabel} ${loc.yearLabel} ${loc.headline || ""} ${loc.slug}`}
                  >
                    <img
                      src={loc.heroPhoto}
                      alt={loc.displayName}
                      class="mp-trip-card-img"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="mp-trip-card-overlay">
                      <span class="mp-trip-card-meta">{loc.dateLabel} · {loc.region}</span>
                      <strong class="mp-trip-card-title" data-motion-share={`album-${loc.slug}`}>{loc.displayName}</strong>
                      <span class="mp-trip-card-count">{loc.photoCount} Photos</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <!-- Albums Folder View -->
        <div id="mp-albums-view" class="mp-albums-view" hidden>
          <div id="mp-folders-grid" class="glass-folder-grid">
            {enhancedLocations.map((loc) => {
              const folderProps = {
                label: loc.displayName,
                meta: `${loc.photoCount} Photos · ${loc.region}`,
                image: loc.heroPhoto || undefined,
                art: "none" as const,
                files: loc.previewImages.map((image, index) => ({
                  name: `${loc.displayName} — ${index + 1}`,
                  image,
                  href: `/photos/${loc.slug}`,
                })),
                href: `/photos/${loc.slug}`,
                action: "none" as const,
                appear: false,
                defaultWidth: 204,
                eager: false,
              };
              return (
                <div
                  class="glass-folder-item"
                  data-region={loc.region}
                  data-album={loc.displayName.toLowerCase()}
                  data-search={`${loc.displayName} ${loc.region} ${loc.country || "Vietnam"} ${loc.headline || ""} ${loc.slug}`}
                  data-href={`/photos/${loc.slug}`}
                >
                  <GlassFolder {...folderProps} />
                </div>
              );
            })}
          </div>
        </div>

        <!-- Interactive macOS Photos Map View -->
        <div
          id="mp-map-view"
          class="mp-map-view"
          data-destinations={JSON.stringify(mapDestinations)}
          hidden
        >
          <div id="mp-map-canvas" class="mp-map-canvas" aria-label="Interactive photo map"></div>

          <!-- Selected Destination Popover Card -->
          <div id="mp-map-card" class="mp-map-card" hidden>
            <button type="button" id="mp-map-card-close" class="mp-map-card-close" aria-label="Close destination preview">×</button>
            <img data-card-img src="" alt="" class="mp-map-card-img" />
            <div class="mp-map-card-body">
              <div class="mp-map-card-title" data-card-title></div>
              <div class="mp-map-card-meta" data-card-meta></div>
              <p class="mp-map-card-headline" data-card-headline></p>
              <a data-card-link href="/photos" class="mp-map-card-link">Open Album →</a>
            </div>
          </div>

          <!-- Bottom-left Legal attribution (like Apple Maps) -->
          <div class="mp-map-legal">
            <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">Legal</a>
          </div>

          <!-- Bottom-right Zoom Pill & Compass -->
          <div class="mp-map-controls" aria-label="Map controls">
            <div class="mp-map-zoom-pill">
              <button type="button" id="mp-map-zoom-out" class="mp-map-ctrl-btn" aria-label="Zoom out">−</button>
              <span class="mp-map-zoom-sep" aria-hidden="true"></span>
              <button type="button" id="mp-map-zoom-in" class="mp-map-ctrl-btn" aria-label="Zoom in">+</button>
            </div>
            <button type="button" id="mp-map-compass" class="mp-map-compass" aria-label="Reset map orientation and zoom" title="Reset View">
              <svg width="26" height="26" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                <circle cx="18" cy="18" r="16.5" stroke="rgba(255,255,255,0.22)" stroke-width="1" />
                <path d="M18 3.5L20.2 8.5H15.8L18 3.5Z" fill="#ff453a" />
                <text x="18" y="22.5" text-anchor="middle" fill="#ffffff" font-size="12" font-weight="700" font-family="-apple-system, BlinkMacSystemFont, sans-serif">N</text>
              </svg>
            </button>
          </div>
        </div>

        <!-- Bottom macOS Photos Status Footer -->
        <footer class="mp-footer" aria-label="Library summary">
          <strong id="mp-footer-count">{totalPhotos.toLocaleString()} Photos, {locations.length} Destinations</strong>
          <span>Shot on Leica Q3, Nikon Zf &amp; iPhone</span>
        </footer>
      </section>
    </div>
  </div>
</PhotosLayout>

