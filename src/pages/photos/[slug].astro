---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../../lib/cms";
import { optimizePhotos } from "../../lib/photo-assets";
import { getLocationEditorial } from "../../data/location-stories";

export const prerender = true;

export async function getStaticPaths() {
  const locations = await getPhotoLocations();
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const allLocations = await getPhotoLocations();
const location = Astro.props.location ?? allLocations.find((loc) => loc.slug === Astro.params.slug);

if (!location) {
  return Astro.redirect("/photos");
}

const editorial = getLocationEditorial(location.slug);

// Process photos
const sourcePhotos: { src: string; alt: string; caption: string; w: number; h: number }[] = (location.photos || []).map((p: any, idx: number) => {
  const src = typeof p === "string" ? p : p.src;
  const alt = typeof p === "string" ? `${location.name} frame ${idx + 1}` : (p.alt || p.caption || `${location.name} photo`);
  const caption = typeof p === "string" ? "" : (p.caption || "");
  const w = p.w || p.width || 1200;
  const h = p.h || p.height || 900;
  return { src, alt, caption, w, h };
});
const photos = await optimizePhotos(sourcePhotos, {
  previewWidth: 960,
  previewWidths: [320, 360, 480, 640, 720, 960, 1280],
  previewSizes: "(max-width: 640px) calc(100vw - 32px), (max-width: 768px) calc((100vw - 48px) / 2), (max-width: 1023px) calc((100vw - 64px) / 2), (max-width: 1279px) calc((94vw - 334px) / 2), (max-width: 1376px) calc((94vw - 350px) / 2), 472px",
});
---

<DashboardLayout
  title={`${location.name || location.location} | Photo Journal — Phuc Loc Nguyen`}
  pageTitle={location.name || location.location}
  description={location.headline || `Travel photography field notes from ${location.name}`}
  breadcrumbs={[
    { label: "Personal", href: "/" },
    { label: "Photography", href: "/photos" },
    { label: location.name || location.location }
  ]}
  maxWidthVariant="default"
  currentPath={`/photos/${location.slug}`}
>
  <!-- Page Introduction -->
  <header class="page-header photo-introduction">
    <div style="margin-bottom: 4px;">
      <h1 class="page-title" style="margin: 0;">{location.name || location.location}</h1>
    </div>

    <p class="page-lead" style="margin-bottom: var(--space-2);">{location.headline}</p>
    {editorial?.subtitle && (
      <p class="editorial-subtitle">{editorial.subtitle}</p>
    )}

    {location.introduction && (
      <p style="font-size: var(--text-body); line-height: var(--leading-body); color: var(--dash-text); margin: 0 0 var(--space-4);">
        {location.introduction}
      </p>
    )}
    {!editorial && (location.introduction?.trim().length || 0) < 300 && (
      <p class="dash-prose" style="font-size: var(--text-body); line-height: var(--leading-body); margin: 0 0 var(--space-4);">
        This collection brings together {photos.length} photographs from {location.name || location.location}, {location.country || "Vietnam"}, by Phuc Loc Nguyen.
        It is part of a personal photography archive covering {allLocations.length} destinations across Vietnam and Southeast Asia.
        Browse the photographs below and open an image for a larger view, or explore other collections in the <a href="/photos">Photography directory</a>.
        For image use or a collaboration inquiry, <a href="/contact">contact Loc</a> with a link to this gallery and identify the photograph you have in mind.
      </p>
    )}

    <!-- Properties Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; padding: 14px 0; border-top: var(--dash-border-width, 0.9px) solid var(--dash-border); border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border); font-size: var(--text-body-sm);">
      {location.bestMonths && (
        <div>
          <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Best Season</span>
          <span style="font-weight: 500; color: var(--dash-text);">{location.bestMonths}</span>
        </div>
      )}
      {location.budgetNote && (
        <div>
          <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Estimated Budget</span>
          <span style="font-weight: 500; color: var(--dash-text);">{location.budgetNote}</span>
        </div>
      )}
      {location.wouldReturn && (
        <div>
          <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Would Return</span>
          <span style="font-weight: 500; color: var(--dash-success); text-transform: capitalize;">{location.wouldReturn}</span>
        </div>
      )}
      <div>
        <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Gallery</span>
        <span style="color: var(--dash-text);">{photos.length} photos</span>
      </div>
    </div>
  </header>

  <!-- Photo Stream (Masonry gallery) -->
  <section class="page-section" aria-label="Photo stream">
    <div 
      class="dash-gallery photo-stream-gallery" 
    >
      {photos.map((p, index) => (
        <figure 
          class="gallery-figure" 
          style="break-inside: avoid; margin-bottom: 16px; border-radius: var(--radius-card); overflow: hidden; background: #EFEFED; border: var(--dash-border-width, 0.9px) solid var(--dash-border);"
        >
          <img 
            src={p.previewSrc}
            srcset={p.previewSrcSet}
            sizes={p.previewSizes}
            alt={p.alt || location.name} 
            width={p.w}
            height={p.h}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
            draggable="false"
            style="width: 100%; height: auto; display: block;"
          />
        </figure>
      ))}
    </div>
  </section>

  <!-- Editorial Section: Travel Journal & Cultural Notes -->
  {editorial && (
    <section class="page-section page-section--divided editorial-section" aria-labelledby="heading-story">
      <!-- Travel Journal Story -->
      <article class="editorial-story-block">
        <div class="editorial-label-row">
          <span class="editorial-kicker">Travel Journal</span>
        </div>
        <h2 id="heading-story" class="section-title editorial-story-heading">
          {editorial.subtitle}
        </h2>
        <div class="editorial-prose">
          {editorial.story.split("\n\n").map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </article>

      <!-- Historical Context Card -->
      <div class="editorial-history-card">
        <div class="editorial-history-header">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <h3 class="editorial-history-title">Historical & Cultural Heritage</h3>
        </div>
        <p class="editorial-history-text">{editorial.history}</p>
      </div>

      <!-- Personal Review -->
      <div class="editorial-review-block">
        <h3 class="item-title" style="font-size: var(--text-h4); margin-bottom: var(--space-2);">Photographer’s Perspective</h3>
        <p style="font-size: var(--text-body); line-height: var(--leading-body); color: var(--dash-text); margin: 0;">
          {editorial.review}
        </p>
      </div>

      <!-- Highlights & Photography Tips Grid -->
      <div class="editorial-columns-grid">
        {editorial.highlights && editorial.highlights.length > 0 && (
          <div class="editorial-col">
            <h3 class="item-title" style="font-size: var(--text-h4); margin-bottom: var(--space-2);">Standout Highlights</h3>
            <ul class="editorial-list">
              {editorial.highlights.map((item) => (
                <li>
                  <span class="dash-bullet" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {editorial.photographyTips && editorial.photographyTips.length > 0 && (
          <div class="editorial-col">
            <h3 class="item-title" style="font-size: var(--text-h4); margin-bottom: var(--space-2);">Photography & Lighting Notes</h3>
            <ul class="editorial-list">
              {editorial.photographyTips.map((tip) => (
                <li>
                  <span class="dash-bullet" aria-hidden="true"></span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Research Sources / References (Subtle, verified) -->
      {editorial.sources && editorial.sources.length > 0 && (
        <div class="editorial-sources-footer">
          <span class="editorial-sources-title">Research References:</span>
          <ul class="editorial-sources-items">
            {editorial.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="editorial-source-link">
                  {s.title}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}
</DashboardLayout>

<style>
  .photo-introduction > p {
    max-width: none;
  }

  .editorial-subtitle {
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
    font-style: italic;
    margin: 0 0 16px;
  }

  .photo-stream-gallery {
    columns: 2;
    column-gap: 16px;
  }

  .gallery-figure {
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .gallery-figure img {
    transition: none;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* Editorial Section Styling */
  .editorial-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 36px;
  }

  .editorial-kicker {
    font-size: var(--text-micro);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--dash-muted);
  }

  .editorial-story-heading {
    font-family: var(--font-headline, inherit);
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    font-weight: var(--font-weight-semibold);
    color: var(--dash-text);
    margin: var(--space-2) 0 var(--space-4);
  }

  .editorial-prose p {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--dash-text);
    margin: 0 0 var(--space-4);
    max-width: none;
  }

  .editorial-prose p:last-child {
    margin-bottom: 0;
  }

  .editorial-history-card {
    padding: 18px 20px;
    background: var(--dash-surface, #ffffff);
    border: 1px solid var(--dash-border, rgba(10, 10, 10, 0.08));
    border-radius: var(--radius-card, 12px);
  }

  .editorial-history-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: var(--dash-text);
  }

  .editorial-history-title {
    font-size: var(--text-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .editorial-history-text {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--dash-text);
    margin: 0;
    max-width: none;
  }

  .editorial-review-block p {
    max-width: none;
  }

  .editorial-columns-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .editorial-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .editorial-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-text);
  }

  .editorial-sources-footer {
    padding-top: 18px;
    border-top: 1px dashed var(--dash-border, rgba(10, 10, 10, 0.12));
    font-size: var(--text-caption);
    color: var(--dash-muted);
  }

  .editorial-sources-title {
    font-weight: 500;
    display: block;
    margin-bottom: 6px;
    color: var(--dash-muted);
  }

  .editorial-sources-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .editorial-source-link {
    color: var(--dash-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 150ms ease;
  }

  .editorial-source-link:hover {
    color: var(--dash-text);
  }

  @media (max-width: 640px) {
    .photo-stream-gallery {
      columns: 1;
      column-gap: 0;
    }

    .editorial-columns-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
