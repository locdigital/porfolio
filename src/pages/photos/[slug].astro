---
import PhotoDetailPage from "../../components/photos/PhotoDetailPage.astro";
import { getPhotoLocations } from "../../lib/content";

export const prerender = true;

export async function getStaticPaths() {
  const locations = await getPhotoLocations();
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const allLocations = await getPhotoLocations();
const location = Astro.props.location ?? allLocations.find((loc) => loc.slug === Astro.params.slug);

if (!location) {
  return Astro.redirect("/photos");
}
---

<PhotoDetailPage location={location} allLocations={allLocations} />
