---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../../lib/cms";
import { 
  ArrowLeft, 
  ChevronLeft, 
  ChevronRight, 
  X
} from "../../components/icons/majesticons";

export const prerender = true;

export async function getStaticPaths() {
  const locations = await getPhotoLocations();
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const allLocations = await getPhotoLocations();
const location = Astro.props.location ?? allLocations.find((loc) => loc.slug === Astro.params.slug);

if (!location) {
  return Astro.redirect("/photos");
}

// Process photos
const photos = (location.photos || []).map((p: any, idx: number) => {
  const src = typeof p === "string" ? p : p.src;
  const alt = typeof p === "string" ? `${location.name} frame ${idx + 1}` : (p.alt || p.caption || `${location.name} photo`);
  const caption = typeof p === "string" ? "" : (p.caption || "");
  const w = p.width || 1200;
  const h = p.height || 900;
  return { src, alt, caption, w, h };
});
---

<DashboardLayout
  title={`${location.name || location.location} | Photo Journal — Phuc Loc Nguyen`}
  pageTitle={location.name || location.location}
  description={location.headline || `Travel photography field notes from ${location.name}`}
  breadcrumbs={[
    { label: "Personal", href: "/" },
    { label: "Photography", href: "/photos" },
    { label: location.name || location.location }
  ]}
  maxWidthVariant="default"
>
  <!-- Back to photos link -->
  <div style="margin-bottom: var(--space-4);">
    <a 
      href="/photos" 
      class="dash-link"
      style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.8125rem; color: var(--dash-muted);"
    >
      <ArrowLeft size={14} aria-hidden="true" />
      <span>All destinations</span>
    </a>
  </div>

  <!-- Page Introduction -->
  <header class="page-header">
    <div style="margin-bottom: 6px;">
      <h1 class="page-title" style="margin: 0;">{location.name || location.location}</h1>
    </div>

    <p class="page-lead" style="margin-bottom: var(--space-4);">{location.headline}</p>

    {location.introduction && (
      <p style="font-size: 0.9375rem; line-height: 1.65; color: var(--dash-muted); max-width: 72ch; margin: 0 0 16px;">
        {location.introduction}
      </p>
    )}

    <!-- Properties Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; padding: 14px 0; border-top: var(--dash-border-width, 0.9px) solid var(--dash-border); border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border); font-size: 0.8125rem;">
      {location.bestMonths && (
        <div>
          <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Best Season</span>
          <span style="font-weight: 500; color: var(--dash-text);">{location.bestMonths}</span>
        </div>
      )}
      {location.budgetNote && (
        <div>
          <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Estimated Budget</span>
          <span style="font-weight: 500; color: var(--dash-text);">{location.budgetNote}</span>
        </div>
      )}
      {location.wouldReturn && (
        <div>
          <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Would Return</span>
          <span style="font-weight: 500; color: var(--dash-success); text-transform: capitalize;">{location.wouldReturn}</span>
        </div>
      )}
      <div>
        <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Gallery</span>
        <span style="color: var(--dash-text);">{photos.length} photos</span>
      </div>
    </div>
  </header>

  <!-- Photo Stream (Masonry gallery) -->
  <section class="page-section" aria-label="Photo stream">
    <div 
      class="dash-gallery" 
      style="columns: 2; column-gap: 16px;"
    >
      {photos.map((p, index) => (
        <figure 
          class="gallery-figure" 
          style="break-inside: avoid; margin-bottom: 16px; border-radius: var(--radius-card); overflow: hidden; background: #EFEFED; border: var(--dash-border-width, 0.9px) solid var(--dash-border); cursor: pointer;"
          data-index={index}
          data-src={p.src}
        >
          <img 
            src={p.src} 
            alt={p.alt || location.name} 
            width={p.w}
            height={p.h}
            loading={index < 4 ? "eager" : "lazy"}
            decoding="async"
            style="width: 100%; height: auto; display: block;"
          />
        </figure>
      ))}
    </div>
  </section>

  <!-- Field Notes & Editorial Review -->
  {(location.editorialReview || location.favoriteThings || (location.travelTips && location.travelTips.length > 0)) && (
    <section class="page-section" aria-labelledby="heading-notes" style="border-top: var(--dash-border-width, 0.9px) solid var(--dash-border); padding-top: calc(var(--space-8) * 1.1); max-width: 760px;">
      <h2 id="heading-notes" class="section-title">Field notes & recommendations</h2>

      <div style="display: flex; flex-direction: column; gap: var(--space-6);">
        {location.editorialReview && (
          <div>
            <h3 class="item-title" style="margin-bottom: 6px;">Personal travel review</h3>
            <p style="font-size: 0.875rem; line-height: 1.65; color: var(--dash-text); margin: 0;">
              {location.editorialReview}
            </p>
          </div>
        )}

        {location.favoriteThings && (
          <div>
            <h3 class="item-title" style="margin-bottom: 6px;">Standout highlights</h3>
            <p style="font-size: 0.875rem; line-height: 1.65; color: var(--dash-text); margin: 0;">
              {location.favoriteThings}
            </p>
          </div>
        )}

        {location.travelTips && location.travelTips.length > 0 && (
          <div>
            <h3 class="item-title" style="margin-bottom: 8px;">Helpful travel tips</h3>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
              {location.travelTips.map((tip: string) => (
                <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.8125rem; line-height: 1.5; color: var(--dash-text);">
                  <span class="dash-bullet" aria-hidden="true"></span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Lightbox Modal Overlay -->
  <dialog 
    id="photo-lightbox" 
    style="position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; margin: 0; padding: 0; background: rgba(0, 0, 0, 0.88); border: none; z-index: 100; display: none; align-items: center; justify-content: center; backdrop-filter: blur(8px);"
    aria-label="Image viewer"
  >
    <div style="position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px;">
      
      <!-- Top controls -->
      <div style="position: absolute; top: 16px; left: 24px; right: 24px; display: flex; align-items: center; justify-content: space-between; color: #fff; z-index: 10;">
        <span id="lb-counter" style="font-size: 0.8125rem; font-variant-numeric: tabular-nums; opacity: 0.8;">1 / {photos.length}</span>
        <button id="lb-close" class="mobile-menu-btn" style="color: #fff;" aria-label="Close viewer">
          <X size={22} />
        </button>
      </div>

      <!-- Image display -->
      <div style="max-width: 90vw; max-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <img 
          id="lb-image" 
          src="" 
          alt="" 
          style="max-width: 100%; max-height: 78vh; object-fit: contain; border-radius: 4px;"
        />
      </div>

      <!-- Caption (hidden) -->
      <div id="lb-caption" style="display: none;"></div>

      <!-- Previous / Next Controls -->
      <button 
        id="lb-prev" 
        style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); background: rgba(255, 255, 255, 0.12); border: none; color: #fff; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;"
        aria-label="Previous image"
      >
        <ChevronLeft size={24} />
      </button>

      <button 
        id="lb-next" 
        style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); background: rgba(255, 255, 255, 0.12); border: none; color: #fff; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;"
        aria-label="Next image"
      >
        <ChevronRight size={24} />
      </button>
    </div>
  </dialog>
</DashboardLayout>

<script is:inline define:vars={{ photos }}>
  function setupLightbox() {
    const dialog = document.getElementById("photo-lightbox");
    const lbImg = document.getElementById("lb-image");
    const lbCaption = document.getElementById("lb-caption");
    const lbCounter = document.getElementById("lb-counter");
    const closeBtn = document.getElementById("lb-close");
    const prevBtn = document.getElementById("lb-prev");
    const nextBtn = document.getElementById("lb-next");
    const figures = document.querySelectorAll(".gallery-figure");

    let currentIndex = 0;
    let lastActiveElement = null;

    function showImage(idx) {
      if (idx < 0) idx = photos.length - 1;
      if (idx >= photos.length) idx = 0;
      currentIndex = idx;

      const p = photos[currentIndex];
      if (lbImg) {
        lbImg.src = p.src;
        lbImg.alt = p.alt;
      }
      if (lbCaption) {
        lbCaption.textContent = p.caption || p.alt;
      }
      if (lbCounter) {
        lbCounter.textContent = `${currentIndex + 1} / ${photos.length}`;
      }
    }

    function openLightbox(idx) {
      lastActiveElement = document.activeElement;
      showImage(idx);
      if (dialog) {
        dialog.style.display = "flex";
        closeBtn?.focus();
        document.body.style.overflow = "hidden";
      }
    }

    function closeLightbox() {
      if (dialog) {
        dialog.style.display = "none";
        document.body.style.overflow = "";
        if (lastActiveElement && typeof lastActiveElement.focus === "function") {
          lastActiveElement.focus();
        }
      }
    }

    figures.forEach((fig) => {
      fig.addEventListener("click", () => {
        const idx = parseInt(fig.getAttribute("data-index") || "0", 10);
        openLightbox(idx);
      });
    });

    closeBtn?.addEventListener("click", closeLightbox);
    prevBtn?.addEventListener("click", () => showImage(currentIndex - 1));
    nextBtn?.addEventListener("click", () => showImage(currentIndex + 1));

    window.addEventListener("keydown", (e) => {
      if (dialog?.style.display === "flex") {
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowLeft") showImage(currentIndex - 1);
        if (e.key === "ArrowRight") showImage(currentIndex + 1);
      }
    });

    dialog?.addEventListener("click", (e) => {
      if (e.target === dialog) closeLightbox();
    });
  }

  document.addEventListener("astro:page-load", setupLightbox);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupLightbox();
  }
</script>
