---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { CheckCircleIcon as CheckCircle2 } from "@phosphor-icons/react";

export const prerender = true;

const certificates = [
  {
    title: "Google Ads Search Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-GOOG-882194",
    skills: ["Search Ads", "Smart Bidding", "Keyword Planning", "ROAS Optimization"],
    description: "Search campaign strategy, high-intent keyword research, and AI-driven smart bidding optimization."
  },
  {
    title: "Google Analytics Certification (GA4)",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-GA4-541298",
    skills: ["GA4 Setup", "Custom Events", "Conversion Funnels", "Audience Builder"],
    description: "Custom event tracking schema, conversion funnel drop-off analysis, and audience segmentation."
  },
  {
    title: "Google Ads Display Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-DISP-339102",
    skills: ["Display Network", "Audience Targeting", "Responsive Display"],
    description: "Targeted audience segments, creative banner testing, and cross-web remarketing funnels."
  },
  {
    title: "Google Ads Video Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-VID-902143",
    skills: ["YouTube Ads", "In-Stream", "Video Action Campaigns"],
    description: "YouTube ad architecture, unskippable bumpers, and Video Action Campaigns for performance conversion."
  },
  {
    title: "Google Shopping Ads Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-SHOP-710492",
    skills: ["Merchant Center", "Product Feeds", "Performance Max"],
    description: "Merchant Center product feed synchronization, catalog optimization, and e-commerce PMax campaigns."
  },
  {
    title: "Google Ads Measurement Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-MEAS-664019",
    skills: ["Conversion Tracking", "Attribution Models", "Enhanced Conversions"],
    description: "Enhanced conversions measurement, data-driven attribution models, and Looker Studio data visualization."
  },
  {
    title: "Google Ads Apps Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-APPS-829104",
    skills: ["App Install Campaigns", "In-App Actions", "Google Play"],
    description: "App user acquisition campaigns and in-app event optimization across Google Play, Search, and YouTube."
  },
  {
    title: "Google Digital Marketing & E-commerce Certificate",
    issuer: "Google via Coursera",
    year: "2024",
    id: "COURSERA-GOOG-992104",
    skills: ["Full-Funnel Strategy", "E-Commerce Growth", "Lifecycle Marketing"],
    description: "Comprehensive professional specialization spanning full-funnel digital marketing and DTC commerce."
  },
  {
    title: "Google AI-Powered Performance Ads Certification",
    issuer: "Google (Skillshop)",
    year: "2024",
    id: "SKILL-AI-304918",
    skills: ["Google AI", "Smart Bidding", "Broad Match AI"],
    description: "Leveraging Google's machine learning, broad match AI bidding, and automated creative asset optimization."
  },
  {
    title: "Google Project Management Professional Certificate",
    issuer: "Google via Coursera",
    year: "2023",
    id: "COURSERA-GOOG-410982",
    skills: ["Agile & Scrum", "Project Governance", "Risk Management"],
    description: "Professional Agile/Scrum project governance, risk mitigation, and cross-functional management."
  }
];
---

<DashboardLayout
  title="Certificates & Credentials — Phuc Loc Nguyen"
  pageTitle="Certificates"
  description="Accredited Google certifications across Google Ads Search, GA4, Performance Max, Measurement, and Coursera."
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Certificates" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Certificates & Credentials</h1>
    <p class="page-lead">
      Accredited credentials from Google Skillshop and Coursera verifying full-funnel paid media, GA4 analytics, and digital commerce ({certificates.length} credentials).
    </p>
  </header>

  <!-- Certificates Grid -->
  <section id="credentials" class="page-section" aria-label="Credentials list">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
      {certificates.map((cert) => (
        <article class="dash-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <span class="dash-tag">{cert.issuer}</span>
              <span style="font-size: 0.75rem; color: var(--dash-muted);">{cert.year}</span>
            </div>

            <h2 class="item-title" style="margin-bottom: 8px;">
              {cert.title}
            </h2>

            <p style="font-size: 0.8125rem; line-height: 1.55; color: var(--dash-muted); margin: 0 0 12px;">
              {cert.description}
            </p>

            <!-- Skills -->
            <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 14px;">
              {cert.skills.map((s) => (
                <span class="dash-tag">{s}</span>
              ))}
            </div>
          </div>

          <!-- Bottom ID Row -->
          <div style="border-top: 1px solid var(--dash-border); padding-top: 10px; display: flex; align-items: center; justify-content: space-between; font-size: 0.75rem; color: var(--dash-muted);">
            <span>ID: <code style="color: var(--dash-text);">{cert.id}</code></span>
            <span style="color: var(--dash-success); display: inline-flex; align-items: center; gap: 4px; font-weight: 500;">
              <CheckCircle2 size={12} aria-hidden="true" />
              <span>Verified</span>
            </span>
          </div>
        </article>
      ))}
    </div>
  </section>
</DashboardLayout>
