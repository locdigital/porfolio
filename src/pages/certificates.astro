---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { CheckCircle2, ChevronRight } from "../components/icons/majesticons";

export const prerender = true;

const certificates = [
  {
    id: "google-ads-search",
    issuer: "Google",
    partner: "Skillshop",
    name: "Ads Search",
    fullName: "Google Ads Search Certification",
    desc: "Search campaign strategy, high-intent keyword planning & AI-driven Smart Bidding optimization.",
    skills: ["Search Ads", "Smart Bidding", "Keyword Planning", "ROAS Optimization", "Quality Score"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "Paid Search",
    color: "#4285F4",
    credentialId: "SKILL-GOOG-882194",
    type: "Skillshop Certification",
  },
  {
    id: "google-analytics-ga4",
    issuer: "Google",
    partner: "Skillshop",
    name: "Analytics (GA4)",
    fullName: "Google Analytics Certification (GA4)",
    desc: "Custom event tracking schema, conversion funnel drop-off analysis, and audience segmentation.",
    skills: ["GA4 Setup", "Custom Events", "Conversion Funnels", "Audience Builder", "BigQuery Export"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "Analytics",
    color: "#34A853",
    credentialId: "SKILL-GA4-541298",
    type: "Platform Certification",
  },
  {
    id: "google-ads-display",
    issuer: "Google",
    partner: "Skillshop",
    name: "Ads Display",
    fullName: "Google Ads Display Certification",
    desc: "Targeted audience segments, visual creative testing, and cross-web remarketing funnels.",
    skills: ["Display Network", "Audience Targeting", "Responsive Display", "Remarketing"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "Display",
    color: "#FBBC05",
    credentialId: "SKILL-DISP-339102",
    type: "Platform Certification",
  },
  {
    id: "google-ads-video",
    issuer: "Google",
    partner: "Skillshop",
    name: "Ads Video",
    fullName: "Google Ads Video Certification",
    desc: "YouTube campaign formats, unskippable bumpers, and Video Action Campaigns for conversions.",
    skills: ["YouTube Ads", "Skippable In-Stream", "Bumper Ads", "Video Action Campaigns"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "Video Ads",
    color: "#EA4335",
    credentialId: "SKILL-VID-902143",
    type: "Platform Certification",
  },
  {
    id: "google-shopping-ads",
    issuer: "Google",
    partner: "Skillshop",
    name: "Shopping Ads",
    fullName: "Google Shopping Ads Certification",
    desc: "Merchant Center product feed synchronization, catalog optimization & Performance Max.",
    skills: ["Merchant Center", "Product Feeds", "Performance Max", "Shopping Campaigns", "ROAS Scaling"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "E-Commerce",
    color: "#4285F4",
    credentialId: "SKILL-SHOP-710492",
    type: "Platform Certification",
  },
  {
    id: "google-ads-measurement",
    issuer: "Google",
    partner: "Skillshop",
    name: "Measurement",
    fullName: "Google Ads Measurement Certification",
    desc: "Enhanced conversions measurement, data-driven attribution models, and Looker Studio data visualization.",
    skills: ["Conversion Tracking", "Attribution Models", "Enhanced Conversions", "Looker Studio"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "Attribution",
    color: "#34A853",
    credentialId: "SKILL-MEAS-664019",
    type: "Platform Certification",
  },
  {
    id: "google-ads-apps",
    issuer: "Google",
    partner: "Skillshop",
    name: "App Campaigns",
    fullName: "Google Ads App Certification",
    desc: "App user acquisition campaigns and in-app event optimization across Google Play, Search, and YouTube.",
    skills: ["App Install Campaigns", "In-App Actions", "Google Play Store", "Asset Clusters"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "App Growth",
    color: "#EA4335",
    credentialId: "SKILL-APPS-829104",
    type: "Platform Certification",
  },
  {
    id: "google-digital-ecommerce",
    issuer: "Google",
    partner: "Coursera",
    name: "Digital & E-Com",
    fullName: "Google Digital Marketing & E-commerce Certificate",
    desc: "Comprehensive professional specialization spanning full-funnel digital marketing and DTC commerce.",
    skills: ["Full-Funnel Strategy", "E-Commerce Growth", "Lifecycle Marketing", "Email Marketing", "SEO"],
    issued: "2024",
    credential: "https://coursera.org/verify/professional-cert/google-digital-marketing",
    tag: "Professional",
    color: "#0056D2",
    credentialId: "COURSERA-GOOG-992104",
    type: "Specialization Certificate",
  },
  {
    id: "google-ai-performance-ads",
    issuer: "Google",
    partner: "Skillshop",
    name: "AI Performance",
    fullName: "Google AI-Powered Performance Ads Certification",
    desc: "Leveraging Google's machine learning, broad match AI bidding, and automated creative asset optimization.",
    skills: ["Google AI", "Smart Bidding", "Performance Max", "Broad Match AI", "Creative Automation"],
    issued: "2024",
    credential: "https://skillshop.credential.net/",
    tag: "AI & Growth",
    color: "#4285F4",
    credentialId: "SKILL-AI-304918",
    type: "Platform Certification",
  },
  {
    id: "google-project-management",
    issuer: "Google",
    partner: "Coursera",
    name: "Project Mgmt",
    fullName: "Google Project Management Professional Certificate",
    desc: "Professional Agile/Scrum project governance, risk mitigation, and cross-functional team execution.",
    skills: ["Agile & Scrum", "Project Governance", "Risk Management", "Stakeholder Communication"],
    issued: "2023",
    credential: "https://coursera.org/verify/professional-cert/google-project-management",
    tag: "Management",
    color: "#0056D2",
    credentialId: "COURSERA-GOOG-410982",
    type: "Specialization Certificate",
  },
];
---

<DashboardLayout
  title="Certificates & Credentials — Phuc Loc Nguyen"
  pageTitle="Certificates"
  description="Accredited Google Skillshop and Coursera professional certifications across Google Ads, Analytics (GA4), Performance Max, Measurement, and AI Workflows."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Certificates" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Certificates & Credentials</h1>
    <p class="page-lead">
      Accredited credentials across paid media, search advertising, analytics, and project governance. Hover any folder to preview the verified certificate or click to inspect credentials.
    </p>
  </header>

  <!-- 5-COLUMN INTERACTIVE FOLDER GRID -->
  <section class="cert-section" aria-label="Certificates collection">
    <div class="folder-grid" role="list">
      {certificates.map((cert, index) => (
        <div class="folder-item" role="listitem">
          <button
            type="button"
            class="folder-wrapper"
            data-folder-trigger
            data-cert-id={cert.id}
            data-cert-index={index}
            aria-label={`Open ${cert.fullName} credentials`}
          >
            <!-- FOLDER 3D CONTAINER -->
            <div class="folder" data-folder-surface>
              <!-- 1. BACK FOLDER FLAP -->
              <div class="folder-back" aria-hidden="true"></div>

              <!-- 2. SECONDARY DOCUMENT (Peeks out behind on hover) -->
              <div class="folder-cert-secondary" aria-hidden="true">
                <div class="cert-secondary-header"></div>
                <div class="cert-secondary-line line-1"></div>
                <div class="cert-secondary-line line-2"></div>
                <div class="cert-secondary-line line-3"></div>
              </div>

              <!-- 3. MAIN COURSERA CERTIFICATE CARD -->
              <div class="folder-cert-card" aria-hidden="true">
                <div class="coursera-card-frame">
                  <div class="cert-mini-titlebar">
                    <span class="cert-mini-dot cert-mini-dot--close"></span>
                    <span class="cert-mini-dot cert-mini-dot--minimize"></span>
                    <span class="cert-mini-dot cert-mini-dot--maximize"></span>
                  </div>
                  <div class="course-logo-preview">
                    <img
                      class="google-wordmark"
                      src="/assets/logos/logo-google-vector-02.png"
                      alt={cert.issuer}
                      loading="lazy"
                      decoding="async"
                    />
                    <strong class="course-logo-name">{cert.name}</strong>
                  </div>
                </div>
              </div>

              <!-- 4. FRONT FOLDER FLAP -->
              <div class="folder-front" aria-hidden="true"></div>
            </div>

            <!-- FOLDER CAPTION -->
            <div class="folder-caption">
              <span class="folder-caption-text">{cert.name}</span>
            </div>
          </button>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       EXPANDED MACOS WINDOW MODAL (CERTIFICATE DETAILS)
       ============================================================ -->
  <div id="cert-modal-root" class="cert-modal-root" aria-hidden="true">
    <!-- Backdrop overlay -->
    <div id="cert-modal-backdrop" class="cert-modal-backdrop"></div>

    <!-- Window Container -->
    <div
      id="cert-modal-window"
      class="cert-modal-window"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cert-modal-title"
    >
      <!-- macOS Window Titlebar -->
      <div class="modal-titlebar">
        <div class="modal-traffic-lights">
          <button
            type="button"
            id="cert-modal-close-dot"
            class="traffic-dot dot-close"
            title="Close Window (Esc)"
            aria-label="Close"
          >
            <svg class="dot-icon" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3.75 3.75L8.25 8.25M8.25 3.75L3.75 8.25" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
            </svg>
          </button>
          <button
            type="button"
            id="cert-modal-minimize-dot"
            class="traffic-dot dot-minimize"
            title="Minimize Window"
            aria-label="Minimize"
          >
            <svg class="dot-icon" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3.2 6H8.8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/>
            </svg>
          </button>
          <span class="traffic-dot dot-expand" aria-hidden="true">
            <svg class="dot-icon" viewBox="0 0 12 12">
              <path d="M3.2 8.8L8.8 3.2M5.2 3.2H8.8V6.8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
        <div class="modal-titlebar-title">
          <span id="cert-modal-window-title">Certificate Credentials</span>
        </div>
      </div>

      <!-- Window Content Container -->
      <div id="cert-modal-content" class="modal-content">
        <!-- Top Hero Card with Coursera styling -->
        <div class="modal-hero-banner" id="cert-modal-banner">
          <div class="modal-hero-meta">
            <div class="modal-badge-row">
              <span id="cert-modal-tag" class="modal-pill-tag">Paid Search</span>
              <span class="modal-verified-badge">
                <CheckCircle2 size={13} aria-hidden="true" />
                Verified Active
              </span>
            </div>
            <h2 id="cert-modal-title" class="modal-main-title">Certification Title</h2>
            <p id="cert-modal-issuer-row" class="modal-issuer-text">Issued by Google · 2024</p>
          </div>
        </div>

        <!-- Details Body -->
        <div class="modal-body-grid">
          <div class="modal-body-left">
            <h3 class="modal-subhead">Overview</h3>
            <p id="cert-modal-desc" class="modal-desc-text">Description goes here</p>

            <h3 class="modal-subhead" style="margin-top: 18px;">Skills & Competencies</h3>
            <div id="cert-modal-skills" class="modal-skills-list"></div>
          </div>

          <div class="modal-body-right">
            <div class="modal-info-card">
              <div class="info-row">
                <span class="info-label">Credential ID</span>
                <span id="cert-modal-id" class="info-val font-mono">SKILL-00000</span>
              </div>
              <div class="info-row">
                <span class="info-label">Issue Year</span>
                <span id="cert-modal-year" class="info-val">2024</span>
              </div>
              <div class="info-row">
                <span class="info-label">Platform</span>
                <span id="cert-modal-platform" class="info-val">Skillshop / Coursera</span>
              </div>
            </div>

            <!-- Action CTA -->
            <a
              id="cert-modal-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="modal-verify-btn"
            >
              <span>Verify Official Credential</span>
              <ChevronRight size={14} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Certificate Data injected for Client Script -->
  <script is:inline define:vars={{ certificates }}>
    window.__CERTIFICATES_DATA__ = certificates;
  </script>
</DashboardLayout>

<style>
  /* ── Page Section ── */
  .cert-section {
    padding: 0 0 64px;
  }

  /* ── 5-Column Grid Layout (Exactly 5 folders per row) ── */
  .folder-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-column-gap: 20px;
    grid-row-gap: 82px;
    padding-top: 56px;
    padding-bottom: 24px;
  }

  /* ── Folder Item Container ── */
  .folder-item {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .folder-wrapper {
    position: relative;
    width: 100%;
    max-width: 156px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .folder-wrapper:focus-visible {
    outline: none;
  }

  .folder-wrapper:focus-visible .folder {
    outline: 2px solid var(--dash-accent);
    outline-offset: 4px;
    border-radius: 12px;
  }

  /* ── Hover Bridge ── */
  .folder-wrapper::before {
    content: "";
    position: absolute;
    top: -85px;
    left: -20px;
    right: -20px;
    bottom: 0;
    pointer-events: none;
    z-index: 10;
  }

  .folder-wrapper:hover::before,
  .folder-wrapper:focus-visible::before {
    pointer-events: auto;
  }

  /* ── Folder 3D Container ── */
  .folder {
    position: relative;
    width: 100%;
    max-width: 156px;
    aspect-ratio: 480 / 379;
    perspective: 800px;
  }

  /* ── 1. SECONDARY DOCUMENT (Peeks out behind on hover) ── */
  .folder-cert-secondary {
    position: absolute;
    left: 50%;
    bottom: 32px;
    width: 108px;
    height: 70px;
    background: #ffffff;
    border-radius: 7px;
    border: 0;
    box-shadow:
      inset 0 0 0 1px rgba(0, 86, 210, 0.06),
      0 8px 18px -14px rgba(12, 22, 38, 0.18);
    z-index: 2;
    padding: 10px 12px;
    transform: translateX(-50%) translateY(0) rotate(0deg);
    transform-origin: bottom center;
    opacity: 0.58;
    pointer-events: none;
    transition:
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 480ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cert-secondary-header {
    height: 4px;
    width: 28px;
    background: rgba(0, 86, 210, 0.3);
    border-radius: 2px;
    margin-bottom: 8px;
  }

  .cert-secondary-line {
    height: 3px;
    background: rgba(0, 86, 210, 0.1);
    border-radius: 2px;
    margin-bottom: 5px;
  }
  .cert-secondary-line.line-1 { width: 85%; }
  .cert-secondary-line.line-2 { width: 65%; }
  .cert-secondary-line.line-3 { width: 45%; }

  .folder-wrapper:hover .folder-cert-secondary,
  .folder-wrapper:focus-visible .folder-cert-secondary {
    transform: translateX(-50%) translateY(-30px) translateX(10px) rotate(5deg);
    opacity: 0.76;
    box-shadow:
      inset 0 0 0 1px rgba(0, 86, 210, 0.05),
      0 10px 22px -12px rgba(12, 22, 38, 0.18);
  }

  /* ── 2. MAIN COURSERA CERTIFICATE CARD ── */
  .folder-cert-card {
    --cert-outer-radius: 8px;
    --cert-inset: 3px;
    position: absolute;
    left: 50%;
    bottom: 30px;
    width: 112px;
    height: 76px;
    background: #ffffff;
    border-radius: var(--cert-outer-radius);
    border: 0;
    box-shadow:
      inset 0 0 0 1px rgba(0, 86, 210, 0.08),
      0 2px 8px rgba(12, 22, 38, 0.06),
      0 10px 24px -14px rgba(12, 22, 38, 0.16);
    z-index: 3;
    padding: var(--cert-inset);
    box-sizing: border-box;
    transform: translateX(-50%) translateY(0) rotate(0deg);
    transform-origin: bottom center;
    pointer-events: none;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Coursera Card Hover Animation: Slides gracefully out of folder! */
  .folder-wrapper:hover .folder-cert-card,
  .folder-wrapper:focus-visible .folder-cert-card {
    transform: translateX(-50%) translateY(-46px) translateX(-4px) rotate(-3deg);
    box-shadow:
      inset 0 0 0 1px rgba(0, 86, 210, 0.07),
      0 5px 16px rgba(0, 0, 0, 0.06),
      0 22px 42px -12px rgba(12, 22, 38, 0.22);
  }

  .coursera-card-frame {
    height: 100%;
    width: 100%;
    border-radius: max(0px, calc(var(--cert-outer-radius) - var(--cert-inset)));
    background: #ffffff;
    padding: 0;
    display: grid;
    grid-template-rows: 18px minmax(0, 1fr);
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .coursera-card-frame::before {
    content: none;
  }

  .cert-mini-titlebar {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    padding: 0 8px;
    background: #dfe7fb;
    box-shadow: inset 0 -1px 0 rgba(0, 86, 210, 0.05);
  }

  .cert-mini-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.18);
    flex: 0 0 auto;
  }

  .cert-mini-dot--close {
    background: #ff5f57;
  }

  .cert-mini-dot--minimize {
    background: #ffbd2e;
  }

  .cert-mini-dot--maximize {
    background: #28c840;
  }

  .course-logo-preview {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 4px;
    text-align: center;
    padding: 7px 9px 8px;
    box-sizing: border-box;
  }

  .google-wordmark {
    width: 62px;
    height: 19px;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  .course-logo-name {
    max-width: 100%;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.08;
    color: #0056d2;
    letter-spacing: -0.04em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Folder Caption ── */
  .folder-caption {
    margin-top: 10px;
    display: flex;
    justify-content: center;
    text-align: center;
    width: 100%;
  }

  .folder-caption-text {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--dash-text);
    transition: color 150ms ease;
  }

  .folder-wrapper:hover .folder-caption-text {
    color: var(--dash-accent);
  }

  /* ── Responsive Breakpoints ── */
  @media (max-width: 1100px) and (min-width: 769px) {
    .folder-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-column-gap: 14px;
      grid-row-gap: 76px;
    }
  }

  @media (max-width: 768px) {
    /* Mobile Horizontal Carousel: Smooth snap scrolling */
    .folder-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: visible;
      overscroll-behavior-x: contain;
      touch-action: pan-x pan-y;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 8px;
      -webkit-overflow-scrolling: touch;
      gap: 18px;
      margin-inline: -8px;
      padding-inline: 8px;
      padding-top: 52px;
      padding-bottom: 24px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .folder-grid::-webkit-scrollbar {
      display: none;
    }

    .folder-item {
      flex: 0 0 148px;
      width: 148px;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 359px) {
    .folder-grid {
      margin-inline: -8px;
      padding-inline: 8px;
      scroll-padding-inline: 8px;
      gap: 14px;
    }

    .folder-item {
      flex: 0 0 138px;
      width: 138px;
    }
  }

  /* ============================================================
     EXPANDED MACOS WINDOW MODAL
     ============================================================ */
  .cert-modal-root {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .cert-modal-root.is-open {
    display: flex;
  }

  .cert-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: modalFadeIn 200ms ease forwards;
  }

  .cert-modal-window {
    --modal-outer-radius: 16px;
    --modal-padding: 0px;
    position: relative;
    width: 100%;
    max-width: 600px;
    background: var(--dash-bg);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    border-radius: var(--modal-outer-radius);
    box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    z-index: 1;
    animation: modalScaleIn 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes modalScaleIn {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .modal-titlebar {
    height: 40px;
    background: var(--dash-surface);
    border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    user-select: none;
  }

  .modal-traffic-lights {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 80px;
  }

  .traffic-dot {
    position: relative;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: block;
    flex: 0 0 12px;
