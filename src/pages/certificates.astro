<script is:inline>
  function setupCertificateModal() {
    const modalRoot = document.getElementById("cert-modal-root");
    const backdrop = document.getElementById("cert-modal-backdrop");
    const closeBtn = document.getElementById("cert-modal-close-dot");
    const minimizeBtn = document.getElementById("cert-modal-minimize-dot");

    const modalTitle = document.getElementById("cert-modal-title");
    const modalIssuer = document.getElementById("cert-modal-issuer-row");
    const modalDesc = document.getElementById("cert-modal-desc");
    const modalTag = document.getElementById("cert-modal-tag");
    const modalId = document.getElementById("cert-modal-id");
    const modalYear = document.getElementById("cert-modal-year");
    const modalPlatform = document.getElementById("cert-modal-platform");
    const modalSkills = document.getElementById("cert-modal-skills");
    const modalLink = document.getElementById("cert-modal-link");
    const modalWindowTitle = document.getElementById("cert-modal-window-title");

    const certData = window.__CERTIFICATES_DATA__ || [];

    function openModal(cert) {
      if (!cert || !modalRoot) return;

      if (modalTitle) modalTitle.textContent = cert.fullName;
      if (modalIssuer) modalIssuer.textContent = `Issued by ${cert.issuer} · ${cert.issued}`;
      if (modalDesc) modalDesc.textContent = cert.desc;
      if (modalTag) modalTag.textContent = cert.tag;
      if (modalId) modalId.textContent = cert.credentialId;
      if (modalYear) modalYear.textContent = cert.issued;
      if (modalPlatform) modalPlatform.textContent = `${cert.issuer} (${cert.partner || "Skillshop"})`;
      if (modalWindowTitle) modalWindowTitle.textContent = cert.fullName;

      if (modalLink) {
        modalLink.href = cert.credential;
      }

      if (modalSkills) {
        modalSkills.innerHTML = "";
        cert.skills.forEach((skill) => {
          const pill = document.createElement("span");
          pill.className = "modal-skill-pill";
          pill.textContent = skill;
          modalSkills.appendChild(pill);
        });
      }

      modalRoot.classList.add("is-open");
      modalRoot.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modalRoot) return;
      modalRoot.classList.remove("is-open");
      modalRoot.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    const triggers = document.querySelectorAll("[data-folder-trigger]");
    triggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = parseInt(btn.getAttribute("data-cert-index") || "0", 10);
        const cert = certData[index];
        if (cert) openModal(cert);
      });
    });

    closeBtn?.addEventListener("click", closeModal);
    minimizeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modalRoot?.classList.contains("is-open")) {
        closeModal();
      }
    });
  }

  document.addEventListener("astro:page-load", setupCertificateModal);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupCertificateModal();
  }
</script>
