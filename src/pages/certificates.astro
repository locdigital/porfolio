---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";
import { CertificatesGallery } from "@/components/ui/CertificatesGallery";

export const prerender = true;

const certTitle = "Coursera Certificates | Phuc Loc Nguyen";
const certDescription = "A minimal archive of Coursera certificates and specializations relevant to performance marketing, analytics, SEO, e-commerce, and AI workflows.";
---

<Layout
  title={certTitle}
  description={certDescription}
  schema={pageSchema({
    url: absoluteUrl("/certificates"),
    title: certTitle,
    description: certDescription,
    type: "WebPage",
  })}
>
  <main class="certificates-page">
    <div class="certificates-shell">
      <section class="certificates-hero certificates-hero--minimal toki-r" data-d="1" aria-label="Certificates introduction">
        <div class="certificates-hero-main t-stagger">
          <div class="page-kicker-wrapper">
            <span class="page-kicker-text">Coursera Certificates</span>
          </div>

          <h1 class="certificates-title t-stagger-line t-stagger-line--1">
            Coursera archive, <em>kept quiet.</em>
          </h1>

          <p class="certificates-intro t-stagger-line t-stagger-line--2">
            A minimal index of Coursera programs that map to performance media, commerce, analytics, SEO, and automation work.
          </p>
        </div>
      </section>

      <section class="certificates-gallery-section toki-r" data-d="2" aria-label="Verified credentials gallery">
        <CertificatesGallery client:load />
      </section>

      <section class="certificates-audit toki-r" data-d="3" aria-label="Credential verification request">
        <div>
          <span>Source links</span>
          <h2>Need the original Coursera pages?</h2>
          <p>
            Each row opens with a short summary and a direct link to the corresponding Coursera program page.
          </p>
        </div>

        <a href="https://www.coursera.org/" target="_blank" rel="noopener noreferrer" class="certificates-audit-link">
          Browse Coursera
        </a>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  .certificates-page {
    min-height: 100dvh;
    padding: calc(var(--hdr-h) + clamp(44px, 6vw, 76px)) 0 112px;
    background: var(--bg);
    color: var(--text);
  }

  .certificates-shell {
    width: min(calc(100% - (var(--page-gutter) * 2)), var(--main-content-max));
    max-width: var(--main-content-max);
    margin: 0 auto;
    padding-inline: 0;
  }

  .certificates-hero {
    padding-bottom: clamp(44px, 7vw, 80px);
    border-bottom: 1px solid var(--divider);
  }

  .certificates-hero-main {
    max-width: 880px;
  }

  .certificates-title {
    max-width: 980px;
    margin: 0;
    font-family: var(--serif);
    font-size: var(--fs-display);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  .certificates-title em {
    color: var(--accent);
    font-style: italic;
  }

  .certificates-intro {
    max-width: 62ch;
    margin-top: clamp(20px, 2.8vw, 30px);
    font-family: var(--sans);
    font-size: var(--type-body);
    font-weight: 500;
    line-height: 1.66;
    color: var(--muted);
    text-wrap: pretty;
  }

  .certificates-gallery-section {
    padding-top: clamp(42px, 6vw, 72px);
  }

  .certificates-audit {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-top: clamp(56px, 7vw, 88px);
    padding-top: 28px;
    border-top: 1px solid var(--divider);
  }

  .certificates-audit span {
    display: block;
    margin-bottom: 12px;
    font-family: var(--mono);
    font-size: var(--type-caption);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .certificates-audit h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: var(--type-section-title);
    font-weight: 400;
    line-height: 1.06;
    color: var(--text);
    text-wrap: balance;
  }

  .certificates-audit p {
    max-width: 64ch;
    margin: 0;
    font-family: var(--sans);
    font-size: var(--type-body);
    line-height: 1.65;
    color: var(--muted);
  }

  .certificates-audit a:not(.certificates-audit-link) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .certificates-audit-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid var(--text);
    border-radius: 999px;
    background: var(--text);
    color: #fff;
    font-family: var(--mono);
    font-size: var(--type-caption);
    text-decoration: none;
    transition: transform 180ms var(--spring), background 180ms var(--spring), color 180ms var(--spring);
  }

  .certificates-audit-link:hover,
  .certificates-audit-link:focus-visible {
    transform: translateY(-2px);
    background: var(--accent);
    border-color: var(--accent);
  }

  .cert-gallery {
    display: grid;
    gap: 24px;
  }

  .cert-gallery-head {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--divider);
  }

  .cert-gallery-head span {
    display: block;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: var(--type-caption);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .cert-gallery-head h2 {
    margin: 0;
    font-family: var(--sans);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cert-gallery-head p {
    max-width: 620px;
    margin: 0;
    font-family: var(--sans);
    font-size: var(--type-body);
    line-height: 1.7;
    color: var(--muted);
    text-wrap: pretty;
  }

  .cert-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 16px;
    align-items: center;
  }

  .cert-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .cert-tabs::-webkit-scrollbar {
    display: none;
  }

  .cert-tabs button,
  .cert-search,
  .cert-empty button,
  .cert-modal-actions button,
  .cert-modal-actions a {
    font-family: var(--mono);
    font-size: calc(var(--type-caption) * 0.86);
  }

  .cert-tabs button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 11px;
    border: 1px solid var(--divider);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background 180ms var(--spring), border-color 180ms var(--spring), color 180ms var(--spring);
  }

  .cert-tabs button:hover,
  .cert-tabs button:focus-visible {
    border-color: rgba(28, 28, 28, 0.24);
    color: var(--text);
  }

  .cert-tabs button.is-active {
    background: var(--text);
    border-color: var(--text);
    color: #fff;
  }

  .cert-tabs strong {
    font: inherit;
    color: inherit;
    opacity: 0.64;
  }

  .cert-search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: 36px;
    border: 1px solid var(--divider);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
  }

  .cert-search svg {
    position: absolute;
    left: 13px;
    width: 15px;
    height: 15px;
    pointer-events: none;
  }

  .cert-search input {
    width: 100%;
    height: 100%;
    padding: 0 36px 0 36px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--sans);
    font-size: var(--type-caption);
  }

  .cert-search input::placeholder {
    color: rgba(110, 110, 110, 0.78);
  }

  .cert-search:focus-within {
    border-color: var(--accent);
    box-shadow: var(--focus-ring);
  }

  .cert-search button {
    position: absolute;
    right: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .cert-search button:hover,
  .cert-search button:focus-visible {
    background: rgba(28, 28, 28, 0.06);
    color: var(--text);
  }

  .cert-search button svg {
    position: static;
    width: 14px;
    height: 14px;
  }

  .cert-list {
    border-top: 1px solid var(--divider);
  }

  .cert-row {
    border-bottom: 1px solid var(--divider);
  }

  .cert-row button {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) minmax(180px, 0.34fr) 116px;
    gap: clamp(18px, 3vw, 36px);
    align-items: start;
    width: 100%;
    padding: 26px 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 180ms var(--spring), background 180ms var(--spring);
  }

  .cert-row button:hover,
  .cert-row button:focus-visible {
    color: var(--accent);
  }

  .cert-row-index,
  .cert-row-category,
  .cert-row-copy strong,
  .cert-row-action {
    font-family: var(--mono);
    font-size: calc(var(--type-caption) * 0.86);
    line-height: 1.4;
    color: var(--muted);
  }

  .cert-row-index {
    color: var(--text);
  }

  .cert-row-category {
    display: block;
    margin-bottom: 8px;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .cert-row h3 {
    max-width: 780px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.22rem + 0.72vw, 2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--text);
    text-wrap: balance;
    transition: color 180ms var(--spring);
  }

  .cert-row button:hover h3,
  .cert-row button:focus-visible h3 {
    color: var(--accent);
  }

  .cert-row-copy strong {
    display: block;
    margin-top: 9px;
    font-weight: 400;
  }

  .cert-row-copy p {
    max-width: 72ch;
    margin: 12px 0 0;
    font-family: var(--sans);
    font-size: var(--type-caption);
    line-height: 1.68;
    color: var(--muted);
    text-wrap: pretty;
  }

  .cert-row-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding-top: 2px;
  }

  .cert-row-skills span,
  .cert-modal-skills span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 8px;
    border: 1px solid var(--divider);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--sans);
    font-size: calc(var(--type-caption) * 0.86);
    font-weight: 600;
    line-height: 1;
  }

  .cert-row-action {
    display: grid;
    justify-items: end;
    gap: 14px;
    color: var(--muted);
  }

  .cert-row-action > span:last-child {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text);
  }

  .cert-row-action svg {
    width: 14px;
    height: 14px;
    transition: transform 180ms var(--spring);
  }

  .cert-row button:hover .cert-row-action svg,
  .cert-row button:focus-visible .cert-row-action svg {
    transform: translate(2px, -2px);
  }

  .cert-empty {
    display: grid;
    place-items: center;
    gap: 10px;
    min-height: 280px;
    padding: 36px;
    border: 1px dashed rgba(28, 28, 28, 0.24);
    border-radius: var(--image-radius);
    color: var(--muted);
    text-align: center;
  }

  .cert-empty svg {
    width: 28px;
    height: 28px;
    color: var(--accent);
  }

  .cert-empty h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--type-card-title);
    font-weight: 400;
    color: var(--text);
  }

  .cert-empty p {
    max-width: 42ch;
    margin: 0;
    font-family: var(--sans);
    font-size: var(--type-caption);
    line-height: 1.6;
  }

  .cert-empty button {
    min-height: 38px;
    margin-top: 6px;
    padding: 0 14px;
    border: 1px solid var(--text);
    border-radius: 999px;
    background: var(--text);
    color: #fff;
    cursor: pointer;
  }

  .cert-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 18px;
    background:
      radial-gradient(circle at 50% 46%, rgba(250, 250, 247, 0.18), transparent 34%),
      rgba(18, 18, 18, 0.58);
    backdrop-filter: blur(16px) saturate(1.08);
    animation: cert-backdrop-in 180ms var(--spring) both;
  }

  .cert-modal {
    position: relative;
    width: min(100%, 640px);
    max-height: min(760px, calc(100dvh - 36px));
    overflow: auto;
    padding: clamp(18px, 3vw, 24px);
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(250, 250, 247, 0.96)),
      var(--bg);
    box-shadow:
      0 34px 90px rgba(18, 18, 18, 0.24),
      inset 0 0 0 1px rgba(28, 28, 28, 0.06);
    animation: cert-modal-in 260ms var(--spring) both;
  }

  .cert-modal::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 0%, rgba(0, 117, 222, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.36), transparent 28%);
  }

  .cert-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(28, 28, 28, 0.1);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.72);
    color: var(--muted);
    cursor: pointer;
    transition: background 180ms var(--spring), color 180ms var(--spring), transform 180ms var(--spring);
    z-index: 2;
  }

  .cert-modal-close:hover,
  .cert-modal-close:focus-visible {
    transform: rotate(6deg) scale(1.04);
    background: var(--text);
    color: #fff;
  }

  .cert-modal-close svg {
    width: 16px;
    height: 16px;
  }

  .cert-modal-header,
  .cert-modal-section,
  .cert-modal-status,
  .cert-modal-actions {
    position: relative;
    z-index: 1;
  }

  .cert-modal-header {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 18px;
    padding: clamp(8px, 1vw, 10px) 48px 24px 0;
  }

  .cert-modal-mark {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 1px solid rgba(0, 117, 222, 0.22);
    border-radius: 18px;
    background: rgba(0, 117, 222, 0.07);
    color: var(--accent);
    font-family: var(--serif);
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1;
  }

  .cert-modal-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: calc(var(--type-caption) * 0.86);
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cert-modal h2 {
    margin: 16px 0 10px;
    font-family: var(--serif);
    font-size: clamp(2.35rem, 6vw, 4.1rem);
    font-weight: 400;
    line-height: 0.96;
    color: var(--text);
    text-wrap: balance;
  }

  .cert-modal-issuer {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--type-caption);
    color: var(--muted);
  }

  .cert-modal-section {
    padding: 18px;
    border: 1px solid rgba(28, 28, 28, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.42);
  }

  .cert-modal-section + .cert-modal-section {
    margin-top: 10px;
  }

  .cert-modal-section > span,
  .cert-modal-status > span {
    display: block;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: calc(var(--type-caption) * 0.86);
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cert-modal-section p {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--type-caption);
    line-height: 1.72;
    color: #555;
  }

  .cert-modal-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .cert-modal-status {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 18px;
    align-items: center;
    margin-top: 10px;
    padding: 16px 18px;
    border: 1px solid rgba(39, 145, 141, 0.2);
    border-radius: 18px;
    background: rgba(39, 145, 141, 0.07);
  }

  .cert-modal-status strong {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: var(--type-caption) !important;
    color: #16706d;
  }

  .cert-modal-status strong svg {
    width: 16px;
    height: 16px;
  }

  .cert-modal-status small {
    grid-column: 1 / -1;
    font-family: var(--mono);
    font-size: calc(var(--type-caption) * 0.86);
    color: var(--muted);
  }

  .cert-modal-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 18px;
  }

  .cert-modal-actions button,
  .cert-modal-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    padding: 0 17px;
    border: 1px solid rgba(28, 28, 28, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.36);
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
    transition: background 180ms var(--spring), color 180ms var(--spring), transform 180ms var(--spring), border-color 180ms var(--spring);
  }

  .cert-modal-actions button:hover,
  .cert-modal-actions button:focus-visible,
  .cert-modal-actions a:hover,
  .cert-modal-actions a:focus-visible {
    transform: translateY(-2px);
  }

  .cert-modal-actions a {
    border-color: var(--text);
    background: var(--text);
    color: #fff;
  }

  .cert-modal-actions a:hover,
  .cert-modal-actions a:focus-visible {
    border-color: var(--accent);
    background: var(--accent);
  }

  .cert-modal-actions svg {
    width: 15px;
    height: 15px;
  }

  @keyframes cert-backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes cert-modal-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-modal-backdrop,
    .cert-modal {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .certificates-hero,
    .cert-gallery-head {
      grid-template-columns: 1fr;
    }

    .certificates-title {
      font-size: clamp(3.4rem, 13vw, 5rem);
    }

    .certificates-audit {
      align-items: flex-start;
      flex-direction: column;
    }

    .cert-toolbar {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .cert-search {
      width: 100%;
      min-width: 0;
    }

    .cert-row button {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 14px 18px;
      padding: 22px 0;
    }

    .cert-row-skills,
    .cert-row-action {
      grid-column: 2;
    }

    .cert-row-action {
      display: flex;
      justify-content: space-between;
      justify-items: start;
      width: 100%;
    }
  }

  @media (max-width: 620px) {
    .certificates-page {
      padding-top: calc(var(--hdr-h) + 44px);
      padding-bottom: 76px;
    }

    .certificates-title {
      font-size: clamp(3rem, 14vw, 4.2rem);
    }

    .certificates-intro,
    .certificates-audit p {
      font-size: var(--type-caption);
    }

    .cert-row button {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .cert-row-index,
    .cert-row-skills,
    .cert-row-action {
      grid-column: 1;
    }

    .cert-row-skills {
      padding-top: 0;
    }

    .cert-modal {
      border-radius: 22px;
      padding: 18px;
    }

    .cert-modal-header {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-right: 42px;
      padding-bottom: 18px;
    }

    .cert-modal-mark {
      width: 48px;
      height: 48px;
      border-radius: 15px;
      font-size: 2rem;
    }

    .cert-modal h2 {
      font-size: clamp(2.05rem, 11vw, 3rem);
    }

    .cert-modal-status {
      grid-template-columns: 1fr;
    }

