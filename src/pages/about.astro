---
import Layout from "../layouts/Layout.astro";
import { Picture, Image } from "astro:assets";
import { getPhotoAsset } from "../lib/photo-assets";

const heroAbout = getPhotoAsset("/assets/photos/img-portfolio/hero-about.webp");
---

<Layout title="About | Phuc Loc Nguyen">
  <main class="gear-page">
    <div class="gear-container">
      
      <!-- HERO SECTION -->
      <section class="gear-hero toki-r" data-d="1" aria-label="About me">
        <p class="gear-kicker">About me</p>
        <h1>Digital marketer who scales brands with <em>data & code</em></h1>
        <p class="gear-intro">
          Hi, I'm Loc 👋 I'm a Performance-driven Digital Marketer based in Ho Chi Minh City, Vietnam. My passion is in creating data-driven campaigns and useful solutions to marketing problems that don't have obvious answers.
        </p>
      </section>

      <!-- EXPERIENCE SECTION -->
      <section class="min-section toki-r" data-d="2">
        <h2 class="min-section-title">My Experience</h2>
        <p class="min-section-desc">Selected roles spanning performance media buying, search strategy, and brand campaigns.</p>
        <div class="min-list">
          <div class="min-row">
            <div class="col-main">WorkFlow Space</div>
            <div class="col-desc">Digital Marketing Specialist</div>
            <div class="col-meta">2024 – Present</div>
          </div>
          <div class="min-row">
            <div class="col-main">PlayAh!</div>
            <div class="col-desc">Digital Marketing Specialist</div>
            <div class="col-meta">2024 – Present</div>
          </div>
          <div class="min-row">
            <div class="col-main">POPS Worldwide</div>
            <div class="col-desc">SEO Executive</div>
            <div class="col-meta">2023 – 2024</div>
          </div>
          <div class="min-row">
            <div class="col-main">PNJ</div>
            <div class="col-desc">Digital Marketing Specialist</div>
            <div class="col-meta">2022 – 2023</div>
          </div>
          <div class="min-row">
            <div class="col-main">Sony</div>
            <div class="col-desc">Digital Marketing Specialist</div>
            <div class="col-meta">2021 – 2022</div>
          </div>
        </div>
      </section>

      <!-- FEATURED PROJECTS -->
      <section class="min-section toki-r" data-d="3">
        <h2 class="min-section-title">Featured Projects</h2>
        <p class="min-section-desc">Campaigns and platforms built and managed for top consumer brands.</p>
        <div class="min-list">
          <a href="/work/playah" class="min-row is-link">
            <div class="col-main">PlayAh!</div>
            <div class="col-desc">Brand Growth & Performance Ads</div>
            <div class="col-meta">playahvietnam.com →</div>
          </a>
          <a href="/work/workflow-space" class="min-row is-link">
            <div class="col-main">WorkFlow Space</div>
            <div class="col-desc">Community & Content Strategy</div>
            <div class="col-meta">workflowspace.vn →</div>
          </a>
          <a href="/work/pnj" class="min-row is-link">
            <div class="col-main">PNJ</div>
            <div class="col-desc">E-commerce Campaigns & Shopping</div>
            <div class="col-meta">pnj.com.vn →</div>
          </a>
          <a href="/work/pops-worldwide" class="min-row is-link">
            <div class="col-main">POPS Worldwide</div>
            <div class="col-desc">SEO & Search Strategy</div>
            <div class="col-meta">pops.vn →</div>
          </a>
          <a href="/work/sony-vietnam" class="min-row is-link">
            <div class="col-main">Sony Vietnam</div>
            <div class="col-desc">Brand Awareness & Lead Gen</div>
            <div class="col-meta">sony.com.vn →</div>
          </a>
        </div>
      </section>

      <!-- TOOLSET & SKILLS -->
      <section class="min-section toki-r" data-d="4">
        <h2 class="min-section-title">Toolset & Skills</h2>
        <p class="min-section-desc">Technologies and skills I use to build workflows and run growth experiments.</p>
        <div class="min-list">
          <div class="min-row">
            <div class="col-main">Meta Ads</div>
            <div class="col-desc">Paid Social Campaigns</div>
            <div class="col-meta">facebook.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">Google Ads</div>
            <div class="col-desc">Search, Shopping & Display</div>
            <div class="col-meta">ads.google.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">TikTok Ads</div>
            <div class="col-desc">Paid Social Campaigns</div>
            <div class="col-meta">ads.tiktok.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">Google Analytics</div>
            <div class="col-desc">Data Audits & GA4 Reporting</div>
            <div class="col-meta">analytics.google.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">Figma</div>
            <div class="col-desc">Interface Design & Creative Mockups</div>
            <div class="col-meta">figma.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">Zapier</div>
            <div class="col-desc">Marketing & Workflow Automation</div>
            <div class="col-meta">zapier.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">Ahrefs</div>
            <div class="col-desc">SEO Keyword & Competitor Research</div>
            <div class="col-meta">ahrefs.com ↗</div>
          </div>
          <div class="min-row">
            <div class="col-main">Notion</div>
            <div class="col-desc">Docs, Wiki & Project Hub</div>
            <div class="col-meta">notion.so ↗</div>
          </div>
        </div>
      </section>

      <!-- EDUCATION & CREDENTIALS -->
      <section class="min-section toki-r" data-d="5">
        <h2 class="min-section-title">Education & Credentials</h2>
        <p class="min-section-desc">Formal degree and professional marketing certifications.</p>
        <div class="min-list">
          <div class="min-row">
            <div class="col-main">University Name</div>
            <div class="col-desc">Bachelor's Degree</div>
            <div class="col-meta">2017 – 2021</div>
          </div>
          <div class="min-row">
            <div class="col-main">Google</div>
            <div class="col-desc">Digital Marketing Specialization</div>
            <div class="col-meta">Issued 2022 ↗</div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .about-minimal-page {
    padding: calc(var(--hdr-h) + 64px) 0 120px;
    background: transparent;
  }

  .about-minimal-container {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--px);
  }

  /* ── Hero section ── */
  .about-min-hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 96px;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
  }

  .hero-main-title {
    font-family: var(--serif);
    font-size: clamp(38px, 5.5vw, 64px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 24px;
  }

  .hero-sub {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
  }

  .hero-bio p {
    font-size: 15px;
    line-height: 1.72;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .hero-links {
    display: flex;
    gap: 24px;
    margin-top: 16px;
  }

  .min-link {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--divider);
    transition: all 0.25s ease;
  }

  .min-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero-right {
    position: relative;
  }

  .hero-right img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--divider);
    filter: grayscale(0.15);
    transition: filter 0.3s ease;
  }

  .hero-right img:hover {
    filter: grayscale(0);
  }

  /* ── Sections ── */
  .min-section {
    margin-bottom: 72px;
  }

  .min-section-title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .min-section-desc {
    font-size: 13.5px;
    color: var(--muted);
    margin-bottom: 24px;
  }

  /* ── Rows ── */
  .min-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--divider);
  }

  .min-row {
    display: grid;
    grid-template-columns: 1.2fr 1.6fr 1.2fr;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--divider);
    font-size: 14.5px;
    align-items: center;
    color: var(--text);
    transition: all 0.2s ease;
  }

  a.min-row {
    text-decoration: none;
  }

  a.min-row:hover {
    background: rgba(0, 0, 0, 0.015);
    padding-left: 8px;
    padding-right: 8px;
    color: var(--accent);
  }

  .col-main {
    font-weight: 600;
  }

  .col-desc {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  a.min-row:hover .col-desc {
    color: var(--text);
  }

  .col-meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    text-align: right;
    transition: color 0.2s ease;
  }

  a.min-row:hover .col-meta {
    color: var(--accent);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .about-min-hero {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 64px;
    }

    .hero-right {
      order: -1;
      max-width: 300px;
    }

    .min-row {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 16px 0;
    }

    .col-meta {
      grid-column: 1 / -1;
      text-align: left;
      margin-top: 2px;
    }
  }
</style>
