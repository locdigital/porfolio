---
import Layout from "../layouts/Layout.astro";
---
<Layout title="About | Phuc Loc Nguyen">
  <main style="display:flex;flex-direction:column;padding-top:120px;min-height:80vh;">
    <!-- ABOUT ––––––––––––––––––––––––––––––––– -->
    <section class="about" id="about" aria-label="About me">
      <div class="container">
        <div class="sh r">
          <span class="sh-title" data-parallax=".1">About Me</span>
          <span class="sh-number" data-parallax=".3">01</span>
        </div>

        <div class="about-layout r" style="margin-top: 40px;">
          <div class="about-prose" style="font-size: 1.1rem; line-height: 1.6;">
            <p>I'm Phuc Loc — a Performance-driven Digital Marketing professional based in Ho Chi Minh City. Over the past 4+ years, I've specialized in growth marketing, paid media management, and SEO.</p>
            <p>My expertise lies in planning and optimizing multi-channel campaigns across Google Ads, Meta, and TikTok. I've successfully scaled website revenues, achieved massive GMV growth on TikTok Shop, and managed large-scale budgets with a rigorous focus on ROAS, CPA, and budget efficiency.</p>
            <p>Beyond paid media, I have hands-on experience in building marketing automation workflows (N8N, AI funnels), technical SEO, and data-driven decision making. I also co-founded online communities reaching millions of members.</p>
            <p>I'm always looking for new challenges to drive measurable growth. Feel free to <a href="mailto:hi@loc.digital">reach out</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
