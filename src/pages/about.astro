---
import Layout from "../layouts/Layout.astro";
import AboutHero from "../components/ui/AboutHero.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";

const aboutTitle = "About | Phuc Loc Nguyen";
const aboutDescription = "Learn more about Nguyen Phuc Loc, a Senior Performance Marketing Executive focused on paid media, TikTok Shop growth, SEO, automation, and full-funnel execution.";
---

<Layout
  title={aboutTitle}
  description={aboutDescription}
  schema={pageSchema({
    url: absoluteUrl("/about"),
    title: aboutTitle,
    description: aboutDescription,
    type: "AboutPage",
  })}
>
  <main class="about-minimal-page">
    <div class="about-minimal-container">
      <section class="about-intro gear-hero" aria-label="About me">
        <AboutHero />
      </section>

      <section class="about-section">
        <div class="about-section-header">
          <p class="section-kicker">Selected work</p>
          <h2 class="card-title">What I Do</h2>
          <p class="card-desc">Campaigns, funnels, and communities scaled across e-commerce, education, and entertainment.</p>
        </div>
        <div class="about-section-body">
          <div class="evidence-panel">
            <div class="work-list">
              <a href="/work/playah" class="work-list-item is-link">
                <div class="item-main">PlayAh!</div>
                <div class="item-desc">Revenue Scaling & TikTok Shop GMV</div>
                <div class="item-meta">playahvietnam.com</div>
              </a>
              <a href="/work/workflow-space" class="work-list-item is-link">
                <div class="item-main">WorkFlow Space</div>
                <div class="item-desc">Branch Launches & Lead Generation</div>
                <div class="item-meta">workflowspace.vn</div>
              </a>
              <a href="/work/tomato-childrens-home" class="work-list-item is-link">
                <div class="item-main">TOMATO Children's Home</div>
                <div class="item-desc">Marketing 360 & Enrollment Growth</div>
                <div class="item-meta">education growth</div>
              </a>
              <a href="/work/pops-worldwide" class="work-list-item is-link">
                <div class="item-main">POPS Worldwide</div>
                <div class="item-desc">Technical SEO & Organic Growth</div>
                <div class="item-meta">pops.vn</div>
              </a>
              <a href="/work/education-communities" class="work-list-item is-link">
                <div class="item-main">Education Communities</div>
                <div class="item-desc">3M+ and 1M Member Communities</div>
                <div class="item-meta">founding member</div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="about-section">
        <div class="about-section-header">
          <p class="section-kicker">Toolset & skills</p>
          <h2 class="card-title">Toolset & Skills</h2>
          <p class="card-desc">Platforms and systems I use to scale performance, attribution, SEO, and automation.</p>
        </div>
        <div class="about-section-body">
          <div class="skills-grid">
            <div class="skill-item">
              <div class="item-main">Meta Ads</div>
              <div class="item-desc">Paid Social Campaigns</div>
              <div class="item-meta">facebook.com</div>
            </div>
            <div class="skill-item">
              <div class="item-main">Google Ads</div>
              <div class="item-desc">Performance Max, Search & Web Conversion</div>
              <div class="item-meta">ads.google.com</div>
            </div>
            <div class="skill-item">
              <div class="item-main">TikTok Ads</div>
              <div class="item-desc">Spark Ads, GMV Max & TikTok Shop</div>
              <div class="item-meta">ads.tiktok.com</div>
            </div>
            <div class="skill-item">
              <div class="item-main">Google Analytics</div>
              <div class="item-desc">Data Audits & GA4 Reporting</div>
              <div class="item-meta">analytics.google.com</div>
            </div>
            <div class="skill-item">
              <div class="item-main">Figma</div>
              <div class="item-desc">Interface Design & Creative Mockups</div>
              <div class="item-meta">figma.com</div>
            </div>
            <div class="skill-item">
              <div class="item-main">n8n</div>
              <div class="item-desc">AI-powered Funnel Automation</div>
              <div class="item-meta">n8n.io</div>
            </div>
            <div class="skill-item">
              <div class="item-main">Ahrefs</div>
              <div class="item-desc">SEO Keyword & Competitor Research</div>
              <div class="item-meta">ahrefs.com</div>
            </div>
            <div class="skill-item">
              <div class="item-main">Looker Studio</div>
              <div class="item-desc">Dashboarding & Performance Reporting</div>
              <div class="item-meta">lookerstudio.google.com</div>
            </div>
          </div>
        </div>
      </section>

      <section class="about-section">
        <div class="about-section-header">
          <p class="section-kicker">Education</p>
          <h2 class="card-title">Education & Credentials</h2>
          <p class="card-desc">Formal degree and professional marketing certifications.</p>
        </div>
        <div class="about-section-body">
          <div class="evidence-panel is-compact">
            <div class="work-list">
              <div class="work-list-item">
                <div class="item-main">FPT University</div>
                <div class="item-desc">Bachelor of Digital Marketing, Graduated with Honors</div>
                <div class="item-meta">2019-2023 · GPA 9.4/10</div>
              </div>
              <div class="work-list-item">
                <div class="item-main">Google</div>
                <div class="item-desc">Digital Marketing Specialization</div>
                <div class="item-meta">Issued 2022</div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .about-minimal-page {
    padding: calc(var(--hdr-h) + clamp(44px, 7vw, 84px)) 0 clamp(72px, 10vw, 128px);
    background: transparent;
  }

  .about-minimal-container {
    width: min(calc(100% - (var(--page-gutter) * 2)), var(--main-content-max));
    max-width: var(--main-content-max);
    margin: 0 auto;
    padding: 0;
  }

  .about-intro {
    margin-bottom: clamp(64px, 8vw, 108px);
    padding-bottom: clamp(44px, 7vw, 80px);
    border-bottom: 1px solid var(--divider);
  }

  :global(.about-hero-shell) {
    max-width: 1120px;
  }

  :global(.about-kicker),
  .section-kicker {
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: var(--type-caption);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    color: #005fb8;
  }

  :global(.about-hero-title) {
    max-width: 980px;
    font-family: var(--serif);
    font-size: var(--type-display-lg);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
    color: var(--text);
    text-wrap: balance;
  }

  :global(.about-hero-grid) {
    display: grid;
    grid-template-columns: minmax(0, 620px) minmax(220px, 1fr);
    gap: clamp(28px, 7vw, 96px);
    align-items: end;
    margin-top: clamp(24px, 4vw, 44px);
  }

  :global(.about-hero-copy) {
    max-width: 68ch;
    font-family: var(--sans);
    font-size: var(--type-body);
    line-height: 1.72;
    color: #6e6e6e;
    text-wrap: pretty;
  }

  :global(.about-hero-aside) {
    display: grid;
    gap: 6px;
    justify-items: end;
    padding-bottom: 2px;
    font-family: var(--mono);
    font-size: var(--type-caption);
    line-height: 1.45;
    color: var(--muted);
    text-align: right;
  }

  :global(.about-hero-aside strong) {
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  :global(.about-hero-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  :global(.about-hero-actions a) {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--divider);
    border-radius: var(--rounded-sm);
    padding: 8px 13px;
    font-family: var(--sans);
    font-size: var(--type-ui);
    font-weight: 600;
    line-height: 1;
    color: var(--text);
    background: rgba(255, 255, 255, 0.42);
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out), background 180ms var(--ease-out);
  }

  :global(.about-hero-actions a:hover) {
    border-color: var(--accent-border);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(220px, 0.82fr) minmax(0, 1.35fr);
    gap: clamp(28px, 6vw, 84px);
    align-items: start;
    margin-bottom: clamp(64px, 8vw, 104px);
  }

  .about-section:last-child {
    margin-bottom: 0;
  }

  .about-section-header {
    position: sticky;
    top: calc(var(--hdr-h) + 32px);
  }

  .card-title {
    font-family: var(--serif);
    font-size: var(--type-section-title);
    font-weight: 400;
    line-height: 1.05;
    color: var(--text);
    text-wrap: balance;
  }

  .card-desc {
    max-width: 34ch;
    margin-top: 14px;
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6e6e6e;
    text-wrap: pretty;
  }

  .about-section-body {
    min-width: 0;
  }

  .evidence-panel {
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--divider);
  }

  .evidence-panel.is-compact {
    border-top-color: var(--divider);
  }

  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-list-item {
    display: grid;
    grid-template-columns: minmax(150px, 0.9fr) minmax(220px, 1.45fr) minmax(128px, 0.8fr);
    gap: clamp(14px, 2.5vw, 28px);
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--divider);
    color: var(--text);
    font-family: var(--sans);
    font-size: var(--type-body);
    transition: color 180ms var(--ease-out), background 180ms var(--ease-out);
  }

  .work-list-item:last-child {
    border-bottom: none;
  }

  a.work-list-item:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  a.work-list-item:hover .item-desc,
  a.work-list-item:hover .item-meta {
    color: var(--text);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid var(--text);
    border-left: 1px solid var(--divider);
  }

  .skill-item {
    min-height: 132px;
    padding: 18px;
    border-right: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
    background: rgba(255, 255, 255, 0.28);
  }

  .item-main {
    font-family: var(--serif);
    font-size: var(--type-subhead);
    font-weight: 400;
    line-height: 1.05;
    color: var(--text);
  }

  .item-desc {
    font-size: 0.875rem;
    color: #6e6e6e;
    transition: color 180ms var(--ease-out);
  }

  .item-meta {
    font-family: var(--mono);
    font-size: var(--type-caption);
    line-height: 1.5;
    color: var(--muted);
    text-align: right;
    transition: color 180ms var(--ease-out);
  }

  .skill-item .item-desc {
    margin-top: 10px;
    line-height: 1.5;
  }

  .skill-item .item-meta {
    display: block;
    margin-top: 22px;
    text-align: left;
  }

  @media (max-width: 992px) {
    .about-section {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 72px;
    }

    .about-section-header {
      position: static;
    }

    :global(.about-hero-grid) {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    :global(.about-hero-aside) {
      justify-items: start;
      text-align: left;
    }

    .card-desc {
      max-width: 58ch;
    }
  }

  @media (max-width: 760px) {
    .work-list-item {
      grid-template-columns: 1fr;
      gap: 7px;
      padding: 17px 0;
    }

    a.work-list-item:hover {
      padding-inline: 0;
      background: transparent;
    }

    .item-meta {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .about-minimal-page {
      padding-top: calc(var(--hdr-h) + 36px);
    }

    .about-intro {
      margin-bottom: 176px;
    }

    :global(.about-hero-title) {
      font-size: var(--type-display-lg);
      line-height: 0.98;
    }

    :global(.about-hero-copy),
    .card-desc,
    .work-list-item {
      font-size: var(--type-body);
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skill-item {
      min-height: 0;
      padding: 16px 0;
      border-right: none;
      background: transparent;
    }
  }
</style>
