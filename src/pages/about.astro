---
import Layout from "../layouts/Layout.astro";
import AboutHero from "../components/ui/about-hero";
---

<Layout title="About | Phuc Loc Nguyen">
  <main class="about-minimal-page">
    <div class="about-minimal-container">
      
      <!-- 00 INTRODUCTION -->
      <section class="figma-intro toki-r" data-d="1" aria-label="About me">
        <AboutHero client:load />
      </section>

      <!-- 01 EXPERIENCE -->
