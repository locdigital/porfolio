          <div class="card-num-kicker">
            <span class="card-num">01</span>
            <span class="card-kicker">EXPERIENCE</span>
          </div>
          <h2 class="card-title">My Experience</h2>
          <p class="card-desc">Selected roles spanning performance media buying, search strategy, and brand campaigns.</p>
        </div>
        <div class="figma-card-body">
          <div class="card-container">
            <div class="card-list">
              <div class="card-list-item">
                <div class="item-main">WorkFlow Space</div>
                <div class="item-desc">Digital Marketing Specialist</div>
                <div class="item-meta">2024 – Present</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">PlayAh!</div>
                <div class="item-desc">Digital Marketing Specialist</div>
                <div class="item-meta">2024 – Present</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">POPS Worldwide</div>
                <div class="item-desc">SEO Executive</div>
                <div class="item-meta">2023 – 2024</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">PNJ</div>
                <div class="item-desc">Digital Marketing Specialist</div>
                <div class="item-meta">2022 – 2023</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Sony</div>
                <div class="item-desc">Digital Marketing Specialist</div>
                <div class="item-meta">2021 – 2022</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 SELECTED WORK -->
      <section class="figma-card toki-r" data-d="3">
        <div class="figma-card-header">
          <div class="card-num-kicker">
            <span class="card-num">02</span>
            <span class="card-kicker">SELECTED WORK</span>
          </div>
          <h2 class="card-title">Featured Projects</h2>
          <p class="card-desc">Campaigns and platforms built and managed for top consumer brands.</p>
        </div>
        <div class="figma-card-body">
          <div class="card-container">
            <div class="card-list">
              <a href="/work/playah" class="card-list-item is-link">
                <div class="item-main">PlayAh!</div>
                <div class="item-desc">Brand Growth & Performance Ads</div>
                <div class="item-meta">playahvietnam.com →</div>
              </a>
              <a href="/work/workflow-space" class="card-list-item is-link">
                <div class="item-main">WorkFlow Space</div>
                <div class="item-desc">Community & Content Strategy</div>
                <div class="item-meta">workflowspace.vn →</div>
              </a>
              <a href="/work/pnj" class="card-list-item is-link">
                <div class="item-main">PNJ</div>
                <div class="item-desc">E-commerce Campaigns & Shopping</div>
                <div class="item-meta">pnj.com.vn →</div>
              </a>
              <a href="/work/pops-worldwide" class="card-list-item is-link">
                <div class="item-main">POPS Worldwide</div>
                <div class="item-desc">SEO & Search Strategy</div>
                <div class="item-meta">pops.vn →</div>
              </a>
              <a href="/work/sony-vietnam" class="card-list-item is-link">
                <div class="item-main">Sony Vietnam</div>
                <div class="item-desc">Brand Awareness & Lead Gen</div>
                <div class="item-meta">sony.com.vn →</div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 03 TOOLSET & SKILLS -->
      <section class="figma-card toki-r" data-d="4">
        <div class="figma-card-header">
          <div class="card-num-kicker">
            <span class="card-num">03</span>
            <span class="card-kicker">TOOLSET & SKILLS</span>
          </div>
          <h2 class="card-title">Toolset & Skills</h2>
          <p class="card-desc">Technologies and skills I use to build workflows and run growth experiments.</p>
        </div>
        <div class="figma-card-body">
          <div class="card-container">
            <div class="card-list">
              <div class="card-list-item">
                <div class="item-main">Meta Ads</div>
                <div class="item-desc">Paid Social Campaigns</div>
                <div class="item-meta">facebook.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Google Ads</div>
                <div class="item-desc">Search, Shopping & Display</div>
                <div class="item-meta">ads.google.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">TikTok Ads</div>
                <div class="item-desc">Paid Social Campaigns</div>
                <div class="item-meta">ads.tiktok.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Google Analytics</div>
                <div class="item-desc">Data Audits & GA4 Reporting</div>
                <div class="item-meta">analytics.google.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Figma</div>
                <div class="item-desc">Interface Design & Creative Mockups</div>
                <div class="item-meta">figma.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Zapier</div>
                <div class="item-desc">Marketing & Workflow Automation</div>
                <div class="item-meta">zapier.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Ahrefs</div>
                <div class="item-desc">SEO Keyword & Competitor Research</div>
                <div class="item-meta">ahrefs.com ↗</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Notion</div>
                <div class="item-desc">Docs, Wiki & Project Hub</div>
                <div class="item-meta">notion.so ↗</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 EDUCATION & CREDENTIALS -->
      <section class="figma-card toki-r" data-d="5">
        <div class="figma-card-header">
          <div class="card-num-kicker">
            <span class="card-num">04</span>
            <span class="card-kicker">EDUCATION</span>
          </div>
          <h2 class="card-title">Education & Credentials</h2>
          <p class="card-desc">Formal degree and professional marketing certifications.</p>
        </div>
        <div class="figma-card-body">
          <div class="card-container">
            <div class="card-list">
              <div class="card-list-item">
                <div class="item-main">University Name</div>
                <div class="item-desc">Bachelor's Degree</div>
                <div class="item-meta">2017 – 2021</div>
              </div>
              <div class="card-list-item">
                <div class="item-main">Google</div>
                <div class="item-desc">Digital Marketing Specialization</div>
                <div class="item-meta">Issued 2022 ↗</div>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .about-minimal-page {
    padding: calc(var(--hdr-h) + 64px) 0 120px;
    background: transparent;
  }

  .about-minimal-container {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--px);
  }

  /* ── Figma Slide Grid ── */
  .figma-card {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 84px);
    margin-bottom: 96px;
    align-items: start;
  }

  /* ── Intro section (no image, full width) ── */
  .figma-intro {
    margin-bottom: 96px;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--divider);
  }

  .figma-card-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: calc(var(--hdr-h) + 32px);
  }

  .card-num-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 600;
  }

  .card-num {
    padding: 2px 8px;
    border: 1px solid rgba(0, 117, 222, 0.25);
    border-radius: 4px;
    background: rgba(0, 117, 222, 0.05);
    font-size: 10px;
  }

  .card-kicker {
    text-transform: uppercase;
  }

  .card-title {
    font-family: var(--serif);
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.15;
    color: var(--text);
    font-weight: 400;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .figma-card-body {
    width: 100%;
  }

  /* ── Card Container ── */
  .card-container {
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid var(--divider);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.015), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .card-container:hover {
    border-color: rgba(0, 117, 222, 0.25);
    box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  /* ── List Items ── */
  .card-list {
    display: flex;
    flex-direction: column;
  }

  .card-list-item {
    display: grid;
    grid-template-columns: 1.2fr 1.6fr 1.2fr;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--divider);
    font-size: 14px;
    align-items: center;
    color: var(--text);
    transition: all 0.25s var(--ease-out);
  }

  .card-list-item:first-child {
    padding-top: 0;
  }

  .card-list-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  a.card-list-item {
    text-decoration: none;
  }

  a.card-list-item:hover {
    color: var(--accent);
    padding-left: 8px;
    background: rgba(0, 117, 222, 0.02);
    border-radius: 6px;
  }

  .item-main {
    font-weight: 600;
  }

  .item-desc {
    color: var(--muted);
    transition: color 0.25s ease;
  }

  a.card-list-item:hover .item-desc {
    color: var(--text);
  }

  .item-meta {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    text-align: right;
    transition: color 0.25s ease;
  }

  a.card-list-item:hover .item-meta {
    color: var(--accent);
  }

  /* ── Hero Customization ── */
  .hero-main-title {
    font-family: var(--serif);
    font-size: clamp(38px, 5vw, 52px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .hero-main-title em {
    font-style: italic;
    color: var(--accent);
    font-family: var(--serif);
  }

  .hero-bio {
    margin-top: 12px;
  }

  .hero-bio p {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero-links {
    display: flex;
    gap: 24px;
    margin-top: 8px;
  }

  .min-link {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--divider);
    transition: all 0.25s ease;
  }

  .min-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 12px;
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.05);
  }

  .hero-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--divider);
    filter: grayscale(0.1);
    transition: filter 0.3s ease;
  }

  .hero-image-wrapper:hover img {
    filter: grayscale(0);
  }

  /* ── Floating Chips ── */
  .floating-chip {
    position: absolute;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 600;
    font-family: var(--mono);
    color: var(--text);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    pointer-events: none;
    transition: transform 0.3s ease;
    animation: chipFloat 6s ease-in-out infinite;
    z-index: 10;
    white-space: nowrap;
  }

  .chip-1 {
    top: 15%;
    left: -35px;
    animation-delay: 0s;
  }

  .chip-2 {
    bottom: 25%;
    right: -45px;
    animation-delay: 1.5s;
  }

  .chip-3 {
    bottom: 10%;
    left: -20px;
    animation-delay: 3s;
  }

  @keyframes chipFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Hover interactivity for chips */
  .hero-image-wrapper:hover .chip-1 {
    transform: translate(-6px, -4px);
  }
  .hero-image-wrapper:hover .chip-2 {
    transform: translate(6px, -4px);
  }
  .hero-image-wrapper:hover .chip-3 {
    transform: translate(-4px, 4px);
  }

  /* ── Responsive ── */
  @media (max-width: 992px) {
    .figma-card {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 64px;
    }

    .figma-card-header {
      position: static;
    }

    .hero-visual {
      order: -1;
      margin-bottom: 16px;
    }

    .hero-image-wrapper {
      max-width: 320px;
    }

    .chip-1 { left: -15px; }
    .chip-2 { right: -20px; }
    .chip-3 { left: -10px; }
  }

  @media (max-width: 640px) {
    .card-container {
      padding: 24px 16px;
    }

    .card-list-item {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 16px 0;
    }

    .item-meta {
      text-align: left;
      margin-top: 4px;
    }

    .floating-chip {
      display: none; /* Hide chips on small mobile to avoid layout clipping */
    }
  }
</style>

