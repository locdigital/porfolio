---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | Phuc Loc Nguyen">
  <main class="about-page">
    <div class="container">
      
      <!-- Intro -->
      <h1 class="about-title"><span class="highlight">Xin chào!</span></h1>
      <p class="about-intro">
        I'm Loc 👋 a Performance-driven Digital Marketer, strategist, and builder living and working in <strong>Ho Chi Minh City, Vietnam 🇻🇳</strong>. I love creating data-driven campaigns and useful solutions to marketing problems that don't have obvious answers.
      </p>

      <!-- Featured Image -->
      <figure class="about-featured-image fade-in">
        <img src="/assets/photos/img-portfolio/hero-about.jpg" alt="Phuc Loc Nguyen">
        <figcaption>Somewhere in Ho Chi Minh City 📍</figcaption>
      </figure>

      <!-- Content text -->
      <div class="about-content">
        <p>My favourite type of professional projects involve translating meticulously crafted details into deliberate, data-driven marketing systems. Over the past 4+ years, I've managed multi-channel paid media and scaled revenue for e-commerce, education, and consumer brands.</p>
        
        <p>Apart from work, I enjoy creating automated workflows, exploring technical SEO, and building online communities in visually expressive and distinct ways. I believe that good marketing isn't just about numbers; it's about telling a compelling story.</p>
        
        <p>As I continue in my career, I am interested in scaling revenue efficiently, managing large-scale budgets with a rigorous focus on ROAS, and discovering new challenges to drive measurable growth.</p>

        <!-- Collage -->
        <div class="about-collage">
          <img src="/assets/photos/img-portfolio/photo-4.jpg" class="img-1 fade-in" alt="Life 1">
          <img src="/assets/photos/img-portfolio/photo-2.jpg" class="img-2 fade-in" alt="Life 2">
          <img src="/assets/photos/img-portfolio/photo-3.jpg" class="img-3 fade-in" alt="Life 3">
        </div>

        <p>I believe in the power of continuous learning. When I'm not optimizing ad campaigns or analyzing data, you can find me taking photographs around the city, reading up on the latest tech trends, or exploring new coffee shops.</p>
        
        <p>If you're building something interesting and need someone who understands both the creative and performance side of growth, I'd love to chat.</p>
      </div>

    </div>
  </main>
</Layout>

<style>
  .about-page {
    padding: calc(var(--hdr-h) + 60px) 0 100px;
  }

  /* Title & Intro */
  .about-title {
    font-family: var(--serif);
    font-size: clamp(42px, 6.5vw, 90px);
    font-weight: 400;
    margin-bottom: 32px;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  
  .highlight {
    position: relative;
    display: inline-block;
    z-index: 1;
  }
  
  .highlight::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: -4px;
    right: -4px;
    height: 20px;
    background-color: rgba(255, 215, 0, 0.6); /* Yellow highlight */
    z-index: -1;
    border-radius: 2px;
  }

  .about-intro {
    font-size: 15px;
    line-height: 1.72;
    margin-bottom: 48px;
    font-weight: 400;
    color: var(--text);
  }
  
  .about-intro strong {
    font-weight: 600;
  }

  /* Featured Image */
  .about-featured-image {
    margin: 0 0 48px 0;
  }
  
  .about-featured-image img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
    aspect-ratio: 16 / 7; /* Wider aspect ratio for bigger container */
    animation: floatImage 9s ease-in-out 1s infinite both;
  }
  
  @keyframes floatImage {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  
  .about-featured-image figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  /* Content */
  .about-content {
  }

  .about-content p {
    font-size: 15px;
    line-height: 1.72;
    margin-bottom: 24px;
    color: var(--text);
  }

  /* Collage */
  .about-collage {
    position: relative;
    height: 520px;
    margin: 80px 0;
    width: 100%;
    isolation: isolate; /* Creates a stacking context */
  }
  
  @keyframes float-polaroid {
    0%, 100% { translate: 0 0px; }
    50% { translate: 0 -8px; }
  }

  .about-collage img {
    position: absolute;
    border-radius: 24px;
    object-fit: cover;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    transition:
      transform 1s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 1s ease,
      filter 1s ease;
    transform-origin: center;
    cursor: pointer;
    animation: float-polaroid 9s ease-in-out infinite both;
  }
  
  /* When the container is hovered, spread them out slightly */
  .about-collage:hover .img-1 {
    transform: rotate(-3deg) translate(-10px, -7px);
  }
  .about-collage:hover .img-2 {
    transform: rotate(4deg) translate(10px, -9px);
  }
  .about-collage:hover .img-3 {
    transform: rotate(-1.5deg) translate(10px, 10px);
  }

  /* The hover effect on the parent: slightly dim the images */
  .about-collage:hover img {
    filter: brightness(0.9) contrast(0.95);
  }

  /* The hover effect on the specific image being hovered */
  .about-collage img:hover {
    transform: scale(1.025) rotate(0deg) !important;
    z-index: 10 !important;
    box-shadow: 0 18px 42px rgba(0,0,0,0.13);
    filter: brightness(1) contrast(1);
    transition:
      transform 1s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 1s ease,
      filter 1s ease;
    animation-play-state: paused;
  }

  /* Default rotations and positions */
  .img-1 {
    width: 58%;
    height: 420px;
    left: 0;
    top: 30px;
    z-index: 2;
    transform: rotate(-2deg);
    animation-delay: 1s;
  }
  
  .img-2 {
    width: 42%;
    height: 340px;
    right: 8%;
    top: 0;
    z-index: 1;
    transform: rotate(3deg);
    animation-delay: 1.35s;
  }
  
  .img-3 {
    width: 48%;
    height: 280px;
    right: 12%;
    bottom: -20px;
    z-index: 3;
    transform: rotate(-1deg);
    animation-delay: 1.7s;
  }

  /* Simple fade-in animation */
  .fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .about-collage { height: 400px; margin: 40px 0; }
    .img-1 { width: 65%; height: 260px; top: 20px; left: 0; transform: rotate(-2deg); }
    .img-2 { width: 45%; height: 220px; top: 0; right: 0; transform: rotate(3deg); }
    .img-3 { width: 60%; height: 180px; right: 5%; bottom: 0; transform: rotate(-1deg); }
    
    .about-collage:hover .img-1 { transform: rotate(-3deg) translate(-4px, -4px); }
    .about-collage:hover .img-2 { transform: rotate(4deg) translate(4px, -4px); }
    .about-collage:hover .img-3 { transform: rotate(-1.5deg) translate(4px, 4px); }
  }
</style>
