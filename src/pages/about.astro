---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import Heroicon from "../components/icons/Heroicon.astro";
import { PERSON_ID, canonicalUrl, pageSchema } from "../lib/seo";

const aboutUrl = canonicalUrl("/about");
const aboutSchema = pageSchema({
  url: aboutUrl,
  title: "About — Phuc Loc Nguyen",
  description: "About Phuc Loc Nguyen (Loc / Henry): performance marketing, growth strategy, travel photography, trekking, and the work behind loc.digital.",
  type: "ProfilePage",
  mainEntity: { "@id": PERSON_ID },
  breadcrumbId: `${aboutUrl}#breadcrumbs`,
});

const aboutParagraphs = [
  "I started exploring social media in ninth grade and was buying and selling Facebook pages by the time I finished high school. Back then, I didn’t know I was learning marketing. I was figuring things out and finding ways to make money. Studying Graphic Design at Arena and Digital Marketing at FPT University eventually gave a name—and some structure—to the skills I’d been teaching myself.",
  "Since then, I’ve worked across entertainment, education, coworking, and FMCG. My work usually starts with a practical question: what’s holding growth back? From there, I look at the creative, the campaigns, and what happens after someone clicks. I’ve helped build and grow TikTok Shop businesses and managed campaigns across Google, Meta, and TikTok, working closely with creative and affiliate teams to turn ideas into measurable results.",
  "I believe good content gives performance marketing something worth scaling. I enjoy connecting the two: testing ideas, understanding the results, and making the next round better. Sometimes that means a new creative direction. Other times, it means improving the customer journey beyond the ad. Lately, my curiosity has also taken me into AI tools and building websites through vibe coding.",
  "Outside work, you’ll usually find me taking photos, cycling, planning a trek, or having coffee with friends. I also enjoy a good desk setup, mechanical keyboards, and probably more gear than I need.",
  "Photography has been with me since childhood. Before I owned a camera, I used to make a rectangle with my fingers to frame whatever caught my eye. That little habit became a big reason to save up for my first camera.",
  "These days, photography and trekking fit naturally together. They give me a reason to explore, slow down, and notice things I might otherwise miss. My laptop still comes along on most trips, though. Apparently, travelling light has its limits.",
  "I like things that look simple at first, then reward a closer look. A thoughtful detail, a useful idea, a photograph that makes you pause. That’s the kind of care I try to bring to my work, too."
];
---

<DashboardLayout
  title="About — Phuc Loc Nguyen"
  pageTitle="About"
  description="About Phuc Loc Nguyen (Loc / Henry): digital media, performance marketing, creative strategy, photography, trekking, and the work behind the portfolio."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "About" }]}
  maxWidthVariant="default"
  pageType="ProfilePage"
  ogType="profile"
  schema={aboutSchema}
>
  <div class="about-layout">
    <article class="about-story" aria-labelledby="about-heading">
      <h1 id="about-heading" class="page-title">Growth Marketer<br />and Photoholic</h1>
      <div class="about-prose">
        <p class="content-description">I’m Loc, also known as Henry. Born in My Tho and now based in Sai Gon, I work in digital media, bringing together creative thinking, performance marketing, and data.</p>
        {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </article>

    <aside class="about-sidebar" aria-label="Photo and contact links">
      <div class="about-photo">
        <img
          src="/images/about-photographer.png"
          alt="Pixel-art illustration of a photographer surrounded by greenery and pink blossoms"
          width="1024"
          height="1536"
          loading="eager"
          decoding="sync"
        />
      </div>
      <nav class="about-socials" aria-label="Find me online">
        <ul role="list" class="about-socials-list">
          <li class="about-social-item">
            <a href="https://www.instagram.com/henrygoodkid" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="about-social-icon">
                <path d="M12 3c-2.444 0-2.75.01-3.71.054-.959.044-1.613.196-2.185.418A4.412 4.412 0 0 0 4.51 4.511c-.5.5-.809 1.002-1.039 1.594-.222.572-.374 1.226-.418 2.184C3.01 9.25 3 9.556 3 12s.01 2.75.054 3.71c.044.959.196 1.613.418 2.185.23.592.538 1.094 1.039 1.595.5.5 1.002.808 1.594 1.038.572.222 1.226.374 2.184.418C9.25 20.99 9.556 21 12 21s2.75-.01 3.71-.054c.959-.044 1.613-.196 2.185-.419a4.412 4.412 0 0 0 1.595-1.038c.5-.5.808-1.002 1.038-1.594.222-.572.374-1.226.418-2.184.044-.96.054-1.267.054-3.711s-.01-2.75-.054-3.71c-.044-.959-.196-1.613-.419-2.185A4.412 4.412 0 0 0 19.49 4.51c-.5-.5-1.002-.809-1.594-1.039-.572-.222-1.226-.374-2.184-.418C14.75 3.01 14.444 3 12 3Zm0 1.622c2.403 0 2.688.009 3.637.052.877.04 1.354.187 1.67.31.421.163.72.358 1.036.673.315.315.51.615.673 1.035.123.317.27.794.31 1.671.043.95.052 1.234.052 3.637s-.009 2.688-.052 3.637c-.04.877-.187 1.354-.31 1.67-.163.421-.358.72-.673 1.036a2.79 2.79 0 0 1-1.035.673c-.317.123-.794.27-1.671.31-.95.043-1.234.052-3.637.052s-2.688-.009-3.637-.052c-.877-.04-1.354-.187-1.67-.31a2.789 2.789 0 0 1-1.036-.673 2.79 2.79 0 0 1-.673-1.035c-.123-.317-.27-.794-.31-1.671-.043-.95-.052-1.234-.052-3.637s.009-2.688.052-3.637c.04-.877.187-1.354.31-1.67.163-.421.358-.72.673-1.036.315-.315.615-.51 1.035-.673.317-.123.794-.27 1.671-.31.95-.043 1.234-.052 3.637-.052Z"></path>
                <path d="M12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0-7.622a4.622 4.622 0 1 0 0 9.244 4.622 4.622 0 0 0 0-9.244Zm5.884-.182a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0Z"></path>
              </svg>
              <span>Instagram · @henrygoodkid</span>
            </a>
          </li>
          <li class="about-social-item">
            <a href="https://t.me/henrygoodkid" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="about-social-icon">
                <path d="M21.944 4.33a1.33 1.33 0 0 0-1.38-.23L3.11 10.97a1.26 1.26 0 0 0 .08 2.36l4.26 1.41 1.65 5.14a1.15 1.15 0 0 0 1.93.45l2.36-2.3 4.24 3.12a1.33 1.33 0 0 0 2.09-.82l2.63-14.66a1.33 1.33 0 0 0-.406-1.34ZM18.4 7.72l-7.92 7.15-.32 3.16-1.26-3.93 9.5-6.38Z"></path>
              </svg>
              <span>Telegram · @henrygoodkid</span>
            </a>
          </li>
          <li class="about-social-item">
            <a href="https://wa.me/84888886038" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="about-social-icon">
                <path d="M12.04 3a8.96 8.96 0 0 0-7.79 13.4L3 21l4.74-1.24A8.96 8.96 0 1 0 12.04 3Zm0 16.36a7.4 7.4 0 0 1-3.77-1.03l-.27-.16-2.81.74.75-2.74-.18-.28a7.42 7.42 0 1 1 6.28 3.47Zm4.07-5.55c-.22-.11-1.32-.65-1.52-.72-.2-.08-.35-.11-.5.11-.15.22-.58.72-.71.87-.13.15-.26.17-.48.06-.22-.11-.94-.35-1.79-1.1-.66-.59-1.11-1.32-1.24-1.54-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.15-.22.22-.37.08-.15.04-.28-.02-.39-.06-.11-.5-1.21-.69-1.65-.18-.44-.36-.38-.5-.39h-.43c-.15 0-.39.06-.6.28-.2.22-.78.76-.78 1.86s.8 2.16.91 2.31c.11.15 1.58 2.41 3.82 3.38.53.23.95.37 1.27.47.53.17 1.02.15 1.4.09.43-.06 1.32-.54 1.5-1.06.19-.52.19-.97.13-1.06-.05-.1-.2-.15-.43-.26Z"></path>
              </svg>
              <span>WhatsApp · @henrygoodkid</span>
            </a>
          </li>
          <li class="about-social-item">
            <a href="https://zalo.me/0888886038" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="about-social-icon">
                <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z"></path>
              </svg>
              <span>Phone / Zalo · +84 888 886 038</span>
            </a>
          </li>
          <li class="about-social-item">
            <a href="https://www.linkedin.com/in/phucloc" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="about-social-icon">
                <path d="M18.335 18.339H15.67v-4.177c0-.996-.02-2.278-1.39-2.278-1.389 0-1.601 1.084-1.601 2.205v4.25h-2.666V9.75h2.56v1.17h.035c.358-.674 1.228-1.387 2.528-1.387 2.7 0 3.2 1.778 3.2 4.091v4.715zM7.003 8.575a1.546 1.546 0 01-1.548-1.549 1.548 1.548 0 111.547 1.549zm1.336 9.764H5.666V9.75H8.34v8.589zM19.67 3H4.329C3.593 3 3 3.58 3 4.297v15.406C3 20.42 3.594 21 4.328 21h15.338C20.4 21 21 20.42 21 19.703V4.297C21 3.58 20.4 3 19.666 3h.003z"></path>
              </svg>
              <span>Connect on LinkedIn</span>
            </a>
          </li>
          <li class="about-social-item about-social-email">
            <a href="mailto:hi@loc.digital">
              <Heroicon name="envelope" size={24} class="about-social-icon" />
              <span>hi@loc.digital</span>
            </a>
          </li>
        </ul>
      </nav>
    </aside>
  </div>
</DashboardLayout>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
    padding-block: 12px 40px;
  }

  .about-story h1 {
    margin: 0 0 30px;
    text-wrap: balance;
  }

  .about-prose {
    color: var(--dash-text);
    font-size: var(--text-body-sm);
    line-height: 1.85;
  }

  .about-prose p {
    font-size: inherit;
    margin: 0 0 28px;
  }

  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .about-sidebar {
    min-width: 0;
    padding: 6px 10px 0;
  }

  .about-photo {
    overflow: hidden;
    border-radius: 20px;
    transform: rotate(3deg);
    background: var(--dash-surface);
    will-change: transform, opacity;
    animation:
      about-photo-fade 0.36s ease-out 0.26s both,
      about-photo-rise 0.6s cubic-bezier(0.34, 1.45, 0.64, 1) 0.26s both;
  }

  @supports (animation-timing-function: linear(0, 1)) {
    .about-photo {
      animation:
        about-photo-fade 0.36s ease-out 0.26s both,
        about-photo-rise 0.6s linear(
          0, 0.1379, 0.4245, 0.7174, 0.9408, 1.0722, 1.123, 1.1189,
          1.0872, 1.0489, 1.0168, 0.9958, 0.9859, 0.9842, 0.9873,
          0.992, 0.9965, 0.9997, 1.0015, 1.002, 1
        ) 0.26s both;
    }
  }

  @keyframes about-photo-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes about-photo-rise {
    from {
      transform: translate3d(0, 28px, 0) rotate(3deg);
    }
    to {
      transform: translate3d(0, 0, 0) rotate(3deg);
    }
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .about-socials {
    margin-top: 46px;
  }

  .about-socials-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-social-item {
    display: flex;
  }

  .about-social-item + .about-social-item {
    margin-top: 16px;
  }

  .about-social-item.about-social-email {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--dash-border);
  }

  .about-socials a {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--dash-text);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    border-radius: 4px;
    transition: color var(--duration-fast, 150ms) ease;
  }

  .about-social-icon {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--dash-muted);
    fill: var(--dash-muted);
    transition: fill var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .about-socials a:hover {
    color: var(--dash-link-hover);
  }

  .about-socials a:hover .about-social-icon {
    color: var(--dash-link-hover);
    fill: var(--dash-link-hover);
  }

  .about-socials a:focus-visible {
    outline: 2px solid var(--dash-accent);
    outline-offset: 5px;
  }

  @media (max-width: 1100px) and (min-width: 769px) {
    .about-layout {
      gap: 28px;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    }
  }

  @media (max-width: 768px) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-block: 0 24px;
    }

    .about-story h1 {
      max-width: 540px;
      margin-bottom: 20px;
    }

    .about-sidebar {
      display: contents;
    }

    .about-photo {
      order: -1;
      width: min(62%, 228px);
      margin: 4px 0 0 6px;
      animation-delay: 0.12s, 0.12s;
    }

    .about-socials {
      order: 1;
      margin-top: 0;
    }

    .about-social-item + .about-social-item {
      margin-top: 8px;
    }

    .about-social-item.about-social-email {
      margin-top: 20px;
      padding-top: 20px;
    }

    .about-socials a {
      min-height: 40px;
      padding-block: 4px;
      gap: 14px;
    }

    .about-prose {
      line-height: 1.78;
    }

    .about-prose p {
      margin-bottom: 22px;
    }
  }
</style>
