---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../lib/content";
import {
  Home,
  Briefcase,
  ContactIcon,
  ArrowRight
} from "../components/icons/phosphor";

export const prerender = true;

const homePath = "/";
const workPath = "/work";
const contactPath = "/about";
const photosPath = "/photos";
const servicesPath = "/services";
const growthPath = "/growth";
const publishedLocations = await getPhotoLocations();
const galleryCount = publishedLocations.length;
---

<DashboardLayout
  title="404 · Page Not Found — Phuc Loc Nguyen"
  pageTitle="404 Not Found"
  description="The page you are looking for does not exist or has moved."
  breadcrumbs={[{ label: "404 Not Found" }]}
  maxWidthVariant="default"
  noindex={true}
>
  <div style="padding: var(--space-8) 0; max-width: 620px;">
    <!-- 404 Badge -->
    <div style="margin-bottom: var(--space-3);">
      <span class="dash-tag" style="color: var(--dash-danger); background: var(--dash-danger-soft); font-weight: 600;">
        404 · Page Not Found
      </span>
    </div>

    <!-- Title & Explanation -->
    <h1 class="page-title" style="margin-bottom: var(--space-3);">
      Hmm, this page doesn’t exist.
    </h1>
    <p class="page-lead" style="margin-bottom: var(--space-6);">
      The link you followed may be broken, or the document has been relocated in the workspace.
    </p>

    <!-- Quick Action Buttons -->
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: var(--space-10);">
      <a href={homePath} class="dash-button dash-button--primary" data-astro-prefetch>
        <Home size={15} aria-hidden="true" />
        <span>Return to overview</span>
      </a>
      <a href={workPath} class="dash-button dash-button--secondary" data-astro-prefetch>
        <Briefcase size={15} aria-hidden="true" />
        <span>Explore work</span>
      </a>
      <a href={contactPath} class="dash-button dash-button--ghost" data-astro-prefetch>
        <ContactIcon size={15} aria-hidden="true" />
        <span>Contact me</span>
      </a>
    </div>

    <!-- Suggested Workspace Sections -->
    <div class="dash-card" style="padding: 16px;">
      <h2 class="item-title" style="font-size: var(--text-micro); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--dash-muted); margin-bottom: 12px;">
        Suggested documents
      </h2>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
        <li>
          <a href={workPath} class="dash-link" style="font-size: var(--text-body-sm); font-weight: 500; display: inline-flex; align-items: center; gap: 4px;" data-astro-prefetch>
            <span>Work (6 case studies)</span>
            <ArrowRight size={13} aria-hidden="true" />
          </a>
        </li>
        <li>
          <a href={growthPath} class="dash-link" style="font-size: var(--text-body-sm); font-weight: 500; display: inline-flex; align-items: center; gap: 4px;" data-astro-prefetch>
            <span>Growth Hub & Performance Marketing Formulas</span>
            <ArrowRight size={13} aria-hidden="true" />
          </a>
        </li>
        <li>
          <a href={servicesPath} class="dash-link" style="font-size: var(--text-body-sm); font-weight: 500; display: inline-flex; align-items: center; gap: 4px;" data-astro-prefetch>
            <span>Services & Retainers (6 modular capabilities)</span>
            <ArrowRight size={13} aria-hidden="true" />
          </a>
        </li>
        <li>
          <a href={photosPath} class="dash-link" style="font-size: var(--text-body-sm); font-weight: 500; display: inline-flex; align-items: center; gap: 4px;" data-astro-prefetch>
            <span>Photography ({galleryCount} travel galleries)</span>
            <ArrowRight size={13} aria-hidden="true" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</DashboardLayout>
