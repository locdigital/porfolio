      <!-- FAQ ACCORDION -->
      <section class="faq-section toki-r" data-d="5">
        <div class="section-header">
          <h2 class="section-title">Frequently Asked Questions</h2>
          <p class="section-desc">Clear answers about collaboration processes, scope, and technical setups.</p>
        </div>

        <div class="faq-accordion-container">
          {faqs.map((faq, index) => (
            <div class="faq-item">
              <button class="faq-header" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
                <span class="faq-question-wrapper">
                  {faq.iconName === "calendar" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                      <line x1="16" x2="16" y1="2" y2="6" />
                      <line x1="8" x2="8" y1="2" y2="6" />
                      <line x1="3" x2="21" y1="10" y2="10" />
                    </svg>
                  )}
                  {faq.iconName === "code" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  )}
                  {faq.iconName === "zap" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {faq.iconName === "message" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                  )}
                  <span class="faq-question">{faq.q}</span>
                </span>
                <svg class="faq-toggle-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M2 8h12" />
                  <path class="vertical-line" d="M8 2v12" />
                </svg>
              </button>
              <div class="faq-answer-wrapper" id={`faq-answer-${index}`} aria-hidden="true">
                <div class="faq-answer">
                  <p>{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="services-cta toki-r" data-d="6">
        <div class="cta-card">
          <h2 class="cta-title">Ready to clean up the growth system?</h2>
          <p class="cta-desc">
            Send the bottleneck, the target, and the current stack. I will map the shortest useful scope.
          </p>
          <div class="cta-buttons">
          <a href="mailto:hi@loc.digital" class="btn btn-primary">hi@loc.digital <ArrowRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
          <a href="/question" class="btn btn-secondary">Ask Leah anything ✦</a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<!-- Client scripts for interactivity -->
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    /* ── Tab Switcher Logic ── */
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Remove active class from buttons and set aria-selected false
        tabButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
        
        // Hide all panes
        tabPanes.forEach(pane => pane.classList.remove('active'));

        // Activate clicked tab
        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');
        
        // Show target pane
        const targetId = `pane-${button.dataset.tab}`;
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.classList.add('active');
        }
      });
    });

    /* ── Pricing Toggle Logic ── */
    const billingToggle = document.getElementById('billing-toggle');
    const priceVals = document.querySelectorAll('.price-val');
    const pricePeriods = document.querySelectorAll('.price-period');
    let isProjectMode = false;

    if (billingToggle) {
      billingToggle.addEventListener('click', () => {
        isProjectMode = !isProjectMode;
        billingToggle.classList.toggle('active', isProjectMode);
        billingToggle.setAttribute('aria-pressed', String(isProjectMode));
        
        priceVals.forEach(val => {
          const monthly = val.dataset.monthly;
          const project = val.dataset.project;
          val.textContent = isProjectMode ? project : monthly;
        });

        pricePeriods.forEach(period => {
          period.textContent = isProjectMode ? ' total' : '/month';
        });
      });
    }

    /* ── Horizontal Scroll Service Stack ── */
    const serviceStackScroller = document.querySelector('.saas-grid');

    if (serviceStackScroller) {
      const serviceCards = Array.from(serviceStackScroller.querySelectorAll('[data-service-card]'));
      const serviceDots = Array.from(document.querySelectorAll('[data-service-dot]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const autoplayDelay = 4000;
      let activeServiceIndex = 0;
      let autoplayTimer = 0;
      let isCarouselPaused = false;

      const setActiveServiceDot = (activeIndex) => {
        activeServiceIndex = activeIndex;
        serviceDots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          if (isActive) {
            if (dot.classList.contains('active')) {
              dot.classList.remove('active');
              void dot.offsetWidth;
            }
            dot.classList.add('active');
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.classList.remove('active');
            dot.removeAttribute('aria-current');
          }
        });
      };

      const scrollToServiceCard = (targetIndex, behavior = 'smooth') => {
        const targetCard = serviceCards[targetIndex];
        if (!targetCard) return;

        serviceStackScroller.scrollTo({
          left: targetCard.offsetLeft,
          behavior: reducedMotion.matches ? 'auto' : behavior,
        });
      };

      const scheduleServiceAutoplay = () => {
        window.clearTimeout(autoplayTimer);
        if (reducedMotion.matches || isCarouselPaused || serviceCards.length < 2) return;

        autoplayTimer = window.setTimeout(() => {
          const nextIndex = (activeServiceIndex + 1) % serviceCards.length;
          setActiveServiceDot(nextIndex);
          scrollToServiceCard(nextIndex);
          scheduleServiceAutoplay();
        }, autoplayDelay);
      };

      const syncServiceDots = () => {
        const activeIndex = serviceCards.reduce((closestIndex, card, index) => {
          const closestCard = serviceCards[closestIndex];
          return Math.abs(card.offsetLeft - serviceStackScroller.scrollLeft) <
            Math.abs(closestCard.offsetLeft - serviceStackScroller.scrollLeft)
            ? index
            : closestIndex;
        }, 0);

        if (activeIndex !== activeServiceIndex) {
          setActiveServiceDot(activeIndex);
        }
      };

      serviceDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const clickedIndex = Number(dot.dataset.index || 0);
          const targetIndex = clickedIndex === activeServiceIndex
            ? (activeServiceIndex + 1) % serviceCards.length
            : clickedIndex;
          scrollToServiceCard(targetIndex);
          setActiveServiceDot(targetIndex);
          scheduleServiceAutoplay();
        });
      });

      serviceStackScroller.addEventListener('scroll', () => {
        window.requestAnimationFrame(syncServiceDots);
      }, { passive: true });

      serviceStackScroller.addEventListener('pointerdown', () => {
        scheduleServiceAutoplay();
      }, { passive: true });

      serviceStackScroller.addEventListener('mouseenter', () => {
        isCarouselPaused = true;
        window.clearTimeout(autoplayTimer);
        serviceDots.forEach((dot) => dot.classList.add('paused'));
      });

      serviceStackScroller.addEventListener('mouseleave', () => {
        isCarouselPaused = false;
        serviceDots.forEach((dot) => dot.classList.remove('paused'));
        scheduleServiceAutoplay();
      });

      serviceDots.forEach((dot) => {
        dot.addEventListener('focus', () => {
          isCarouselPaused = true;
          window.clearTimeout(autoplayTimer);
          serviceDots.forEach((item) => item.classList.add('paused'));
        });

        dot.addEventListener('blur', () => {
          isCarouselPaused = false;
          serviceDots.forEach((item) => item.classList.remove('paused'));
          scheduleServiceAutoplay();
        });
      });

      reducedMotion.addEventListener('change', scheduleServiceAutoplay);
      syncServiceDots();
      scheduleServiceAutoplay();
    }

    /* ── Collapsible Accordion FAQs ── */
    const faqHeaders = document.querySelectorAll('.faq-header');

    faqHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        const wrapper = header.nextElementSibling;
        
        // Toggle state
        header.setAttribute('aria-expanded', !isExpanded);
        header.classList.toggle('active', !isExpanded);
        
        if (wrapper) {
          wrapper.setAttribute('aria-hidden', isExpanded);
          
          wrapper.style.opacity = !isExpanded ? '1' : '0';
        }
      });
    });
  });
</script>

