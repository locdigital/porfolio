    checklist: [
      { text: "Brand voice guidelines & copywriting frameworks", Icon: Briefcase },
      { text: "Core market positioning audits & value proposition design", Icon: Compass },
      { text: "Launch campaign themes and key message mapping", Icon: Sparkles },
      { text: "Cohesive typographic, palette, and symbol rulebooks", Icon: Layers }
    ],
