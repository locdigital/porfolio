        <p class="gear-kicker">My Services</p>
        <h1>
          Scale your digital footprint with <em>high-velocity marketing</em> and <em>robust code.</em>
        </h1>
        <p class="gear-intro">
          I partner with growth-focused brands and startups to run conversion ads, deploy organic forum seeding, map creative positioning, and build headless static sites.
        </p>
        <div class="hero-ctas">
          <a href="mailto:hi@loc.digital" class="btn btn-primary">Book a Discovery Call</a>
          <button class="btn btn-secondary" id="scroll-to-pricing">Explore Retainers</button>
        </div>
      </section>

      <!-- TRUST LOGOS (Infinite Horizontal Scrolling Marquee) -->
      <div class="client-strip">
        <span class="strip-label">Powering workflows across major digital sectors:</span>
        <div class="marquee-container">
          <div class="marquee-track">
            <!-- Group 1 -->
            <div class="marquee-group">
              <span>E-Commerce</span><span class="separator">✦</span>
              <span>Consumer Brands</span><span class="separator">✦</span>
              <span>SaaS Products</span><span class="separator">✦</span>
              <span>Mobile Apps</span><span class="separator">✦</span>
              <span>B2B Marketplaces</span><span class="separator">✦</span>
              <span>Fintech Services</span><span class="separator">✦</span>
              <span>AI Platforms</span><span class="separator">✦</span>
              <span>Creative Studios</span><span class="separator">✦</span>
              <span>Web3 Protocols</span>
            </div>
            <!-- Group 2 (Duplicate for seamless loop) -->
            <div class="marquee-group" aria-hidden="true">
              <span class="separator">✦</span>
              <span>E-Commerce</span><span class="separator">✦</span>
              <span>Consumer Brands</span><span class="separator">✦</span>
              <span>SaaS Products</span><span class="separator">✦</span>
              <span>Mobile Apps</span><span class="separator">✦</span>
              <span>B2B Marketplaces</span><span class="separator">✦</span>
              <span>Fintech Services</span><span class="separator">✦</span>
              <span>AI Platforms</span><span class="separator">✦</span>
              <span>Creative Studios</span><span class="separator">✦</span>
              <span>Web3 Protocols</span>
            </div>
          </div>
        </div>
      </div>

      <!-- MAIN FEATURES GRID (SaaS Style) -->
      <section class="features-section toki-r" data-d="2">
        <div class="section-header">
          <h2 class="section-title">A complete stack of marketing & development services</h2>
          <p class="section-desc">Highly structured, data-driven frameworks designed to drive revenue without overhead.</p>
        </div>

        <div class="saas-grid">
          {services.map((service) => (
            <div class="saas-card">
              <div class="card-header">
                <span class="card-num">{service.num}</span>
                <span class="card-metric">{service.metric}</span>
              </div>
              <h3 class="card-title">{service.title}</h3>
              <p class="card-desc">{service.desc}</p>
              
              <div class="card-checklist-header">What's included:</div>
              <ul class="card-checklist">
                {service.checklist.map((item) => (
                  <li>
                    <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="card-tags">
                {service.tags.map((tag) => (
                  <span class="card-tag">{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CAPABILITIES SWITCHER (Interactive Product tab) -->
      <section class="capabilities-dashboard toki-r" data-d="3">
        <div class="section-header">
          <h2 class="section-title">Deep dive into operational capabilities</h2>
          <p class="section-desc">Select a core services category to explore specific tasks, procedures, and outputs.</p>
        </div>

        <div class="dashboard-container">
          <!-- Left Tab Selectors -->
          <div class="dashboard-tabs">
            {services.map((service, index) => (
              <button 
                class={`tab-button ${index === 0 ? 'active' : ''}`}
                data-tab={service.id}
                aria-selected={index === 0 ? "true" : "false"}
