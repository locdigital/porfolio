      { name: "Astro Static Builds", desc: "Creating static page assemblies that load in milliseconds and deliver perfect SEO crawls.", Icon: Code },
      { name: "Dynamic React Modules", desc: "Building snappier components (collages, listings, query tabs) that run securely in browser frames.", Icon: Layers },
      { name: "Headless CMS Integration", desc: "Linking repositories with easy Markdown editors (Keystatic/Decap) for simple client-side updates.", Icon: Globe }
