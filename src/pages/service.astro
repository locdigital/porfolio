const pricingPlans = [
  {
    title: "Advocacy Seeding Retainer",
    desc: "Build community trust, handle sentiment issues, and run ongoing seeding loops on niche forums.",
    priceMonthly: "$2,490",
    priceProject: "$6,900",
    features: [
      "Weekly seed posts & organic discussions",
      "Reddit, Facebook, and local forum tracking",
      "Dedicated account campaign engineer",
      "Sentiment monitoring alerts",
      "Basic creative book (KOCs & copy)",
      "Community angle map by product benefit",
      "Weekly conversation screenshots & links",
      "Light competitor narrative monitoring",
      "Monthly learnings recap with next actions"
    ],
    tag: "Awareness & Community"
  },
  {
    title: "Full-Funnel Growth Retainer",
    desc: "Complete performance scaling, tracking integration, landing optimization, and reporting dashboards.",
    priceMonthly: "$4,990",
    priceProject: "$12,500",
    popular: true,
    features: [
      "Meta, Google, and TikTok ad management",
      "Server-side Conversions API (CAPI) & GA4 GTM",
      "Weekly analytics updates + Looker dashboards",
      "Custom landing page CRO diagnostics",
      "Creator ad creatives direction & briefs",
      "Weekly creative testing roadmap",
      "Budget pacing and CAC guardrails",
      "Funnel drop-off review and fixes",
      "Monthly growth memo for stakeholders"
    ],
    tag: "Scale & Performance"
  },
  {
    title: "Headless Web Engineering",
    desc: "End-to-end design, static site building, SEO, and CMS setup. Fast, clean, lightweight code.",
    priceMonthly: "$3,800",
    priceProject: "$7,500",
    features: [
      "Astro/React responsive static builds",
      "CMS integration (Keystatic/Decap/Sanity)",
      "100/100 Lighthouse speed performance package",
      "Full technical SEO configuration",
      "4 weeks post-launch support",
      "Reusable component system setup",
      "Analytics, pixels, and event wiring",
      "Content migration and redirects",
      "Deployment, QA, and handoff docs"
    ],
    tag: "Code & SEO"
  }
];

const trustClients = [
  { name: "UEH University", tag: "Academic Workshop Partner", logo: "/assets/logos/logo-ueh.png" },
  { name: "Foreign Trade Univ (FTU)", tag: "Campus Community Partner", logo: "/assets/logos/logo-ftu.png" },
  { name: "FPT University", tag: "Career Guidance Partner", logo: "/assets/logos/logo-fpt.svg" },
  { name: "RMIT Vietnam", tag: "Student Community Partner", logo: "/assets/logos/logo-rmit.svg" },
  { name: "ĐH Bách Khoa (HCMUT)", tag: "Tech Community Partner", logo: "/assets/logos/logo-hcmut.svg" },
  { name: "Đại học Văn Lang", tag: "Education & Workshop Partner", logo: "/assets/logos/logo-vlu.png" },
  { name: "Đại học Hoa Sen", tag: "Community Media Partner", logo: "/assets/logos/logo-hsu.png" },
  { name: "Đại học Tôn Đức Thắng", tag: "Academic Outreach Partner", logo: "/assets/logos/logo-tdtu.png" },
];

const serviceTitle = "Digital Services | Phuc Loc Nguyen";
const serviceDescription = "Scale conversions, build community trust, and deploy lightning-fast headless websites. Explore my modern digital marketing and engineering services.";
---

<Layout
  title={serviceTitle}
  description={serviceDescription}
  schema={[
    pageSchema({
      url: absoluteUrl("/service"),
      title: serviceTitle,
      description: serviceDescription,
      type: "WebPage",
    }),
    {
      "@type": "OfferCatalog",
      "@id": `${absoluteUrl("/service")}#services`,
      name: "Digital marketing and web services",
      itemListElement: services.map((service) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: service.title,
          description: service.desc,
          serviceType: service.kicker,
          provider: { "@id": `${absoluteUrl("/")}#person` },
        },
      })),
    },
  ]}
>
  <main class="gear-page">
    <div class="gear-container">
      
      <!-- HERO -->
      <section class="gear-hero about-reveal-hero toki-r" data-d="1" aria-label="Services introduction">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">My Services</span>
        </div>
        <h1 class="gear-hero-title" set:html={serviceHeadlineHtml} />
        <p class="gear-intro">
          I help lean teams connect paid media, organic trust, analytics, SEO, and headless web builds into one measurable operating system.
        </p>
      </section>

      <!-- TRUST LOGOS (Infinite Horizontal Scrolling Marquee) -->
      <div class="client-strip">
        <span class="strip-label">Powering workflows across major digital sectors:</span>
        <div class="marquee-container">
          <div class="marquee-track">
            <!-- Group 1 -->
            <div class="marquee-group">
              <span>E-Commerce</span><span class="separator">✦</span>
              <span>Consumer Brands</span><span class="separator">✦</span>
              <span>SaaS Products</span><span class="separator">✦</span>
              <span>Mobile Apps</span><span class="separator">✦</span>
              <span>B2B Marketplaces</span><span class="separator">✦</span>
              <span>Fintech Services</span><span class="separator">✦</span>
              <span>AI Platforms</span><span class="separator">✦</span>
              <span>Creative Studios</span><span class="separator">✦</span>
              <span>Web3 Protocols</span>
            </div>
            <!-- Group 2 (Duplicate for seamless loop) -->
            <div class="marquee-group" aria-hidden="true">
              <span class="separator">✦</span>
              <span>E-Commerce</span><span class="separator">✦</span>
              <span>Consumer Brands</span><span class="separator">✦</span>
              <span>SaaS Products</span><span class="separator">✦</span>
              <span>Mobile Apps</span><span class="separator">✦</span>
              <span>B2B Marketplaces</span><span class="separator">✦</span>
              <span>Fintech Services</span><span class="separator">✦</span>
              <span>AI Platforms</span><span class="separator">✦</span>
              <span>Creative Studios</span><span class="separator">✦</span>
              <span>Web3 Protocols</span>
            </div>
          </div>
        </div>
      </div>

      <!-- MAIN FEATURES GRID -->
      <section class="features-section toki-r" data-d="2">
        <div class="section-header">
          <h2 class="section-title">A practical stack for acquisition, trust, and delivery</h2>
          <p class="section-desc">Each service is scoped around the operating work that moves revenue: setup, execution, measurement, and iteration.</p>
        </div>

        <div class="saas-grid">
          {services.map((service, index) => (
            <div class="saas-card" id={`service-card-${service.id}`} data-service-card data-index={index}>
              <div class="p-6 h-full flex flex-col">
                <div class="card-header">
                  <span class="card-num">{service.num}</span>
                  <span class="card-metric">{service.metric}</span>
                </div>
                <h3 class="card-title">{service.title}</h3>
                <p class="card-desc">{service.desc}</p>

                <ul class="card-checklist">
                  {service.checklist.map((item) => (
                    <li>
                      {item.Icon && <item.Icon className="w-4 h-4 text-accent shrink-0 mt-0.5" size={16} strokeWidth={1.8} />}
                      <span>{item.text}</span>
                    </li>
                  ))}
                </ul>

                <div class="card-tags mt-auto">
                  {service.tags.map((tag) => (
                    <span class="card-tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="saas-pagination" aria-label="Service carousel pagination">
          {services.map((service, index) => (
            <button
              class={`saas-pagination-dot ${index === 0 ? "active" : ""}`}
              type="button"
              aria-label={`Show ${service.title}`}
              aria-current={index === 0 ? "true" : undefined}
              data-service-dot
              data-index={index}
            ></button>
          ))}
        </div>
      </section>

      <!-- CAPABILITIES SWITCHER (Interactive Product tab) -->
      <section class="capabilities-dashboard toki-r" data-d="3">
        <div class="section-header">
          <h2 class="section-title">How the work gets executed</h2>
          <p class="section-desc">Pick a lane to see the actual operating tasks behind the service.</p>
        </div>

        <div class="dashboard-container">
          <!-- Left Tab Selectors -->
          <div class="dashboard-tabs" role="tablist" aria-label="Service capabilities">
            {services.map((service, index) => (
              <button 
                class={`tab-button ${index === 0 ? 'active' : ''}`}
                id={`tab-${service.id}`}
                data-tab={service.id}
                role="tab"
                aria-controls={`pane-${service.id}`}
                aria-selected={index === 0 ? "true" : "false"}
              >
                {service.Icon && <service.Icon className="tab-service-icon text-accent mr-2 shrink-0 inline-block" size={16} strokeWidth={1.8} />}
                <span class="tab-num">{service.num}</span>
                <span class="tab-title">{service.title}</span>
                <ArrowRight className="tab-arrow" size={16} strokeWidth={1.8} aria-hidden="true" />
              </button>
            ))}
          </div>

          <!-- Right Content Frame -->
          <div class="dashboard-content-panel">
            {services.map((service, index) => (
              <div 
                class={`tab-pane ${index === 0 ? 'active' : ''}`}
                id={`pane-${service.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${service.id}`}
                tabindex="0"
              >
                <div class="pane-split">
                  <div class="pane-info">
                    <div class="pane-meta">
                      <span class="pane-kicker">{service.kicker}</span>
                      <span class="pane-badge">{service.metric}</span>
                    </div>
                    <h3 class="pane-title">How I execute: {service.title}</h3>
                    <p class="pane-desc">{service.desc}</p>
                    
                    <div class="pane-cap-list">
                      {service.capabilities.map((cap) => (
                        <div class="pane-cap-item flex items-start gap-3">
                          {cap.Icon && (
                            <div class="pane-cap-icon-box p-2 rounded-lg bg-accent/10 text-accent shrink-0">
                              <cap.Icon size={18} strokeWidth={1.8} />
                            </div>
                          )}
                          <div class="pane-cap-copy">
                            <span class="pane-cap-name">{cap.name}</span>
                            <p class="pane-cap-desc">{cap.desc}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>


                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- TRUSTED BY BRANDS & TEAMS SECTION -->
      <section class="trust-by-section toki-r" data-d="4" id="trusted-by">
        <div class="trust-by-header">
          <span class="trust-by-eyebrow">ACADEMIC & CAMPUS PARTNERS</span>
          <h2 class="trust-by-title">Trusted by top universities & academic communities</h2>
          <p class="trust-by-desc">Collaborating with leading universities across Vietnam for workshops, career orientation, and student community building.</p>
        </div>

        <!-- Marquee Strip -->
        <div class="trust-by-marquee-wrapper" aria-hidden="true">
          <div class="trust-by-marquee-track">
            {[...trustClients, ...trustClients, ...trustClients, ...trustClients].map((client) => (
              <div class="trust-by-pill">
                <img src={client.logo} alt={client.name} class="trust-by-pill-logo" loading="eager" decoding="async" />
                <span class="trust-by-pill-name">{client.name}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- PRICING TIERS SECTION -->
      <section class="pricing-section toki-r" data-d="4" id="pricing-block">
        <div class="section-header">
          <h2 class="section-title">Simple, flat-rate pricing models</h2>
          <p class="section-desc">No agency percentages. No complex sales loops. Pick the format that fits your pace.</p>
          
          <!-- Billing Toggle -->
          <div class="pricing-toggle-container">
            <span class="toggle-label">Monthly Retainer</span>
            <button class="pricing-toggle-btn" id="billing-toggle" type="button" aria-label="Toggle billing duration" aria-pressed="false">
              <span class="toggle-slider"></span>
            </button>
            <span class="toggle-label">One-Time Project</span>
          </div>
        </div>

        <div class="pricing-grid">
          {pricingPlans.map((plan) => (
            <div class={`pricing-card t-tilt ${plan.popular ? 'popular' : ''}`}>
              <div class="t-tilt-card p-8 h-full flex flex-col">
                <div class="plan-header">
                  <div class="plan-tag-row">
                    <span class="plan-tag">{plan.tag}</span>
                    {plan.popular && <span class="popular-badge">RECOMMENDED</span>}
                  </div>
                  <h3 class="plan-title">{plan.title}</h3>
                  <p class="plan-desc">{plan.desc}</p>
                </div>

                <div class="plan-price" aria-live="polite">
                  <span class="price-eyebrow">Starting at</span>
                  <div class="price-row">
                    <span class="price-val" data-monthly={plan.priceMonthly} data-project={plan.priceProject}>
                      {plan.priceMonthly}
                    </span>
                    <span class="price-period">/month</span>
                  </div>
                </div>


                <div class="plan-features-header">Scope parameters:</div>
                <ul class="plan-features">
                  {plan.features.map((feat) => (
                    <li>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </main>
</Layout>

<!-- Client scripts for interactivity -->
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    /* ── Tab Switcher Logic ── */
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Remove active class from buttons and set aria-selected false
        tabButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
        
        // Hide all panes
        tabPanes.forEach(pane => pane.classList.remove('active'));

        // Activate clicked tab
        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');
        
        // Show target pane
        const targetId = `pane-${button.dataset.tab}`;
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.classList.add('active');
        }
      });
    });

    /* ── Pricing Toggle Logic ── */
    const billingToggle = document.getElementById('billing-toggle');
    const priceVals = document.querySelectorAll('.price-val');
    const pricePeriods = document.querySelectorAll('.price-period');
    let isProjectMode = false;

    if (billingToggle) {
      billingToggle.addEventListener('click', () => {
        isProjectMode = !isProjectMode;
        billingToggle.classList.toggle('active', isProjectMode);
        billingToggle.setAttribute('aria-pressed', String(isProjectMode));
        
        priceVals.forEach(val => {
          const monthly = val.dataset.monthly;
          const project = val.dataset.project;
          val.textContent = isProjectMode ? project : monthly;
        });

        pricePeriods.forEach(period => {
          period.textContent = isProjectMode ? ' total' : '/month';
        });
      });
    }

    /* ── Horizontal Scroll Service Stack ── */
    const serviceStackScroller = document.querySelector('.saas-grid');

    if (serviceStackScroller) {
      const serviceCards = Array.from(serviceStackScroller.querySelectorAll('[data-service-card]'));
      const serviceDots = Array.from(document.querySelectorAll('[data-service-dot]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const autoplayDelay = 4000;
      let activeServiceIndex = 0;
      let autoplayTimer = 0;
      let isCarouselPaused = false;
      let scrollFrame = 0;

      const setActiveServiceDot = (activeIndex) => {
        activeServiceIndex = activeIndex;
        serviceDots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          if (isActive) {
            if (dot.classList.contains('active')) {
              dot.classList.remove('active');
              void dot.offsetWidth;
            }
            dot.classList.add('active');
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.classList.remove('active');
            dot.removeAttribute('aria-current');
          }
        });
      };

      const getServiceCardScrollLeft = (card) => {
        const scrollerRect = serviceStackScroller.getBoundingClientRect();
        const cardRect = card.getBoundingClientRect();
        return cardRect.left - scrollerRect.left + serviceStackScroller.scrollLeft;
      };

      const scrollToServiceCard = (targetIndex, behavior = 'smooth') => {
        const targetCard = serviceCards[targetIndex];
        if (!targetCard) return;

        serviceStackScroller.scrollTo({
          left: getServiceCardScrollLeft(targetCard),
          behavior: reducedMotion.matches ? 'auto' : behavior,
        });
      };

      const advanceServiceCarousel = () => {
        if (isCarouselPaused || serviceCards.length < 2) return;

        const nextIndex = (activeServiceIndex + 1) % serviceCards.length;
        setActiveServiceDot(nextIndex);
        scrollToServiceCard(nextIndex);
        scheduleServiceAutoplay();
      };

      const scheduleServiceAutoplay = () => {
        window.clearTimeout(autoplayTimer);
        if (isCarouselPaused || serviceCards.length < 2) return;

        autoplayTimer = window.setTimeout(advanceServiceCarousel, autoplayDelay + 80);
      };

      const syncServiceDots = () => {
        const activeIndex = serviceCards.reduce((closestIndex, card, index) => {
          const closestCard = serviceCards[closestIndex];
          return Math.abs(getServiceCardScrollLeft(card) - serviceStackScroller.scrollLeft) <
            Math.abs(getServiceCardScrollLeft(closestCard) - serviceStackScroller.scrollLeft)
            ? index
            : closestIndex;
        }, 0);

        if (activeIndex !== activeServiceIndex) {
          setActiveServiceDot(activeIndex);
        }
      };

      serviceDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const clickedIndex = Number(dot.dataset.index || 0);
          const targetIndex = clickedIndex === activeServiceIndex
            ? (activeServiceIndex + 1) % serviceCards.length
            : clickedIndex;
          scrollToServiceCard(targetIndex);
          setActiveServiceDot(targetIndex);
          scheduleServiceAutoplay();
        });
      });

      serviceStackScroller.addEventListener('scroll', () => {
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(syncServiceDots);
      }, { passive: true });

      serviceStackScroller.addEventListener('pointerdown', () => {
        scheduleServiceAutoplay();
      }, { passive: true });

      serviceDots.forEach((dot) => {
        dot.addEventListener('focus', () => {
          isCarouselPaused = true;
          window.clearTimeout(autoplayTimer);
          serviceDots.forEach((item) => item.classList.add('paused'));
        });

        dot.addEventListener('blur', () => {
          isCarouselPaused = false;
          serviceDots.forEach((item) => item.classList.remove('paused'));
          scheduleServiceAutoplay();
        });
      });

      reducedMotion.addEventListener('change', scheduleServiceAutoplay);
      syncServiceDots();
      scheduleServiceAutoplay();
    }

  });
</script>

