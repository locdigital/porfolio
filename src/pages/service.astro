            {services.map((service, index) => (
              <button 
                class={`tab-button ${index === 0 ? 'active' : ''}`}
                id={`tab-${service.id}`}
                data-tab={service.id}
                role="tab"
                aria-controls={`pane-${service.id}`}
                aria-selected={index === 0 ? "true" : "false"}
