                <span class="tab-num">{service.num}</span>
                <span class="tab-title">{service.title}</span>
                <span class="tab-arrow">→</span>
              </button>
            ))}
          </div>

          <!-- Right Content Frame -->
          <div class="dashboard-content-panel">
            {services.map((service, index) => (
              <div 
                class={`tab-pane ${index === 0 ? 'active' : ''}`}
                id={`pane-${service.id}`}
              >
                <div class="pane-split">
                  <div class="pane-info">
                    <div class="pane-meta">
                      <span class="pane-kicker">{service.kicker}</span>
                      <span class="pane-badge">{service.metric}</span>
                    </div>
                    <h3 class="pane-title">How I execute: {service.title}</h3>
                    <p class="pane-desc">{service.desc}</p>
                    
                    <div class="pane-cap-list">
                      {service.capabilities.map((cap) => (
                        <div class="pane-cap-item">
                          <div class="pane-cap-header">
                            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                            <span class="pane-cap-name">{cap.name}</span>
                          </div>
                          <p class="pane-cap-desc">{cap.desc}</p>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="pane-media">
                    <div class="media-container">
                      <Image src={service.img} alt={service.alt} loading="lazy" decoding="async" />
                      <div class="media-label">Sample Work Environment</div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- PRICING TIERS SECTION -->
      <section class="pricing-section toki-r" data-d="4" id="pricing-block">
        <div class="section-header">
          <h2 class="section-title">Simple, flat-rate pricing models</h2>
          <p class="section-desc">No agency percentages. No complex sales loops. Pick the format that fits your pace.</p>
          
          <!-- Billing Toggle -->
          <div class="pricing-toggle-container">
            <span class="toggle-label">Monthly Retainer</span>
            <button class="pricing-toggle-btn active" id="billing-toggle" aria-label="Toggle billing duration">
              <span class="toggle-slider"></span>
            </button>
            <span class="toggle-label">One-Time Project</span>
          </div>
        </div>

        <div class="pricing-grid">
          {pricingPlans.map((plan) => (
            <div class={`pricing-card ${plan.popular ? 'popular' : ''}`}>
              {plan.popular && <span class="popular-badge">RECOMMENDED</span>}
              <div class="plan-header">
                <span class="plan-tag">{plan.tag}</span>
                <h3 class="plan-title">{plan.title}</h3>
                <p class="plan-desc">{plan.desc}</p>
              </div>

              <div class="plan-price">
                <span class="price-val" data-monthly={plan.priceMonthly} data-project={plan.priceProject}>
                  {plan.priceMonthly}
                </span>
                <span class="price-period" id="pricing-period">/month</span>
              </div>

              <a href="mailto:hi@loc.digital" class={`plan-cta-btn ${plan.popular ? 'btn-primary' : 'btn-secondary'}`}>
                Get Started
              </a>

              <div class="plan-features-header">Scope parameters:</div>
              <ul class="plan-features">
                {plan.features.map((feat) => (
                  <li>
                    <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ ACCORDION -->
      <section class="faq-section toki-r" data-d="5">
        <div class="section-header">
          <h2 class="section-title">Frequently Asked Questions</h2>
          <p class="section-desc">Clear answers about collaboration processes, scope, and technical setups.</p>
        </div>

        <div class="faq-accordion-container">
          {faqs.map((faq, index) => (
            <div class="faq-item">
              <button class="faq-header" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
                <span class="faq-question-wrapper">
                  {faq.iconName === "calendar" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                      <line x1="16" x2="16" y1="2" y2="6" />
                      <line x1="8" x2="8" y1="2" y2="6" />
                      <line x1="3" x2="21" y1="10" y2="10" />
                    </svg>
                  )}
                  {faq.iconName === "code" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  )}
                  {faq.iconName === "zap" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {faq.iconName === "message" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-question-icon">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                  )}
                  <span class="faq-question">{faq.q}</span>
                </span>
                <svg class="faq-toggle-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M2 8h12" />
                  <path class="vertical-line" d="M8 2v12" />
                </svg>
              </button>
              <div class="faq-answer-wrapper" id={`faq-answer-${index}`} aria-hidden="true">
                <div class="faq-answer">
                  <p>{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="services-cta toki-r" data-d="6">
        <div class="cta-card">
          <h2 class="cta-title">Ready to scale your next campaign?</h2>
          <p class="cta-desc">
            Let's build a clean setup that accurately attributes conversions and runs at maximum speed.
          </p>
          <div class="cta-buttons">
            <a href="mailto:hi@loc.digital" class="btn btn-primary">hi@loc.digital ↗</a>
            <a href="/question" class="btn btn-secondary">Ask Leah anything ✦</a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<!-- Client scripts for interactivity -->
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    /* ── Tab Switcher Logic ── */
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Remove active class from buttons and set aria-selected false
        tabButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
        
        // Hide all panes
        tabPanes.forEach(pane => pane.classList.remove('active'));

        // Activate clicked tab
        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');
        
        // Show target pane
        const targetId = `pane-${button.dataset.tab}`;
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.classList.add('active');
        }
      });
    });

    /* ── Pricing Toggle Logic ── */
    const billingToggle = document.getElementById('billing-toggle');
    const priceVals = document.querySelectorAll('.price-val');
    const pricePeriods = document.querySelectorAll('#pricing-period');
    let isProjectMode = false;

    if (billingToggle) {
      billingToggle.addEventListener('click', () => {
        isProjectMode = !isProjectMode;
        billingToggle.classList.toggle('active', isProjectMode);
        
        priceVals.forEach(val => {
          const monthly = val.dataset.monthly;
          const project = val.dataset.project;
          val.textContent = isProjectMode ? project : monthly;
        });

        pricePeriods.forEach(period => {
          period.textContent = isProjectMode ? ' total' : '/month';
        });
      });
    }

    /* ── Scroll to Pricing ── */
    const scrollBtn = document.getElementById('scroll-to-pricing');
    const pricingBlock = document.getElementById('pricing-block');
    if (scrollBtn && pricingBlock) {
      scrollBtn.addEventListener('click', () => {
        pricingBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    /* ── Collapsible Accordion FAQs ── */
    const faqHeaders = document.querySelectorAll('.faq-header');

    faqHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        const wrapper = header.nextElementSibling;
        
        // Toggle state
        header.setAttribute('aria-expanded', !isExpanded);
        header.classList.toggle('active', !isExpanded);
        
        if (wrapper) {
          wrapper.setAttribute('aria-hidden', isExpanded);
          
          if (!isExpanded) {
            // Get exact content height and set max-height for transition
            const contentHeight = wrapper.scrollHeight;
            wrapper.style.maxHeight = `${contentHeight}px`;
            wrapper.style.opacity = '1';
          } else {
            wrapper.style.maxHeight = '0';
            wrapper.style.opacity = '0';
          }
        }
      });
    });
  });
</script>

<style>
