---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";

export const prerender = true;

const resumePdfPath = "/Senior%20Performance%20Marketing_NguyenPhucLoc_Resume.pdf";
const pageTitle = "Resume V2 | Phuc Loc Nguyen";
const pageDescription =
  "A clean Harvard-style web resume for Phuc Loc Nguyen, Digital Media Senior Executive.";

const contactLinks = [
  { label: "loc.digital", href: "https://loc.digital/" },
  { label: "hi@loc.digital", href: "mailto:hi@loc.digital" },
  { label: "+84 888 886 038", href: "tel:+84888886038" },
  { label: "linkedin.com/in/phucloc", href: "https://www.linkedin.com/in/phucloc" },
];

const experiences = [
  {
    company: "PlayAh! Vietnam",
    role: "Performance Senior Executive",
    period: "Dec 2024 — Aug 2026",
    roleDescription:
      "Own multi-channel performance growth across TikTok Shop, website, Meta, Google, and AI-assisted sales funnels, turning creator supply, creative testing, and media buying into scalable revenue.",
    bullets: [
      "Scaled TikTok Shop revenue from tens of millions to billions of VND per month by building a KOC booking engine, developing AI-powered character channels, and continuously testing UGC, AI sales videos, and new content angles.",
      "Increased website revenue by 10x within 3 months through a multi-channel paid media strategy combining Google Performance Max, Search, TikTok Spark Ads, and Meta Website Conversion campaigns.",
      "Grew Facebook-driven revenue by 3x and redesigned the sales conversion flow with AI-assisted customer handling, improving Fanpage conversion rate by 30%+.",
    ],
  },
  {
    company: "WorkFlow Space",
    role: "Digital Marketing Executive",
    period: "May 2024 — Aug 2026",
    roleDescription:
      "Lead branch-launch acquisition for co-working spaces and private pods, covering paid media, landing pages, booking UX, creative testing, and reporting.",
    bullets: [
      "Built and optimized full-funnel Paid Media strategies, covering customer acquisition, conversion, and retargeting, while reallocating budgets based on campaign efficiency and contribution margin.",
      "Led Performance Marketing campaigns supporting the company's expansion into new locations, generating more than 5,000 trial registrations for co-working spaces and private pods during the launch of the Go Vap and District 8 branches.",
      "Worked closely with the IT and Design teams to rebuild the website, improve booking UX, and test 100+ creative assets across Facebook and Google.",
    ],
  },
  {
    company: "TOMATO Children's Home",
    role: "Digital Marketing Executive",
    period: "Mar 2023 — May 2024",
    roleDescription:
      "Manage integrated enrollment marketing across paid media, social, landing pages, OOH, CRM, and email automation for early childhood education.",
    bullets: [
      "Developed and executed integrated 360° marketing strategies across paid media, CRM, social media, content, landing pages, and offline channels, contributing to nearly 2x growth in student enrollment.",
      "Led performance marketing and creative optimization across Facebook and Google, improving media efficiency while reducing cost per lead by approximately 60%.",
      "Built and optimized email automation and lead nurturing journeys, maintaining 60%+ open rates while supporting stronger conversion across the customer lifecycle.",
    ],
  },
  {
    company: "POPS Worldwide",
    role: "Search Engine Optimization Executive",
    period: "Mar 2022 — May 2023",
    roleDescription:
      "Lead technical and product SEO execution across POPS Vietnam, POPS Kids, and POPS Kids Learn, coordinating with data, product, and engineering teams.",
    bullets: [
      "Developed SEO strategies and technical roadmaps across regional and local markets, focusing on Technical Performance, Content Quality, and Link Building.",
      "Grew monthly users for POPS.VN by 10x, reaching approximately 2.5 million users per month compared with 2020.",
      "Supported the development and launch of POPS Kids Learn (10,000+ new users in 4 months) and POPS Kids (400,000 users in 6 months).",
    ],
  },
  {
    company: "Đại Học Đừng Học Đại & Đi Làm Đừng Đi Làm",
    role: "Founding Member / Community Lead",
    period: "Jan 2021 — Present",
    roleDescription:
      "Co-build education and career communities that translate student questions into content systems, guidance formats, and audience growth loops.",
    bullets: [
      "Co-founded and scaled two educational communities reaching approximately +3,000,000 and +1,000,000 members respectively within 12 months.",
      "Led community content direction, audience growth loops, and student mentorship initiatives.",
    ],
  },
];

const skills = [
  {
    group: "Creator & Campaign Marketing",
    items: "Creator/KOC Campaigns, Community Activations, Short-Form Video Marketing, Campaign Planning & Execution, Local Market Activation",
  },
  {
    group: "Analytics & Reporting",
    items: "GA4, Looker Studio, Campaign Dashboards, Performance Analysis, Market & Audience Insights",
  },
  {
    group: "Performance & Optimisation",
    items: "Paid Media, Campaign Measurement, ROI & Conversion Optimisation, Test-and-Learn, Creative & Audience Testing",
  },
  {
    group: "Stakeholder Management",
    items: "Cross-functional Collaboration, Agency Management, Partnership Coordination, Campaign Workflow Management",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  hideHeader={true}
  hideFooter={true}
  schema={pageSchema({
    url: absoluteUrl("/resume-v2"),
    title: pageTitle,
    description: pageDescription,
    type: "ProfilePage",
  })}
>
  <main class="resume-v2" aria-labelledby="resume-title">
    <div class="resume-toolbar" aria-label="Resume actions">
      <a href="/">Back to portfolio</a>
      <a href={resumePdfPath} target="_blank" rel="noopener noreferrer">Open PDF</a>
    </div>

    <article class="resume-sheet">
      <header class="resume-header">
        <h1 id="resume-title">Phuc Loc Nguyen</h1>
        <p>Digital Media Senior Executive</p>
        <nav aria-label="Contact links">
          {contactLinks.map((link, index) => (
            <>
              <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                {link.label}
              </a>
              {index < contactLinks.length - 1 && <span aria-hidden="true">|</span>}
            </>
          ))}
        </nav>
      </header>

      <section class="resume-section" aria-labelledby="summary-title">
        <h2 id="summary-title">Professional Summary</h2>
        <p>
          Digital media and performance marketing senior executive based in Ho Chi Minh City with extensive experience scaling paid acquisition, TikTok Shop revenue, SEO growth, and automation systems across e-commerce, education, community, and digital entertainment products. Strong in connecting channel strategy, creator/KOC activations, creative testing, analytics, and funnel operations to measurable revenue outcomes.
        </p>
      </section>

      <section class="resume-section" aria-labelledby="education-title">
        <h2 id="education-title">Education</h2>
        <div class="resume-row">
          <div>
            <h3>FPT University</h3>
            <p>Bachelor of Digital Marketing, Graduated with Honors (GPA 9.4/10)</p>
          </div>
          <span>May 2019 — Mar 2023</span>
        </div>
      </section>

      <section class="resume-section" aria-labelledby="experience-title">
        <h2 id="experience-title">Professional Experience</h2>
        <div class="resume-experience-list">
          {experiences.map((experience) => (
            <section class="resume-experience" aria-label={`${experience.role} at ${experience.company}`}>
              <div class="resume-row resume-row--role">
                <div>
                  <h3>{experience.company}</h3>
                  <p>{experience.role}</p>
                </div>
                <span>{experience.period}</span>
              </div>
              <p class="resume-role-description">{experience.roleDescription}</p>
              <ul>
                {experience.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </section>
          ))}
        </div>
      </section>

      <section class="resume-section" aria-labelledby="skills-title">
        <h2 id="skills-title">Skills</h2>
        <div class="resume-skills">
          {skills.map((skill) => (
            <p><span>{skill.group}:</span> {skill.items}</p>
          ))}
        </div>
      </section>

      <section class="resume-section" aria-labelledby="selected-impact-title">
        <h2 id="selected-impact-title">Selected Impact</h2>
        <ul class="resume-impact">
          <li>Scaled TikTok Shop revenue to 1B+ VND monthly.</li>
          <li>Generated 5,000+ trial registrations for WorkFlow Space branch launches.</li>
          <li>Grew education and career communities to 4M+ combined members.</li>
          <li>Scaled POPS Vietnam monthly active users 10x YoY to 2.5M.</li>
        </ul>
      </section>
    </article>
  </main>
</Layout>

<style>
  .resume-v2 {
    --resume-ink: #171717;
    --resume-muted: #4f4f4a;
    --resume-line: #d9d6cc;
    --resume-paper: #fffdf8;
    min-height: 100vh;
    padding: clamp(20px, 4vw, 48px) var(--page-gutter) clamp(48px, 7vw, 88px);
    color: var(--resume-ink);
    background: #f7f3e8;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.52;
  }

  .resume-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: min(100%, 880px);
    margin: 0 auto 14px;
    font-size: 13px;
  }

  .resume-toolbar a,
  .resume-header a {
    color: var(--resume-ink);
    font-weight: 500;
    text-decoration-color: rgba(23, 23, 23, 0.28);
    text-underline-offset: 3px;
  }

  .resume-sheet {
    width: min(100%, 880px);
    margin: 0 auto;
    padding: clamp(28px, 5vw, 54px);
    border: 1px solid var(--resume-line);
    background: var(--resume-paper);
    box-shadow: 0 18px 52px rgba(31, 25, 14, 0.08);
  }

  .resume-header {
    padding-bottom: 18px;
    text-align: center;
  }

  .resume-header h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.35rem, 5vw, 3.65rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.018em;
  }

  .resume-header p {
    margin: 8px 0 9px;
    color: var(--resume-ink);
    font-size: 14px;
    font-weight: 500;
  }

  .resume-header nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 9px;
    color: var(--resume-muted);
    font-size: 12.5px;
  }

  .resume-section {
    padding-top: 16px;
  }

  .resume-section h2 {
    margin: 0 0 9px;
    border-bottom: 1px solid var(--resume-ink);
    padding-bottom: 3px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .resume-section p,
  .resume-section li {
    color: var(--resume-muted);
    font-size: 14px;
    font-weight: 400;
  }

  .resume-section > p {
    margin: 0;
  }

  .resume-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    margin-top: 9px;
  }

  .resume-row h3 {
    margin: 0;
    color: var(--resume-ink);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
  }

  .resume-row p {
    margin: 1px 0 0;
  }

  .resume-row > span {
    color: var(--resume-ink);
    font-size: 13px;
    font-weight: 500;
    text-align: right;
    white-space: nowrap;
  }

  .resume-row--role {
    margin-top: 0;
  }

  .resume-row--role p {
    color: var(--resume-ink);
    font-weight: 400;
    font-style: italic;
  }

  .resume-role-description {
    max-width: 72ch;
    margin: 4px 0 0;
    text-wrap: pretty;
  }

  .resume-experience-list {
    display: grid;
    gap: 13px;
  }

  .resume-experience ul,
  .resume-impact {
    display: grid;
    gap: 4px;
    margin: 6px 0 0;
    padding-left: 18px;
  }

  .resume-experience li,
  .resume-impact li {
    padding-left: 2px;
  }

  .resume-skills {
    display: grid;
    gap: 5px;
  }

  .resume-skills p {
    margin: 0;
  }

  .resume-skills span {
    color: var(--resume-ink);
    font-weight: 500;
  }

  @media (max-width: 680px) {
    .resume-v2 {
      padding-inline: 12px;
      background: var(--resume-paper);
    }

    .resume-sheet {
      padding: 24px 18px 36px;
      border: 0;
      box-shadow: none;
    }

    .resume-toolbar {
      padding-inline: 6px;
    }

    .resume-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .resume-row > span {
      text-align: left;
      white-space: normal;
    }
  }

  @media print {
    .resume-v2 {
      padding: 0;
      background: #fff;
    }

    .resume-toolbar {
      display: none;
    }

    .resume-sheet {
      width: 100%;
      max-width: none;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: #fff;
    }
  }
</style>
