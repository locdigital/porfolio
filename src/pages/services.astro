---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { ArrowUpRight, Check } from "../components/icons/majesticons";

const services = [
  {
    id: "01",
    category: "Performance Marketing",
    title: "Performance Ads & Attribution",
    metric: "4.2x Avg ROAS",
    color: "#2383E2",
    soft: "#EAF4FF",
    border: "#B9DDFF",
    ink: "#0B5CAD",
    summary: "Acquisition scaling and CAC reduction across Meta, Google Search/PMax, and TikTok Ads supported by server-side CAPI and attribution modeling.",
    tags: ["Meta Ads", "Google Ads", "TikTok Ads", "GA4 Server-Side", "Looker Studio"],
    checklist: [
      "Custom tracking Pixel & Server-Side Conversions API (CAPI) integration.",
      "Full-funnel ad structure on Google (Search/PMax), Meta, and TikTok.",
      "Attribution audit & GA4 measurement event standardization.",
      "Automated weekly performance reporting dashboards via Looker Studio."
    ]
  },
  {
    id: "02",
    category: "Social Seeding",
    title: "Organic Seeding & Advocacy",
    metric: "85% Trust Index",
    color: "#FFB224",
    soft: "#FFF4D8",
    border: "#FFD98A",
    ink: "#8A5A00",
    summary: "Authentic peer discussion seeding across high-intent communities, sentiment management, and micro-influencer advocacy.",
    tags: ["Forum Seeding", "Reddit & Facebook", "Sentiment Mgmt", "KOC Booking"],
    checklist: [
      "Natural conversation angles across Reddit, Facebook groups, and tech forums.",
      "Niche community monitoring & proactive brand sentiment control.",
      "Brand credibility reinforcement through authentic micro-KOCs.",
      "Crisis response scripts and community moderation guidelines."
    ]
  },
  {
    id: "03",
    category: "Brand Marketing",
    title: "Strategic Brand Positioning",
    metric: "100% Alignment",
    color: "#FF4938",
    soft: "#FFEDEA",
    border: "#FFC1B8",
    ink: "#A51E12",
    summary: "Core brand positioning, tone-of-voice frameworks, and visual identity guidelines to differentiate in crowded digital markets.",
    tags: ["Market Positioning", "Messaging Maps", "Visual Styleguides", "Tone of Voice"],
    checklist: [
      "Brand voice guideline & copy architecture handbook.",
      "Market positioning audit & Unique Value Proposition (UVP) design.",
      "Campaign narrative planning & launch messaging roadmaps.",
      "Harmonized typography, color palettes, and visual systems."
    ]
  },
  {
    id: "04",
    category: "E-Commerce Growth",
    title: "DTC Storefront Optimization",
    metric: "+28% Conversion",
    color: "#20B84E",
    soft: "#E8F8EE",
    border: "#AEE7C1",
    ink: "#137633",
    summary: "Storefront UX refinement and retention funnel architecture to maximize Average Order Value (AOV) and customer lifetime value (LTV).",
    tags: ["Shopify CRO", "Cart Funnel", "Klaviyo CRM", "Catalog Feed"],
    checklist: [
      "Sliding Cart Drawer & dynamic checkout optimization (CRO).",
      "Automated customer lifecycle email nurturing via Klaviyo CRM.",
      "Optimized product catalog feeds for TikTok Shop & Meta Shopping.",
      "E-commerce drop-off analysis and checkout funnel diagnostics."
    ]
  },
  {
    id: "05",
    category: "Web Development",
    title: "Headless Web Engineering",
    metric: "100/100 Speed",
    color: "#1710A8",
    soft: "#ECEBFF",
    border: "#C7C3FF",
    ink: "#1710A8",
    summary: "Ultra-fast responsive static websites built on Astro and React, achieving perfect Google Lighthouse scores and strict technical SEO.",
    tags: ["Astro Framework", "React & TS", "Keystatic CMS", "Core Web Vitals"],
    checklist: [
      "Headless static website deployment on modern Astro framework.",
      "Interactive fluid UI with lightweight micro-animations.",
      "Complete technical SEO meta tags, automatic sitemaps, and JSON-LD schema.",
      "Intuitive headless CMS integration for seamless content updates."
    ]
  },
  {
    id: "06",
    category: "Growth Automation",
    title: "AI Funnels & Growth Automation",
    metric: "95% Automation",
    color: "#8B7CF6",
    soft: "#F1EFFF",
    border: "#D6D0FF",
    ink: "#4C3CCF",
    summary: "Eliminating manual marketing operations and scaling lead acquisition through CRM workflows, webhook syncs, and AI content engines.",
    tags: ["Make.com", "Zapier", "AI Scripting", "CRM Flows", "Programmatic SEO"],
    checklist: [
      "Automated multi-channel lead routing to CRM with instant alerts.",
      "AI-driven content optimization & programmatic SEO workflows.",
      "Database synchronization and automated reporting via webhooks.",
      "Multi-branch automated email sequence logic."
    ]
  }
];

const pricingPlans = [
  {
    title: "Advocacy Seeding Retainer",
    category: "Awareness & Community",
    monthlyPrice: "$2,490",
    projectPrice: "$6,900",
    popular: false,
    description: "Ideal for brands wanting authentic peer discussion, forum presence, and community sentiment control.",
    deliverables: [
      "Weekly organic seeding threads & discussion moderation",
      "Reddit, Facebook groups & tech forum monitoring",
      "Dedicated campaign engineer & sentiment alerts",
      "Creator & KOC content briefs and angles mapping",
      "Weekly screenshot & link reporting",
      "Competitor movement tracking"
    ]
  },
  {
    title: "Full-Funnel Growth Retainer",
    category: "Scale & Performance",
    monthlyPrice: "$4,990",
    projectPrice: "$12,500",
    popular: true,
    description: "Comprehensive end-to-end performance engine connecting paid media, TikTok Shop, landing pages, and attribution.",
    deliverables: [
      "End-to-end management of Meta, Google & TikTok Ads",
      "Server-side CAPI & GA4 measurement setup via GTM Server",
      "Weekly automated Looker Studio performance dashboard",
      "Landing page CRO audits and diagnostic fixes",
      "KOC/Creator briefing & weekly creative testing roadmap",
      "Strict CAC guardrails & spend discipline",
      "Monthly executive growth briefing"
    ]
  },
  {
    title: "Headless Web Engineering",
    category: "Code & SEO",
    monthlyPrice: "$3,800",
    projectPrice: "$7,500",
    popular: false,
    description: "Bespoke Astro/React website build engineered for extreme speed, Core Web Vitals, and effortless CMS editing.",
    deliverables: [
      "Custom responsive Astro & React website architecture",
      "Headless CMS integration for effortless client editing",
      "100/100 Google Lighthouse Core Web Vitals optimization",
      "Full Technical SEO & JSON-LD schema configuration",
      "Integrated analytics, pixel, and conversion event tagging",
      "4 weeks dedicated post-launch support and warranty"
    ]
  }
];

const collaborationLogos = [
  { name: "Framer", role: "Web Experience", initials: "Fr", logo: "https://cdn.simpleicons.org/framer/111111" },
  { name: "Recraft", role: "AI Visual Design", initials: "Rc", logo: "https://www.google.com/s2/favicons?domain=recraft.ai&sz=128" },
  { name: "Higgsfield", role: "AI Motion", initials: "Hi", logo: "https://www.google.com/s2/favicons?domain=higgsfield.ai&sz=128" },
  { name: "Freepik", role: "Creative Assets", initials: "Fp", logo: "https://cdn.simpleicons.org/freepik/1273EB" },
  { name: "Figma", role: "Interface Design", initials: "Fi", logo: "https://cdn.simpleicons.org/figma/F24E1E" },
  { name: "Kittl", role: "Brand Design", initials: "Ki", logo: "https://www.google.com/s2/favicons?domain=kittl.com&sz=128" },
  { name: "Adobe", role: "Creative Suite", initials: "Ad", logo: "https://www.google.com/s2/favicons?domain=adobe.com&sz=128" },
  { name: "Lovart", role: "AI Design Agent", initials: "Lo", logo: "https://www.google.com/s2/favicons?domain=lovart.ai&sz=128" },
  { name: "Lottie Files", role: "Motion Assets", initials: "Lf", logo: "https://cdn.simpleicons.org/lottiefiles/00DDB3" },
  { name: "Relume", role: "Wireframes", initials: "Rl", logo: "https://www.google.com/s2/favicons?domain=relume.io&sz=128" },
  { name: "Spline", role: "3D Web", initials: "Sp", logo: "https://www.google.com/s2/favicons?domain=spline.design&sz=128" },
  { name: "Wix Studio", role: "Web Platform", initials: "Wx", logo: "https://cdn.simpleicons.org/wix/0C6EFC" },
  { name: "Webflow", role: "No-code Build", initials: "Wf", logo: "https://cdn.simpleicons.org/webflow/146EF5" },
  { name: "Canva", role: "Creative Design", initials: "Ca", logo: "https://www.google.com/s2/favicons?domain=canva.com&sz=128" },
  { name: "OpenAI", role: "AI Operations", initials: "AI", logo: "https://www.google.com/s2/favicons?domain=openai.com&sz=128" },
  { name: "Runway", role: "AI Video", initials: "Rw", logo: "https://www.google.com/s2/favicons?domain=runwayml.com&sz=128" },
  { name: "Notion", role: "Project Docs", initials: "No", logo: "https://cdn.simpleicons.org/notion/111111" },
];
---

<DashboardLayout
  title="Services & Retainers — Phuc Loc Nguyen"
  pageTitle="Services"
  description="Performance ads, TikTok Shop acceleration, DTC CRO, headless web development, and AI marketing automation services."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Services" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Services & Capabilities</h1>
    <p class="page-lead">
      Connecting paid media, organic trust, analytics, technical SEO, and headless web engineering into one measurable growth engine.
    </p>
  </header>

  <!-- 6 Modular Capabilities -->
  <section class="page-section" aria-labelledby="heading-capabilities">
    <h2 id="heading-capabilities" class="section-title">Modular capabilities (6 offerings)</h2>

    <div class="services-grid">
      {services.map((s) => (
        <article
          class="dash-card service-capability-card"
          style={`--service-color: ${s.color}; --service-soft: ${s.soft}; --service-border: ${s.border}; --service-ink: ${s.ink}; --card-outer-radius: 12px; --card-padding: 16px;`}
        >
          <div>
            <div class="service-card-header">
              <span class="dash-tag service-category-pill">{s.category}</span>
              <span class="service-card-id">{s.id}</span>
            </div>

            <h3 class="item-title" style="margin-bottom: 8px;">
              {s.title}
            </h3>

            <p style="font-size: 0.875rem; line-height: 1.55; color: var(--dash-muted); margin: 0 0 14px;">
              {s.summary}
            </p>

            <!-- Scope Checklist (Concentric nested surface block) -->
            <div class="dash-card-nested-block service-scope-block">
              <div style="font-size: 0.75rem; font-weight: 600; color: var(--dash-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.04em;">
                Scope & deliverables
              </div>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
                {s.checklist.map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.8125rem; line-height: 1.45; color: var(--dash-text);">
                    <span class="dash-bullet service-bullet" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tags -->
            <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 16px;">
              {s.tags.map((t) => (
                <span class="dash-tag service-tech-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Pricing Plans & Retainer Structures -->
  <section class="page-section" aria-labelledby="heading-pricing">
    <h2 id="heading-pricing" class="pricing-section-title">Pricing plans & retainers</h2>
    <p class="pricing-section-desc">
      Dedicated monthly retainers for ongoing growth acceleration or fixed-scope engineering packages.
    </p>

    <div class="pricing-grid">
      {pricingPlans.map((plan) => (
        <article 
          class={`pricing-card ${plan.popular ? "pricing-card--recommended" : ""}`}
        >
          <!-- 1. Category label & optional recommendation label -->
          <div class="pricing-meta-row">
            <span class="pricing-category">{plan.category}</span>
            {plan.popular && (
              <span class="pricing-recommended-badge">Recommended</span>
            )}
          </div>

          <!-- 2. Plan name -->
          <h3 class="pricing-plan-title">
            {plan.title}
          </h3>

          <!-- 3. Monthly price & 4. Fixed-scope alternative -->
          <div class="pricing-price-block">
            <div class="pricing-monthly-row">
              <span class="pricing-amount">{plan.monthlyPrice}</span>
              <span class="pricing-interval">/ month</span>
            </div>
            <div class="pricing-fixed-scope">
              or {plan.projectPrice} fixed scope
            </div>
          </div>

          <!-- 5. Thin divider -->
          <hr class="pricing-divider" />

          <!-- 6. Short description -->
          <p class="pricing-description">
            {plan.description}
          </p>

          <!-- 7. Feature list -->
          <ul class="pricing-features">
            {plan.deliverables.map((item) => (
              <li class="pricing-feature-item">
                <span class="pricing-check-icon-wrap" aria-hidden="true">
                  <Check size={13} strokeWidth={2.2} />
                </span>
                <span class="pricing-feature-text">{item}</span>
              </li>
            ))}
          </ul>

          <!-- 8. Booking button anchored at the bottom -->
          <div class="pricing-action-wrap">
            <a 
              href={`mailto:hi@loc.digital?subject=Inquiry:%20${encodeURIComponent(plan.title)}`}
              class={`pricing-btn ${plan.popular ? "pricing-btn--primary" : "pricing-btn--secondary"}`}
            >
              <span>Book retainer</span>
              <ArrowUpRight size={13} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Creative Collaboration Tools -->
  <section class="page-section" aria-labelledby="heading-partners">
    <h2 id="heading-partners" class="section-title">Creative tooling collaboration</h2>
    <p style="font-size: 0.875rem; color: var(--dash-muted); margin: 0 0 16px;">
      Brand, web, AI creative, motion, and interface systems built with a modern toolkit across strategy, production, and launch.
    </p>

    <div class="partners-marquee-container" aria-label="Creative tooling collaboration logos">
      <div class="partners-marquee-track">
        {[0, 1].map((groupIndex) => (
          <div class="partners-marquee-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
            {collaborationLogos.map((p) => (
              <div class="dash-card partner-card">
                {p.logo ? (
                  <img
                    src={p.logo}
                    alt={groupIndex === 0 ? p.name : ""}
                    class="partner-logo"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="partner-wordmark" aria-hidden="true">
                    {p.initials}
                  </span>
                )}
                <div class="partner-meta">
                  <div class="partner-name">
                    {p.name}
                  </div>
                  <div class="partner-role">
                    {p.role}
                  </div>
                </div>
              </div>
            ))}
            </div>
        ))}
      </div>
    </div>
  </section>
</DashboardLayout>

<style>
  /* ============================================================
     MODULAR CAPABILITIES SECTION (Grid on Desktop, Swipe on Mobile)
     ============================================================ */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .service-capability-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: var(--card-outer-radius);
    border-color: color-mix(in srgb, var(--service-border) 72%, var(--dash-border));
    padding: var(--card-padding);
  }

  .service-capability-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--service-color);
  }

  .service-capability-card:hover {
    border-color: var(--service-border);
  }

  .service-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .service-category-pill {
    background: var(--service-soft);
    border-color: var(--service-border);
    color: var(--service-ink);
  }

  .service-card-id {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--service-color);
    font-variant-numeric: tabular-nums;
  }

  .service-scope-block {
    margin-bottom: 14px;
    padding: 10px 12px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--service-soft) 68%, #ffffff), #ffffff);
    border-color: color-mix(in srgb, var(--service-border) 72%, var(--dash-border));
    border-radius: max(0px, calc(var(--card-outer-radius) - var(--card-padding)));
  }

  .service-capability-card .dash-bullet {
    background-color: var(--service-color);
  }

  .service-tech-tag {
    background: color-mix(in srgb, var(--service-soft) 58%, #ffffff);
    border-color: color-mix(in srgb, var(--service-border) 70%, var(--dash-border));
    color: color-mix(in srgb, var(--service-ink) 78%, var(--dash-muted));
  }

  @media (max-width: 768px) {
    .services-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 8px;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      margin-inline: -8px;
      padding-inline: 8px;
      padding-top: 4px;
      padding-bottom: 14px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .services-grid::-webkit-scrollbar {
      display: none;
    }

    .service-capability-card {
      flex: 0 0 min(390px, calc(100vw - 16px));
      width: min(390px, calc(100vw - 16px));
      scroll-snap-align: start;
    }
  }

  @media (max-width: 359px) {
    .services-grid {
      margin-inline: -8px;
      padding-inline: 8px;
      scroll-padding-inline: 8px;
    }

    .service-capability-card {
      flex: 0 0 calc(100vw - 16px);
      width: calc(100vw - 16px);
    }
  }

  /* ============================================================
     NOTION-INSPIRED PRICING SECTION
     ============================================================ */
  
  .pricing-section-title {
    font-size: 1.875rem; /* 30px */
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--dash-text);
    margin: 0 0 8px;
    text-align: left;
  }

  @media (max-width: 640px) {
    .pricing-section-title {
      font-size: 1.625rem; /* 26px */
    }
  }

  .pricing-section-desc {
    font-size: 0.9375rem; /* 15px */
    line-height: 1.6;
    color: var(--dash-muted);
    margin: 0 0 28px;
    max-width: 64ch;
    text-align: left;
  }

  /* Grid Layout: Desktop shared-row alignment */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto auto 1fr auto;
    column-gap: 20px;
    row-gap: 0;
    align-items: stretch;
  }

  /* Pricing Card */
  .pricing-card {
    grid-row: 1 / 8;
    display: grid;
    grid-template-rows: subgrid;
    background: var(--dash-surface);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    border-radius: 8px;
    padding: 24px;
    box-sizing: border-box;
    box-shadow: none;
    transition: border-color var(--duration-fast, 250ms) var(--ease-smooth-out),
                box-shadow var(--duration-fast, 250ms) var(--ease-smooth-out),
                transform var(--duration-fast, 250ms) var(--ease-smooth-out);
  }

  .pricing-card:hover {
    border-color: var(--dash-border-strong);
    transform: none;
    box-shadow: none;
  }

  .pricing-card:nth-child(1) {
    grid-column: 1;
  }

  .pricing-card:nth-child(2) {
    grid-column: 2;
  }

  .pricing-card:nth-child(3) {
    grid-column: 3;
  }

  /* Recommended Plan subtle emphasis */
  .pricing-card--recommended {
    border-color: var(--dash-border-strong);
  }

  /* Row 1: Header / Category & Badge */
  .pricing-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 24px;
    margin: 0 0 12px;
  }

  .pricing-category {
    font-size: 0.75rem; /* 12px */
    font-weight: 500;
    color: var(--dash-muted);
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .pricing-recommended-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem; /* 11px */
    font-weight: 500;
    color: var(--dash-text);
    background: var(--dash-surface-subtle);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    border-radius: 4px;
    padding: 1px 7px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* Row 2: Plan Title */
  .pricing-plan-title {
    font-size: 1.25rem; /* 20px */
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--dash-text);
    margin: 0 0 14px;
  }

  /* Row 3: Price Block */
  .pricing-price-block {
    margin: 0 0 16px;
  }

  .pricing-monthly-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .pricing-amount {
    font-size: 1.875rem; /* 30px */
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--dash-text);
    font-variant-numeric: tabular-nums;
  }

  .pricing-interval {
    font-size: 0.8125rem; /* 13px */
    color: var(--dash-muted);
    font-weight: 400;
  }

  .pricing-fixed-scope {
    font-size: 0.8125rem; /* 13px */
    line-height: 1.4;
    color: var(--dash-muted);
    margin-top: 4px;
  }

  /* Row 4: Thin Divider */
  .pricing-divider {
    border: none;
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    margin: 0 0 16px;
    width: 100%;
  }

  /* Row 5: Description */
  .pricing-description {
    font-size: 0.875rem; /* 14px */
    line-height: 1.55;
    color: var(--dash-muted);
    margin: 0 0 18px;
  }

  /* Row 6: Feature List */
  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .pricing-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .pricing-check-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 21px; /* Center-aligned with 14px/1.5 first line of text */
    flex-shrink: 0;
    color: var(--dash-muted);
  }

  .pricing-feature-text {
    font-size: 0.875rem; /* 14px */
    line-height: 1.5;
    color: var(--dash-text);
    flex: 1;
    min-width: 0;
  }

  /* Row 7: Action Button */
  .pricing-action-wrap {
    display: flex;
    align-items: flex-end;
    width: 100%;
  }

  .pricing-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 42px;
