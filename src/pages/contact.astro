---
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Contact & Collaboration — Phuc Loc Nguyen"
  pageTitle="Contact"
  description="Connect with Nguyen Phuc Loc for performance marketing retainers, TikTok Shop acceleration, and digital growth consulting."
  breadcrumbs={[{ label: "Contact" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Contact & Inquiries</h1>
    <p class="page-lead">
      I respond personally to inquiries regarding performance marketing retainers, TikTok Shop acceleration, and digital growth strategy.
    </p>
  </header>

  <!-- Direct Contact Channels -->
  <section class="page-section" aria-labelledby="heading-channels">
    <h2 id="heading-channels" class="section-title">Direct channels</h2>

    <div style="display: flex; flex-direction: column; gap: var(--docs-space-grid-gap, 16px);">
      <!-- Primary Email -->
      <div class="dash-card" style="padding: var(--docs-space-card-padding, 20px);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
          <span style="font-size: var(--text-micro); color: var(--dash-muted); text-transform: uppercase; font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-caps);">Primary Email</span>
          <button 
            id="contact-copy-email-btn" 
            class="dash-button dash-button--secondary"
            style="min-height: 28px; padding: 2px 10px; font-size: var(--text-body-sm);"
            aria-label="Copy email address"
          >
            Copy address
          </button>
        </div>
        <a 
          href="mailto:hi@loc.digital" 
          class="dash-link"
          style="font-size: var(--text-h4); line-height: var(--leading-snug); font-weight: var(--font-weight-medium);"
        >
          hi@loc.digital
        </a>
        <div id="contact-copy-feedback" aria-live="polite" style="position: absolute; left: -9999px;"></div>
        <p style="font-size: var(--text-body-sm); line-height: var(--leading-body); color: var(--dash-muted); margin: 6px 0 0;">
          Best channel for project briefs, RFPs, advisory scopes, and hiring discussions.
        </p>
      </div>


      <!-- Phone & Zalo -->
      <div class="dash-card" style="padding: var(--docs-space-card-padding, 20px);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
          <span style="font-size: var(--text-micro); color: var(--dash-muted); text-transform: uppercase; font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-caps);">Direct Phone & Zalo</span>
          <a 
            href="https://zalo.me/0888886038"
            target="_blank"
            rel="noopener noreferrer"
            class="dash-button dash-button--secondary"
            style="min-height: 28px; padding: 2px 10px; font-size: var(--text-body-sm); text-decoration: none;"
            aria-label="Open Zalo chat"
          >
            Chat Zalo ↗
          </a>
        </div>
        <a 
          href="https://zalo.me/0888886038" 
          target="_blank"
          rel="noopener noreferrer"
          class="dash-link"
          style="font-size: var(--text-h4); line-height: var(--leading-snug); font-weight: var(--font-weight-medium);"
        >
          +84 888 886 038
        </a>
        <p style="font-size: var(--text-body-sm); line-height: var(--leading-body); color: var(--dash-muted); margin: 6px 0 0;">
          Available during business hours (09:00 — 18:00 GMT+7) via Phone or Zalo.
        </p>
      </div>

      <!-- Location & Working Arrangement -->
      <div class="contact-meta-grid">
        <div class="dash-card" style="padding: var(--docs-space-card-padding, 20px);">
          <span style="font-size: var(--text-micro); color: var(--dash-muted); text-transform: uppercase; font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-caps); display: block; margin-bottom: 4px;">Location</span>
          <div style="font-size: var(--text-body); line-height: var(--leading-compact); font-weight: var(--font-weight-medium); color: var(--dash-text);">Saigon, Vietnam 🇻🇳</div>
          <div style="font-size: var(--text-caption); line-height: var(--leading-compact); color: var(--dash-muted); margin-top: 2px;">UTC / GMT +7</div>
        </div>

        <div class="dash-card" style="padding: var(--docs-space-card-padding, 20px);">
          <span style="font-size: var(--text-micro); color: var(--dash-muted); text-transform: uppercase; font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-caps); display: block; margin-bottom: 4px;">Work Arrangement</span>
          <div style="font-size: var(--text-body); line-height: var(--leading-compact); font-weight: var(--font-weight-medium); color: var(--dash-text);">Remote Worldwide</div>
          <div style="font-size: var(--text-caption); line-height: var(--leading-compact); color: var(--dash-muted); margin-top: 2px;">or Hybrid in TP.HCM</div>
        </div>
      </div>
    </div>
  </section>

</DashboardLayout>

<style>
  .contact-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--docs-space-grid-gap, 16px);
  }

  @media (max-width: 520px) {
    .contact-meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const btn = document.getElementById("contact-copy-email-btn");
    const feedback = document.getElementById("contact-copy-feedback");
    if (!btn) return;
    let resetTimer = 0;

    btn.addEventListener("click", async () => {
      const email = "hi@loc.digital";
      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(email);
        }
        if (signal.aborted) return;
        btn.textContent = "Copied!";
        if (feedback) feedback.textContent = "Email address copied to clipboard";
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          btn.textContent = "Copy address";
          if (feedback) feedback.textContent = "";
        }, 2000);
      } catch (err) {
        console.error("Copy failed", err);
      }
    }, { signal });
    signal.addEventListener("abort", () => window.clearTimeout(resetTimer), { once: true });
  });
</script>
