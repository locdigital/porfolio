---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";
import { ArrowUpRight, BriefcaseBusiness, Camera, Image, Mail, Zap } from "lucide-react";

const socialTitle = "Social | Phuc Loc Nguyen";
const socialDescription =
  "Find Phuc Loc Nguyen across Instagram, LinkedIn, X, Pexels, and email.";

const socialLinks: Array<{
  name: string;
  handle: string;
  href: string;
  note: string;
  accent: string;
  Icon: typeof Camera;
}> = [
  {
    name: "Instagram",
    handle: "@henrygoodkid",
    href: "https://www.instagram.com/henrygoodkid",
    note: "Photos, travel frames, and small visual experiments.",
    accent: "#e34f76",
    Icon: Camera,
  },
  {
    name: "LinkedIn",
    handle: "/in/phucloc",
    href: "https://www.linkedin.com/in/phucloc",
    note: "Work updates, performance marketing notes, and projects.",
    accent: "#0075de",
    Icon: BriefcaseBusiness,
  },
  {
    name: "X",
    handle: "@vuaecom",
    href: "https://x.com/vuaecom",
    note: "Fast thoughts on e-commerce, growth, AI, and the web.",
    accent: "#1c1c1c",
    Icon: Zap,
  },
  {
    name: "Pexels",
    handle: "@henrygoodkid",
    href: "https://www.pexels.com/@henrygoodkid",
    note: "Public photo library from trips and everyday scenes.",
    accent: "#00a878",
    Icon: Image,
  },
  {
    name: "Email",
    handle: "hi@loc.digital",
    href: "mailto:hi@loc.digital",
    note: "Best place for collaborations, projects, and direct notes.",
    accent: "#8c5a13",
    Icon: Mail,
  },
];
---

<Layout
  title={socialTitle}
  description={socialDescription}
  schema={pageSchema({
    url: absoluteUrl("/social"),
    title: socialTitle,
    description: socialDescription,
    type: "ProfilePage",
  })}
>
  <main class="social-page">
    <section class="social-shell" aria-labelledby="social-title">
      <div class="social-intro animated-card" data-card-type="title">
        <p class="social-kicker">Social desk</p>
        <h1 id="social-title">Find me where the work keeps moving.</h1>
        <p>
          A simple directory for the places I post work, notes, photography, and the occasional unfinished thought.
        </p>
      </div>

      <div class="social-links" aria-label="Social profiles">
        {socialLinks.map((link, index) => {
          const Icon = link.Icon;
          return (
            <a
              class="social-link animated-card"
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
              style={`--social-accent: ${link.accent};`}
              data-card-type={index === 0 ? "featured" : "link"}
            >
              <span class="social-link-icon" aria-hidden="true">
                <Icon size={20} strokeWidth={1.8} aria-hidden="true" />
              </span>
              <span class="social-link-copy">
                <span class="social-link-name">{link.name}</span>
                <span class="social-link-note">{link.note}</span>
              </span>
              <span class="social-link-meta">
                <span>{link.handle}</span>
                <ArrowUpRight className="social-link-arrow" size={18} strokeWidth={1.8} aria-hidden="true" />
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  .social-page {
    min-height: 100dvh;
    padding: calc(var(--hdr-h) + clamp(44px, 7vw, 92px)) 0 clamp(72px, 10vw, 128px);
    background:
      radial-gradient(circle at 12% 12%, rgba(0, 117, 222, 0.08), transparent 28rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(250, 250, 247, 0));
  }

  .social-shell {
    width: min(calc(100% - (var(--page-gutter) * 2)), 980px);
    margin: 0 auto;
  }

  .social-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.58fr);
    gap: clamp(22px, 5vw, 72px);
    align-items: end;
    padding-bottom: clamp(34px, 6vw, 66px);
    border-bottom: 1px solid var(--divider);
  }

  .social-kicker {
    grid-column: 1 / -1;
    max-width: none;
    font-family: var(--mono);
    font-size: var(--type-caption);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .social-intro h1 {
    max-width: 720px;
    font-size: var(--type-display-lg);
    font-weight: 400;
    line-height: 0.98;
    color: var(--text);
  }

  .social-intro p:not(.social-kicker) {
    max-width: 42ch;
    justify-self: end;
    font-family: var(--sans);
    font-size: var(--type-body);
    line-height: 1.72;
    color: var(--muted);
  }

  .social-links {
    display: grid;
    gap: 10px;
    margin-top: clamp(22px, 4vw, 44px);
  }

  .social-link {
    --social-accent: var(--accent);
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    gap: clamp(14px, 3vw, 24px);
    align-items: center;
    min-height: 84px;
    border: 1px solid rgba(232, 232, 226, 0.94);
    border-radius: var(--rounded-md);
    padding: clamp(14px, 2.8vw, 22px);
    background: rgba(255, 255, 255, 0.58);
    transition:
      border-color 180ms var(--ease-out),
      background 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  .social-link:hover {
    border-color: color-mix(in srgb, var(--social-accent) 42%, var(--divider));
    background: color-mix(in srgb, var(--social-accent) 8%, #ffffff);
    transform: translateY(-2px);
  }

  .social-link-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: var(--rounded-sm);
    color: var(--social-accent);
    background: color-mix(in srgb, var(--social-accent) 10%, #ffffff);
  }

  .social-link-icon svg {
    width: 20px;
    height: 20px;
  }

  .social-link-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .social-link-name {
    font-family: var(--serif);
    font-size: clamp(1.55rem, 1.18rem + 1.45vw, 2.35rem);
    line-height: 0.98;
    color: var(--text);
  }

  .social-link-note {
    max-width: 52ch;
    font-family: var(--sans);
    font-size: var(--type-body);
    line-height: 1.55;
    color: #5c5c5c;
  }

  .social-link-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: end;
    min-width: 0;
    font-family: var(--mono);
    font-size: var(--type-caption);
    line-height: 1.35;
    color: var(--muted);
    white-space: nowrap;
  }

  .social-link-arrow {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .social-link:hover .social-link-arrow {
    color: var(--social-accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 760px) {
    .social-intro {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .social-intro p:not(.social-kicker) {
      justify-self: start;
    }

    .social-link {
      grid-template-columns: 38px minmax(0, 1fr);
      min-height: 96px;
    }

    .social-link-icon {
      width: 38px;
      height: 38px;
    }

    .social-link-meta {
      grid-column: 2;
      justify-self: start;
      white-space: normal;
    }
  }

  @media (max-width: 420px) {
    .social-link {
      grid-template-columns: 1fr;
    }

    .social-link-meta {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link,
    .social-link-arrow {
      transition: none;
    }

    .social-link:hover {
      transform: none;
    }
  }
</style>
