---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";

export const prerender = true;

const socialTitle = "Social | Phuc Loc Nguyen";
const socialDescription = "Find Phuc Loc Nguyen on LinkedIn, email, writing, work, photos, and the main channels for collaboration.";

const primaryLinks = [
  {
    label: "Email",
    handle: "hi@loc.digital",
    description: "Best for work, collaborations, consulting, and anything that needs context.",
    href: "mailto:hi@loc.digital",
    meta: "Fastest reply",
  },
  {
    label: "LinkedIn",
    handle: "/in/phucloc",
    description: "Career updates, marketing notes, growth work, and professional conversations.",
    href: "https://www.linkedin.com/in/phucloc",
    meta: "Professional",
  },
];

const siteLinks = [
  {
    label: "Instagram",
    description: "Everyday photos, travel frames, and lighter personal updates.",
    href: "https://www.instagram.com/henrygoodkid",
  },
  {
    label: "X",
    description: "Short thoughts on ecommerce, growth, tools, and experiments.",
    href: "https://x.com/vuaecom",
  },
  {
    label: "Pexels",
    description: "A small public photo archive for free visual references.",
    href: "https://www.pexels.com/@henrygoodkid",
  },
  {
    label: "Work",
    description: "Selected growth, SEO, paid media, commerce, and funnel projects.",
    href: "/work",
  },
  {
    label: "Writing",
    description: "Notes on marketing systems, growth decisions, and digital execution.",
    href: "/blog",
  },
  {
    label: "Photos",
    description: "Travel, street, and landscape frames from places I have passed through.",
    href: "/photos",
  },
  {
    label: "Ask me",
    description: "Send a quick question if email feels too formal.",
    href: "/question",
  },
];
---

<Layout
  title={socialTitle}
  description={socialDescription}
  schema={pageSchema({
    url: absoluteUrl("/social"),
    title: socialTitle,
    description: socialDescription,
    type: "ContactPage",
  })}
>
  <main class="gear-page social-page">
    <div class="gear-container social-container">
      <section class="gear-hero social-hero" aria-label="Social links introduction">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">Social</span>
        </div>
        <h1 class="gear-hero-title">Let’s keep the conversation <em>useful.</em></h1>
        <p class="gear-intro social-intro">
          The shortest route to me is email. For public updates, work history, and marketing notes, LinkedIn is the cleanest place to connect.
        </p>
      </section>

      <section class="social-primary" aria-label="Primary contact links">
        {primaryLinks.map((link) => (
          <a class="social-card social-card--primary" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
            <span class="social-card-meta">{link.meta}</span>
            <div class="social-card-main">
              <h2>{link.label}</h2>
              <span aria-hidden="true">↗</span>
            </div>
            <p class="social-handle">{link.handle}</p>
            <p>{link.description}</p>
          </a>
        ))}
      </section>

      <section class="social-section" aria-label="More places to browse">
        <div class="gear-section-head social-section-head">
          <div>
            <h2>More places</h2>
            <p>Browse the site by what you need: proof, ideas, visual references, or a lightweight question.</p>
          </div>
          <span>{String(siteLinks.length).padStart(2, "0")}</span>
        </div>

        <div class="social-link-list">
          {siteLinks.map((link) => (
            <a class="social-row" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
              <div>
                <h3>{link.label}</h3>
                <p>{link.description}</p>
              </div>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .social-page {
    background:
      radial-gradient(circle at 78% 12%, rgba(0, 117, 222, 0.08), transparent 28rem),
      var(--bg);
  }

  .social-container {
    max-width: 980px;
  }

  .social-hero {
    margin-bottom: 34px;
  }

  .social-hero em {
    font-style: italic;
    color: var(--accent);
  }

  .social-intro {
    font-family: var(--sans);
    font-size: var(--type-body);
  }

  .social-primary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 72px;
  }

  .social-card {
    color: var(--text);
    text-decoration: none;
  }

  .social-card--primary {
    display: flex;
    min-height: 280px;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--divider);
    border-radius: var(--rounded-sm);
    padding: 24px;
    background: rgba(255, 255, 255, 0.42);
    transition:
      border-color 180ms var(--ease-out),
      background 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  .social-card--primary:hover,
  .social-card--primary:focus-visible {
    border-color: var(--accent-border);
    background: rgba(255, 255, 255, 0.68);
    transform: translateY(-2px);
  }

  .social-card-meta {
    width: fit-content;
    border: 1px solid rgba(0, 117, 222, 0.18);
    border-radius: var(--rounded-full);
    padding: 6px 10px;
    color: var(--accent);
    background: var(--accent-soft);
    font-family: var(--mono);
    font-size: var(--type-micro) !important;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .social-card-main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-top: 46px;
  }

  .social-card-main h2 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.03em;
  }

  .social-card-main span {
    color: var(--accent);
    font-family: var(--sans);
    font-size: 28px !important;
    line-height: 1;
    transition: transform 180ms var(--ease-out);
  }

  .social-card--primary:hover .social-card-main span,
  .social-card--primary:focus-visible .social-card-main span {
    transform: translate(2px, -2px);
  }

  .social-handle {
    margin: 18px 0 10px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: var(--type-caption);
    letter-spacing: 0.02em;
  }

  .social-card--primary p:not(.social-handle) {
    max-width: 34rem;
    color: #6e6e6e;
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .social-section {
    scroll-margin-top: calc(var(--hdr-h) + 24px);
  }

  .social-section-head {
    margin-bottom: 16px;
  }

  .social-link-list {
    display: grid;
    border-top: 1px solid var(--divider);
  }

  .social-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--divider);
    padding: 22px 0;
    color: var(--text);
    text-decoration: none;
    transition: color 180ms var(--ease-out), padding 180ms var(--ease-out);
  }

  .social-row:hover,
  .social-row:focus-visible {
    color: var(--accent);
    padding-inline: 8px;
  }

  .social-row h3 {
    margin-bottom: 5px;
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1;
  }

  .social-row p {
    color: #6e6e6e;
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .social-row > span {
    color: currentColor;
    font-family: var(--sans);
    font-size: 22px !important;
  }

  @media (max-width: 720px) {
    .social-primary {
      grid-template-columns: 1fr;
      margin-bottom: 56px;
    }

    .social-card--primary {
      min-height: 230px;
      padding: 20px;
    }

    .social-card-main {
      margin-top: 34px;
    }

    .social-row {
      align-items: flex-start;
      padding: 20px 0;
    }

    .social-row h3 {
      font-size: 1.75rem;
    }
  }
</style>
