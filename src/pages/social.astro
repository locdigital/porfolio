---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";
import { Folder, BookOpen, Camera, ArrowUpRight, ArrowRight } from "lucide-react";

export const prerender = true;

const socialTitle = "Social & Contact | Phuc Loc Nguyen";
const socialDescription = "Connect with Phuc Loc Nguyen via email, phone, LinkedIn, Instagram, X, Pexels, or explore selected work and writing.";

const directContacts = [
  {
    label: "Email",
    value: "hi@loc.digital",
    subtext: "Project inquiries & growth consulting",
    href: "mailto:hi@loc.digital",
    badge: "Direct Email",
    isEmail: true,
    iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
  {
    label: "Phone & Hotline",
    value: "+84 777 779 459",
    secondaryValue: "+84 888 886 038",
    subtext: "Phone, WhatsApp & Zalo ready",
    href: "tel:+84777779459",
    secondaryHref: "tel:+84888886038",
    badge: "Direct Call",
    isPhone: true,
    iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/phucloc",
    subtext: "Professional network & career updates",
    href: "https://www.linkedin.com/in/phucloc",
    badge: "Network",
    isExternal: true,
    iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
];

const publicChannels = [
  {
    label: "Instagram",
    handle: "@henrygoodkid",
    desc: "Everyday photography & travel frames",
    href: "https://www.instagram.com/henrygoodkid",
    category: "Photos",
    iconSvg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
  {
    label: "X / Twitter",
    handle: "@vuaecom",
    desc: "E-commerce CRO, growth & AI workflows",
    href: "https://x.com/vuaecom",
    category: "Notes",
    iconSvg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`,
  },
  {
    label: "Pexels",
    handle: "@henrygoodkid",
    desc: "Free high-res photography archive",
    href: "https://www.pexels.com/@henrygoodkid",
    category: "Archive",
    iconSvg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`,
  },
];

const sitePages = [
  {
    label: "Selected Work",
    handle: "/work",
    desc: "Performance marketing & tech case studies",
    href: "/work",
    category: "Work",
    Icon: Folder,
  },
  {
    label: "Writing & Notes",
    handle: "/blog",
    desc: "Performance frameworks & marketing guides",
    href: "/blog",
    category: "Blog",
    Icon: BookOpen,
  },
  {
    label: "Photo Gallery",
    handle: "/photos",
    desc: "Landscape & street photography collection",
    href: "/photos",
    category: "Visuals",
    Icon: Camera,
  },
];
---

<Layout
  title={socialTitle}
  description={socialDescription}
  schema={pageSchema({
    url: absoluteUrl("/social"),
    title: socialTitle,
    description: socialDescription,
    type: "ContactPage",
  })}
>
  <main class="gear-page social-page">
    <div class="gear-container social-container">
      
      <!-- COMPACT HERO HEADER -->
      <section class="social-hero" aria-label="Social links introduction">
        <div class="status-pill-wrapper">
          <span class="status-dot"></span>
          <span class="status-text">Available for consulting & growth projects</span>
        </div>

        <h1 class="social-hero-title">
          Let’s connect & <em>collaborate.</em>
        </h1>
        <p class="social-intro">
          Direct channels for inquiries, performance marketing partnerships, and public social feeds.
        </p>
      </section>

      <!-- STREAMLINED DIRECT CONTACT (3 Compact Cards) -->
      <section class="social-direct-section" aria-label="Direct contact channels">
        <div class="social-direct-grid">
          {directContacts.map((c) => (
            <div class="contact-card">
              <div class="contact-card-top">
                <div class="contact-badge">
                  <Fragment set:html={c.iconSvg} />
                  <span>{c.badge}</span>
                </div>
                {c.isPhone ? (
                  <a href={c.href} class="contact-arrow-btn" aria-label={`Call ${c.value}`}>
                    <ArrowUpRight size={16} strokeWidth={2} />
                  </a>
                ) : (
                  <a
                    href={c.href}
                    target={c.href.startsWith("http") ? "_blank" : undefined}
                    rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="contact-arrow-btn"
                    aria-label={`Open ${c.label}`}
                  >
                    <ArrowUpRight size={16} strokeWidth={2} />
                  </a>
                )}
              </div>

              <div class="contact-card-body">
                <h2 class="contact-label">{c.label}</h2>
                
                {c.isPhone ? (
                  <div class="contact-phone-links">
                    <a href={c.href} class="contact-val-link">{c.value}</a>
                    <span class="contact-phone-sep">·</span>
                    <a href={c.secondaryHref} class="contact-val-link">{c.secondaryValue}</a>
                  </div>
                ) : (
                  <a
                    href={c.href}
                    target={c.href.startsWith("http") ? "_blank" : undefined}
                    rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="contact-val-link"
                  >
                    {c.value}
                  </a>
                )}
                
                <p class="contact-sub">{c.subtext}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- STREAMLINED 2-COLUMN SECTION: PUBLIC FEEDS & SITE DESTINATIONS -->
      <section class="social-grouped-section" aria-label="Links and destinations">
        <div class="grouped-grid">
          
          <!-- Column 1: Public Channels -->
          <div class="grouped-col">
            <div class="grouped-head">
              <span class="grouped-eyebrow">CHANNELS & FEEDS</span>
              <span class="grouped-count">{String(publicChannels.length).padStart(2, "0")}</span>
            </div>

            <div class="grouped-list">
              {publicChannels.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="stream-tile"
                >
                  <div class="stream-tile-left">
                    <div class="stream-icon-box">
                      <Fragment set:html={item.iconSvg} />
                    </div>
                    <div class="stream-text">
                      <div class="stream-title-row">
                        <span class="stream-title">{item.label}</span>
                        <span class="stream-tag">{item.category}</span>
                      </div>
                      <span class="stream-handle">{item.handle}</span>
                    </div>
                  </div>

                  <div class="stream-arrow">
                    <ArrowUpRight size={15} strokeWidth={2} />
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Column 2: Portfolio Links -->
          <div class="grouped-col">
            <div class="grouped-head">
              <span class="grouped-eyebrow">EXPLORE SITE</span>
              <span class="grouped-count">{String(sitePages.length).padStart(2, "0")}</span>
            </div>

            <div class="grouped-list">
              {sitePages.map((item) => (
                <a href={item.href} class="stream-tile">
                  <div class="stream-tile-left">
                    <div class="stream-icon-box">
                      <item.Icon size={16} strokeWidth={1.8} />
                    </div>
                    <div class="stream-text">
                      <div class="stream-title-row">
                        <span class="stream-title">{item.label}</span>
                        <span class="stream-tag">{item.category}</span>
                      </div>
                      <span class="stream-handle">{item.handle}</span>
                    </div>
                  </div>

                  <div class="stream-arrow">
                    <ArrowRight size={15} strokeWidth={2} />
                  </div>
                </a>
              ))}
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .social-page {
    min-height: 80vh;
  }

  .social-container {
    padding-top: var(--space-6);
    padding-bottom: var(--space-10);
    max-width: 980px;
    margin: 0 auto;
  }

  /* ── COMPACT HERO ── */
  .social-hero {
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .status-pill-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--bg) 92%, #ffffff);
    border: 1px solid var(--divider);
    margin-bottom: 16px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .status-text {
    font-family: var(--mono);
    font-size: 11px !important;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .social-hero-title {
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 56px) !important;
    font-weight: 400 !important;
    line-height: 1.08 !important;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    text-wrap: balance;
  }

  .social-hero-title em {
    font-style: italic;
    color: var(--accent);
  }

  .social-intro {
    font-family: var(--sans);
    font-size: 14px !important;
    line-height: 1.6;
    color: var(--muted);
    max-width: 520px;
    margin: 0;
  }

  /* ── DIRECT CONTACT 3-CARD GRID ── */
  .social-direct-section {
    margin-bottom: clamp(36px, 5vw, 52px);
  }

  .social-direct-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: color-mix(in srgb, var(--bg) 95%, #ffffff);
    border: 1px solid var(--divider);
    border-radius: 8px;
    padding: 18px 18px;
    transition: transform 0.22s var(--spring), border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--divider));
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.06);
  }

  .contact-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .contact-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 10%, #ffffff);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 11px !important;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact-arrow-btn {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 85%, #ffffff);
    border: 1px solid var(--divider);
    color: var(--muted);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .contact-card:hover .contact-arrow-btn {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    transform: translate(1px, -1px);
  }

  .contact-card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-label {
    font-family: var(--serif);
    font-size: 22px !important;
    font-weight: 400 !important;
    line-height: 1.2 !important;
    color: var(--text);
    margin: 0;
  }

  .contact-val-link {
    font-family: var(--mono);
    font-size: 13px !important;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .contact-val-link:hover {
    text-decoration: underline;
    opacity: 0.85;
  }

  .contact-phone-links {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .contact-phone-sep {
    color: var(--muted);
    font-size: 12px;
  }

  .contact-sub {
    font-family: var(--sans);
    font-size: 12px !important;
    line-height: 1.45;
    color: var(--muted);
    margin: 2px 0 0;
  }

  /* ── GROUPED 2-COLUMN SECTION ── */
  .social-grouped-section {
    margin-bottom: var(--space-8);
  }

  .grouped-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .grouped-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--divider);
  }

  .grouped-eyebrow {
    font-family: var(--mono);
    font-size: 11px !important;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .grouped-count {
    font-family: var(--mono);
    font-size: 12px !important;
    color: var(--muted);
  }

  .grouped-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ── STREAMLINED TILES ── */
  .stream-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg) 95%, #ffffff);
    border: 1px solid var(--divider);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s var(--spring), border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .stream-tile:hover {
    transform: translateX(3px);
    background: #FFFFFF;
    border-color: color-mix(in srgb, var(--accent) 45%, var(--divider));
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.04);
  }

  .stream-tile-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .stream-icon-box {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    flex-shrink: 0;
  }

  .stream-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stream-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stream-title {
    font-family: var(--sans);
    font-size: 14px !important;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .stream-tag {
    font-family: var(--mono);
    font-size: 10px !important;
    padding: 1px 6px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--text) 6%, transparent);
    color: var(--muted);
  }

  .stream-handle {
    font-family: var(--mono);
    font-size: 12px !important;
    color: var(--muted);
    line-height: 1.2;
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stream-arrow {
    display: grid;
    place-items: center;
    color: var(--muted);
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
    margin-left: 8px;
  }

  .stream-tile:hover .stream-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .social-direct-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .grouped-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .social-hero-title {
      font-size: 34px !important;
    }

    .contact-card {
      padding: 14px 16px;
    }

    .stream-tile {
      padding: 10px 12px;
    }
  }
</style>
