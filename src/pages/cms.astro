---
import Layout from "../layouts/Layout.astro";
import { CMSDashboard } from "../components/cms/CMSDashboard";

const isDev = import.meta.env.DEV;
---

<Layout title="CMS Dashboard | Portfolio Manager" hideHeader={true} hideFooter={true}>
  <div class="cms-wrapper">
    <CMSDashboard client:only="react" isDev={isDev} />
  </div>
</Layout>

<style is:global>
  /* Reset page padding that Layout.astro might add */
  body {
    background-color: #f9fafb !important;
    color: #111827 !important;
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    overflow: hidden !important;
  }
  
  .cms-wrapper {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    position: relative;
    background-color: #f9fafb;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  /* Custom scrollbar styling for CMS tables and content */
  .cms-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  
  .cms-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .cms-scrollbar::-webkit-scrollbar-thumb {
    background: #e5e7eb;
    border-radius: 3px;
  }
  
  .cms-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #d1d5db;
  }
</style>
