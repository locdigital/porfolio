---
import Layout from "../layouts/Layout.astro";
import { HeroCollage } from "../components/ui/modern-hero-section";
import { optimizePhotos } from "../lib/photo-assets";

const stats = [
  { value: '10+', label: 'Tools Integrated' },
  { value: '4+', label: 'Years Experience' },
  { value: '100+', label: 'Campaigns Delivered' },
];

const images = (
  await optimizePhotos(
    [1, 2, 3, 4, 5, 6, 7].map((number) => ({
      src: `/assets/photos/img-portfolio/photo-${number}.webp`,
      alt: `Workflow collage photo ${number}`,
      w: 0,
      h: 0,
    })),
    {
      previewWidth: 520,
      previewWidths: [320, 480, 640, 960],
      previewSizes: "(max-width: 768px) 70vw, 320px",
      fullQuality: 84,
    },
  )
).map((photo) => photo.previewSrc);
---

<Layout title="Workflow Space — Phuc Loc Nguyen">
  <main class="min-h-screen pt-12">
    <HeroCollage
      client:load
      title="My Workflow Space"
      subtitle="A glimpse into the digital tools, setups, and workflows I use daily to build, optimize, and scale data-driven marketing systems."
      stats={stats}
      images={images}
    />
  </main>
</Layout>
