---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    id: "workflow-space",
    title: "WorkFlow Space — Community & Brand Growth",
    description:
      "Led digital strategy for a co-working brand — content, paid ads, and community campaigns that grew monthly engagement by 3×.",
    href: "https://www.workflowspace.vn/",
    image:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
  {
    id: "playah",
    title: "PlayAh! — Performance Marketing",
    description:
      "Drove full-funnel Meta & TikTok campaigns for a lifestyle brand, optimizing ROAS and scaling profitable customer acquisition.",
    href: "https://playahvietnam.com/",
    image:
      "https://images.unsplash.com/photo-1540575467063-178a50c2df87?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
  {
    id: "pops",
    title: "POPS Worldwide — SEO & Organic Growth",
    description:
      "Owned search strategy for Vietnam's largest entertainment platform, compounding organic traffic through content and technical SEO.",
    href: "https://pops.vn/",
    image:
      "https://images.unsplash.com/photo-1598899134739-24c46f58b8c0?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
  {
    id: "pnj",
    title: "PNJ — E-commerce & Retail Campaigns",
    description:
      "Managed multi-channel digital campaigns for Vietnam's top jewellery retailer across seasonal peaks and new product launches.",
    href: "https://www.pnj.com.vn/",
    image:
      "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
  {
    id: "sony",
    title: "Sony Vietnam — Brand Awareness & Lead Gen",
    description:
      "Ran integrated brand and performance campaigns for Sony's consumer electronics launches, delivering qualified leads at scale.",
    href: "https://www.sony.com.vn/",
    image:
      "https://images.unsplash.com/photo-1511174511562-5f7f18b874f8?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080",
  },
];
---

<Layout title="Work — Phuc Loc Nguyen">
  <main class="custom-page">

    <!-- ===== SECTION HEADER ===== -->
    <section class="projects-section">
      <div class="container">
        <div class="projects-header r">
          <div class="projects-header-left">
            <h2 class="projects-title">Work</h2>
            <p class="projects-desc">
              A selection of brand and performance campaigns that drove measurable
              growth — from organic search to paid social and full-funnel strategy.
            </p>
          </div>
          <div class="carousel-controls">
            <button class="carousel-btn" id="carousel-prev" aria-label="Previous slide" disabled>
              <!-- Arrow left SVG -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
            </button>
            <button class="carousel-btn" id="carousel-next" aria-label="Next slide">
              <!-- Arrow right SVG -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- ===== CAROUSEL TRACK (full-bleed) ===== -->
      <div class="carousel-outer">
        <div class="carousel-track" id="carousel-track">
          {projects.map((project, i) => (
            <div class="carousel-slide" data-index={i}>
              <a href={project.href} class="slide-card" target="_blank" rel="noopener noreferrer">
                <div class="slide-image-wrap">
                  <img
                    src={project.image}
                    alt={project.title}
                    width="1080"
                    height="720"
                    loading={i < 2 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={i === 0 ? "high" : "auto"}
                    draggable="false"
                  />
                  <!-- gradient overlay -->
                  <div class="slide-overlay" aria-hidden="true"></div>
                  <div class="slide-content">
                    <p class="slide-title">{project.title}</p>
                    <p class="slide-desc">{project.description}</p>
                    <span class="slide-link">
                      Read more
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2"
                           stroke-linecap="round" stroke-linejoin="round"
                           class="slide-arrow">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- ===== DOT INDICATORS ===== -->
      <div class="carousel-dots" id="carousel-dots">
        {projects.map((_, i) => (
          <button
            class={`dot${i === 0 ? " dot--active" : ""}`}
            data-dot-index={i}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))}
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ============================================================
     PAGE
  ============================================================ */
  .custom-page {
    padding-top: var(--hdr-h);
    min-height: 100svh;
  }

  .projects-section {
    padding: 80px 0 clamp(40px, 5vw, 72px);
  }

  /* ============================================================
     HEADER ROW
  ============================================================ */
  .projects-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .projects-header-left {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 520px;
  }

  .projects-title {
    font-family: var(--serif);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.06;
    color: var(--text);
  }

  .projects-desc {
    font-size: 15px;
    line-height: 1.72;
    color: var(--muted);
    max-width: 440px;
  }

  /* ============================================================
     CONTROLS
  ============================================================ */
  .carousel-controls {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .carousel-controls {
      display: none;
    }
  }

  .carousel-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--divider);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease,
                opacity 0.25s ease;
  }

  .carousel-btn:hover:not(:disabled) {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .carousel-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* ============================================================
     CAROUSEL OUTER — full-bleed
  ============================================================ */
  .carousel-outer {
    width: 100%;
    overflow: hidden;
    /* Left padding mirrors the container's left padding so first slide aligns */
    padding-left: clamp(20px, 4vw, calc((100vw - 1160px) / 2 + 56px));
  }

  .carousel-track {
    display: flex;
    gap: 20px;
    /* Will be transformed by JS */
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    cursor: grab;
    user-select: none;
  }

  .carousel-track.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  /* ============================================================
     SLIDES
  ============================================================ */
  .carousel-slide {
    flex-shrink: 0;
    width: 320px;
  }

  @media (min-width: 1024px) {
    .carousel-slide {
      width: 360px;
    }
  }

  .slide-card {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .slide-image-wrap {
    position: relative;
    min-height: 432px;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: 14px;
  }

  @media (min-width: 1024px) {
    .slide-image-wrap {
      aspect-ratio: 16 / 9;
    }
  }

  .slide-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .slide-card:hover .slide-image-wrap img {
    transform: scale(1.05);
  }

  /* gradient overlay — matches Gallery4 mix-blend approach */
  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(10, 10, 20, 0.35) 55%,
      rgba(10, 10, 20, 0.82) 100%
    );
    border-radius: 14px;
  }

  /* ============================================================
     SLIDE CONTENT
  ============================================================ */
  .slide-content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 24px 28px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    color: #fff;
  }

  .slide-title {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .slide-desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .slide-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-family: var(--mono);
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
    transition: gap 0.25s ease;
  }

  .slide-card:hover .slide-link {
    gap: 10px;
  }

  .slide-arrow {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .slide-card:hover .slide-arrow {
    transform: translateX(3px);
  }

  /* ============================================================
     DOT INDICATORS
  ============================================================ */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--divider);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .dot--active {
    background: var(--text);
    transform: scale(1.3);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('carousel-track') as HTMLElement | null;
    const prevBtn = document.getElementById('carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('carousel-next') as HTMLButtonElement | null;
    const dotsContainer = document.getElementById('carousel-dots');

    if (!track || !prevBtn || !nextBtn || !dotsContainer) return;

    const slides = Array.from(track.querySelectorAll('.carousel-slide')) as HTMLElement[];
    const dots = Array.from(dotsContainer.querySelectorAll('.dot')) as HTMLButtonElement[];
    const total = slides.length;

    // Measure slide width + gap dynamically
    const getSlideWidth = () => {
      if (slides.length === 0) return 340;
      const slideRect = slides[0].getBoundingClientRect();
      const gap = 20; // matches CSS gap
      return slideRect.width + gap;
    };

    let current = 0;

    const goTo = (index: number) => {
      current = Math.max(0, Math.min(index, total - 1));
      const offset = current * getSlideWidth();
      track.style.transform = `translateX(-${offset}px)`;

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('dot--active', i === current);
      });

      // Update buttons
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;
    };

    // Initial state
    goTo(0);

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goTo(i));
    });

    // ── Drag-to-scroll ─────────────────────────────────────────
    let dragging = false;
    let startX = 0;
    let startOffset = 0;
    let moved = false;

    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      startOffset = current * getSlideWidth();
      track.classList.add('is-dragging');
      track.setPointerCapture(e.pointerId);
    });

    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      const raw = startOffset - dx;
      track.style.transform = `translateX(-${Math.max(0, raw)}px)`;
    });

    track.addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('is-dragging');
      const dx = e.clientX - startX;
      const threshold = getSlideWidth() * 0.25;
      if (dx < -threshold) {
        goTo(current + 1);
      } else if (dx > threshold) {
        goTo(current - 1);
      } else {
        goTo(current); // snap back
      }
    });

    // Prevent link navigation after drag
    track.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', (e) => {
        if (moved) {
          e.preventDefault();
          moved = false;
        }
      });
    });

    // Re-snap on resize
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => goTo(current), 150);
    });
  });
</script>
