---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getGear } from "../lib/cms";

export const prerender = true;

const gear = await getGear();
const sections = gear?.sections || [];

// Per-item image scale overrides (frame size stays the same)
const imageScaleBySlug: Record<string, number> = {
  "nikkor-z-24-70mm-f4-s": 0.8,
};
---

<DashboardLayout
  title="Gear & Workspace Setup — Phuc Loc Nguyen"
  pageTitle="Gear"
  description="Tools I actually use to work, shoot, write, and build: M4 Max MacBook Pro, Leica Q3, Nikon Zf, custom keyboards, cycling, and trail running gear."
  breadcrumbs={[{ label: "Gear" }]}
  maxWidthVariant="default"
>
  <!-- Page Header -->
  <header class="page-header">
    <h1 class="page-title">Gear & Hardware</h1>
    <p class="page-lead">
      A living catalog of computing hardware, camera optics, mechanical keyboards, desk ergonomics, cycling, and outdoor equipment.
    </p>
  </header>

  <!-- Gear Sections -->
  <div style="display: flex; flex-direction: column; gap: var(--space-12);">
    {sections.map((section: any) => (
      <section class="page-section" aria-labelledby={`heading-${section.title?.toLowerCase().replace(/\s+/g, '-')}`}>
        <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-4);">
          <div>
            <h2 id={`heading-${section.title?.toLowerCase().replace(/\s+/g, '-')}`} class="section-title" style="margin: 0 0 4px;">
              {section.title}
            </h2>
            {section.description && (
              <p style="font-size: 0.875rem; color: var(--dash-muted); margin: 0;">
                {section.description}
              </p>
            )}
          </div>
          <span style="font-size: 0.75rem; color: var(--dash-muted); white-space: nowrap;">
            {section.items?.length || 0} items
          </span>
        </div>

        <!-- Items Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px;">
          {section.items?.map((item: any) => (
            <div class="dash-card" style="--card-outer-radius: 18px; --card-padding: 12px; border-radius: var(--card-outer-radius); padding: var(--card-padding);">
              {item.image && (
                <div style="aspect-ratio: 16/10; border-radius: max(0px, calc(var(--card-outer-radius) - var(--card-padding))); overflow: hidden; background: #EFEFED; border: var(--dash-border-width, 0.9px) solid var(--dash-border); margin-bottom: 10px;">
                  <img 
                    src={item.image} 
                    alt={item.name} 
                    style={`width: 100%; height: 100%; object-fit: cover;${imageScaleBySlug[item.slug] ? ` transform: scale(${imageScaleBySlug[item.slug]});` : ""}`}
                    loading="lazy"
                  />
                </div>
              )}

              <h3 class="item-title" style="margin: 0 0 6px; font-size: 0.9375rem;">
                {item.name}
              </h3>

              <p style="font-size: 0.8125rem; line-height: 1.5; color: var(--dash-muted); margin: 0;">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</DashboardLayout>
