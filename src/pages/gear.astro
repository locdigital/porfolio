---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getGear } from "../lib/content";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";
import { ArrowUpRight } from "../components/icons/phosphor";
import { canonicalUrl, collectionPageSchema } from "../lib/seo";

export const prerender = true;

const gear = await getGear();
const categoryOrder = [
  "Photography",
  "Cycling",
  "Outdoor & Running",
  "Computers & Devices",
  "Monitors",
  "Desk",
  "Ergonomics",
];
const orderedSections = [...(gear?.sections || [])].sort((a, b) => {
  const aIndex = categoryOrder.indexOf(a.title);
  const bIndex = categoryOrder.indexOf(b.title);
  return (aIndex === -1 ? categoryOrder.length : aIndex) - (bIndex === -1 ? categoryOrder.length : bIndex);
});
const items = orderedSections.flatMap((section) =>
  section.items.map((item) => ({ ...item, category: section.title }))
);
const pageUrl = canonicalUrl("/gear");
const gearSchema = collectionPageSchema({
  url: pageUrl,
  title: "Gear & Workspace Setup — Phuc Loc Nguyen",
  description: "The cameras and lenses, bicycle, outdoor equipment, computers, keyboards, and workspace gear I use every day.",
  items: items.map((item) => ({
    name: item.name,
    url: item.url || pageUrl,
    description: item.description,
    image: item.image,
  })),
  breadcrumbId: `${pageUrl}#breadcrumbs`,
});

const imageScaleBySlug: Record<string, number> = {
  "nikkor-z-24-70mm-f4-s": 0.85,
  "nisi-15mm-f4-sunstar": 0.85,
  "leofoto-urban-lx-254ct": 0.82,
};
---

<DashboardLayout
  title="Gear & Workspace Setup — Phuc Loc Nguyen"
  pageTitle="Gear"
  description="The cameras and lenses, bicycle, outdoor equipment, computers, keyboards, and workspace gear I use every day."
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Gear" }]}
  maxWidthVariant="default"
  schema={gearSchema}
>
  <header class="page-header">
    <h1 class="page-title">Gear & Hardware</h1>
    <p class="page-lead">
      A living catalog of cameras and lenses, cycling, outdoor equipment, computing hardware, mechanical keyboards, and desk ergonomics.
    </p>
  </header>

  <div class="gear-sections" aria-label="Gear and equipment">
    {orderedSections.map((section, sectionIndex) => (
      <section class="gear-section" aria-labelledby={`gear-cat-${sectionIndex}`}>
        <h2 id={`gear-cat-${sectionIndex}`} class="gear-section-label">
          {section.title}
        </h2>

        <div class="gear-list">
          {section.items.map((item, itemIndex) => (
            <article class="gear-row" data-slug={item.slug}>
              <div class="gear-row-hover" aria-hidden="true"></div>
              <div class="gear-row-media">
                {item.image && (
                  <ResponsiveImage
                    src={item.image}
                    alt={item.name}
                    width={160}
                    height={160}
                    widths={[80, 128, 160, 240]}
                    sizes="(max-width: 720px) 56px, 68px"
                    style={`width: 100%; height: 100%; object-fit: contain; transform: scale(${imageScaleBySlug[item.slug] || 1});`}
                    loading={sectionIndex === 0 && itemIndex === 0 ? "eager" : "lazy"}
                    fetchpriority={sectionIndex === 0 && itemIndex === 0 ? "high" : "auto"}
                  />
                )}
              </div>

              <div class="gear-row-body">
                <h3 class="gear-row-title">
                  {item.url ? (
                    <a
                      class="gear-row-link"
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="gear-row-hit" aria-hidden="true"></span>
                      <span class="gear-row-title-inner">
                        <span>{item.name}</span>
                        <ArrowUpRight size={15} strokeWidth={1.6} className="gear-row-arrow" aria-hidden="true" />
                      </span>
                    </a>
                  ) : (
                    <span class="gear-row-title-inner">{item.name}</span>
                  )}
                </h3>
                <p class="gear-row-description">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</DashboardLayout>

<style>
  .gear-sections {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-top: 8px;
    padding-bottom: 40px;
  }

  .gear-section {
    display: grid;
    grid-template-columns: minmax(140px, 200px) minmax(0, 1fr);
    gap: 24px 40px;
    align-items: start;
  }

  .gear-section-label {
    margin: 4px 0 0;
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-compact);
    color: var(--dash-text);
    position: sticky;
    top: 24px;
  }

  .gear-list {
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  .gear-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .gear-row-hover {
    pointer-events: none;
    position: absolute;
    inset: -20px -16px;
    z-index: 0;
    border-radius: 16px;
    background: #f5f5f5;
    opacity: 0;
    transform: scale(0.95);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
                opacity 300ms ease;
  }

  @media (min-width: 640px) {
    .gear-row-hover {
      inset: -22px -24px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .gear-row:hover .gear-row-hover,
    .gear-row:focus-within .gear-row-hover {
      opacity: 1;
      transform: scale(1);
    }
  }

  .gear-row-media {
    position: relative;
    z-index: 10;
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.08));
  }

  .gear-row-body {
    min-width: 0;
    flex: 1 1 auto;
    padding-top: 2px;
  }

  .gear-row-title {
    margin: 0;
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    letter-spacing: var(--tracking-subheading);
    color: var(--dash-text);
    overflow-wrap: anywhere;
  }

  .gear-row-link,
  .gear-row-link:hover {
    color: var(--dash-text) !important;
    text-decoration: none !important;
  }

  .gear-row-hit {
    position: absolute;
    inset: -20px -16px;
    z-index: 20;
    border-radius: 16px;
  }

  @media (min-width: 640px) {
    .gear-row-hit {
      inset: -22px -24px;
    }
  }

  .gear-row-title-inner {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .gear-row-arrow {
    color: var(--dash-muted);
    flex-shrink: 0;
    transition: color var(--duration-fast, 150ms) ease;
  }

  .gear-row:hover .gear-row-arrow,
  .gear-row:focus-within .gear-row-arrow,
  .gear-row-link:hover .gear-row-arrow {
    color: var(--dash-link-hover, #0969DA);
  }

  .gear-row-link:focus-visible {
    outline: none;
  }

  .gear-row-link:focus-visible .gear-row-hit {
    outline: 2px solid var(--dash-accent);
    outline-offset: 2px;
  }

  .gear-row-description {
    position: relative;
    z-index: 10;
    margin: 8px 0 0;
    max-width: 56ch;
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
  }

  @media (max-width: 720px) {
    .gear-sections {
      gap: 44px;
    }

    .gear-section {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gear-section-label {
      position: static;
      margin: 0;
      padding-bottom: 8px;
      border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
      color: var(--dash-muted);
    }

    .gear-list {
      gap: 36px;
    }

    .gear-row {
      gap: 16px;
    }

    .gear-row-media {
      flex: 0 0 56px;
      width: 56px;
      height: 56px;
    }
  }
</style>
