---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { absoluteUrl, pageSchema } from "../../lib/seo";
import { getPostBySlug } from "../../lib/writing/posts";
import { computeReadingTime, countWords, extractTextFromHtml } from "../../lib/writing/reading-time";

const { slug } = Astro.params;

const allPosts = await getCollection("writing", ({ data }) => !data.draft);
const mdPost = allPosts.find((p) => p.slug === slug);
const jsonPost = !mdPost ? await getPostBySlug(slug as string) : null;

if (!mdPost && (!jsonPost || jsonPost.status !== "published")) {
  return Astro.redirect("/404", 404);
}

type TocItem = {
  depth: number;
  id: string;
  text: string;
};

const authorName = jsonPost?.author || "Phuc Loc Nguyen";
const authorAvatar = "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59hKiIFGGTvWeLQqSKNwarCDg0EFydvVs3BXGZR";

function slugifyHeading(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/&/g, " and ")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 72) || "section";
}

function stripTags(value: string) {
  return value
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function tocLabel(value: string) {
  return value.replace(/^\s*(?:\d+(?:\.\d+)*[.)]?\s+)+/, "").trim();
}

function uniqueId(base: string, used: Map<string, number>) {
  const count = used.get(base) ?? 0;
  used.set(base, count + 1);
  return count === 0 ? base : `${base}-${count + 1}`;
}

function extractMarkdownToc(markdown: string): TocItem[] {
  const used = new Map<string, number>();
  return markdown
    .split("\n")
    .map((line) => {
      const match = /^(#{2,3})\s+(.+?)\s*$/.exec(line);
      if (!match) return null;
      const text = match[2].replace(/\s+#+$/, "").trim();
      return {
        depth: match[1].length,
        id: uniqueId(slugifyHeading(text), used),
        text,
      };
    })
    .filter(Boolean) as TocItem[];
}

function enhanceHtmlHeadings(html: string) {
  const toc: TocItem[] = [];
  const used = new Map<string, number>();
  const htmlWithIds = html.replace(/<h([2-3])([^>]*)>([\s\S]*?)<\/h\1>/gi, (full, level, attrs, inner) => {
    const text = stripTags(inner);
    if (!text) return full;
    const existingId = /id=(["'])(.*?)\1/i.exec(attrs)?.[2];
    const id = existingId || uniqueId(slugifyHeading(text), used);
    toc.push({ depth: Number(level), id, text });
    return existingId ? full : `<h${level}${attrs} id="${id}">${inner}</h${level}>`;
  });

  return { html: htmlWithIds, toc };
}

type MarkdownPost = NonNullable<typeof mdPost>;
type MarkdownRenderResult = Awaited<ReturnType<MarkdownPost["render"]>>;

let mdRendered: MarkdownRenderResult | null = null;
let postTitle = "";
let postDescription = "";
let featuredImage: string | undefined;
let publishDate = "";
let tags: string[] = [];
let postUrl = "";
let readingMinutes = 1;
let articleHtml = "";
let tocItems: TocItem[] = [];

if (mdPost) {
  mdRendered = await mdPost.render();
  featuredImage = mdPost.data.coverImage;
  publishDate = mdPost.data.publishedAt.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
  tags = mdPost.data.tags ?? [];
  postUrl = absoluteUrl(`/blog/${mdPost.slug}`);
  postTitle = mdPost.data.title;
  postDescription = mdPost.data.metaDescription || mdPost.data.summary || mdPost.data.headline;
  readingMinutes = computeReadingTime(countWords(mdPost.body || postDescription));
  tocItems = extractMarkdownToc(mdPost.body ?? "");
} else if (jsonPost) {
  postTitle = jsonPost.seoTitle || jsonPost.title;
  postDescription = jsonPost.seoDescription || jsonPost.excerpt || "";
  featuredImage = jsonPost.coverImage || jsonPost.ogImage;
  publishDate = jsonPost.publishedAt
    ? new Date(jsonPost.publishedAt).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : "";
  tags = jsonPost.tags ?? [];
  postUrl = absoluteUrl(`/blog/${jsonPost.slug}`);
  readingMinutes = jsonPost.readingTime || computeReadingTime(countWords(extractTextFromHtml(jsonPost.contentHtml)));
  const enhanced = enhanceHtmlHeadings(jsonPost.contentHtml || "<p>No content.</p>");
  articleHtml = enhanced.html;
  tocItems = enhanced.toc;
}

const displayTitle = mdPost ? mdPost.data.headline : postTitle;
const primaryCategory = tags[0] || "Writing";
---

<Layout
  title={`${postTitle} | Lộc Digital`}
  description={postDescription}
  ogImage={featuredImage}
  ogType="article"
  schema={[
    pageSchema({
      url: postUrl,
      title: `${postTitle} | Lộc Digital`,
      description: postDescription,
      type: "WebPage",
    }),
    {
      "@type": "BlogPosting",
      "@id": `${postUrl}#article`,
      headline: mdPost?.data?.headline || postTitle,
      name: postTitle,
      description: postDescription,
      image: featuredImage ? absoluteUrl(featuredImage) : absoluteUrl("https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59hz9GQ9ONrQN89V1S2GcyZlRdnh3U0J4kfWYAX"),
      url: postUrl,
      datePublished: mdPost?.data?.publishedAt?.toISOString() || jsonPost?.publishedAt || "",
      dateModified: mdPost?.data?.publishedAt?.toISOString() || jsonPost?.updatedAt || "",
      author: { "@id": `${absoluteUrl("/")}#person` },
      publisher: { "@id": `${absoluteUrl("/")}#person` },
      keywords: tags,
      mainEntityOfPage: { "@id": `${postUrl}#webpage` },
    },
  ]}
>
  <main class="blog-article-page">
    <div class="article-shell">
      <article class="article-main">
        <header class="article-hero">
          <div class="article-hero-copy">
            <p class="article-date article-enter article-enter-1">
              {publishDate || primaryCategory} · {readingMinutes} min read
            </p>

            <h1 class="blog-article-title article-enter article-enter-2">{displayTitle}</h1>

            {postDescription && <p class="article-summary article-enter article-enter-3">{postDescription}</p>}

            <div class="article-byline article-enter article-enter-3">
              <img src={authorAvatar} alt={authorName} loading="eager" decoding="async" />
              <p>
                <span>Posted by</span>
                <strong>{authorName}</strong>
              </p>
            </div>
          </div>

          <div class={`article-cover article-enter article-enter-4 ${featuredImage ? "" : "article-cover-empty"}`}>
            {featuredImage ? (
              <img src={featuredImage} alt={postTitle} loading="eager" decoding="async" />
            ) : (
              <span>{primaryCategory}</span>
            )}
          </div>
        </header>

        <div class="article-body-grid">
          {tocItems.length > 0 && (
            <aside class="article-rail toki-r" data-d="1" aria-label="Article information">
              <div class="article-rail-inner">
                <nav class="article-toc" aria-label="Table of contents">
                  <p>On this page</p>
                  <ol>
                    {tocItems.map((item) => (
                      <li class={`toc-depth-${item.depth}`}>
                        <a href={`#${item.id}`}>{tocLabel(item.text)}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </div>
            </aside>
          )}

          <div class="article-content-column">
            <div class="article-meta toki-r" data-d="2">
              <span>{publishDate || primaryCategory}</span>
              {tags.length > 0 && (
                <div class="article-tags">
                  {tags.map((tag: string) => (
                    <span>#{tag.toLowerCase().replace(/\s+/g, "-")}</span>
                  ))}
                </div>
              )}
            </div>

            <div class="blog-article-content" id="article-content">
              {mdRendered && <mdRendered.Content />}
              {jsonPost && <Fragment set:html={articleHtml} />}
            </div>

            <div class="article-footer toki-r" data-d="2">
              <a href="/blog" class="article-back-link">
                <span aria-hidden="true">-</span> Back to writing
              </a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .blog-article-page {
    --article-bg: #fff;
    --article-text: #292929;
    --article-heading: #191919;
    --article-muted: #747474;
    --article-border: #dededb;
    --article-code-bg: #f5f5f3;
    --article-page-max: 80rem;
    --article-prose-width: 45rem;
    --article-rail-width: 16.25rem;
    --article-page-gap: clamp(2.5rem, 6vw, 5rem);
    --article-section-gap: clamp(1.5rem, 3vw, 2rem);
    --article-group-gap: 1rem;
    padding: calc(var(--hdr-h) + var(--article-page-gap)) var(--px) 112px;
    background: var(--article-bg);
  }

  .article-shell {
    width: min(var(--article-page-max), 100%);
    margin: 0 auto;
    background: transparent;
    border: 0;
  }

  .article-main {
    min-width: 0;
    background: transparent;
  }

  .article-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--article-section-gap);
    min-height: 0;
    padding: 0 0 var(--article-page-gap);
    border-bottom: 0;
    opacity: 0;
    transform: translateY(22px) scale(0.992);
    filter: blur(14px);
    transition:
      opacity 980ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 980ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 980ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  .blog-article-page.is-ready .article-hero {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  .article-enter {
    opacity: 0;
    transform: translateY(10px) scaleY(1.012);
    filter: blur(5px);
    transition:
      opacity 820ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 820ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 820ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  .blog-article-page.is-ready .article-enter {
    opacity: 1;
    transform: translateY(0) scaleY(1);
    filter: blur(0);
  }

  .blog-article-page.is-ready .article-enter-1 {
    transition-delay: 260ms;
  }

  .blog-article-page.is-ready .article-enter-2 {
    transition-delay: 360ms;
  }

  .blog-article-page.is-ready .article-enter-3 {
    transition-delay: 470ms;
  }

  .blog-article-page.is-ready .article-enter-4 {
    transition-delay: 380ms;
  }

  .article-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    min-width: 0;
    width: min(860px, 100%);
    padding: 0;
    text-align: left;
  }

  .article-date {
    margin: 0 0 var(--article-group-gap);
    font-family: var(--sans);
    font-size: var(--type-caption);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
    color: color-mix(in srgb, var(--text) 62%, transparent);
  }

  .blog-article-title {
    width: 100%;
    max-width: 53.125rem;
    margin: 12px 0 24px;
    font-family: var(--serif);
    font-size: clamp(56px, 6.2vw, 78px);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 0.92;
    color: var(--article-heading);
    text-wrap: balance;
  }

  .article-summary {
    max-width: 62ch;
    margin: 0 0 var(--article-section-gap);
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: #6e6e6e;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--sans);
    color: #292824;
    justify-content: flex-start;
  }

  .article-byline img {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    border-radius: var(--image-radius);
    object-fit: cover;
  }

  .article-byline p {
    margin: 0;
    font-size: var(--type-body);
    line-height: 1.35;
  }

  .article-byline strong {
    display: block;
    font-weight: 700;
  }

  .article-byline span {
    display: block;
    margin: 0 0 1px;
    color: color-mix(in srgb, var(--text) 68%, transparent);
  }

  .article-cover {
    width: 100%;
    max-width: none;
    aspect-ratio: 16 / 7.5;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--article-border);
    border-radius: var(--image-radius);
    background: #ece8dc;
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    border-radius: var(--image-radius);
    object-fit: cover;
    transform: scale(1.045);
    transition: transform 1.35s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .blog-article-page.is-ready .article-cover img {
    transform: scale(1);
  }

  .article-cover:hover img {
    transform: scale(1.025);
  }

  .article-cover-empty {
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--text) 54%, transparent);
    font-family: var(--sans);
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--article-prose-width)) minmax(15rem, var(--article-rail-width));
    justify-content: center;
    gap: var(--article-page-gap);
    align-items: start;
    padding: 0;
  }

  .article-body-grid:not(:has(.article-rail)) {
    grid-template-columns: minmax(0, var(--article-prose-width));
  }

  .article-rail {
    display: block;
    position: sticky;
    top: calc(var(--hdr-h) + 32px);
    order: 2;
    min-width: 0;
    align-self: start;
  }

  .article-rail-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-toc {
    width: 100%;
    padding: 0 0 18px;
    background: transparent;
    border-bottom: 1px solid var(--article-border);
  }

  .article-toc p {
    margin: 0 0 14px;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
  }

  .article-toc ol {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .article-toc li {
    margin: 0;
    padding: 0;
  }

  .article-toc li::marker,
  .article-toc li::before {
    content: none;
  }

  .article-toc a {
    display: block;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--text) 58%, transparent);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  .article-toc a.is-active {
    font-weight: 600;
    color: #1c1c1c;
  }

  .article-toc a:hover,
  .article-toc a:focus-visible {
    color: var(--text);
    transform: translateX(2px);
    outline: none;
  }

  .article-toc .toc-depth-3 {
    padding-left: 0;
  }

  .article-content-column {
    order: 1;
    min-width: 0;
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .article-meta {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 28px;
    font-family: var(--sans);
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text) 54%, transparent);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .blog-article-content {
    --article-prose-size: 1.125rem;
    --article-prose-leading: 1.7;
    --article-paragraph-gap: 20px;
    --article-heading-gap-before: 80px;
    --article-heading-gap-after: 24px;
    --article-subheading-gap-before: 52px;
    --article-subheading-gap-after: 18px;
    --article-block-gap: 2.5rem;
    color: var(--article-text);
    font-family: var(--sans);
    max-width: var(--article-prose-width);
    text-align: left;
    text-wrap: pretty;
  }

  .blog-article-content :global(h2:first-child),
  .blog-article-content :global(h3:first-child) {
    margin-top: 0;
  }

  /* Allow inline styles from BlockNote custom serializer */
  .blog-article-content :global([style]) {
    /* inline styles are intentional — do not override */
  }

  .article-content-reveal {
    opacity: 0;
    transform: translateY(10px) scaleY(1.012);
    filter: blur(4px);
    transition:
      opacity 780ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 780ms cubic-bezier(0.4, 0, 0.2, 1),
      filter 780ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform, filter;
  }

  .article-content-reveal.in {
    opacity: 1;
    transform: translateY(0) scaleY(1);
    filter: blur(0);
  }

  .blog-article-content :global(h1) {
    text-align: left;
    font-family: var(--serif);
    color: var(--article-heading);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 0.96;
    scroll-margin-top: calc(var(--hdr-h) + 32px);
  }

  .blog-article-content :global(h2),
  .blog-article-content :global(h3),
  .blog-article-content :global(h4),
  .blog-article-content :global(h5),
  .blog-article-content :global(h6) {
    text-align: left;
    font-family: var(--serif);
    color: var(--article-heading);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1;
    scroll-margin-top: calc(var(--hdr-h) + 32px);
    text-wrap: balance;
  }

  .blog-article-content :global(h2) {
    margin: var(--article-heading-gap-before) 0 var(--article-heading-gap-after);
    font-size: clamp(38px, 4vw, 52px);
    letter-spacing: -0.02em;
    line-height: 0.96;
  }

  .blog-article-content :global(h3) {
    margin: var(--article-subheading-gap-before) 0 var(--article-subheading-gap-after);
    font-size: clamp(30px, 3vw, 38px);
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .blog-article-content :global(p) {
    margin: 0 0 var(--article-paragraph-gap);
    max-width: 68ch;
    font-family: var(--sans);
    font-weight: 400;
    font-size: var(--article-prose-size);
    line-height: var(--article-prose-leading);
    letter-spacing: -0.008em;
    text-align: left;
  }

  .blog-article-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 0.2s ease;
  }

  .blog-article-content :global(a:hover) {
    color: var(--accent);
  }

  .blog-article-content :global(strong) {
    color: var(--text);
    font-weight: 700;
  }

  .blog-article-content :global(ul),
  .blog-article-content :global(ol) {
    margin: 0 0 var(--article-paragraph-gap);
    padding-left: 1.25em;
    max-width: 68ch;
    font-family: var(--sans);
    font-size: var(--article-prose-size);
    line-height: var(--article-prose-leading);
    letter-spacing: -0.008em;
    text-align: left;
  }

  .blog-article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .blog-article-content :global(blockquote) {
    margin: var(--article-block-gap) 0;
    padding: 6px 0 6px 24px;
    border-left: 1px solid var(--article-border);
    color: var(--article-muted);
    font-style: normal;
  }

  .blog-article-content :global(img) {
    max-width: 100%;
    border-radius: 6px;
    margin: var(--article-block-gap) 0;
  }

  .blog-article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--article-border);
    margin: 3rem 0;
  }

  .blog-article-content :global(code) {
    font-family: var(--mono);
    font-size: var(--type-caption);
    background: var(--article-code-bg);
    border-radius: 5px;
    padding: 0.12em 0.34em;
  }

  .blog-article-content :global(pre) {
    overflow-x: auto;
    margin: var(--article-block-gap) 0;
    padding: 22px 24px;
    border-radius: 8px;
    background: #16162a;
    color: #f7f7f2;
  }

  .blog-article-content :global(pre code) {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  .blog-article-content :global(table) {
    width: 100%;
    max-width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: var(--article-block-gap) 0;
    font-size: var(--type-body);
    line-height: 1.5;
  }

  .blog-article-content :global(th),
  .blog-article-content :global(td) {
    padding: 12px 14px;
    border: 1px solid var(--article-border);
    text-align: left;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .article-footer {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--article-border);
  }

  .article-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: var(--type-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-back-link span {
    transition: transform 0.2s ease;
  }

  .article-back-link:hover {
    color: var(--accent);
  }

  .article-back-link:hover span {
    transform: translateX(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-enter,
    .article-hero,
    .article-content-reveal,
    .article-cover img {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }

  @media (max-width: 980px) {
    .blog-article-page {
      --article-page-gap: clamp(2rem, 6vw, 2.5rem);
      padding-top: calc(var(--hdr-h) + var(--article-page-gap));
    }

    .article-shell {
      width: 100%;
    }

    .article-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 0 0 var(--article-page-gap);
    }

    .article-cover {
      grid-column: 1;
      min-height: auto;
      aspect-ratio: 16 / 9;
      border-left: 1px solid var(--article-border);
      border-top: 1px solid var(--article-border);
    }

    .article-body-grid {
      grid-template-columns: 1fr;
      gap: var(--article-page-gap);
      padding: 0;
    }

    .article-rail {
      display: none;
    }

    .article-content-column {
      order: 1;
    }
  }

  @media (max-width: 640px) {
    .blog-article-page {
      --article-page-gap: 2rem;
      padding-inline: 12px;
      padding-bottom: 88px;
    }

    .article-shell {
      width: 100%;
    }

    .article-hero {
      gap: var(--article-section-gap);
      padding: 0 0 var(--article-page-gap);
    }

    .article-hero-copy {
      padding: 0;
    }

    .blog-article-title {
      font-size: clamp(42px, 12vw, 58px);
      line-height: 0.94;
      letter-spacing: -0.02em;
    }

    .article-summary {
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .article-byline {
      align-items: flex-start;
    }

    .article-byline span {
      display: block;
      margin: 4px 0 0;
    }

    .article-body-grid {
      gap: var(--article-page-gap);
      padding: 0;
    }

    .blog-article-content {
      --article-prose-size: 1.0625rem;
      --article-prose-leading: 1.7;
    }

    .article-toc a {
      font-size: var(--type-body-lg);
      line-height: 1.6;
    }

    .blog-article-content :global(p),
    .blog-article-content :global(ul),
    .blog-article-content :global(ol) {
      font-size: var(--article-prose-size);
      line-height: var(--article-prose-leading);
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const page = document.querySelector(".blog-article-page");
    requestAnimationFrame(() => page?.classList.add("is-ready"));

    const content = document.getElementById("article-content");
    if (!content) return;

    const used = new Map();
    const slugify = (value: string | null) => {
      const base = (value || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/&/g, " and ")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 72) || "section";
      const count = used.get(base) || 0;
      used.set(base, count + 1);
      return count === 0 ? base : `${base}-${count + 1}`;
    };

    const headings = Array.from(content.querySelectorAll("h2, h3")) as HTMLElement[];

    headings.forEach((heading) => {
      if (!heading.id) heading.id = slugify(heading.textContent);
    });

    const tocLinks = Array.from(document.querySelectorAll(".article-toc a")) as HTMLAnchorElement[];
    const tocById = new Map(
      tocLinks
        .map((link) => [decodeURIComponent(link.hash.replace("#", "")), link] as const)
        .filter(([id]) => id)
    );
    const setActiveToc = (id: string) => {
      tocLinks.forEach((link) => link.classList.toggle("is-active", link === tocById.get(id)));
    };

    if (headings.length > 0) {
      setActiveToc(headings[0].id);

      const headingObserver = new IntersectionObserver(
        (entries) => {
          const visibleHeadings = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visibleHeadings[0]?.target instanceof HTMLElement) {
            setActiveToc(visibleHeadings[0].target.id);
          }
        },
        { rootMargin: "-18% 0px -66% 0px", threshold: 0 }
      );

      headings.forEach((heading) => headingObserver.observe(heading));

      window.addEventListener(
        "scroll",
        () => {
          const currentHeading = headings.findLast((heading) => heading.getBoundingClientRect().top <= window.innerHeight * 0.32);
          if (currentHeading) setActiveToc(currentHeading.id);
        },
        { passive: true }
      );
    }

    const revealItems = Array.from(
      content.querySelectorAll("h2, h3, p, ul, ol, blockquote, img, table, pre")
    );

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      revealItems.forEach((item) => item.classList.add("in"));
      return;
    }

    revealItems.forEach((item, index) => {
      item.classList.add("article-content-reveal");
      (item as HTMLElement).style.transitionDelay = `${Math.min(index % 4, 3) * 55}ms`;
    });

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("in");
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -42px 0px" }
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  });
</script>
