---
import Layout from "../../layouts/Layout.astro";
import { getWritingPosts } from "../../lib/writing";

export async function getStaticPaths() {
  const posts = await getWritingPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const renderedPost = post.source === "local" ? await post.render() : null;
const Content = renderedPost?.Content;
const featuredImage = post.data.coverImage;

// Format date
const publishDate = post.data.publishedAt.toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
});

const tags = post.data.tags;
---

<Layout 
  title={`${post.data.title} | Lộc Digital`} 
  description={post.data.metaDescription || post.data.summary} 
  ogImage={featuredImage}
>
  <article class="container mx-auto pb-32 px-4 max-w-[880px]" style="padding-top: 140px;">
    <a href="/blog" class="group inline-flex items-center font-sans text-[11px] font-bold tracking-[0.15em] text-[var(--muted)] hover:text-[var(--text)] transition-colors mb-8 uppercase">
      <span class="mr-2 transition-transform group-hover:-translate-x-1">←</span> WRITING
    </a>
    
    <header class="mb-[64px]">
      <h1 class="text-[44px] md:text-[64px] font-['PP_Editorial_Old'] font-normal tracking-[-0.02em] leading-[1.05] text-[var(--text)] mb-[24px]">{post.data.headline}</h1>
      
      <div class="flex flex-wrap items-center gap-x-4 text-[var(--muted)] font-mono text-[12px] tracking-wide">
        <time datetime={post.data.publishedAt.toISOString()}>{publishDate}</time>
        {tags.length > 0 && (
          <div class="flex items-center gap-x-3">
            {tags.map((tag: string) => (
              <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    {featuredImage && (
      <div class="aspect-[16/9] w-full rounded-[8px] overflow-hidden mb-[64px]">
        <img 
          src={featuredImage} 
          alt={post.data.title} 
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    {/* Prose configuration for styling WordPress HTML output */}
    {post.source === "wordpress" ? (
      <div 
        class="prose prose-lg max-w-none 
               prose-headings:font-['PP_Editorial_Old'] prose-headings:font-normal prose-headings:text-[var(--text)] prose-headings:tracking-[-0.01em] prose-headings:mt-16 prose-headings:mb-6
               prose-p:font-sans prose-p:text-[17px] prose-p:text-[var(--text)] prose-p:leading-[1.8] prose-p:mb-8
               prose-a:text-[var(--text)] prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-[var(--accent)] prose-a:transition-colors
               prose-strong:text-[var(--text)] prose-strong:font-semibold
               prose-ul:text-[var(--text)] prose-ol:text-[var(--text)] prose-li:text-[var(--text)]
               prose-img:rounded-[8px] prose-img:mx-auto prose-img:my-12
               prose-hr:border-[var(--divider)] prose-hr:my-12
               prose-blockquote:text-[var(--muted)] prose-blockquote:border-l-[var(--divider)] prose-blockquote:font-normal prose-blockquote:not-italic"
        set:html={post.content}
      />
    ) : (
      <div 
        class="prose prose-lg max-w-none 
               prose-headings:font-['PP_Editorial_Old'] prose-headings:font-normal prose-headings:text-[var(--text)] prose-headings:tracking-[-0.01em] prose-headings:mt-16 prose-headings:mb-6
               prose-p:font-sans prose-p:text-[17px] prose-p:text-[var(--text)] prose-p:leading-[1.8] prose-p:mb-8
               prose-a:text-[var(--text)] prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-[var(--accent)] prose-a:transition-colors
               prose-strong:text-[var(--text)] prose-strong:font-semibold
               prose-ul:text-[var(--text)] prose-ol:text-[var(--text)] prose-li:text-[var(--text)]
               prose-img:rounded-[8px] prose-img:mx-auto prose-img:my-12
               prose-hr:border-[var(--divider)] prose-hr:my-12
               prose-blockquote:text-[var(--muted)] prose-blockquote:border-l-[var(--divider)] prose-blockquote:font-normal prose-blockquote:not-italic"
      >
        {Content && <Content />}
      </div>
    )}

    <div class="mt-24 pt-8 border-t border-[var(--divider)]">
      <a href="/blog" class="group inline-flex items-center font-sans text-[13px] font-bold tracking-[0.1em] text-[var(--text)] hover:text-[var(--accent)] transition-colors uppercase">
        <span class="mr-2 transition-transform group-hover:-translate-x-1">←</span> BACK TO WRITING
      </a>
    </div>
  </article>
</Layout>
