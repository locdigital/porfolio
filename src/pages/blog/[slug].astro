---
import Layout from "../../layouts/Layout.astro";
import { getPosts, extractSEOData } from "../../lib/wordpress";

export async function getStaticPaths() {
  // Fetch recent posts to generate static paths at build time
  const posts = await getPosts(100);
  
  if (!posts || posts.length === 0) {
    return [];
  }

  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const seo = extractSEOData(post);
const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;

// Format date
const publishDate = new Date(post.date).toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
});

// Extract tags
const terms = post._embedded?.['wp:term']?.flat() || [];
const tags = terms.filter((term: any) => term.taxonomy === 'post_tag' || term.taxonomy === 'category').map((term: any) => term.name);
---

<Layout 
  title={`${seo?.title || post.title.rendered} | Lộc Digital`} 
  description={seo?.description} 
  ogImage={seo?.ogImage || featuredImage}
>
  <article class="container mx-auto pb-32 px-4 max-w-[880px]" style="padding-top: 140px;">
    <a href="/blog" class="group inline-flex items-center font-sans text-[11px] font-bold tracking-[0.15em] text-[var(--muted)] hover:text-[var(--text)] transition-colors mb-8 uppercase">
      <span class="mr-2 transition-transform group-hover:-translate-x-1">←</span> WRITING
    </a>
    
    <header class="mb-[64px]">
      <h1 class="text-[44px] md:text-[64px] font-['PP_Editorial_Old'] font-normal tracking-[-0.02em] leading-[1.05] text-[var(--text)] mb-[24px]" set:html={post.title.rendered} />
      
      <div class="flex flex-wrap items-center gap-x-4 text-[var(--muted)] font-mono text-[12px] tracking-wide">
        <time datetime={post.date}>{publishDate}</time>
        {tags.length > 0 && (
          <div class="flex items-center gap-x-3">
            {tags.map((tag: string) => (
              <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    {featuredImage && (
      <div class="aspect-[16/9] w-full rounded-[8px] overflow-hidden mb-[64px]">
        <img 
          src={featuredImage} 
          alt={post.title.rendered} 
          class="w-full h-full object-cover"
        />
      </div>
    )}

    {/* Prose configuration for styling WordPress HTML output */}
    <div 
      class="prose prose-lg max-w-none 
             prose-headings:font-['PP_Editorial_Old'] prose-headings:font-normal prose-headings:text-[var(--text)] prose-headings:tracking-[-0.01em] prose-headings:mt-16 prose-headings:mb-6
             prose-p:font-sans prose-p:text-[17px] prose-p:text-[var(--text)] prose-p:leading-[1.8] prose-p:mb-8
             prose-a:text-[var(--text)] prose-a:underline prose-a:underline-offset-4 hover:prose-a:[background:var(--accent)] hover:prose-a:[-webkit-background-clip:text] hover:prose-a:[-webkit-text-fill-color:transparent] prose-a:transition-colors
             prose-strong:text-[var(--text)] prose-strong:font-semibold
             prose-ul:text-[var(--text)] prose-ol:text-[var(--text)] prose-li:text-[var(--text)]
             prose-img:rounded-[8px] prose-img:mx-auto prose-img:my-12
             prose-hr:border-[var(--divider)] prose-hr:my-12
             prose-blockquote:text-[var(--muted)] prose-blockquote:border-l-[var(--divider)] prose-blockquote:font-normal prose-blockquote:not-italic"
      set:html={post.content.rendered} 
    />

    <div class="mt-24 pt-8 border-t border-[var(--divider)]">
      <a href="/blog" class="group inline-flex items-center font-sans text-[13px] font-bold tracking-[0.1em] text-[var(--text)] hover:[background:var(--accent)] hover:[-webkit-background-clip:text] hover:[-webkit-text-fill-color:transparent] transition-colors uppercase">
        <span class="mr-2 transition-transform group-hover:-translate-x-1">←</span> BACK TO WRITING
      </a>
    </div>
  </article>
</Layout>
