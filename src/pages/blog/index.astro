---
import Layout from "../../layouts/Layout.astro";
import { getWritingPosts } from "../../lib/writing";

let posts: Awaited<ReturnType<typeof getWritingPosts>> = [];
try {
  posts = await getWritingPosts();
} catch (e) {
  console.error("[blog/index] Failed to load writing posts:", e);
}
---

<Layout title="Writing | Lộc Digital" description="Journal & Essays">
  <main class="gear-page">
    <div class="gear-container">
      <!-- PAGE HERO -->
      <section class="gear-hero toki-r" data-d="1" aria-label="Writing">
        <p class="gear-kicker">Writing</p>
        <h1>Journal & <em>Essays</em></h1>
        <p class="gear-intro">
          A collection of thoughts, tutorials, and reflections on marketing, code, and life.
        </p>
      </section>

        {posts.length > 0 ? (
          <div class="flex flex-col gap-y-[72px]">
            {posts.map((post) => {
              const dateStr = post.data.publishedAt.toLocaleDateString('en-US', { 
                month: 'short', 
                year: 'numeric' 
              });
              
              return (
                <a 
                  href={`/blog/${post.slug}`} 
                  class="group flex flex-col md:flex-row md:items-start md:gap-[60px] transition-opacity hover:opacity-70 duration-300"
                >
                  <div class="md:w-[120px] flex-shrink-0 font-mono text-[11px] text-[var(--muted)] uppercase pt-[14px] mb-2 md:mb-0 tracking-wider">
                    {dateStr}
                  </div>
                  <div class="flex-grow max-w-[800px]">
                    <h2 class="text-[32px] md:text-[42px] font-['PP_Editorial_Old'] font-normal tracking-[-0.02em] text-[var(--text)] leading-[1.1] mb-[12px]">{post.data.headline}</h2>
                    <div class="text-[15px] text-[var(--muted)] leading-[1.6] line-clamp-2">{post.data.summary}</div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="py-10 text-[var(--muted)]">
            <p>New writing is coming soon.</p>
          </div>
        )}

      </div>
  </main>
</Layout>
