---
import Layout from "../layouts/Layout.astro";
import BlurFade from "../components/ui/BlurFade.astro";
---

<Layout
  title="Ask Loc Anything | Phuc Loc Nguyen"
  description="Have a question about Loc's digital marketing work, skills, or experience? Ask him anything and get an instant answer."
>
  <main class="qp" id="qp-main">

    <!-- ------ Content ------------------------------------------------------------------------------------------------------------------ -->
    <div class="qp-wrap">

      <!-- Intro heading -->
      <header class="qp-intro about-reveal-hero toki-r" data-d="1">
        <div class="qp-avatar" aria-hidden="true">
          <span>👋</span>
        </div>
        <BlurFade>
          <h1 class="qp-headline">
            <span>Ask <span class="name-highlight"><span class="name-hl-bg"></span><span class="name-hl-dot name-hl-dot-tl"></span><span class="name-hl-dot name-hl-dot-br"></span><span class="name-hl-text">Loc</span></span> anything.</span>
          </h1>
        </BlurFade>
      </header>

      <!-- Chat messages (hidden when empty) -->
      <div
        class="qp-messages"
        id="qp-messages"
        aria-live="polite"
        aria-atomic="false"
        aria-label="Chat conversation"
        role="log"
      ></div>

      <!-- Quick-action pill buttons -->
      <nav class="qp-pills" aria-label="Quick questions">
        <button
          class="qp-pill"
          data-q="What projects and campaigns have you worked on? Tell me about your best work."
          type="button"
        >see my work --</button>
        <button
          class="qp-pill"
          data-q="Tell me about your digital marketing background and work experience."
          type="button"
        >my background?</button>
        <button
          class="qp-pill"
          data-q="What are your key skills and areas of expertise?"
          type="button"
        >what skills?</button>
        <button
          class="qp-pill"
          data-q="Are you currently available for new projects or full-time hire?"
          type="button"
        >available for hire?</button>
        <div class="qp-pills-break"></div>
        <a class="qp-pill qp-pill--ext" href="mailto:hi@loc.digital">email -></a>
        <a class="qp-pill qp-pill--ext" href="https://www.linkedin.com/in/phucloc" target="_blank" rel="noopener noreferrer">LinkedIn -></a>
        <a class="qp-pill qp-pill--ext" href="https://phucloc.digital/resume" target="_blank" rel="noopener noreferrer">resume -></a>
      </nav>

      <!-- Input form -->
      <form class="qp-form" id="qp-form" autocomplete="off" novalidate>
        <label class="qp-field" for="qp-input">
          <input
            type="text"
            id="qp-input"
            name="question"
            class="qp-input"
            placeholder="ask Loc anything..."
            maxlength="500"
            spellcheck="false"
            aria-label="Type your question about Loc"
          />
          <button
            type="submit"
            id="qp-submit"
            class="qp-submit"
            aria-label="Send question"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4"></path>
            </svg>
          </button>
        </label>
      </form>

      <p class="qp-note">Answers are automated based on Loc's portfolio content.</p>

    </div><!-- /.qp-wrap -->
  </main>
</Layout>

<!-- ============================================================
     STYLES
============================================================ -->
<style is:global>
  /* ------ Page shell ------ */
  .qp {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--hdr-h) + 40px) clamp(20px, 5vw, 48px) 60px;
    overflow: hidden;
  }

  /* ------ Content wrapper ------ */
  .qp-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* ------ Intro ------ */
  .qp-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .qp-avatar {
    width: 52px;
    height: 52px;
    font-size: 32px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    border: 1px solid rgba(0, 117, 222, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 117, 222, 0.1);
    animation: avatarPop 0.6s var(--spring) 0.05s both;
  }

  @keyframes avatarPop {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* ------ Headline ------ */
  .qp-headline {
    font-family: var(--serif);
    font-size: clamp(42px, 6.5vw, 90px);
    font-weight: 400;
    line-height: 1.13;
    letter-spacing: -0.025em;
    color: #16162a;
  }

  .name-highlight {
    position: relative;
    display: inline-block;
    padding: 0 6px;
  }
  .name-hl-bg {
    position: absolute;
    inset: 0;
    border-left: 2px solid rgba(0, 117, 222, 0.45);
    border-right: 2px solid rgba(0, 117, 222, 0.45);
    background-color: rgba(0, 117, 222, 0.12);
  }
  .name-hl-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgb(0, 117, 222);
  }
  .name-hl-dot-tl {
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }
  .name-hl-dot-br {
    bottom: 0;
    right: 0;
    transform: translate(50%, 50%);
  }
  .name-hl-text {
    position: relative;
    color: #16162a;
  }

  .qp-headline em {
    font-style: italic;
    color: #16162a;
  }

  /* Line reveal animation */
  .qhl {
    display: inline;
    position: relative;
    top: 24px;
    opacity: 0;
    transition: opacity 0.75s var(--ease-out), top 0.75s var(--ease-out);
  }

  .qhl.in {
    opacity: 1;
    top: 0;
  }

  .qhl-2 { transition-delay: 0.12s; }
  .qhl-3 { transition-delay: 0.22s; }
  
  /* ------ Pills ------ */
  .qp-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
    max-width: 640px;
    width: 100%;
  }

  .qp-pills-break {
    flex-basis: 100%;
    height: 0;
  }

  .qp-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 17px;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    color: #2a2040;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(0, 117, 222, 0.32);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease,
                box-shadow 0.2s ease, transform 0.15s ease, color 0.2s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2px 8px rgba(0, 117, 222, 0.07);
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    animation: pillFade 0.5s var(--ease-out) both;
  }

  .qp-pill:nth-child(1) { animation-delay: 0.3s; }
  .qp-pill:nth-child(2) { animation-delay: 0.36s; }
  .qp-pill:nth-child(3) { animation-delay: 0.42s; }
  .qp-pill:nth-child(4) { animation-delay: 0.48s; }
  .qp-pill:nth-child(6) { animation-delay: 0.54s; }
  .qp-pill:nth-child(7) { animation-delay: 0.60s; }
  .qp-pill:nth-child(8) { animation-delay: 0.66s; }

  @keyframes pillFade {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .qp-pill:hover,
  .qp-pill:focus-visible {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 117, 222, 0.5);
    box-shadow: 0 4px 18px rgba(0, 117, 222, 0.14);
    transform: translateY(-1.5px);
    color: var(--accent);
    outline: none;
  }

  .qp-pill--ext {
    color: #2a2040;
  }

  /* ------ Chat messages ------ */
  .qp-messages {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 42vh;
    overflow-y: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 4px 0;
  }

  .qp-messages:empty { display: none; }

  .qp-messages::-webkit-scrollbar { display: none; }

  /* Individual message row */
  .qp-msg {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    animation: msgIn 0.32s var(--ease-out) both;
  }

  .qp-msg--user { flex-direction: row-reverse; }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Bubble */
  .qp-bubble {
    max-width: 78%;
    padding: 11px 16px;
    font-size: 15px;
    line-height: 1.62;
    word-break: break-word;
    white-space: pre-wrap;
  }

  .qp-msg--user .qp-bubble {
    background: #16162a;
    color: #fff;
    border-radius: 18px 18px 4px 18px;
  }

  .qp-msg--ai .qp-bubble {
    background: rgba(255, 255, 255, 0.82);
    color: #16162a;
    border-radius: 18px 18px 18px 4px;
    border: 1px solid rgba(0, 117, 222, 0.22);
    box-shadow: 0 2px 14px rgba(0, 117, 222, 0.07);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .qp-chat-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(0, 117, 222, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  /* Typing indicator */
  .qp-typing {
    display: flex;
    gap: 5px;
    padding: 6px 2px 2px;
    align-items: center;
  }

  .qp-typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(0, 117, 222, 0.5);
    animation: typeBounce 1.3s ease-in-out infinite;
  }

  .qp-typing span:nth-child(2) { animation-delay: 0.18s; }
  .qp-typing span:nth-child(3) { animation-delay: 0.36s; }

  @keyframes typeBounce {
    0%, 60%, 100% { transform: translateY(0);   opacity: 0.45; }
    30%            { transform: translateY(-6px); opacity: 1; }
  }

  /* ------ Input form ------ */
  .qp-form {
    width: 100%;
    animation: formRise 0.6s var(--ease-out) 0.5s both;
  }

  @keyframes formRise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  .qp-field {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(210, 210, 215, 0.6);
    border-radius: 16px;
    padding: 10px 10px 10px 16px;
    cursor: text;
    transition: background 0.25s ease, border-color 0.25s ease,
                box-shadow 0.25s ease;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 4px 22px rgba(0, 0, 0, 0.04);
  }

  .qp-field:focus-within {
    background: #fff;
    border-color: #b0b0b0;
    box-shadow: 0 4px 28px rgba(0, 0, 0, 0.08);
  }

  .qp-prompt {
    font-family: var(--mono);
    font-size: 15px;
    color: rgba(0, 117, 222, 0.6);
    flex-shrink: 0;
    user-select: none;
    letter-spacing: -0.04em;
  }

  .qp-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--sans);
    font-size: 15px;
    color: #16162a;
    outline: none;
  }

  .qp-input::placeholder {
    color: rgba(0, 117, 222, 0.4);
  }

  /* Send button */
  .qp-submit {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #b5b5b5;
    color: #fff;
    border: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s ease, transform 0.15s ease, opacity 0.2s ease;
  }

  .qp-submit:hover:not(:disabled) {
    background: #a3a3a3;
    transform: scale(1.06);
  }

  .qp-submit:active:not(:disabled) {
    transform: scale(0.97);
  }

  .qp-submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* ------ Footer note ------ */
  .qp-note {
    font-family: var(--mono);
    font-size: 11px;
    color: rgba(0, 117, 222, 0.45);
    text-align: center;
    animation: formRise 0.6s var(--ease-out) 0.7s both;
  }

  /* ------ Mobile ------ */
  @media (max-width: 600px) {
    .qp {
      padding-top: calc(var(--hdr-h) + 32px);
      align-items: flex-start;
    }

    .qp-headline {
      font-size: clamp(28px, 9vw, 42px);
    }

    .qp-messages {
      max-height: 38vh;
    }

    .qp-bubble {
      max-width: 90%;
    }
  }
</style>

<!-- ============================================================
     SCRIPTS --- chat logic
============================================================ -->
<script>
  document.addEventListener('astro:page-load', () => {
    // ------ DOM references ------------------------------------------------------------------------------------------------------
    const main      = document.getElementById('qp-main');
    if (!main) return;

    const form      = document.getElementById('qp-form') as HTMLFormElement;
    const input     = document.getElementById('qp-input') as HTMLInputElement;
    const submitBtn = document.getElementById('qp-submit') as HTMLButtonElement;
    const messages  = document.getElementById('qp-messages')!;
    const pills     = document.querySelectorAll<HTMLButtonElement>('.qp-pill[data-q]');

    // ------ Helpers ------------------------------------------------------------------------------------------------------------------------------
    function addMessage(text: string, role: 'user' | 'ai'): HTMLDivElement {
      const row = document.createElement('div');
      row.className = `qp-msg qp-msg--${role}`;

      if (role === 'ai') {
        const avatar = document.createElement('div');
        avatar.className = 'qp-chat-avatar';
        avatar.innerHTML = '<span>👋</span>';
        row.appendChild(avatar);
      }

      const bubble = document.createElement('div');
      bubble.className = 'qp-bubble';
      bubble.textContent = text;

      row.appendChild(bubble);
      messages.appendChild(row);
      messages.scrollTop = messages.scrollHeight;
      return bubble;
    }

    function showTyping(): void {
      const row = document.createElement('div');
      row.className = 'qp-msg qp-msg--ai';
      row.id = 'qp-typing';

      const avatar = document.createElement('div');
      avatar.className = 'qp-chat-avatar';
      avatar.innerHTML = '<span>👋</span>';
      row.appendChild(avatar);

      const bubble = document.createElement('div');
      bubble.className = 'qp-bubble';
      bubble.innerHTML = '<div class="qp-typing"><span></span><span></span><span></span></div>';

      row.appendChild(bubble);
      messages.appendChild(row);
      messages.scrollTop = messages.scrollHeight;
    }

    function removeTyping(): void {
      document.getElementById('qp-typing')?.remove();
    }

    function setLoading(loading: boolean): void {
      submitBtn.disabled = loading;
      input.disabled = loading;
      pills.forEach(p => { (p as HTMLButtonElement).disabled = loading; });
    }

    // ------ Local Automated Responder ---------------------------------------------------------------------------------------------------
    async function askLocalAgent(userText: string): Promise<void> {
      setLoading(true);
      showTyping();

      // Simulate network delay for natural feel
      await new Promise(r => setTimeout(r, 600 + Math.random() * 600));

      const text = userText.toLowerCase();
      let aiText = "";

      if (text.includes("project") || text.includes("campaign") || text.includes("work") || text.includes("portfolio")) {
        aiText = "Loc has worked on performance marketing, SEO, lead generation, and community growth for PlayAh!, WorkFlow Space, TOMATO Children's Home, POPS Worldwide, and education communities. Check out the Work section for detailed case studies.";
      } else if (text.includes("background") || text.includes("experience") || text.includes("history") || text.includes("past")) {
        aiText = "Loc is a Senior Performance Marketing Executive with 4+ years of experience scaling e-commerce, education, and consumer brands. His resume includes 10x website revenue growth, 30x+ TikTok Shop GMV growth, and 10x organic traffic growth.";
      } else if (text.includes("skill") || text.includes("expertise") || text.includes("expert") || text.includes("do you know") || text.includes("can you")) {
        aiText = "Loc's key skills include Performance Marketing on Meta, Google, and TikTok; TikTok Shop GMV scaling; SEO/SEM; GA4/GTM/Looker Studio analytics; n8n and email automation; and ROAS, CPA, and CPL optimization.";
      } else if (text.includes("hire") || text.includes("available") || text.includes("freelance") || text.includes("job") || text.includes("opportunity")) {
        aiText = "Yes, Loc is open to performance marketing, growth, and full-time opportunities. You can email him at hi@loc.digital to discuss further.";
      } else if (text.includes("contact") || text.includes("email") || text.includes("reach") || text.includes("touch") || text.includes("connect")) {
        aiText = "You can reach Loc directly via email at hi@loc.digital or connect with him on LinkedIn.";
      } else if (text.includes("hello") || text.includes("hi") || text.includes("hey")) {
        aiText = "Hi there! I'm here to help you with questions about Loc's digital marketing work. What would you like to know about his projects, skills, or experience?";
      } else {
        aiText = "I'm only here to answer questions about Loc's work! Try asking about his digital marketing campaigns, skills, or professional background.";
      }

      removeTyping();
      addMessage(aiText, 'ai');
      
      setLoading(false);
      input.focus();
    }

    // ------ Form submit ---------------------------------------------------------------------------------------------------------------
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      triggerIntro(true); // force instant if they somehow submit before intro finishes
      addMessage(text, 'user');
      input.value = '';

      await askLocalAgent(text);
    });

    // ------ Auto Introduction ---------------------------------------------------------------------------------------------
    let hasIntroduced = false;
    function triggerIntro(instant = false) {
      if (hasIntroduced) return;
      hasIntroduced = true;
      
      const introEl = document.querySelector('.qp-intro') as HTMLElement;
      if (introEl) introEl.style.display = 'none';

      const introText = "I'm Loc --- based in Ho Chi Minh City. I grow revenue through performance marketing, SEO, and automation.";
      
      if (instant) {
        addMessage(introText, 'ai');
      } else {
        showTyping();
        setTimeout(() => {
          removeTyping();
          addMessage(introText, 'ai');
        }, 600);
      }
    }

    input.addEventListener('focus', () => triggerIntro(false), { once: true });

    // ------ Pill clicks ------------------------------------------------------------------------------------------------------------------
    pills.forEach((pill) => {
      pill.addEventListener('click', async () => {
        triggerIntro(true);
        const q = pill.dataset.q!;
        addMessage(q, 'user');
        await askLocalAgent(q);
      });
    });

    // ------ Headline line reveal animation ------------------------------------------------------
    setTimeout(() => {
      document.querySelectorAll<HTMLElement>('.qhl').forEach((el, i) => {
        setTimeout(() => el.classList.add('in'), i * 130 + 80);
      });
    }, 60);
  });
</script>
