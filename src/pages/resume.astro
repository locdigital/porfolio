---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { GraduationCap } from "../components/icons/phosphor";
import { PERSON_ID, canonicalUrl, pageSchema } from "../lib/seo";

const resumeUrl = canonicalUrl("/resume");
const resumeSchema = pageSchema({
  url: resumeUrl,
  title: "Resume — Phuc Loc Nguyen",
  description: "Resume of Phuc Loc Nguyen (Loc / Henry): education at FPT University, performance marketing experience, SEO leadership, and growth competencies.",
  type: "ProfilePage",
  mainEntity: { "@id": PERSON_ID },
  breadcrumbId: `${resumeUrl}#breadcrumbs`,
});

const experiences = [
  {
    company: "SONY",
    logo: "/assets/logos/logo-sony.webp",
    role: "D2C Marketing",
    period: "2025 — 2026",
    type: "Consumer Electronics & E-Commerce",
    location: "Vietnam / Regional",
    description: "Supported direct-to-consumer marketing and e-commerce operations across website content, campaign assets, performance analysis, experimentation, AI workflows, and CRM coordination.",
    achievements: [
      "Improved engagement by 5% in FY25 through AI-powered copy testing and predictive analytics initiatives.",
      "Managed and coordinated resolution for 200+ monthly customer support incidents through Salesforce CRM.",
      "Optimized product pages, promotional banners, and campaign content through Adobe Analytics, A/B testing, and personalization."
    ],
    tools: ["Adobe Analytics", "Adobe Experience Manager", "Salesforce CRM", "A/B Testing", "AI Workflows"]
  },
  {
    company: "WorkFlow Space",
    logo: "/assets/logos/logo-workflow.webp",
    role: "Digital Marketing Executive",
    period: "2024 — 2026",
    type: "Co-working & Private Pods",
    location: "Saigon",
    description: "Owned full-funnel performance marketing for new branch launches, connecting paid media, landing pages, creative testing, and booking UX into a repeatable lead engine.",
    achievements: [
      "Generated 5,000+ experience bookings and 2,000+ qualified leads.",
      "Achieved 35–40% landing page booking conversion rate.",
      "Launched and scaled Next Wave Startup program with 50+ founding teams."
    ],
    tools: ["Meta Ads", "Google Ads", "Looker Studio", "Landing Pages"]
  },
  {
    company: "Đi Làm Đừng Đi Lầm",
    logo: "/assets/logos/logo-dlddl.png",
    role: "Co-Founder & Community Lead",
    period: "2023 — Present",
    type: "Career Guidance Community",
    location: "Vietnam",
    description: "Co-led a career community for early professionals, shaping content, audience growth, and practical guidance around first jobs and workplace decisions.",
    achievements: [
      "Scaled community to 1,000,000+ members within 12 months.",
      "Organized career orientation series and resume review sessions.",
      "Established community collaboration loops without paid media spend."
    ],
    tools: ["Community Strategy", "Social Media", "Content Production"]
  },
  {
    company: "Đại Học Đừng Học Đại",
    logo: "/assets/logos/logo-community.png",
    role: "Co-Founder & Community Lead",
    period: "2021 — Present",
    type: "Youth Education Network",
    location: "Vietnam",
    description: "Co-founded an education community helping students choose schools, majors, and long-term career directions through positioning, content strategy, and peer-led discussion.",
    achievements: [
      "Grew to 3,000,000+ active members across Vietnam.",
      "Partnered with 8+ leading universities (UEH, FTU, FPT, RMIT, HCMUT, etc.).",
      "Created viral educational content formats reaching tens of millions of views."
    ],
    tools: ["Audience Growth", "Brand Architecture", "Partnerships"]
  },
  {
    company: "PlayAh!",
    logo: "/assets/logos/logo-playah.webp",
    role: "Performance Senior Executive",
    period: "2024 — 2026",
    type: "E-Commerce Retainer",
    location: "Saigon",
    description: "Scaled e-commerce acquisition across TikTok Shop, website, and Facebook by connecting KOC booking, paid media, creative testing, and AI-assisted conversion flows.",
    achievements: [
      "Scaled TikTok Shop revenue to 1B+ VND monthly.",
      "Increased website revenue by 10x in 2 months with ROAS > 10.",
      "Automated Facebook Messenger AI funnels boosting sales by 300%."
    ],
    tools: ["TikTok Ads", "TikTok Shop", "Meta Ads", "Google Ads", "AI Funnels"]
  },
  {
    company: "Asia Strategic Holdings",
    logo: "/assets/logos/logo-asia-strategic.png",
    role: "Performance Marketing",
    period: "2025 — 2026",
    type: "Growth Media",
    location: "Saigon",
    description: "Supported performance marketing initiatives across growth briefs, balancing campaign setup, reporting, audience testing, and stakeholder coordination.",
    achievements: [
      "Executed targeted paid acquisition across multi-channel portfolios.",
      "Standardized weekly performance attribution reporting dashboards.",
      "Coordinated cross-team deliverables between creative and media buyers."
    ],
    tools: ["Google Ads", "Meta Ads", "Attribution Auditing"]
  },
  {
    company: "Vinh Cara",
    logo: "/assets/logos/logo-vinhcara.png",
    role: "Digital Marketing Specialist",
    period: "2024 — 2025",
    type: "Luxury Retail",
    location: "Saigon",
    description: "Handled digital marketing execution across campaign operations, creative coordination, acquisition tracking, and day-to-day performance improvements.",
    achievements: [
      "Orchestrated product launch promotions and high-intent local campaigns.",
      "Optimized retail lead generation funnels and showroom foot-traffic ads."
    ],
    tools: ["Performance Media", "Creative Tracking", "Google Search"]
  },
  {
    company: "TOMATO Children's Home",
    logo: "/assets/logos/logo-tomato.webp",
    role: "Digital Marketing Executive",
    period: "2023 — 2024",
    type: "Early Childhood Education",
    location: "Saigon",
    description: "Ran integrated marketing across paid media, social, landing pages, OOH, CRM, and email automation to improve enrollment efficiency.",
    achievements: [
      "Tripled monthly student enrollments while cutting CPL by 60%.",
      "Automated lifecycle email nurturing system with 40,000+ contacts (>60% open rate).",
      "Achieved +85% CTR improvement across landing pages and social campaigns."
    ],
    tools: ["Meta Ads", "Email Automation", "CRM", "Landing Pages"]
  },
  {
    company: "POPS Worldwide",
    logo: "/assets/logos/logo-pops.webp",
    role: "Search Engine Optimization Executive",
    period: "2022 — 2023",
    type: "Digital Entertainment",
    location: "Southeast Asia (Saigon HQ)",
    description: "Built SEO strategy across entertainment and education products, partnering with data, product, and technology teams on technical roadmaps and organic growth.",
    achievements: [
      "Scaled monthly active users (MAU) of POPS.VN by 10x YoY, reaching 2.5 million.",
      "Successfully launched POPS Kids gaining 400,000 users in first 6 months.",
      "Built unified Business Intelligence dashboards for real-time organic KPI tracking."
    ],
    tools: ["Technical SEO", "Ahrefs", "Google Analytics 4", "Looker Studio"]
  }
];

const skillClusters = [
  {
    title: "Performance & Paid Acquisition",
    items: ["Meta Ads & CAPI", "Google Search & PMax", "TikTok Ads & Spark Ads", "ROAS Scaling & CAC Guardrails", "Budget Allocation Modeling"]
  },
  {
    title: "Analytics & Tracking Architecture",
    items: ["GA4 Server-Side GTM", "Custom Event Schema", "Looker Studio Dashboards", "Attribution Modeling", "Funnel Drop-off Auditing"]
  },
  {
    title: "Conversion Rate Optimization (CRO)",
    items: ["Astro/React Headless Landing Pages", "Cart Drawer Optimization", "A/B Testing Loops", "Creative Angle Testing", "Checkout Friction Elimination"]
  },
  {
    title: "Community & Creator Strategy",
    items: ["KOC/Creator Booking Briefs", "Viral Organic Loops", "Advocacy & Forum Seeding", "Sentiment Management", "Campus Partnership Outreach"]
  }
];
---

<DashboardLayout
  title="Resume — Phuc Loc Nguyen"
  pageTitle="Resume"
  description="Resume of Phuc Loc Nguyen (Nguyen Phuc Loc), including FPT University education, performance marketing experience, community growth, tools, and skill clusters."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Resume" }]}
  maxWidthVariant="default"
  pageType="ProfilePage"
  ogType="profile"
  schema={resumeSchema}
>
  <header class="page-header">
    <h1 class="page-title">Resume</h1>
    <p class="page-lead">
      Education, selected experience, notable contributions, and working areas across performance marketing, community growth, SEO, analytics, and conversion strategy.
    </p>
  </header>

  <section class="page-section" aria-label="Education">
    <div class="dash-callout">
      <div class="dash-callout-icon">
        <GraduationCap size={18} aria-hidden="true" />
      </div>
      <div class="dash-callout-content">
        <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
          <div style="font-weight: 600; color: var(--dash-text);">FPT University</div>
          <span style="font-size: var(--text-caption); color: var(--dash-muted);">2019 — 2023 · Ho Chi Minh City</span>
        </div>
        <div style="font-size: var(--text-body-sm); font-weight: 500; color: var(--dash-link-hover, #0969DA); margin: 2px 0 6px;">
          Bachelor of Digital Marketing · Graduated with Honors
        </div>
        <p style="margin: 0; font-size: var(--text-body-sm); color: var(--dash-muted); line-height: var(--leading-body);">
          Cumulative GPA: <strong style="color: var(--dash-text);">9.4 / 10</strong>. Specialization in digital marketing economics, customer acquisition modeling, and media data analytics.
        </p>
      </div>
    </div>
  </section>

  <section id="career-timeline" class="page-section" aria-label="Chronological Employment History">
    <h2 class="section-title">Selected experience</h2>

    <div class="experience-list">
      {experiences.map((exp) => (
        <article class="experience-item">
          <div class="experience-logo" aria-hidden="true">
            <img src={exp.logo} alt="" loading="lazy" decoding="async" />
          </div>

          <div class="experience-content">
            <div class="experience-head">
              <div>
                <h3 class="item-title experience-role">{exp.role}</h3>
                <span class="experience-sep">·</span>
                <span class="experience-company">{exp.company}</span>
              </div>
              <span class="experience-period">{exp.period}</span>
            </div>

            <div class="experience-meta">
              {exp.type} · {exp.location}
            </div>

            <p class="content-description experience-desc">
              {exp.description}
            </p>

            <div class="experience-box">
              <div class="experience-box-label">
                Notable contributions
              </div>
              <ul class="experience-achievements">
                {exp.achievements.map((ach) => (
                  <li>
                    <span class="dash-bullet" aria-hidden="true"></span>
                    <span>{ach}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="experience-tags">
              {exp.tools.map((t) => (
                <span class="dash-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="skill-clusters" class="page-section" aria-label="Core Competencies">
    <h2 class="section-title">Working areas</h2>

    <div class="skill-cluster-grid">
      {skillClusters.map((cluster) => (
        <div class="dash-card skill-cluster-card">
          <h3 class="item-title skill-cluster-title">
            {cluster.title}
          </h3>
          <ul class="skill-cluster-list">
            {cluster.items.map((item) => (
              <li>
                <span class="skill-cluster-dot" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</DashboardLayout>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .experience-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    border-bottom: var(--dash-border-width, 1px) solid var(--dash-border);
    padding-bottom: var(--space-6);
  }

  .experience-logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    box-sizing: border-box;
    padding: 7px;
    overflow: hidden;
    border: 1px solid var(--dash-card-border, rgba(10, 10, 10, 0.1));
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
  }

  .experience-logo img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .experience-content {
    min-width: 0;
  }

  .experience-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }

  .experience-role {
    font-size: calc(var(--text-body) + 3px);
    display: inline;
    margin: 0;
  }

  .experience-sep {
    color: var(--dash-muted);
    margin: 0 6px;
  }

  .experience-company {
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    color: var(--dash-link-hover);
  }

  .experience-period {
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--dash-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .experience-meta {
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
    margin-bottom: 10px;
  }

  .experience-desc {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    margin: 0 0 12px;
  }

  .experience-box {
    margin-bottom: 12px;
    padding: 14px 18px;
    background: var(--color-ivory);
    border-radius: 12px;
    border: 1px solid var(--dash-card-border, rgba(10, 10, 10, 0.08));
  }

  .experience-box-label {
    font-size: var(--text-micro);
    font-weight: var(--font-weight-semibold);
    color: var(--color-fog);
    text-transform: uppercase;
    margin-bottom: 6px;
    letter-spacing: var(--tracking-caps);
  }

  .experience-achievements,
  .skill-cluster-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .experience-achievements li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--dash-text);
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .skill-cluster-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .skill-cluster-card {
    padding: var(--space-5);
  }

  .skill-cluster-title {
    font-size: calc(var(--text-h4) + 3px);
    margin: 0 0 var(--space-2);
  }

  .skill-cluster-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--dash-muted);
  }

  .skill-cluster-dot {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--dash-border-strong);
  }

  @media (max-width: 1100px) {
    .skill-cluster-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .experience-item {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
    }

    .experience-logo {
      width: 40px;
      height: 40px;
      padding: 6px;
    }

    .skill-cluster-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
