---
// showcase.astro --- Scroll-driven 3D photo card animation
import { optimizePhotos } from "../lib/photo-assets";

const showcaseSrcs = (
  await optimizePhotos(
    [1, 4, 6, 9, 12, 16, 19, 22, 25, 28, 31, 34].map((number) => ({
      src: `/assets/photos/img-portfolio/photo-${number}.webp`,
      alt: `Showcase photo ${number}`,
      w: 0,
      h: 0,
    })),
    {
      previewWidth: 960,
      previewWidths: [640, 960],
      previewSizes: "960px",
      fullQuality: 84,
    },
  )
).map((photo) => photo.previewSrc);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Showcase --- Phuc Loc Nguyen</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link id="dynamic-favicon" rel="icon" type="image/svg+xml" href="/favicon-active.svg" />
  <script is:inline>
    function syncFavicon() {
      const favicon = document.getElementById("dynamic-favicon");
      if (favicon) {
        favicon.href = document.hidden || !document.hasFocus()
          ? "/favicon-inactive.svg"
          : "/favicon-active.svg";
      }
    }

    document.addEventListener("visibilitychange", syncFavicon);
    window.addEventListener("focus", syncFavicon);
    window.addEventListener("blur", syncFavicon);
    syncFavicon();
  </script>
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

    html { scroll-behavior: auto; }

    body {
      background: #06060a;
      font-family: var(--sans);
      overflow-x: hidden;
    }

    /* ------ Scroll driver: 500vh gives plenty of scroll room ------ */
    #scroll-driver {
      height: 500vh;
      position: relative;
    }

    /* ------ Sticky viewport ------ */
    #sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      width: 100%;
      overflow: hidden;
    }

    #c {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* ------ HUD ------ */
    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 5;
    }

    /* Back nav */
    #back {
      position: fixed;
      top: 28px;
      left: 36px;
      font-size: var(--type-caption);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.38);
      text-decoration: none;
      pointer-events: all;
      z-index: 20;
      transition: color .3s;
    }
    #back:hover { color: #0075de; }

    /* Phase indicator dots */
    #phases {
      position: fixed;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 20;
      pointer-events: none;
    }
    .phase-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      transition: background .5s, transform .5s;
    }
    .phase-dot.active {
      background: rgba(255,255,255,0.85);
      transform: scale(1.5);
    }

    /* Phase label */
    #phase-label {
      position: fixed;
      bottom: 44px;
      left: 50%;
      transform: translateX(-50%);
      font-size: var(--type-micro);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      transition: opacity .6s;
    }

    /* Scroll hint */
    #hint {
      position: fixed;
      bottom: 72px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      opacity: 1;
      transition: opacity 1s ease;
    }
    #hint span {
      font-size: var(--type-micro);
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.28);
    }
    #hint .bar {
      width: 1px;
      height: 36px;
      background: linear-gradient(to bottom, rgba(255,255,255,.45) 0%, transparent 100%);
      animation: barPulse 2s ease-in-out infinite;
    }
    @keyframes barPulse {
      0%,100% { opacity:.25; transform:scaleY(1); }
      50%      { opacity:1;   transform:scaleY(1.15); }
    }
    #hint.gone { opacity: 0; pointer-events:none; }

    /* Loading overlay */
    #loading {
      position: fixed;
      inset: 0;
      background: #06060a;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      transition: opacity 1s ease;
    }
    #loading.out { opacity: 0; pointer-events: none; }
    #loading-ring {
      width: 32px;
      height: 32px;
      border: 1.5px solid rgba(255,255,255,0.12);
      border-top-color: rgba(255,255,255,0.6);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

  <a href="/gallery" id="back">- Gallery</a>

  <div id="phases">
    <div class="phase-dot active" data-ph="0"></div>
    <div class="phase-dot" data-ph="1"></div>
    <div class="phase-dot" data-ph="2"></div>
    <div class="phase-dot" data-ph="3"></div>
    <div class="phase-dot" data-ph="4"></div>
  </div>

  <div id="phase-label">Scatter</div>

  <div id="scroll-driver">
    <div id="sticky">
      <canvas id="c"></canvas>
      <div id="hud"></div>
    </div>
  </div>

  <div id="hint">
    <div class="bar"></div>
    <span>Scroll</span>
  </div>

  <div id="loading"><div id="loading-ring"></div></div>

  <!-- Three.js r165 UMD --- works in all browsers without importmap -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.min.js"></script>

  <script is:inline define:vars={{ showcaseSrcs }}>
  (function () {
    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       CONFIG
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var SRCS = showcaseSrcs;

    var N        = SRCS.length;
    var CW       = 1.52;   // card width
    var CH       = 1.00;   // card height (landscape)
    var PHASES   = ['Scatter','Alignment','Circle','Arc','Gallery'];

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       RENDERER
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var canvas   = document.getElementById('c');
    var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.toneMapping       = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.outputColorSpace  = THREE.SRGBColorSpace;

    var scene = new THREE.Scene();
    scene.background = new THREE.Color(0x06060a);
    scene.fog = new THREE.FogExp2(0x06060a, 0.048);

    var camera = new THREE.PerspectiveCamera(52, window.innerWidth / window.innerHeight, 0.1, 120);
    camera.position.set(0, 0, 10);

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       LIGHTS
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    scene.add(new THREE.AmbientLight(0xffffff, 0.18));

    var key = new THREE.DirectionalLight(0xd6ecff, 1.4);
    key.position.set(6, 10, 7);
    scene.add(key);

    var rim = new THREE.DirectionalLight(0xfff0d8, 0.55);
    rim.position.set(-7, -4, -5);
    scene.add(rim);

    var fill = new THREE.PointLight(0x8090ff, 0.3, 30);
    fill.position.set(0, 0, 8);
    scene.add(fill);

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       SEEDED RNG
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    function rng(seed) {
      var s = seed | 0;
      return function () {
        s = (s ^ (s << 13)) | 0;
        s = (s ^ (s >> 17)) | 0;
        s = (s ^ (s << 5))  | 0;
        return (s >>> 0) / 4294967296;
      };
    }

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       TARGET POSITIONS PER PHASE
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    function posScatter(i) {
      var r = rng(i * 3571 + 17);
      return new THREE.Vector3(
        (r() - 0.5) * 20,
        (r() - 0.5) * 11,
        (r() - 0.5) * 14 - 3
      );
    }
    function rotScatter(i) {
      var r = rng(i * 5003 + 41);
      return { x: (r()-0.5)*0.55, y: (r()-0.5)*0.7, z: (r()-0.5)*0.45 };
    }

    function posLine(i) {
      var span = (N - 1) * 1.72;
      return new THREE.Vector3(i * 1.72 - span * 0.5, 0, 0);
    }

    function posCircle(i) {
      var a = (i / N) * Math.PI * 2 - Math.PI * 0.5;
      var r = 4.4;
      return new THREE.Vector3(Math.cos(a) * r, Math.sin(a) * r, 0);
    }
    function rotCircle(i) {
      var a = (i / N) * Math.PI * 2 - Math.PI * 0.5;
      return { x: 0, y: 0, z: a + Math.PI * 0.5 };
    }

    function posArc(i) {
      var t = i / (N - 1) - 0.5;
      var a = t * Math.PI * 1.25;
      var r = 5.6;
      return new THREE.Vector3(
        Math.sin(a) * r,
        Math.cos(a) * r * -0.42 + 1.8,
        0
      );
    }
    function rotArc(i) {
      var t = i / (N - 1) - 0.5;
      return { x: 0, y: t * 0.5, z: 0 };
    }

    function posGallery(i, offset) {
      offset = offset || 0;
      var t  = i / (N - 1) - 0.5;
      var a  = t * Math.PI * 1.35 + offset;
      var r  = 5.8;
      return new THREE.Vector3(
        Math.sin(a) * r,
        Math.cos(a) * r * -0.3 + 2.0,
        Math.sin(a * 2) * 0.7
      );
    }

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       BUILD CARDS
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var geo     = new THREE.PlaneGeometry(CW, CH, 1, 1);
    var loader  = new THREE.TextureLoader();
    var cards   = [];
    var loaded  = 0;
    var loading = document.getElementById('loading');
    var hint    = document.getElementById('hint');

    SRCS.forEach(function (src, i) {
      loader.load(src, function (tex) {
        tex.colorSpace     = THREE.SRGBColorSpace;
        tex.anisotropy     = renderer.capabilities.getMaxAnisotropy();
        tex.generateMipmaps = true;
        tex.minFilter      = THREE.LinearMipmapLinearFilter;

        var mat  = new THREE.MeshStandardMaterial({
          map:       tex,
          roughness: 0.1,
          metalness: 0.04,
        });
        var mesh = new THREE.Mesh(geo, mat);

        var sp = posScatter(i);
        var sr = rotScatter(i);
        mesh.position.copy(sp);
        mesh.rotation.set(sr.x, sr.y, sr.z);
        scene.add(mesh);

        /* Spring state: current + velocity per axis */
        cards[i] = {
          mesh: mesh,
          i:    i,
          // Current state (spring origin)
          cx: sp.x, cy: sp.y, cz: sp.z,
          crx: sr.x, cry: sr.y, crz: sr.z,
          csx: 1, csy: 1,        // scale
          // Velocities
          vx: 0, vy: 0, vz: 0,
          vrx: 0, vry: 0, vrz: 0,
          vsx: 0, vsy: 0,
        };

        loaded++;
        if (loaded === N) {
          // All textures ready - fade out loading screen
          loading.classList.add('out');
        }
      });
    });

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       SCROLL
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var scrollT  = 0;   // raw 0..1
    var smoothT  = 0;   // low-pass filtered

    function syncScrollProgress() {
      var el  = document.getElementById('scroll-driver');
      var max = el.scrollHeight - window.innerHeight;
      scrollT = max > 0 ? window.scrollY / max : 0;
    }

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       HELPERS
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    function lerp(a, b, t) { return a + (b - a) * t; }

    function easeIO(t) {
      // Smooth-step-3
      t = Math.max(0, Math.min(1, t));
      return t * t * t * (t * (t * 6 - 15) + 10);
    }

    // Spring: returns new {val, vel}
    function spr(cur, vel, target, k, d) {
      var f = (target - cur) * k;
      var nv = vel * d + f;
      return { val: cur + nv, vel: nv };
    }

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       PHASE HUD
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var dots      = document.querySelectorAll('.phase-dot');
    var phLabel   = document.getElementById('phase-label');
    var lastPhIdx = -1;

    function updateHUD(phIdx) {
      if (phIdx === lastPhIdx) return;
      lastPhIdx = phIdx;
      dots.forEach(function (d, j) {
        d.classList.toggle('active', j === phIdx);
      });
      phLabel.textContent = PHASES[Math.min(phIdx, PHASES.length - 1)];
      if (phIdx > 0) hint.classList.add('gone');
    }

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       CAMERA SPRING STATE
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var cam = { x: 0, y: 0, z: 10, lx: 0, ly: 0 };
    var camV = { x: 0, y: 0, z: 0 };

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       ANIMATION LOOP
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    var clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);

      var t  = clock.getElapsedTime();

      if (loaded < N) { renderer.render(scene, camera); return; }

      /* Smooth scroll time */
      syncScrollProgress();
      smoothT += (scrollT - smoothT) * 0.055;

      /* phaseBlend: 0 = scatter -- 4 = gallery (continuous float) */
      var pb = smoothT * 4;
      var phIdx = Math.min(Math.floor(pb + 0.1), 4);
      updateHUD(phIdx);

      /* ------ Camera target ------ */
      var ctX, ctY, ctZ, lookY;

      if (pb < 1) {
        /* SCATTER: slow cinematic drift */
        ctX = Math.sin(t * 0.11) * 0.7;
        ctY = Math.cos(t * 0.08) * 0.35;
        ctZ = 10;
        lookY = 0;
      } else if (pb < 2) {
        /* LINE: pull back, slight elevation */
        var f = easeIO(pb - 1);
        ctX = Math.sin(t * 0.07) * 0.4;
        ctY = lerp(0, 0.5, f);
        ctZ = lerp(10, 9, f);
        lookY = lerp(0, 0.3, f);
      } else if (pb < 3) {
        /* CIRCLE: orbit around formation */
        var f = easeIO(pb - 2);
        var orb = f * 0.7;
        ctX = Math.sin(orb) * 4.5;
        ctZ = Math.cos(orb) * 4.5 + 7;
        ctY = lerp(0.5, 1.8, f);
        lookY = lerp(0.3, 0.6, f);
      } else if (pb < 4) {
        /* ARC: dolly back, tilt up */
        var f = easeIO(pb - 3);
        ctX = lerp(Math.sin(0.7) * 4.5, 0, f);
        ctZ = lerp(Math.cos(0.7) * 4.5 + 7, 9.5, f);
        ctY = lerp(1.8, 1.4, f);
        lookY = lerp(0.6, 1.5, f);
      } else {
        /* GALLERY: slow dolly side to side */
        ctX = Math.sin(t * 0.045) * 1.8;
        ctZ = 9.5;
        ctY = 1.4;
        lookY = 1.5;
      }

      /* Spring camera */
      var r = spr(cam.x, camV.x, ctX, 0.038, 0.88);
      cam.x = r.val; camV.x = r.vel;
      r = spr(cam.y, camV.y, ctY, 0.038, 0.88);
      cam.y = r.val; camV.y = r.vel;
      r = spr(cam.z, camV.z, ctZ, 0.038, 0.88);
      cam.z = r.val; camV.z = r.vel;

      camera.position.set(cam.x, cam.y, cam.z);
      camera.lookAt(0, lookY || 0, 0);

      /* ------ Update each card ------ */
      cards.forEach(function (card) {
        if (!card) return;
        var i = card.i;

        /* --- Determine target state --- */
        var phase = Math.floor(pb);
        var frac  = easeIO(pb - phase);
        phase = Math.min(phase, 3);

        /* Positions at boundary phases */
        var positions = [posScatter(i), posLine(i), posCircle(i), posArc(i), posGallery(i)];

        /* Rotations */
        var rots = [
          rotScatter(i),
          { x:0, y:0, z:0 },
          rotCircle(i),
          rotArc(i),
          { x:0, y:(i/(N-1)-0.5)*0.6, z:0 },
        ];

        /* Floating wobble in scatter phase only */
        var rr = rng(i * 997 + 3);
        var fOff = rr() * Math.PI * 2;
        var wobble = Math.max(0, 1.0 - pb) * 0.22;

        var posA = positions[phase];
        var posB = positions[Math.min(phase+1, 4)];
        var rotA = rots[phase];
        var rotB = rots[Math.min(phase+1, 4)];

        var tx = lerp(posA.x, posB.x, frac) + Math.sin(t * 0.38 + fOff) * wobble * 0.5;
        var ty = lerp(posA.y, posB.y, frac) + Math.sin(t * 0.29 + fOff + 1) * wobble;
        var tz = lerp(posA.z, posB.z, frac);
        var trx = lerp(rotA.x, rotB.x, frac);
        var try_ = lerp(rotA.y, rotB.y, frac);
        var trz = lerp(rotA.z, rotB.z, frac);

        /* In gallery phase, the entire arc slowly spins */
        if (pb > 3.6) {
          var gf  = Math.min(1, (pb - 3.6) / 0.4);
          var spinOffset = t * 0.055 * gf;
          var gp  = posGallery(i, spinOffset);
          tx = lerp(tx, gp.x, gf);
          ty = lerp(ty, gp.y, gf);
          tz = lerp(tz, gp.z, gf);
          var gRotY = (i / (N-1) - 0.5) * 0.65 + spinOffset;
          try_ = lerp(try_, gRotY, gf);
        }

        /* Scale: cards grow slightly in arc - gallery */
        var targetScale = pb < 2.5 ? 1.0 : lerp(1.0, 1.14, (pb - 2.5) / 1.5);

        /* Spring toward targets --- tighter spring after scatter */
        var k = pb < 0.5 ? 0.032 : 0.062;
        var d = 0.87;

        var rx; 
        rx = spr(card.cx, card.vx, tx, k, d); card.cx = rx.val; card.vx = rx.vel;
        rx = spr(card.cy, card.vy, ty, k, d); card.cy = rx.val; card.vy = rx.vel;
        rx = spr(card.cz, card.vz, tz, k, d); card.cz = rx.val; card.vz = rx.vel;
        rx = spr(card.crx, card.vrx, trx, k, d); card.crx = rx.val; card.vrx = rx.vel;
        rx = spr(card.cry, card.vry, try_, k, d); card.cry = rx.val; card.vry = rx.vel;
        rx = spr(card.crz, card.vrz, trz, k, d); card.crz = rx.val; card.vrz = rx.vel;
        rx = spr(card.csx, card.vsx, targetScale, 0.08, 0.85); card.csx = rx.val; card.vsx = rx.vel;

        card.mesh.position.set(card.cx, card.cy, card.cz);
        card.mesh.rotation.set(card.crx, card.cry, card.crz);
        card.mesh.scale.setScalar(card.csx);
      });

      renderer.render(scene, camera);
    }

    animate();

    /* ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
       RESIZE
    --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    window.addEventListener('resize', function () {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

  })();
  </script>
</body>
</html>
