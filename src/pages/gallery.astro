---
import Layout from "../layouts/Layout.astro";
import { locations } from "../lib/locations";
import { MASONRY_GRID_SIZES, optimizePhotos } from "../lib/photo-assets";

// Flatten all photos from all locations
const allPhotos = locations.flatMap(loc =>
  loc.photos.map((photo, i) => ({
    ...photo,
    alt: `${loc.name} --- photo ${i + 1}`
  }))
);

// Deduplicate photos by src
const uniqueRawPhotos = Array.from(
  new Map(allPhotos.map(p => [p.src, p])).values()
);

const uniquePhotos = await optimizePhotos(uniqueRawPhotos, {
  previewWidth: 520,
  previewWidths: [240, 360, 520, 760],   // tighter --- masonry columns max ~520px each
  previewSizes: MASONRY_GRID_SIZES,
  fullQuality: 75,
  withWebpFallback: true,
});
---

<Layout title="Gallery --- Phuc Loc Nguyen">
  <main class="gallery-page">
    <div id="gallery-grid" class="gallery-grid"></div>
    <div id="loading-trigger" style="height:1px;width:100%;"></div>
  </main>

  <style>
    .gallery-page {
      min-height: 100vh;
      background: transparent;
      padding: 8px;
      padding-top: 80px;
      width: 100%;
      margin: 0;
    }

    .gallery-grid {
      display: flex;
      gap: 3px;
      width: 100%;
      align-items: flex-start;
    }

    :global(.gallery-col) {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    :global(.gal-item) {
      width: 100%;
      overflow: hidden;
      border-radius: 4px;
      background: #ddd;
    }

    /* The aspect-ratio box --- padding-bottom locks each image to its real ratio */
    :global(.gal-item .ratio-box) {
      position: relative;
      width: 100%;
      height: 0;
      overflow: hidden;
    }

    :global(.gal-item .ratio-box img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    :global(.gal-item:hover .ratio-box img) {
      transform: scale(1.04);
    }
  </style>

  <script is:inline define:vars={{ uniquePhotos }}>
    (function () {
      var photos = uniquePhotos;
      var grid = document.getElementById('gallery-grid');
      var trigger = document.getElementById('loading-trigger');
      var cols = 6;
      var colEls = [];
      var colH = [];   // logical height tracker (sum of h/w ratios)
      var batchSize = 15;
      var currentIndex = 0;

      function numCols() {
        var w = window.innerWidth;
        if (w < 600) return 2;
        if (w < 900) return 3;
        if (w < 1200) return 4;
        return 6;
      }

      function initCols() {
        if (!grid) return;
        grid.innerHTML = '';
        colEls = [];
        colH = [];
        cols = numCols();
        for (var i = 0; i < cols; i++) {
          var c = document.createElement('div');
          c.className = 'gallery-col';
          grid.appendChild(c);
          colEls.push(c);
          colH.push(0);
        }
      }

      function addNextBatch() {
        if (currentIndex >= photos.length) return;
        var end = Math.min(currentIndex + batchSize, photos.length);
        for (var i = currentIndex; i < end; i++) {
          var photo = photos[i];

          // find shortest column
          var min = 0;
          for (var j = 1; j < cols; j++) {
            if (colH[j] < colH[min]) min = j;
          }

          var pw = photo.previewWidth || photo.w || 1280;
          var ph = photo.previewHeight || photo.h || 853;
          var ratio = ph / pw;                    // e.g. portrait -> 1.5, landscape -> 0.667
          var pb = (ratio * 100).toFixed(3) + '%'; // padding-bottom %

          var item = document.createElement('div');
          item.className = 'gal-item';

          var box = document.createElement('div');
          box.className = 'ratio-box';
          box.style.paddingBottom = pb;          // - this locks in natural height

          var img = document.createElement('img');
          img.src = photo.previewSrc || photo.src;
          if (photo.previewSrcSet) img.srcset = photo.previewSrcSet;
          if (photo.previewSizes) img.sizes = photo.previewSizes;
          img.alt = photo.alt;
          img.loading = 'lazy';
          img.decoding = 'async';
          img.width = pw;
          img.height = ph;

          box.appendChild(img);
          item.appendChild(box);
          colEls[min].appendChild(item);

          colH[min] += ratio;   // accumulate logical height
        }
        currentIndex = end;
      }

      // Run immediately (script is deferred by is:inline)
      initCols();
      addNextBatch();

      // Infinite scroll
      if (trigger) {
        var io = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting && currentIndex < photos.length) {
            addNextBatch();
          }
        }, { rootMargin: '800px' });
        io.observe(trigger);
      }

      // Responsive reflow - re-add only the photos that are already loaded
      var resizeT;
      window.addEventListener('resize', function () {
        clearTimeout(resizeT);
        resizeT = setTimeout(function () {
          var n = numCols();
          if (n !== cols) {
            var loadedPhotosCount = currentIndex;
            initCols();
            currentIndex = 0;
            
            var originalBatchSize = batchSize;
            batchSize = loadedPhotosCount;
            addNextBatch();
            batchSize = originalBatchSize;
          }
        }, 250);
      });
    })();
  </script>
</Layout>
