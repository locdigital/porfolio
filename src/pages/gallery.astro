---
import Layout from "../layouts/Layout.astro";
import { locations } from "../lib/locations";

// Flatten all photos from all locations
const allPhotos = locations.flatMap(loc =>
  loc.photos.map((photo, i) => ({
    ...photo,
    alt: `${loc.name} — photo ${i + 1}`
  }))
);

// Deduplicate photos by src
const uniquePhotos = Array.from(
  new Map(allPhotos.map(p => [p.src, p])).values()
);
---

<Layout title="Gallery — Phuc Loc Nguyen">
  <main class="gallery-page">
    <div id="gallery-grid" class="gallery-grid"></div>
    <div id="loading-trigger" style="height:1px;width:100%;"></div>
  </main>

  <style>
    .gallery-page {
      min-height: 100vh;
      background: #fdfdfd;
      padding: 8px;
      padding-top: 80px;
      width: 100%;
      margin: 0;
    }

    .gallery-grid {
      display: flex;
      gap: 3px;
      width: 100%;
      align-items: flex-start;
    }

    :global(.gallery-col) {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    :global(.gal-item) {
      width: 100%;
      overflow: hidden;
      border-radius: 4px;
      background: #ddd;
    }

    /* The aspect-ratio box — padding-bottom locks each image to its real ratio */
    :global(.gal-item .ratio-box) {
      position: relative;
      width: 100%;
      height: 0;
      overflow: hidden;
    }

    :global(.gal-item .ratio-box img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    :global(.gal-item:hover .ratio-box img) {
      transform: scale(1.04);
    }
  </style>

  <script is:inline define:vars={{ uniquePhotos }}>
    (function () {
      var photos = uniquePhotos;
      var grid = document.getElementById('gallery-grid');
      var trigger = document.getElementById('loading-trigger');
      var cols = 6;
      var colEls = [];
      var colH = [];   // logical height tracker (sum of h/w ratios)

      function numCols() {
        var w = window.innerWidth;
        if (w < 600) return 2;
        if (w < 900) return 3;
        if (w < 1200) return 4;
        return 6;
      }

      function initCols() {
        if (!grid) return;
        grid.innerHTML = '';
        colEls = [];
        colH = [];
        cols = numCols();
        for (var i = 0; i < cols; i++) {
          var c = document.createElement('div');
          c.className = 'gallery-col';
          grid.appendChild(c);
          colEls.push(c);
          colH.push(0);
        }
      }

      function addPhotos(list) {
        for (var i = 0; i < list.length; i++) {
          var photo = list[i];

          // find shortest column
          var min = 0;
          for (var j = 1; j < cols; j++) {
            if (colH[j] < colH[min]) min = j;
          }

          var pw = photo.w || 1280;
          var ph = photo.h || 853;
          var ratio = ph / pw;                    // e.g. portrait → 1.5, landscape → 0.667
          var pb = (ratio * 100).toFixed(3) + '%'; // padding-bottom %

          var item = document.createElement('div');
          item.className = 'gal-item';

          var box = document.createElement('div');
          box.className = 'ratio-box';
          box.style.paddingBottom = pb;          // ← this locks in natural height

          var img = document.createElement('img');
          img.src = photo.src;
          img.alt = photo.alt;
          img.loading = 'lazy';
          img.decoding = 'async';

          box.appendChild(img);
          item.appendChild(box);
          colEls[min].appendChild(item);

          colH[min] += ratio;   // accumulate logical height
        }
      }

      // Run immediately (script is deferred by is:inline)
      initCols();
      addPhotos(photos);

      // Infinite scroll
      if (trigger) {
        var io = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            addPhotos(photos);
          }
        }, { rootMargin: '800px' });
        io.observe(trigger);
      }

      // Responsive reflow
      var resizeT;
      window.addEventListener('resize', function () {
        clearTimeout(resizeT);
        resizeT = setTimeout(function () {
          var n = numCols();
          if (n !== cols) {
            initCols();
            addPhotos(photos);
          }
        }, 250);
      });
    })();
  </script>
</Layout>
