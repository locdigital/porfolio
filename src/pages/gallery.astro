---
import Layout from "../layouts/Layout.astro";
import { locations } from "../lib/locations";

// Unique photos (deduplicated by src)
const uniquePhotos = Array.from(
  new Map(
    locations.flatMap(loc => loc.photos).map(photo => [photo.src, photo])
  ).values()
);
---

<Layout title="Gallery — Phuc Loc Nguyen">
  <main class="gallery-page">
    <div id="gallery-container" class="gallery-container">
      <div id="gallery-canvas" class="gallery-canvas">
        {uniquePhotos.map((photo, index) => (
          <div
            class="gallery-item"
            data-w={photo.w}
            data-h={photo.h}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              loading={index < 16 ? "eager" : "lazy"}
              draggable="false"
            />
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .gallery-page {
    position: fixed;
    inset: 0;
    background: #fff;
    overflow: hidden;
  }

  .gallery-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
  }

  .gallery-container:active {
    cursor: grabbing;
  }

  /* Canvas is absolutely positioned for JS masonry */
  .gallery-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    /* height set by JS */
    will-change: transform;
  }

  .gallery-item {
    position: absolute;
    overflow: hidden;
    /* top/left/width/height set by JS */
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gallery-item:hover img {
    transform: scale(1.04);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('gallery-container');
    const canvas = document.getElementById('gallery-canvas');
    if (!container || !canvas) return;

    const GAP = 5; // px gap between images

    function getColumnCount() {
      const w = window.innerWidth;
      if (w <= 480) return 2;
      if (w <= 768) return 3;
      if (w <= 1200) return 4;
      return 5;
    }

    function buildMasonry() {
      const items = Array.from(canvas.querySelectorAll('.gallery-item'));
      const cols = getColumnCount();
      const totalWidth = canvas.offsetWidth - GAP * (cols - 1);
      const colWidth = totalWidth / cols;

      // Track bottom Y of each column
      const colHeights = new Array(cols).fill(0);

      items.forEach(item => {
        const w = parseInt(item.dataset.w) || 1;
        const h = parseInt(item.dataset.h) || 1;
        const itemHeight = Math.round(colWidth * h / w);

        // Place in shortest column
        let shortestCol = 0;
        for (let i = 1; i < cols; i++) {
          if (colHeights[i] < colHeights[shortestCol]) shortestCol = i;
        }

        const x = shortestCol * (colWidth + GAP);
        const y = colHeights[shortestCol];

        item.style.left = x + 'px';
        item.style.top = y + 'px';
        item.style.width = colWidth + 'px';
        item.style.height = itemHeight + 'px';

        colHeights[shortestCol] += itemHeight + GAP;
      });

      // Set canvas height
      const totalHeight = Math.max(...colHeights);
      canvas.style.height = totalHeight + 'px';
    }

    // Build layout immediately with known dimensions
    buildMasonry();
    window.addEventListener('resize', buildMasonry);

    // ── Smooth drag scroll ──────────────────────────────────────────────────
    let currentY = 0;
    let targetY = 0;
    let velocityY = 0;

    function getMaxScroll() {
      return -(parseInt(canvas.style.height || '0') - container.clientHeight + GAP);
    }

    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

    function tick() {
      currentY += (targetY - currentY) * 0.1;
      const maxScroll = getMaxScroll();
      currentY = clamp(currentY, maxScroll, 0);
      targetY = clamp(targetY, maxScroll, 0);
      canvas.style.transform = `translate3d(0, ${currentY}px, 0)`;
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    // Pointer drag (desktop)
    let dragging = false;
    let dragStartY = 0;
    let dragLastY = 0;

    container.addEventListener('pointerdown', (e) => {
      dragging = true;
      dragStartY = dragLastY = e.clientY;
      velocityY = 0;
      container.setPointerCapture(e.pointerId);
    });

    container.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dy = e.clientY - dragLastY;
      velocityY = dy;
      dragLastY = e.clientY;
      targetY += dy;
    });

    container.addEventListener('pointerup', () => {
      dragging = false;
      targetY += velocityY * 10; // momentum
    });

    container.addEventListener('pointercancel', () => { dragging = false; });

    // Wheel
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      targetY -= e.deltaY * 1.2;
    }, { passive: false });

    // Touch (mobile)
    let touchLastY = 0;
    let touchVelocity = 0;

    container.addEventListener('touchstart', (e) => {
      touchLastY = e.touches[0].clientY;
      touchVelocity = 0;
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      e.preventDefault();
      const dy = e.touches[0].clientY - touchLastY;
      touchVelocity = dy;
      touchLastY = e.touches[0].clientY;
      targetY += dy;
    }, { passive: false });

    container.addEventListener('touchend', () => {
      targetY += touchVelocity * 10;
    }, { passive: true });
  });
</script>
