---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getProjects } from "../../lib/cms";
import { CaretRightIcon as ChevronRight } from "@phosphor-icons/react";

export const prerender = true;

const projects = await getProjects();
const brandNames: Record<string, string> = {
  playah: "PlayAh!",
  "workflow-space": "WorkFlow Space",
  "pops-worldwide": "POPS Worldwide",
  "tomato-childrens-home": "TOMATO Children's Home",
  "education-communities": "Đại Học Đừng Học Đại",
};

// Enhanced project metadata with category grouping & key highlights:
const enhancedProjects = projects.map((p) => {
  let category = "Performance";
  
  if (p.slug === "playah") {
    category = "E-Commerce";
  } else if (p.slug === "workflow-space") {
    category = "Paid Media";
  } else if (p.slug === "pops-worldwide") {
    category = "SEO";
  } else if (p.slug === "tomato-childrens-home") {
    category = "Marketing 360";
  } else if (p.slug === "education-communities") {
    category = "Community";
  }

  return {
    ...p,
    category,
    brandName: brandNames[p.slug] ?? p.client,
  };
});
---

<DashboardLayout
  title="Selected Work — Phuc Loc Nguyen"
  pageTitle="Selected Work"
  description="Performance marketing case studies: PlayAh! TikTok Shop scaling, WorkFlow Space branch launches, POPS Worldwide SEO 10x growth, and TOMATO Children's Home."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Selected work" }]}
  maxWidthVariant="default"
>
  <!-- Page Header (Open document surface) -->
  <header class="page-header">
    <h1 class="page-title">Selected Work</h1>
    <p class="page-lead">
      Deep dives into multi-channel paid acquisition, TikTok Shop GMV acceleration, technical SEO roadmaps, and community-led organic growth.
    </p>

    <!-- Quiet Filter Toolbar -->
    <div 
      class="dash-filter-bar" 
      role="toolbar" 
      aria-label="Filter case studies by category"
      style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"
    >
      <button class="dash-filter-chip active" data-filter="all" aria-pressed="true">All (5)</button>
      <button class="dash-filter-chip" data-filter="E-Commerce" aria-pressed="false">E-Commerce</button>
      <button class="dash-filter-chip" data-filter="Paid Media" aria-pressed="false">Paid Media</button>
      <button class="dash-filter-chip" data-filter="SEO" aria-pressed="false">Technical SEO</button>
      <button class="dash-filter-chip" data-filter="Marketing 360" aria-pressed="false">Marketing 360</button>
      <button class="dash-filter-chip" data-filter="Community" aria-pressed="false">Community</button>
    </div>
  </header>

  <!-- Projects Grid (Cards reserved for browsable units) -->
  <div 
    id="projects-grid" 
    style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;"
  >
    {enhancedProjects.map((p) => (
      <article 
        class="dash-card project-item" 
        data-category={p.category}
        style="display: flex; flex-direction: column; justify-content: space-between;"
      >
        <div>
          <!-- Top metadata row -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 6px;">
              <span class="dash-tag">{p.category}</span>
            </div>
            <span style="font-size: 0.75rem; color: var(--dash-muted);">{p.year}</span>
          </div>

          <!-- Cover Image (16:10 ratio) -->
          {p.coverImage && (
            <a 
              href={`/work/${p.slug}`} 
              style="display: block; aspect-ratio: 16/10; border-radius: 6px; overflow: hidden; border: 1px solid var(--dash-border); background: #F0EFEA; margin-bottom: 14px;"
            >
              <img 
                src={p.coverImage} 
                alt={p.title} 
                style="width: 100%; height: 100%; object-fit: cover;"
                loading="lazy"
              />
            </a>
          )}

          <!-- Title -->
          <h2 class="item-title" style="margin-bottom: 8px;">
            <a href={`/work/${p.slug}`} style="color: var(--dash-text); text-decoration: none;">
              {p.brandName}
            </a>
          </h2>

          <!-- Summary -->
          <p style="font-size: 0.875rem; line-height: 1.55; color: var(--dash-muted); margin: 0 0 14px;">
            {p.summary}
          </p>

          <!-- Tags -->
          <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 16px;">
            {p.tags.slice(0, 3).map((tag: string) => (
              <span class="dash-tag">{tag}</span>
            ))}
          </div>
        </div>

        <!-- Read Action Link -->
        <div style="border-top: 1px solid var(--dash-border); padding-top: 10px; display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 0.75rem; color: var(--dash-muted);">Case Study</span>
          <a 
            href={`/work/${p.slug}`} 
            class="dash-link"
            style="font-size: 0.8125rem; font-weight: 500; display: inline-flex; align-items: center; gap: 3px;"
          >
            <span>Read breakdown</span>
            <ChevronRight size={13} aria-hidden="true" />
          </a>
        </div>
      </article>
    ))}
  </div>

  <!-- Empty state (hidden by default) -->
  <div id="projects-empty" style="display: none; padding: var(--space-8) 0; text-align: center; color: var(--dash-muted);">
    <p style="margin-bottom: 12px;">No case studies found in this category.</p>
    <button id="reset-filter-btn" class="dash-button dash-button--secondary">Reset filters</button>
  </div>
</DashboardLayout>

<script is:inline>
  function setupProjectFilters() {
    const filterButtons = document.querySelectorAll(".dash-filter-chip");
    const projectItems = document.querySelectorAll(".project-item");
    const emptyState = document.getElementById("projects-empty");
    const resetBtn = document.getElementById("reset-filter-btn");

    function applyFilter(category) {
      let visibleCount = 0;
      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute("data-category");
        if (category === "all" || itemCategory === category) {
          item.style.display = "flex";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? "block" : "none";
      }

      filterButtons.forEach((btn) => {
        const isMatch = btn.getAttribute("data-filter") === category;
        btn.classList.toggle("active", isMatch);
        btn.setAttribute("aria-pressed", isMatch ? "true" : "false");
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = btn.getAttribute("data-filter") || "all";
        applyFilter(category);
      });
    });

    resetBtn?.addEventListener("click", () => applyFilter("all"));
  }

  document.addEventListener("astro:page-load", setupProjectFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupProjectFilters();
  }
</script>
