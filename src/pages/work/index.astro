---
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/cms";
import { absoluteUrl, pageSchema } from "../../lib/seo";

const sortedProjects = await getProjects();
const workTitle = "Work | Phuc Loc Nguyen";
const workDescription = "Selected projects by Phuc Loc Nguyen: paid media scaling, TikTok Shop growth, SEO, lead generation, and community strategy.";
const workHeadline = "Selected work & <em>case studies</em>";
---

<Layout
  title={workTitle}
  description={workDescription}
  schema={[
    pageSchema({
      url: absoluteUrl("/work"),
      title: workTitle,
      description: workDescription,
      type: "CollectionPage",
    }),
    {
      "@type": "ItemList",
      "@id": `${absoluteUrl("/work")}#projects`,
      name: "Selected case studies",
      itemListElement: sortedProjects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: absoluteUrl(`/work/${project.slug}`),
        name: project.title,
        description: project.summary,
      })),
    },
  ]}
>
  <main class="gear-page">
    <div class="gear-container">

      <!-- PAGE HERO -->
      <section class="gear-hero work-hero" aria-label="My work">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">My work</span>
        </div>
        <h1 set:html={workHeadline} />
        <p class="gear-intro">
          Paid media scaling, TikTok Shop growth, technical SEO,
          lead generation, and community work across e-commerce,
          education, and entertainment.
        </p>
      </section>


      <!-- Project List -->
      <div class="project-list">
        {sortedProjects.map((project) => (
          <article class="project-row">
            <div class:list={["project-row-inner", !project.coverImage && "project-row-inner--text-only"]}>

              <!-- Left: text -->
              <div class="project-text">
                <span class="project-number">{project.number} / {project.client.toUpperCase()}</span>
                <a href={`/work/${project.slug}`} class="project-title-link">
                  <h2 class="project-name">{project.title}</h2>
                </a>
                <p class="project-summary">{project.summary}</p>

                <p class="project-tools">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </p>

                <div class="project-links">
                  <a href={`/work/${project.slug}`} class="link-primary">
                    See case study
                  </a>
                  {project.link && (
                    <a href={project.link} target="_blank" rel="noopener noreferrer" class="link-secondary">
                      {project.linkLabel ?? "Visit site"}
                    </a>
                  )}
                </div>
              </div>

              {project.coverImage && (
                <!-- Right: visual card -->
                <div class="project-visual">
                  <a href={`/work/${project.slug}`} class="project-card-link" aria-label={`View ${project.title}`}>
                    <div class="project-card-img">
                      <div class="card-logo-wrapper">
                        <img
                          src={project.coverImage}
                          alt={project.client}
                          class="card-logo"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="card-overlay">
                        <span class="card-cta">View project</span>
                      </div>
                    </div>
                  </a>
                </div>
              )}

            </div>
            <div class="project-divider"></div>
          </article>
        ))}
      </div>

    </div>
  </main>
</Layout>

<style>
  .projects-page {
    padding: calc(var(--hdr-h) + 80px) 0 120px;
  }

  /* ------ Page header ------ */
  .page-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: end;
    margin-bottom: 64px;
  }

  .page-title {
    font-family: var(--serif);
    font-size: var(--type-display-xl);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .page-subtitle {
    font-size: var(--type-ui);
    color: var(--muted);
    font-family: var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-desc {
    font-size: var(--type-body);
    line-height: 1.72;
    color: var(--muted);
    max-width: 400px;
    align-self: end;
  }


  /* ------ Project list ------ */
  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project-row {
    content-visibility: visible;
    transition: none;
  }

  .project-row-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 64px 0;
  }

  .project-row-inner--text-only {
    grid-template-columns: minmax(0, 720px);
  }

  /* ------ Text side ------ */
  .project-number {
    display: block;
    font-family: var(--mono);
    font-size: var(--type-caption);
    color: color-mix(in srgb, var(--text) 68%, var(--muted));
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .project-title-link {
    text-decoration: none;
    display: inline-block;
  }

  .project-title-link:hover .project-name {
    color: var(--accent);
  }

  .project-name {
    font-family: var(--serif);
    font-size: var(--type-card-title);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--text);
    margin-bottom: 16px;
    transition: color 0.25s ease;
  }

  .project-summary {
    font-size: var(--type-body);
    line-height: 1.72;
    color: color-mix(in srgb, var(--text) 72%, var(--muted));
    margin-bottom: 20px;
    max-width: 420px;
    text-wrap: pretty;
  }

  .project-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .tag {
    font-family: var(--mono);
    font-size: var(--type-caption);
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--text) 72%, var(--muted));
    border: 1px solid var(--divider);
    border-radius: 3px;
    padding: 4px 8px;
    text-transform: uppercase;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .project-row:hover .tag {
    color: var(--text);
    border-color: #bbb;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .link-primary {
    font-size: var(--type-ui);
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--divider);
    transition: text-decoration-color 0.25s ease, color 0.25s ease;
  }

  .link-primary:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .link-secondary {
    font-size: var(--type-ui);
    font-family: var(--mono);
    color: color-mix(in srgb, var(--text) 72%, var(--muted));
    transition: color 0.25s ease;
  }

  .link-secondary:hover {
    color: var(--accent);
  }

  /* ------ Visual card ------ */
  .project-card-link {
    display: block;
    text-decoration: none;
    border-radius: var(--rounded-md);
  }

  .project-card-img {
    --thumb-radius: var(--rounded-md);
    --thumb-border-width: 1.5px;
    --thumb-inner-radius: calc(var(--thumb-radius) - var(--thumb-border-width));

    position: relative;
    aspect-ratio: 2 / 1;
    background: transparent;
    border-radius: var(--thumb-radius);
    overflow: hidden;
    border: var(--thumb-border-width) solid rgba(0, 0, 0, 0.06);
    transition: border-color 180ms var(--ease-out), background 180ms var(--ease-out);
  }

  .project-card-link:hover .project-card-img,
  .project-card-link:focus-visible .project-card-img {
    border-color: var(--accent-border);
    background: var(--accent-soft);
  }

  .card-logo-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--thumb-inner-radius);
  }

  @media (max-width: 600px) {
    .card-logo-wrapper {
      padding: 0;
    }
  }

  .card-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--thumb-inner-radius);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    border-radius: var(--thumb-inner-radius);
    background: rgba(28, 28, 28, 0);
    display: flex;
    align-items: flex-end;
    padding: 24px;
    transition: background 0.4s ease;
  }

  .card-cta {
    font-size: var(--type-ui);
    font-weight: 500;
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card-link:hover .card-overlay,
  .project-card-link:focus-visible .card-overlay {
    background: rgba(28, 28, 28, 0.18);
  }

  .project-card-link:hover .card-cta,
  .project-card-link:focus-visible .card-cta {
    opacity: 1;
  }

  /* ------ Divider ------ */
  .project-divider {
    height: 1px;
    background: var(--divider);
  }

  .project-row:last-child .project-divider {
    display: none;
  }

  /* ------ Responsive ------ */
  @media (max-width: 900px) {
    .page-header {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 48px;
    }

    .page-desc {
      max-width: 100%;
    }

    .project-row-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 0;
    }

    /* On mobile: image first, text below */
    .project-visual {
      order: -1;
    }

    .project-summary {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    :global(.mobile-bottom-nav) {
      display: none !important;
    }

    .projects-page {
      padding-top: calc(var(--hdr-h) + 48px);
    }

    .project-row-inner {
      padding: 36px 0;
    }

    .project-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
