---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getProjects } from "../../lib/cms";
import { ChevronRight, ChevronLeft } from "../../components/icons/majesticons";
import ResponsiveImage from "../../components/ui/ResponsiveImage.astro";

export const prerender = true;

const projects = await getProjects();
const brandNames: Record<string, string> = {
  sony: "SONY",
  playah: "PlayAh!",
  "workflow-space": "WorkFlow Space",
  "pops-worldwide": "POPS Worldwide",
  "tomato-childrens-home": "TOMATO Children's Home",
  "education-communities": "Đại Học Đừng Học Đại",
};

// Enhanced project metadata with category grouping & key highlights:
const enhancedProjects = projects.map((p) => {
  let category = "Performance";
  
  if (p.slug === "sony" || p.slug === "playah") {
    category = "E-Commerce";
  } else if (p.slug === "workflow-space") {
    category = "Paid Media";
  } else if (p.slug === "pops-worldwide") {
    category = "SEO";
  } else if (p.slug === "tomato-childrens-home") {
    category = "Marketing 360";
  } else if (p.slug === "education-communities") {
    category = "Community";
  }

  const tags = (p.tools && p.tools.length > 0 ? p.tools : p.skills) || [];

  return {
    ...p,
    category,
    brandName: brandNames[p.slug] ?? p.client,
    tags,
  };
});
const projectCount = enhancedProjects.length;
---

<DashboardLayout
  title="Work — Phuc Loc Nguyen"
  pageTitle="Work"
  description="Performance marketing case studies across SONY D2C marketing, PlayAh!, WorkFlow Space, POPS Worldwide, TOMATO Children's Home, and community-led education projects."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Work" }]}
  maxWidthVariant="default"
>
  <!-- Page Header (Open document surface) -->
  <header class="page-header">
    <h1 class="page-title">Work</h1>
    <p class="page-lead">
      Deep dives into D2C e-commerce, multi-channel paid acquisition, TikTok Shop GMV acceleration, technical SEO roadmaps, and community-led organic growth.
    </p>

  </header>

  <!-- Projects Grid / Mobile Carousel -->
  <div 
    id="projects-grid" 
    class="projects-grid"
  >
    {enhancedProjects.map((p, index) => (
      <article 
        class="dash-card project-item" 
        data-category={p.category}
      >
        <!-- 1. Category and date -->
        <div class="project-card-meta">
          <span class="dash-tag">{p.category}</span>
          <span class="project-card-date">{p.year}</span>
        </div>

        <!-- 2. Image (consistent 16:9, preserve logos without cropping, concentric radius) -->
        {p.coverImage && (
          <a 
            href={`/work/${p.slug}`} 
            class="project-card-media"
            tabindex="-1"
            aria-hidden="true"
          >
            <ResponsiveImage
              src={p.coverImage} 
              alt={p.title} 
              width={640}
              height={360}
              widths={[320, 360, 480, 640, 720, 960]}
              sizes="(max-width: 768px) 85vw, (max-width: 1100px) 50vw, 33vw"
              class="project-card-img"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          </a>
        )}

        <!-- 3. Title -->
        <h2 class="item-title project-card-title">
          <a href={`/work/${p.slug}`}>
            {p.brandName}
          </a>
        </h2>

        <!-- 4. Short description (limited to 3 lines) -->
        <p class="project-card-summary">
          {p.summary}
        </p>

        <!-- 5. Tags -->
        <div class="project-card-tags">
          {p.tags.slice(0, 3).map((tag: string) => (
            <span class="dash-tag">{tag}</span>
          ))}
        </div>

        <!-- 6. Case-study link -->
        <div class="project-card-footer">
          <span class="project-card-label">Case Study</span>
          <a 
            href={`/work/${p.slug}`} 
            class="dash-link project-card-link"
            aria-label={`Read case study for ${p.brandName}`}
          >
            <span>Read breakdown</span>
            <ChevronRight size={13} aria-hidden="true" />
          </a>
        </div>
      </article>
    ))}
  </div>

  <!-- Carousel Controls (Mobile Only) -->
  <div 
    id="carousel-controls" 
    class="carousel-controls" 
    aria-label="Project carousel controls"
  >
    <span id="carousel-counter" class="carousel-counter" aria-live="polite">1 / {projectCount}</span>
    <div id="carousel-nav" class="carousel-nav-group">
      <button 
        type="button"
        id="carousel-prev" 
        class="carousel-btn" 
        aria-label="Previous project"
        disabled
      >
        <ChevronLeft size={16} aria-hidden="true" />
      </button>
      <button 
        type="button"
        id="carousel-next" 
        class="carousel-btn" 
        aria-label="Next project"
      >
        <ChevronRight size={16} aria-hidden="true" />
      </button>
    </div>
  </div>
</DashboardLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .carousel-controls {
    display: none;
  }

  .project-item {
    --card-outer-radius: 20px;
    --card-padding: 14px;
    border-radius: var(--card-outer-radius);
    padding: var(--card-padding);
    background: var(--color-ivory);
    border: 1px solid var(--dash-card-border, rgba(10, 10, 10, 0.08));
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-item:hover {
    border-color: rgba(10, 10, 10, 0.16);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(10, 10, 10, 0.04);
  }

  .project-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .project-card-date {
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--dash-muted);
    font-variant-numeric: tabular-nums;
  }

  .project-card-media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: max(0px, calc(var(--card-outer-radius) - var(--card-padding)));
    overflow: hidden;
    background: var(--dash-surface-subtle);
    margin-bottom: 14px;
    position: relative;
  }

  .project-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms var(--ease-smooth-out);
  }

  .project-item:hover .project-card-img {
    transform: none;
  }

  .project-card-title {
    margin: 0 0 6px;
    font-size: var(--text-h4);
    line-height: var(--leading-heading);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-subheading);
  }

  .project-card-title a {
    color: var(--dash-text);
    text-decoration: none;
    transition: color var(--duration-fast, 150ms) ease;
  }

  .project-card-title a:not(:where(button, [role="button"], .dash-button, .btn, .dash-filter-chip, .pricing-btn, .modal-verify-btn, .showcase-pass-gate-button, .ig-sort-btn, .carousel-btn, .mobile-menu-btn, .dash-nav-disclosure, .hero-primary, .hero-secondary, .gallery-arrow, .email-copy, .back-to-top, .mobile-pill-link, .t-learn, .t-tab, .traffic-dot, .dash-traffic-dot)):hover {
    color: var(--dash-accent);
  }

  .project-card-title a:focus-visible {
    outline: 2px solid var(--dash-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .project-card-summary {
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-grow: 1;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 16px;
  }

  .project-card-footer {
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    padding-top: 10px;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-card-label {
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--dash-muted);
  }

  .project-card-link {
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--dash-text);
    text-decoration: none;
    transition: color var(--duration-fast, 150ms) ease;
  }

  .project-card-link:hover {
    color: var(--dash-accent);
  }

  .project-card-link:focus-visible {
    outline: 2px solid var(--dash-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    /* Projects horizontal carousel */
    .projects-grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      overscroll-behavior-x: contain;
      touch-action: pan-x pan-y;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--mobile-page-edge, 16px);
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      margin-inline: calc(var(--mobile-page-edge, 16px) * -1);
      padding-inline: var(--mobile-page-edge, 16px);
      padding-top: 2px;
      padding-bottom: 12px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
    }

    .projects-grid.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none !important;
      user-select: none;
    }

    .projects-grid::-webkit-scrollbar {
      display: none;
    }

    .project-item {
      --card-padding: 14px;
      flex: 0 0 min(360px, calc(100vw - (var(--mobile-page-edge, 16px) * 2))) !important;
      width: min(360px, calc(100vw - (var(--mobile-page-edge, 16px) * 2))) !important;
      max-width: min(360px, calc(100vw - (var(--mobile-page-edge, 16px) * 2))) !important;
      scroll-snap-align: start;
      scroll-snap-stop: normal;
    }

    .project-card-media {
      -webkit-user-drag: none;
      user-select: none;
    }

    .project-card-img {
      pointer-events: none;
      user-select: none;
      -webkit-user-drag: none;
    }

    /* Carousel Controls */
    .carousel-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 8px;
      padding-inline: 2px;
    }

    .carousel-counter {
      font-size: var(--text-body-sm);
      font-weight: var(--font-weight-semibold);
      color: var(--dash-muted);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }

    .carousel-nav-group {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .carousel-btn {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--btn-bg);
      border: 0;
      border-radius: 9999px;
      color: var(--color-jet);
      cursor: pointer;
      padding: 0;
      transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1), opacity 150ms ease;
    }

    .carousel-btn:focus-visible {
      outline: 2px solid var(--dash-accent);
      outline-offset: 2px;
    }

    .carousel-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }
  }

  @media (max-width: 359px) {
    .projects-grid {
      gap: 12px;
    }
  }
</style>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const gridElement = document.getElementById("projects-grid");
    if (!gridElement) return;
    const grid = gridElement;

    const projectItems = Array.from(grid.querySelectorAll<HTMLElement>(".project-item"));

    const controls = document.getElementById("carousel-controls");
    const counter = document.getElementById("carousel-counter");
    const navGroup = document.getElementById("carousel-nav");
    const prevBtn = document.querySelector<HTMLButtonElement>("#carousel-prev");
    const nextBtn = document.querySelector<HTMLButtonElement>("#carousel-next");

    let activeVisibleIndex = 0;
    let snapPositions: number[] = [];
    const measureItems = () => {
      const firstOffset = projectItems[0]?.offsetLeft || 0;
      snapPositions = projectItems.map((item) => item.offsetLeft - firstOffset);
    };
    measureItems();

    function getVisibleItems() {
      return projectItems;
    }

    function updateControls() {
      const visible = getVisibleItems();
      const total = visible.length;

      if (total === 0) {
        if (controls) controls.style.display = "none";
        return;
      }

      if (controls) {
        controls.style.display = "";
      }

      if (activeVisibleIndex < 0) activeVisibleIndex = 0;
      if (activeVisibleIndex >= total) activeVisibleIndex = total - 1;

      if (counter) {
        counter.textContent = `${activeVisibleIndex + 1} / ${total}`;
      }

      if (total === 1) {
        // For one result, show "1 / 1" without navigation controls
        if (navGroup) navGroup.style.display = "none";
      } else {
        if (navGroup) navGroup.style.display = "";
        if (prevBtn) {
          const isFirst = activeVisibleIndex === 0;
          prevBtn.disabled = isFirst;
          if (isFirst) {
            prevBtn.setAttribute("aria-disabled", "true");
          } else {
            prevBtn.removeAttribute("aria-disabled");
          }
        }
        if (nextBtn) {
          const isLast = activeVisibleIndex === total - 1;
          nextBtn.disabled = isLast;
          if (isLast) {
            nextBtn.setAttribute("aria-disabled", "true");
          } else {
            nextBtn.removeAttribute("aria-disabled");
          }
        }
      }
    }

    function scrollToItem(index: number, smooth = true) {
      const visible = getVisibleItems();
      if (index < 0 || index >= visible.length) return;
      activeVisibleIndex = index;

      const scrollLeft = snapPositions[index] ?? 0;

      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      grid.scrollTo({
        left: scrollLeft,
        behavior: smooth && !prefersReduced ? "smooth" : "auto",
      });

      updateControls();
    }

    function calculateActiveIndexFromScroll() {
      const visible = getVisibleItems();
      if (visible.length <= 1) {
        activeVisibleIndex = 0;
        updateControls();
        return;
      }

      const scrollLeft = grid.scrollLeft;

      let closestIndex = 0;
      let smallestDistance = Infinity;

      snapPositions.forEach((itemSnapPos, idx) => {
        const dist = Math.abs(scrollLeft - itemSnapPos);
        if (dist < smallestDistance) {
          smallestDistance = dist;
          closestIndex = idx;
        }
      });

      if (closestIndex !== activeVisibleIndex) {
        activeVisibleIndex = closestIndex;
        updateControls();
      }
    }

    let scrollFrame = 0;
    function handleScroll() {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(() => {
        scrollFrame = 0;
        calculateActiveIndexFromScroll();
      });
    }

    grid.addEventListener("scroll", handleScroll, { passive: true, signal });
    grid.addEventListener("scrollend", calculateActiveIndexFromScroll, { passive: true, signal });

    // Mouse Drag-to-Scroll support for desktop emulation / previewing
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let hasDragged = false;

    grid.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return;
      isDown = true;
      hasDragged = false;
      startX = e.pageX;
      scrollStart = grid.scrollLeft;
      grid.classList.add("is-dragging");
    }, { signal });

    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      const walk = e.pageX - startX;
      if (Math.abs(walk) > 4) {
        hasDragged = true;
      }
      grid.scrollLeft = scrollStart - walk;
    }, { signal });

    const onMouseUp = () => {
      if (!isDown) return;
      isDown = false;
      grid.classList.remove("is-dragging");
      calculateActiveIndexFromScroll();
    };

    window.addEventListener("mouseup", onMouseUp, { signal });

    grid.addEventListener(
      "click",
      (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          hasDragged = false;
        }
      },
      { capture: true, signal }
    );

    prevBtn?.addEventListener("click", () => {
      if (activeVisibleIndex > 0) {
        scrollToItem(activeVisibleIndex - 1, true);
      }
    }, { signal });

    nextBtn?.addEventListener("click", () => {
      const visible = getVisibleItems();
      if (activeVisibleIndex < visible.length - 1) {
        scrollToItem(activeVisibleIndex + 1, true);
      }
    }, { signal });

    const resizeObserver = new ResizeObserver(() => {
      measureItems();
      handleScroll();
    });
    resizeObserver.observe(grid);
    signal.addEventListener("abort", () => {
      resizeObserver.disconnect();
      cancelAnimationFrame(scrollFrame);
    }, { once: true });

    updateControls();
  });
</script>
