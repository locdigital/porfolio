---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getProjects } from "../../lib/cms";
import { ChevronRight, ChevronLeft } from "../../components/icons/majesticons";

export const prerender = true;

const projects = await getProjects();
const brandNames: Record<string, string> = {
  sony: "Sony",
  playah: "PlayAh!",
  "workflow-space": "WorkFlow Space",
  "pops-worldwide": "POPS Worldwide",
  "tomato-childrens-home": "TOMATO Children's Home",
  "education-communities": "Đại Học Đừng Học Đại",
};

// Enhanced project metadata with category grouping & key highlights:
const enhancedProjects = projects.map((p) => {
  let category = "Performance";
  
  if (p.slug === "sony" || p.slug === "playah") {
    category = "E-Commerce";
  } else if (p.slug === "workflow-space") {
    category = "Paid Media";
  } else if (p.slug === "pops-worldwide") {
    category = "SEO";
  } else if (p.slug === "tomato-childrens-home") {
    category = "Marketing 360";
  } else if (p.slug === "education-communities") {
    category = "Community";
  }

  const tags = (p.tools && p.tools.length > 0 ? p.tools : p.skills) || [];

  return {
    ...p,
    category,
    brandName: brandNames[p.slug] ?? p.client,
    tags,
  };
});
---

<DashboardLayout
  title="Work — Phuc Loc Nguyen"
  pageTitle="Work"
  description="Performance marketing case studies: Sony D2C operations, PlayAh! TikTok Shop scaling, WorkFlow Space branch launches, POPS Worldwide SEO 10x growth, and TOMATO Children's Home."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Work" }]}
  maxWidthVariant="default"
>
  <!-- Page Header (Open document surface) -->
  <header class="page-header">
    <h1 class="page-title">Work</h1>
    <p class="page-lead">
      Deep dives into D2C e-commerce, multi-channel paid acquisition, TikTok Shop GMV acceleration, technical SEO roadmaps, and community-led organic growth.
    </p>

    <!-- Quiet Filter Toolbar -->
    <div 
      class="dash-filter-bar" 
      role="toolbar" 
      aria-label="Filter case studies by category"
    >
      <button type="button" class="dash-filter-chip active" data-filter="all" aria-pressed="true">All (6)</button>
      <button type="button" class="dash-filter-chip" data-filter="E-Commerce" aria-pressed="false">E-Commerce</button>
      <button type="button" class="dash-filter-chip" data-filter="Paid Media" aria-pressed="false">Paid Media</button>
      <button type="button" class="dash-filter-chip" data-filter="SEO" aria-pressed="false">Technical SEO</button>
      <button type="button" class="dash-filter-chip" data-filter="Marketing 360" aria-pressed="false">Marketing 360</button>
      <button type="button" class="dash-filter-chip" data-filter="Community" aria-pressed="false">Community</button>
    </div>
  </header>

  <!-- Projects Grid / Mobile Carousel -->
  <div 
    id="projects-grid" 
    class="projects-grid"
  >
    {enhancedProjects.map((p) => (
      <article 
        class="dash-card project-item" 
        data-category={p.category}
      >
        <!-- 1. Category and date -->
        <div class="project-card-meta">
          <span class="dash-tag">{p.category}</span>
          <span class="project-card-date">{p.year}</span>
        </div>

        <!-- 2. Image (consistent 16:9, preserve logos without cropping, concentric radius) -->
        {p.coverImage && (
          <a 
            href={`/work/${p.slug}`} 
            class="project-card-media"
            tabindex="-1"
            aria-hidden="true"
          >
            <img 
              src={p.coverImage} 
              alt={p.title} 
              class="project-card-img"
              loading="lazy"
            />
          </a>
        )}

        <!-- 3. Title -->
        <h2 class="item-title project-card-title">
          <a href={`/work/${p.slug}`}>
            {p.brandName}
          </a>
        </h2>

        <!-- 4. Short description (limited to 3 lines) -->
        <p class="project-card-summary">
          {p.summary}
        </p>

        <!-- 5. Tags -->
        <div class="project-card-tags">
          {p.tags.slice(0, 3).map((tag: string) => (
            <span class="dash-tag">{tag}</span>
          ))}
        </div>

        <!-- 6. Case-study link -->
        <div class="project-card-footer">
          <span class="project-card-label">Case Study</span>
          <a 
            href={`/work/${p.slug}`} 
            class="dash-link project-card-link"
            aria-label={`Read case study for ${p.brandName}`}
          >
            <span>Read breakdown</span>
            <ChevronRight size={13} aria-hidden="true" />
          </a>
        </div>
      </article>
    ))}
  </div>

  <!-- Carousel Controls (Mobile Only) -->
  <div 
    id="carousel-controls" 
    class="carousel-controls" 
    aria-label="Project carousel controls"
  >
    <span id="carousel-counter" class="carousel-counter" aria-live="polite">1 / 6</span>
    <div id="carousel-nav" class="carousel-nav-group">
      <button 
        type="button"
        id="carousel-prev" 
        class="carousel-btn" 
        aria-label="Previous project"
        disabled
      >
        <ChevronLeft size={16} aria-hidden="true" />
      </button>
      <button 
        type="button"
        id="carousel-next" 
        class="carousel-btn" 
        aria-label="Next project"
      >
        <ChevronRight size={16} aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Empty state (hidden by default) -->
  <div id="projects-empty" class="projects-empty" style="display: none;">
    <p style="margin-bottom: 12px;">No case studies found in this category.</p>
    <button type="button" id="reset-filter-btn" class="dash-button dash-button--secondary">Reset filters</button>
  </div>
</DashboardLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .carousel-controls {
    display: none;
  }

  .projects-empty {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--dash-muted);
  }

  .project-item {
    --card-outer-radius: 18px;
    --card-padding: 16px;
    border-radius: var(--card-outer-radius);
    padding: var(--card-padding);
    background: var(--dash-surface);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: transform var(--duration-fast, 250ms) var(--ease-smooth-out),
                box-shadow var(--duration-fast, 250ms) var(--ease-smooth-out),
                border-color var(--duration-fast, 250ms) var(--ease-smooth-out);
  }

  .project-item:hover {
    border-color: var(--dash-border-strong);
    transform: none;
    box-shadow: none;
  }

  .project-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .project-card-date {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--dash-muted);
    font-variant-numeric: tabular-nums;
  }

  .project-card-media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: max(0px, calc(var(--card-outer-radius) - var(--card-padding)));
    overflow: hidden;
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    background: var(--dash-surface-subtle);
    margin-bottom: 14px;
    position: relative;
  }

  .project-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms var(--ease-smooth-out);
  }

  .project-item:hover .project-card-img {
    transform: scale(1.025);
  }

  .project-card-title {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project-card-title a {
    color: var(--dash-text);
    text-decoration: none;
    transition: color var(--duration-fast, 150ms) ease;
  }

  .project-card-title a:hover {
    color: var(--dash-accent);
  }

  .project-card-title a:focus-visible {
    outline: 2px solid var(--dash-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .project-card-summary {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--dash-muted);
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-grow: 1;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 16px;
  }

  .project-card-footer {
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    padding-top: 10px;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-card-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--dash-muted);
  }

  .project-card-link {
    font-size: 0.8125rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--dash-text);
    text-decoration: none;
    transition: color var(--duration-fast, 150ms) ease;
  }

  .project-card-link:hover {
    color: var(--dash-accent);
  }

  .project-card-link:focus-visible {
    outline: 2px solid var(--dash-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    /* Category filters horizontally scrollable without wrapping */
    .dash-filter-bar {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      gap: 8px;
      margin-inline: -22px;
      padding-inline: 22px;
      padding-bottom: 6px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .dash-filter-bar::-webkit-scrollbar {
      display: none;
    }

    .dash-filter-chip {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    /* Projects horizontal carousel */
    .projects-grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      overscroll-behavior-x: contain;
      touch-action: pan-x pan-y;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 22px;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      margin-inline: -22px;
      padding-inline: 22px;
      padding-top: 2px;
      padding-bottom: 12px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
    }

    .projects-grid.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none !important;
      user-select: none;
    }

    .projects-grid::-webkit-scrollbar {
      display: none;
    }

    .project-item {
      --card-padding: 14px;
      flex: 0 0 clamp(280px, 82vw, 340px) !important;
      width: clamp(280px, 82vw, 340px) !important;
      max-width: clamp(280px, 82vw, 340px) !important;
      scroll-snap-align: start;
      scroll-snap-stop: normal;
    }

    .project-card-media {
      -webkit-user-drag: none;
      user-select: none;
    }

    .project-card-img {
      pointer-events: none;
      user-select: none;
      -webkit-user-drag: none;
    }

    /* Carousel Controls */
    .carousel-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 8px;
      padding-inline: 2px;
    }

    .carousel-counter {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--dash-muted);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }

    .carousel-nav-group {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .carousel-btn {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--dash-surface);
      border: var(--dash-border-width, 0.9px) solid var(--dash-border);
      border-radius: var(--radius-control, 6px);
      color: var(--dash-text);
      cursor: pointer;
      padding: 0;
      transition: background-color var(--duration-fast, 150ms) ease, border-color var(--duration-fast, 150ms) ease, opacity var(--duration-fast, 150ms) ease;
    }

    .carousel-btn:hover:not(:disabled) {
      background: var(--dash-surface-subtle);
      border-color: var(--dash-border);
      color: var(--dash-text);
    }

    .carousel-btn:focus-visible {
      outline: 2px solid var(--dash-accent);
      outline-offset: 2px;
    }

    .carousel-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }
  }

  @media (max-width: 359px) {
    .dash-filter-bar {
      margin-inline: -18px;
      padding-inline: 18px;
    }

    .projects-grid {
      margin-inline: -18px;
      padding-inline: 18px;
      scroll-padding-inline: 18px;
      gap: 12px;
    }

    .project-item {
      flex: 0 0 clamp(260px, 84vw, 300px) !important;
      width: clamp(260px, 84vw, 300px) !important;
      max-width: clamp(260px, 84vw, 300px) !important;
    }
  }
</style>

<script is:inline>
  function setupProjectCarouselAndFilters() {
    const grid = document.getElementById("projects-grid");
    if (!grid) return;

    const filterButtons = document.querySelectorAll(".dash-filter-chip");
    const projectItems = Array.from(grid.querySelectorAll(".project-item"));
    const emptyState = document.getElementById("projects-empty");
    const resetBtn = document.getElementById("reset-filter-btn");

    const controls = document.getElementById("carousel-controls");
    const counter = document.getElementById("carousel-counter");
    const navGroup = document.getElementById("carousel-nav");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");

    let activeVisibleIndex = 0;

    function getVisibleItems() {
      return projectItems.filter((item) => item.style.display !== "none");
    }

    function updateControls() {
      const visible = getVisibleItems();
      const total = visible.length;

      if (total === 0) {
        if (controls) controls.style.display = "none";
        return;
      }

      if (controls) {
        controls.style.display = "";
      }

      if (activeVisibleIndex < 0) activeVisibleIndex = 0;
      if (activeVisibleIndex >= total) activeVisibleIndex = total - 1;

      if (counter) {
        counter.textContent = `${activeVisibleIndex + 1} / ${total}`;
      }

      if (total === 1) {
        // For one result, show "1 / 1" without navigation controls
        if (navGroup) navGroup.style.display = "none";
      } else {
        if (navGroup) navGroup.style.display = "";
        if (prevBtn) {
          const isFirst = activeVisibleIndex === 0;
          prevBtn.disabled = isFirst;
          if (isFirst) {
            prevBtn.setAttribute("aria-disabled", "true");
          } else {
            prevBtn.removeAttribute("aria-disabled");
          }
        }
        if (nextBtn) {
          const isLast = activeVisibleIndex === total - 1;
          nextBtn.disabled = isLast;
          if (isLast) {
            nextBtn.setAttribute("aria-disabled", "true");
          } else {
            nextBtn.removeAttribute("aria-disabled");
          }
        }
      }
    }

    function scrollToItem(index, smooth = true) {
      const visible = getVisibleItems();
      if (index < 0 || index >= visible.length) return;
      activeVisibleIndex = index;

      const targetItem = visible[index];
      const firstItem = visible[0];
      const scrollLeft = targetItem.offsetLeft - firstItem.offsetLeft;

      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      grid.scrollTo({
        left: scrollLeft,
        behavior: smooth && !prefersReduced ? "smooth" : "auto",
      });

      updateControls();
    }

    function calculateActiveIndexFromScroll() {
      const visible = getVisibleItems();
      if (visible.length <= 1) {
        activeVisibleIndex = 0;
        updateControls();
        return;
      }

      const scrollLeft = grid.scrollLeft;
      const firstItem = visible[0];
      const baseOffset = firstItem ? firstItem.offsetLeft : 0;

      let closestIndex = 0;
      let smallestDistance = Infinity;

      visible.forEach((item, idx) => {
        const itemSnapPos = item.offsetLeft - baseOffset;
        const dist = Math.abs(scrollLeft - itemSnapPos);
        if (dist < smallestDistance) {
          smallestDistance = dist;
          closestIndex = idx;
        }
      });

      if (closestIndex !== activeVisibleIndex) {
        activeVisibleIndex = closestIndex;
        updateControls();
      }
    }

    let isThrottled = false;
    function handleScroll() {
      if (!isThrottled) {
        window.requestAnimationFrame(() => {
          calculateActiveIndexFromScroll();
          isThrottled = false;
        });
        isThrottled = true;
      }
    }

    grid.addEventListener("scroll", handleScroll, { passive: true });
    grid.addEventListener("scrollend", calculateActiveIndexFromScroll, { passive: true });

    // Mouse Drag-to-Scroll support for desktop emulation / previewing
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let hasDragged = false;

    grid.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return;
      isDown = true;
      hasDragged = false;
      startX = e.pageX;
      scrollStart = grid.scrollLeft;
      grid.classList.add("is-dragging");
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      const walk = e.pageX - startX;
      if (Math.abs(walk) > 4) {
        hasDragged = true;
      }
      grid.scrollLeft = scrollStart - walk;
    });

    const onMouseUp = () => {
      if (!isDown) return;
      isDown = false;
      grid.classList.remove("is-dragging");
      calculateActiveIndexFromScroll();
    };

    window.addEventListener("mouseup", onMouseUp);

    grid.addEventListener(
      "click",
      (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          hasDragged = false;
        }
      },
      true
    );

    function applyFilter(category) {
      let visibleCount = 0;

      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute("data-category");
        if (category === "all" || itemCategory === category) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? "block" : "none";
      }

      filterButtons.forEach((btn) => {
        const isMatch = btn.getAttribute("data-filter") === category;
        btn.classList.toggle("active", isMatch);
        btn.setAttribute("aria-pressed", isMatch ? "true" : "false");
      });

      // Reset to first matching project
      activeVisibleIndex = 0;
      grid.scrollTo({ left: 0, behavior: "auto" });
      updateControls();
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = btn.getAttribute("data-filter") || "all";
        applyFilter(category);
      });
    });

    resetBtn?.addEventListener("click", () => applyFilter("all"));

    prevBtn?.addEventListener("click", () => {
      if (activeVisibleIndex > 0) {
        scrollToItem(activeVisibleIndex - 1, true);
      }
    });

    nextBtn?.addEventListener("click", () => {
      const visible = getVisibleItems();
      if (activeVisibleIndex < visible.length - 1) {
        scrollToItem(activeVisibleIndex + 1, true);
      }
    });

    window.addEventListener("resize", () => {
      calculateActiveIndexFromScroll();
    });

    // Initial setup
    applyFilter("all");
  }

  document.addEventListener("astro:page-load", setupProjectCarouselAndFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupProjectCarouselAndFilters();
  }
</script>
