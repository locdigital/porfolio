---
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/cms";
import BlurFade from "../../components/ui/BlurFade.astro";
import { absoluteUrl, pageSchema } from "../../lib/seo";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const projects = await getProjects();
const project = projects.find((p) => p.slug === slug);

if (!project) {
  return Astro.redirect("/work");
}

// Find prev / next for navigation
const currentIndex = projects.findIndex((p) => p.slug === slug);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : null;

// Split description into paragraphs
const paragraphs = project.description.split("\n\n").filter(Boolean);
const projectUrl = absoluteUrl(`/work/${project.slug}`);
const creativeWorkSchema = {
  "@type": "CreativeWork",
  "@id": `${projectUrl}#case-study`,
  name: project.title,
  description: project.summary,
  ...(project.coverImage ? { image: absoluteUrl(project.coverImage) } : {}),
  url: projectUrl,
  dateCreated: project.year,
  creator: { "@id": `${absoluteUrl("/")}#person` },
  keywords: project.tags,
  mentions: {
    "@type": "Organization",
    name: project.client,
    url: project.link,
  },
};
---

<Layout
  title={`${project.title} | Phuc Loc Nguyen`}
  description={project.summary}
  schema={[
    pageSchema({
      url: projectUrl,
      title: `${project.title} | Phuc Loc Nguyen`,
      description: project.summary,
      type: "WebPage",
    }),
    creativeWorkSchema,
  ]}
>
  <main class="project-detail-page">
    <div class="container">

      <!-- Back link -->
      <a href="/work" class="back-link r">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        All work
      </a>

      <!-- Project header -->
      <header class="detail-header">
        <div class="detail-header-top r">
          <span class="detail-number">{project.number}</span>
          <span class="detail-year">{project.year}</span>
        </div>

        <BlurFade>
          <h1 class="detail-title r" data-d="1">{project.title}</h1>
        </BlurFade>

        <div class="detail-meta r" data-d="2">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{project.client}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Role</span>
            <span class="meta-value">{project.role}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{project.year}</span>
          </div>
        </div>
      </header>

      {project.coverImage && (
        <!-- Hero visual -->
        <div class="detail-hero r" data-d="3">
          <div class="detail-hero-img">
            <div class="hero-logo-wrapper">
              <img
                src={project.coverImage}
                alt={project.client}
                class="hero-logo"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      )}

      <!-- Content grid -->
      <div class="detail-content r" data-d="4">

        <!-- Main body -->
        <div class="detail-body">
          <p class="detail-summary">{project.summary}</p>

          {paragraphs.map((para) => (
            <p class="detail-para">{para}</p>
          ))}

          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="detail-link"
            >
              {project.linkLabel ?? "Visit site ↗"}
            </a>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="detail-sidebar">
          <div class="sidebar-block">
            <span class="sidebar-label">Tools / Skills</span>
            <ul class="sidebar-tags">
              {project.tags.map((tag) => (
                <li class="sidebar-tag">{tag}</li>
              ))}
            </ul>
          </div>

          <div class="sidebar-block">
            <span class="sidebar-label">Client</span>
            <span class="sidebar-value">{project.client}</span>
          </div>

          <div class="sidebar-block">
            <span class="sidebar-label">Year</span>
            <span class="sidebar-value">{project.year}</span>
          </div>

          {project.link && (
            <div class="sidebar-block">
              <span class="sidebar-label">Live</span>
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="sidebar-link"
              >
                {project.linkLabel ?? "Visit site ↗"}
              </a>
            </div>
          )}
        </aside>

      </div>

    </div>

    <!-- Project navigation -->
    <nav class="project-nav" aria-label="Project navigation">
      <div class="container">
        <div class="project-nav-inner">
          {prevProject ? (
            <a href={`/work/${prevProject.slug}`} class="pnav-item pnav-prev r">
              <span class="pnav-dir">← Previous</span>
              <span class="pnav-title">{prevProject.title}</span>
            </a>
          ) : (
            <div></div>
          )}

          {nextProject ? (
            <a href={`/work/${nextProject.slug}`} class="pnav-item pnav-next r" data-d="2">
              <span class="pnav-dir">Next →</span>
              <span class="pnav-title">{nextProject.title}</span>
            </a>
          ) : (
            <a href="/work" class="pnav-item pnav-next r" data-d="2">
              <span class="pnav-dir">Back to</span>
              <span class="pnav-title">All Work</span>
            </a>
          )}
        </div>
      </div>
    </nav>

  </main>
</Layout>

<style>
  .project-detail-page {
    padding: calc(var(--hdr-h) + 56px) 0 0;
  }

  /* ── Back link ── */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-family: var(--mono);
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 56px;
    transition: color 0.25s ease, gap 0.25s ease;
  }

  .back-link:hover {
    color: var(--accent);
    gap: 12px;
  }

  /* ── Detail header ── */
  .detail-header {
    margin-bottom: 64px;
  }

  .detail-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .detail-number {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.12em;
  }

  .detail-year {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .detail-title {
    font-family: var(--serif);
    font-size: clamp(42px, 6.5vw, 90px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 40px;
    max-width: 820px;
  }

  /* ── Meta row ── */
  .detail-meta {
    display: flex;
    gap: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--divider);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta-value {
    font-size: 14px;
    color: var(--text);
  }

  /* ── Hero image ── */
  .detail-hero {
    margin-bottom: 80px;
  }

  .detail-hero-img {
    position: relative;
    aspect-ratio: 2 / 1;
    background: transparent;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .hero-logo-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  @media (max-width: 600px) {
    .hero-logo-wrapper {
      padding: 0;
    }
  }

  .hero-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0;
  }

  /* ── Content grid ── */
  .detail-content {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 80px;
    margin-bottom: 0;
    padding-bottom: 100px;
    border-bottom: 1px solid var(--divider);
  }

  /* ── Body text ── */
  .detail-summary {
    font-family: var(--serif);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.55;
    color: var(--text);
    margin-bottom: 36px;
    letter-spacing: -0.01em;
  }

  .detail-para {
    font-size: 15px;
    line-height: 1.78;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .detail-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--divider);
    transition: color 0.25s ease, text-decoration-color 0.25s ease;
  }

  .detail-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* ── Sidebar ── */
  .detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 8px;
  }

  .sidebar-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sidebar-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sidebar-tags {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sidebar-tag {
    font-size: 13px;
    color: var(--text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sidebar-tag::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted);
    flex-shrink: 0;
  }

  .sidebar-value {
    font-size: 14px;
    color: var(--text);
  }

  .sidebar-link {
    font-size: 13px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.25s ease;
  }

  .sidebar-link:hover {
    color: var(--accent);
  }

  /* ── Project nav ── */
  .project-nav {
    border-top: 1px solid var(--divider);
    padding: 0;
  }

  .project-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .pnav-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 48px 0;
    text-decoration: none;
    color: var(--text);
    transition: color 0.25s ease;
    border-right: 1px solid var(--divider);
  }

  .pnav-next {
    border-right: none;
    text-align: right;
    align-items: flex-end;
    padding-left: 40px;
  }

  .pnav-prev {
    padding-right: 40px;
  }

  .pnav-dir {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
    transition: color 0.25s ease;
  }

  .pnav-title {
    font-family: var(--serif);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.25;
    transition: color 0.25s ease;
  }

  .pnav-item:hover .pnav-title {
    color: var(--accent);
  }

  .pnav-item:hover .pnav-dir {
    color: var(--text);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .detail-content {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .detail-sidebar {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
      padding-top: 0;
      border-top: 1px solid var(--divider);
      padding-top: 32px;
    }

    .detail-meta {
      flex-wrap: wrap;
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .project-nav-inner {
      grid-template-columns: 1fr;
    }

    .pnav-item {
      border-right: none;
      border-bottom: 1px solid var(--divider);
      padding: 32px 0;
    }

    .pnav-next {
      padding-left: 0;
      text-align: left;
      align-items: flex-start;
    }

    .pnav-item:last-child {
      border-bottom: none;
    }
  }
</style>
