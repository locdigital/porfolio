---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getProjects } from "../../lib/cms";
import BeforeAfterPerformance from "../../components/ui/BeforeAfterPerformance.astro";
import ShowcasePassGate from "../../components/ui/ShowcasePassGate.astro";
import BrandPositioningFeed from "../../components/ui/BrandPositioningFeed.astro";
import { 
  ArrowLeftIcon as ArrowLeft, 
  ArrowSquareOutIcon as ExternalLink, 
  CaretRightIcon as ChevronRight
} from "@phosphor-icons/react";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const allProjects = await getProjects();
const project = Astro.props.project ?? allProjects.find((p) => p.slug === Astro.params.slug);

if (!project) {
  return Astro.redirect("/work");
}

const otherProjects = allProjects.filter((p) => p.slug !== project.slug).slice(0, 3);

// Content paragraphs
const descriptionParagraphs = Array.isArray(project.description) 
  ? project.description 
  : project.description
      .split(/\n{2,}/)
      .map((paragraph: string) => paragraph.trim())
      .filter(Boolean);

// Pre-configured comparison data for interactive Before/After module
let comparisonData: any = null;

if (project.slug === "playah") {
  comparisonData = {
    badge: "PlayAh! Growth",
    heading: "From Static Brand Awareness to +10x TikTok Shop GMV",
    description: "Multi-layered comparison: scaling from tens of millions to >1B VND monthly revenue while maintaining ROAS > 10.",
    categoryLabel: "TikTok Shop Acceleration",
    beforeLabel: "Baseline (Th07/2025)",
    afterLabel: "Scaled Engine (Th08/2025)",
    beforeImage: {
      src: "/images/playah/playah-before.png",
      alt: "PlayAh! Doanh thu & GMV TikTok Shop trước tối ưu (Tháng 7/2025 — 125 triệu)",
    },
    afterImage: {
      src: "/images/playah/playah-after.png",
      alt: "PlayAh! Doanh thu & GMV TikTok Shop sau tối ưu (Tháng 8/2025 — 1.46 tỷ)",
    },
    beforePanel: {
      eyebrow: "Initial Phase",
      title: "Isolated Ad Spend",
      description: "Static Facebook ad sets without automated affiliate seeding, erratic CPA, and unintegrated conversion tracking.",
      metrics: [
        { label: "Monthly GMV", value: "30-50M" },
        { label: "Blended ROAS", value: "1.8x" },
        { label: "Affiliate Creators", value: "None" }
      ]
    },
    afterPanel: {
      eyebrow: "Optimized Phase",
      title: "1B+ / Month System",
      description: "Automated TikTok Shop affiliate engine + Meta conversion funnels maintaining >10 ROAS across product catalogs.",
      metrics: [
        { label: "Monthly GMV", value: "> 1,000M" },
        { label: "Blended ROAS", value: "> 10x" },
        { label: "Affiliate GMV", value: "65%" }
      ]
    },
    highlights: [
      { title: "Direct Affiliate Seeding", description: "Hundreds of creator samples routed automatically based on category GMV potential." },
      { title: "Server-Side Tracking", description: "Meta CAPI + TikTok Events API deduplication for near 100% purchase attribution." }
    ]
  };
} else if (project.slug === "workflow-space") {
  comparisonData = {
    badge: "WorkFlow Space Launch",
    heading: "Branch Launch Positioning & 5,000+ Verified Bookings",
    description: "Connecting local targeted ads with high-converting booking funnels for new workspace locations.",
    categoryLabel: "Location Marketing",
    beforeLabel: "Pre-Launch",
    afterLabel: "Post-Launch",
    beforeImage: {
      src: "/images/workflow/workflow-before.jpg",
      alt: "WorkFlow Space Mobile Booking Funnel Pre-Launch (Before)",
    },
    afterImage: {
      src: "/images/workflow/workflow-after.png",
      alt: "WorkFlow Space 5,000+ Bookings Ad Campaign Performance (After)",
    },
    beforePanel: {
      eyebrow: "Cold Launch",
      title: "Zero Brand Search",
      description: "Empty foot traffic, unranked Google Maps presence, zero automated tour booking engine.",
      metrics: [
        { label: "Bookings", value: "0" },
        { label: "Leads/mo", value: "< 20" },
        { label: "Search Share", value: "0%" }
      ]
    },
    afterPanel: {
      eyebrow: "Active Branches",
      title: "5,000+ Bookings",
      description: "Saturated workspace occupancy, 2,000+ hot leads, and top-3 local SEO pack rank for all branches.",
      metrics: [
        { label: "Bookings", value: "5,000+" },
        { label: "Qualified Leads", value: "2,000+" },
        { label: "Impressions", value: "4M+" }
      ]
    },
    highlights: [
      { title: "Localized Geo-Fencing", description: "Targeting tech & creative workers within 3km radius of workspace branches." },
      { title: "Automated Tour Scheduling", description: "Zero-friction booking system converting ad clicks at 35–40% CVR." }
    ]
  };
} else if (project.slug === "pops-worldwide") {
  comparisonData = {
    badge: "POPS Worldwide",
    heading: "Technical SEO Scaling to 2.5M Monthly Active Users",
    description: "Re-architecting content taxonomy and regional entertainment indexability.",
    categoryLabel: "Technical SEO",
    beforeLabel: "Legacy CMS",
    afterLabel: "SEO Architecture",
    beforeImage: {
      src: "/images/pops/pops-before.png",
      alt: "POPS Worldwide Legacy Index (Before)",
    },
    afterImage: {
      src: "/images/pops/pops-after.png",
      alt: "POPS Worldwide Scaled Architecture (After)",
    },
    beforePanel: {
      eyebrow: "Legacy Index",
      title: "Indexation Bottlenecks",
      description: "Orphaned video categories, slow SSR rendering, missing schema markup across Southeast Asia.",
      metrics: [
        { label: "MAU", value: "250k" },
        { label: "Organic Keywords", value: "1.2k" },
        { label: "Crawl Efficiency", value: "32%" }
      ]
    },
    afterPanel: {
      eyebrow: "Enterprise Structure",
      title: "2.5M MAU (10x YoY)",
      description: "Clean faceted search, automated VideoObject schema, and 400,000 organic installs for POPS Kids.",
      metrics: [
        { label: "MAU", value: "2,500,000" },
        { label: "POPS Kids Users", value: "400,000" },
        { label: "YoY Growth", value: "10x" }
      ]
    },
    highlights: [
      { title: "Programmatic Internal Linking", description: "Connecting related anime & entertainment episodes to pass authority." },
      { title: "Core Web Vitals Optimization", description: "Sub-second LCP and zero CLS across video streaming landing pages." }
    ]
  };
} else if (project.slug === "tomato-childrens-home") {
  comparisonData = {
    badge: "Enrollment Performance",
    heading: "From Expensive Leads to Scaled Enrollment Growth",
    description: "Compare the enrollment funnel before and after paid media, landing-page, and lifecycle optimization.",
    categoryLabel: "Marketing 360",
    beforeLabel: "High CPL Baseline",
    afterLabel: "Growth Loop",
    beforeImage: {
      src: "/images/tomato/tomato-before.png",
      alt: "TOMATO Children's Home Enrollment Baseline (Before)",
    },
    afterImage: {
      src: "/images/tomato/tomato-after.png",
      alt: "TOMATO Children's Home High Conversion Funnel (After)",
    },
    beforePanel: {
      eyebrow: "Before",
      title: "High-friction funnel",
      description: "Lead generation needed stronger channel decisions, clearer landing pages, and more consistent lifecycle follow-up.",
      metrics: [
        { label: "Cost per lead", value: "High" },
        { label: "Campaign flow", value: "Split" },
        { label: "Lifecycle ops", value: "Manual" }
      ]
    },
    afterPanel: {
      eyebrow: "After",
      title: "Enrollment growth loop",
      description: "Integrated marketing connected social, landing pages, paid media, OOH, CRM, and email automation around student enrollment.",
      metrics: [
        { label: "Monthly enrollment", value: "3x" },
        { label: "Cost per lead", value: "-60%" },
        { label: "CTR increase", value: "+85%" }
      ]
    },
    highlights: [
      { title: "Lower acquisition cost", description: "Budget decisions and funnel fixes reduced CPL while enrollment grew." },
      { title: "Sharper creative", description: "Campaign and landing-page messaging improved click intent." },
      { title: "Automated nurture", description: "Email automation supported follow-up across 40,000+ contacts." }
    ]
  };
}
---

<DashboardLayout
  title={`${project.title} | Case Study — Phuc Loc Nguyen`}
  pageTitle={project.title}
  description={project.summary}
  breadcrumbs={[
    { label: "Workspace", href: "/" },
    { label: "Selected work", href: "/work" },
    { label: project.title }
  ]}
  maxWidthVariant="default"
>
  <!-- Back to work & External link bar -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-6); font-size: 0.8125rem;">
    <a 
      href="/work" 
      class="dash-link"
      style="display: inline-flex; align-items: center; gap: 4px; color: var(--dash-muted);"
    >
      <ArrowLeft size={14} aria-hidden="true" />
      <span>All case studies</span>
    </a>

    {project.link && (
      <a 
        href={project.link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="dash-link"
        style="color: var(--dash-accent); display: inline-flex; align-items: center; gap: 4px;"
      >
        <span>{project.linkLabel || "Live project"}</span>
        <ExternalLink size={12} aria-hidden="true" />
      </a>
    )}
  </div>

  <!-- Page Introduction (Open document surface) -->
  <header class="page-header">
    <h1 class="page-title">{project.title}</h1>
    <p class="page-lead">{project.summary}</p>

    <!-- Properties List -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; padding: 16px 0; border-top: 1px solid var(--dash-border); border-bottom: 1px solid var(--dash-border); font-size: 0.8125rem;">
      <div>
        <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Role</span>
        <span style="font-weight: 600; color: var(--dash-text);">{project.role}</span>
      </div>
      <div>
        <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Timeline</span>
        <span style="color: var(--dash-text);">{project.year}</span>
      </div>
      <div>
        <span style="color: var(--dash-muted); display: block; margin-bottom: 2px;">Client / Platform</span>
        <span style="color: var(--dash-text);">{project.client}</span>
      </div>
    </div>
  </header>

  <!-- Interactive Before / After Comparison -->
  {comparisonData && (
    <section class="page-section" aria-label="Performance comparison">
      <h2 class="section-title">Performance breakdown</h2>
      <p style="font-size: 0.875rem; color: var(--dash-muted); margin: 0 0 16px;">
        {comparisonData.description}
      </p>

      <BeforeAfterPerformance {...comparisonData} />
    </section>
  )}

  <!-- Strategic Narrative & Execution -->
  <section class="page-section work-narrative-section" aria-labelledby="heading-narrative">
    <h2 id="heading-narrative" class="section-title">Context, strategy & execution</h2>
    
    <div class="dash-prose work-narrative-prose">
      {descriptionParagraphs.map((para) => (
        <p>{para}</p>
      ))}
    </div>
  </section>

  <!-- Special Feed for WorkFlow Space -->
  {project.slug === "workflow-space" && (
    <section class="page-section" aria-label="Visual identity feed">
      <h2 class="section-title">Brand visual architecture (@workflowspace)</h2>
      <p style="font-size: 0.875rem; color: var(--dash-muted); margin: 0 0 16px;">
        Harmonized 4:5 lifestyle feeds, ergonomic product storytelling, and branch interior atmosphere.
      </p>
      <BrandPositioningFeed />
    </section>
  )}

  <!-- Confidential Pass Gate -->
  {project.password && (
    <ShowcasePassGate id={project.slug} password={project.password} />
  )}

  <!-- More Case Studies -->
  <section class="page-section more-work-section" aria-labelledby="heading-more-work" style="border-top: 1px solid var(--dash-border); padding-top: var(--space-8);">
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-4);">
      <h2 id="heading-more-work" class="section-title" style="margin: 0;">More case studies</h2>
      <a href="/work" class="dash-link" style="font-size: 0.8125rem;">
        View directory →
      </a>
    </div>

    <div class="more-work-grid">
      {otherProjects.map((op) => (
        <a 
          href={`/work/${op.slug}`} 
          class="dash-card dash-card--interactive"
          style="padding: 14px; text-decoration: none;"
        >
          <div style="font-size: 0.75rem; color: var(--dash-muted); margin-bottom: 4px;">
            {op.client}
          </div>
          <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--dash-text); margin: 0 0 8px;">
            {op.title}
          </h3>
          <span style="font-size: 0.75rem; color: var(--dash-accent); display: inline-flex; align-items: center; gap: 2px;">
            <span>Read case study</span>
            <ChevronRight size={11} aria-hidden="true" />
          </span>
        </a>
      ))}
    </div>
  </section>

</DashboardLayout>

<style>
  .work-narrative-section,
  .more-work-section {
    max-width: 500px;
    width: 100%;
  }

  .work-narrative-prose {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 500px;
    width: 100%;
    color: var(--dash-text);
    font-size: 1rem;
    line-height: 1.68;
  }

  .work-narrative-prose p {
    margin: 0;
    text-align: justify;
    text-align-last: left;
    text-wrap: pretty;
    hyphens: auto;
  }

  .more-work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }

  @media (max-width: 640px) {
    .work-narrative-section,
    .more-work-section,
    .work-narrative-prose {
      max-width: 100%;
    }

    .work-narrative-prose {
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    .work-narrative-prose p {
      text-align: left;
    }
  }
</style>
