---
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/cms";
import BlurFade from "../../components/ui/BlurFade.astro";
import BeforeAfterPerformance from "../../components/ui/BeforeAfterPerformance";
import type { BeforeAfterPerformanceProps } from "../../components/ui/BeforeAfterPerformance";
import ShowcasePassGate from "../../components/ui/ShowcasePassGate.astro";
import { absoluteUrl, pageSchema } from "../../lib/seo";
import { ExternalLink } from "lucide-react";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const projects = await getProjects();
const project = projects.find((p) => p.slug === slug);

if (!project) {
  return Astro.redirect("/work");
}

const otherProjects = projects.filter((p) => p.slug !== slug).slice(0, 3);

const performanceComparisons: Record<string, BeforeAfterPerformanceProps> = {
  playah: {
    badge: "",
    heading: "From fragmented spend to scalable growth.",
    description: "A draggable before/after view for the performance system behind the PlayAh! case study.",
    beforeLabel: "Before",
    afterLabel: "After",
    beforeImage: {
      src: "/images/playah/playah-before.png?v=before-125801419",
      alt: "PlayAh! Baseline Spend & Channel Performance (Before)",
    },
    afterImage: {
      src: "/images/playah/playah-after.png?v=after-146b",
      alt: "PlayAh! Scaled Conversion Engine Performance (After)",
    },
    beforePanel: {
      eyebrow: "Before",
      title: "Fragmented acquisition",
      description: "Paid media, TikTok Shop, and web conversion work were not yet operating as one measurable growth loop.",
      metrics: [
        { value: "1×", label: "Revenue baseline" },
        { value: "0", label: "TikTok Shop GMV" },
        { value: "Manual", label: "Funnel learning" },
      ],
    },
    afterPanel: {
      eyebrow: "After",
      title: "Scaled conversion engine",
      description: "Performance Max, Spark Ads, Meta conversion campaigns, and Shop operations worked together around ROAS guardrails.",
      metrics: [
        { value: "10×", label: "Website revenue" },
        { value: "30×+", label: "Shop GMV growth" },
        { value: "10+", label: "Maintained ROAS" },
      ],
    },
    highlights: [
      { id: "playah-1", icon: "zap", title: "Faster learning loop", description: "Creative, budget, and channel decisions connected to weekly performance signals." },
      { id: "playah-2", icon: "sparkles", title: "Cleaner funnel view", description: "Website, TikTok Shop, and paid media outcomes moved into one optimization model." },
      { id: "playah-3", icon: "check", title: "ROAS-first scaling", description: "Growth focused on profitable expansion instead of raw spend increases." },
    ],
  },
  "workflow-space": {
    badge: "Launch performance",
    heading: "From launch setup to lead engine.",
    description: "Compare the branch-launch baseline with the optimized paid funnel after creative and landing-page iteration.",
    beforeLabel: "Before",
    afterLabel: "After",
    beforeImage: {
      src: "/images/workflow/workflow-before.jpg",
      alt: "WorkFlow Space Launch Setup Baseline (Before)",
    },
    afterImage: {
      src: "/images/workflow/workflow-after.png",
      alt: "WorkFlow Space Optimized Lead Machine (After)",
    },
    beforePanel: {
      eyebrow: "Before",
      title: "New branch baseline",
      description: "New locations needed campaign structure, landing-page clarity, and creative testing before paid traffic could scale.",
      metrics: [
        { value: "0", label: "Launch leads" },
        { value: "New", label: "Branch funnel" },
        { value: "Manual", label: "Reporting flow" },
      ],
    },
    afterPanel: {
      eyebrow: "After",
      title: "Qualified lead system",
      description: "Campaigns, landing pages, dashboards, and creative production were connected into a repeatable branch-launch machine.",
      metrics: [
        { value: "2,000+", label: "Qualified leads" },
        { value: "4M+", label: "Impressions" },
        { value: "35–40%", label: "Website CVR" },
      ],
    },
    highlights: [
      { id: "workflow-1", icon: "check", title: "Landing-page clarity", description: "Paid traffic had a sharper destination for inquiry and booking intent." },
      { id: "workflow-2", icon: "zap", title: "Creative throughput", description: "200+ assets supported faster testing across branch campaigns." },
      { id: "workflow-3", icon: "sparkles", title: "Dashboard feedback", description: "Looker-style reporting made weekly optimization easier to read." },
    ],
  },
  "pops-worldwide": {
    badge: "SEO performance",
    heading: "From roadmap backlog to organic scale.",
    description: "A before/after view of the technical SEO execution that helped scale POPS properties.",
    beforeLabel: "Before",
    afterLabel: "After",
    beforeImage: {
      src: "/images/pops/pops-before.png",
      alt: "POPS Worldwide Organic SEO Baseline (Before)",
    },
    afterImage: {
      src: "/images/pops/pops-after.png",
      alt: "POPS Worldwide Scaled Organic Traffic (After)",
    },
    beforePanel: {
      eyebrow: "Before",
      title: "Technical SEO backlog",
      description: "SEO opportunities needed prioritization across data, product, and technology teams before compounding growth could happen.",
      metrics: [
        { value: "Backlog", label: "Tech SEO work" },
        { value: "Split", label: "Team ownership" },
        { value: "Slow", label: "Organic loop" },
      ],
    },
    afterPanel: {
      eyebrow: "After",
      title: "Organic growth system",
      description: "Roadmap execution tied product improvements, technical fixes, and content surfaces to measurable user growth.",
      metrics: [
        { value: "10×", label: "Monthly users" },
        { value: "2.5M", label: "Users / month" },
        { value: "400K", label: "POPS Kids users" },
      ],
    },
    highlights: [
      { id: "pops-1", icon: "check", title: "Prioritized roadmap", description: "SEO work moved from scattered requests to planned technical delivery." },
      { id: "pops-2", icon: "zap", title: "Faster indexability", description: "Technical fixes improved the path from publishing to discoverability." },
      { id: "pops-3", icon: "sparkles", title: "New property growth", description: "POPS Kids and POPS Kids Learn launched with clearer organic foundations." },
    ],
  },
  "tomato-childrens-home": {
    badge: "Enrollment performance",
    heading: "From expensive leads to efficient enrollment.",
    description: "Compare the enrollment funnel before and after paid media, landing-page, and lifecycle optimization.",
    beforeLabel: "Before",
    afterLabel: "After",
    beforeImage: {
      src: "/images/tomato/tomato-before.png",
      alt: "TOMATO Children's Home Enrollment Baseline (Before)",
    },
    afterImage: {
      src: "/images/tomato/tomato-after.png",
      alt: "TOMATO Children's Home High Conversion Funnel (After)",
    },
    beforePanel: {
      eyebrow: "Before",
      title: "High-friction funnel",
      description: "Lead generation needed stronger channel decisions, clearer landing pages, and more consistent lifecycle follow-up.",
      metrics: [
        { value: "High", label: "Cost per lead" },
        { value: "Split", label: "Campaign flow" },
        { value: "Manual", label: "Lifecycle ops" },
      ],
    },
    afterPanel: {
      eyebrow: "After",
      title: "Enrollment growth loop",
      description: "Integrated marketing connected social, landing pages, paid media, OOH, CRM, and email automation around student enrollment.",
      metrics: [
        { value: "3×", label: "Monthly enrollment" },
        { value: "-60%", label: "Cost per lead" },
        { value: "+85%", label: "CTR increase" },
      ],
    },
    highlights: [
      { id: "tomato-1", icon: "check", title: "Lower acquisition cost", description: "Budget decisions and funnel fixes reduced CPL while enrollment grew." },
      { id: "tomato-2", icon: "sparkles", title: "Sharper creative", description: "Campaign and landing-page messaging improved click intent." },
      { id: "tomato-3", icon: "zap", title: "Automated nurture", description: "Email automation supported follow-up across 40,000+ contacts." },
    ],
  },
};

const performanceComparison = project.slug === "playah" ? performanceComparisons.playah : undefined;
const projectPassword = project.password || `${project.slug.split("-")[0]}2026`;
const gateDescriptions: Record<string, string> = {
  playah: "Unlock internal campaign dashboards, TikTokShop KOC booking pipelines, Meta-to-Web ad metrics, and AI sales conversation flows for PlayAh! Vietnam.",
  "tomato-childrens-home": "Unlock full-funnel Marketing 360 campaign visuals, student enrollment CPL reduction analytics, landing page variations, and 40,000+ contact email automation workflows.",
  "workflow-space": "Unlock high-converting landing page UI components, Astro build performance specs, automated lead intake funnels, and design system assets.",
  "pops-worldwide": "Unlock digital media distribution analytics, audience engagement campaign assets, multi-platform publishing metrics, and content growth workflows.",
  "education-communities": "Unlock community growth dashboards, 4M+ member reach metrics, content distribution breakdowns, and student career guidance assets.",
};

const gateDescription = gateDescriptions[project.slug] || `Unlock confidential campaign dashboards, behind-the-scenes visuals, and key growth metrics for ${project.client || project.title}.`;

const showcaseGate = {
  id: `${project.slug}-showcase-gate`,
  password: [
    projectPassword,
    `${project.slug}2026`,
    `${project.slug}2024`,
    "workflow2024",
    "workflow2026",
    "loc2026",
  ],
  storageKey: `${project.slug}-showcase-unlocked`,
  eyebrow: "Private showcase",
  title: `Unlock ${project.client || project.title} visuals.`,
  description: gateDescription,
  inputLabel: "Access code",
  placeholder: "Enter access code",
  buttonLabel: "Unlock",
  successLabel: "Access granted",
};

const paragraphs = project.description.split("\n\n").filter(Boolean);
const projectUrl = absoluteUrl(`/work/${project.slug}`);
const projectLinkLabel = project.linkLabel?.replace(/\s*->\s*$/, "") ?? "Visit site";
const creativeWorkSchema = {
  "@type": "CreativeWork",
  "@id": `${projectUrl}#case-study`,
  name: project.title,
  description: project.summary,
  ...(project.coverImage ? { image: absoluteUrl(project.coverImage) } : {}),
  url: projectUrl,
  dateCreated: project.year,
  creator: { "@id": `${absoluteUrl("/")}#person` },
  keywords: project.tags,
  mentions: {
    "@type": "Organization",
    name: project.client,
    url: project.link,
  },
};
---

<Layout
  title={`${project.title} | Phuc Loc Nguyen`}
  description={project.summary}
  schema={[
    pageSchema({
      url: projectUrl,
      title: `${project.title} | Phuc Loc Nguyen`,
      description: project.summary,
      type: "WebPage",
    }),
    creativeWorkSchema,
  ]}
>
  <main class="min-h-screen bg-background text-foreground case-study-page">

    <!-- HERO TITLE SECTION -->
    <div class="relative overflow-hidden px-[var(--page-gutter)] pt-0 pb-16 border-b border-border">
      <div class="relative z-10 mx-auto max-w-[1280px]">
        <div>
          <p class="font-mono-label text-accent mb-4">Case study · {project.client}</p>
          
          <BlurFade>
            <h1 class="font-display text-display-sm sm:text-display-md md:text-display-lg leading-[1.05] tracking-[-0.025em] text-foreground">
              {project.title}
            </h1>
          </BlurFade>
        </div>
      </div>
    </div>

    <!-- SUMMARY SECTION -->
    <div class="border-b border-border">
      <div class="px-[var(--page-gutter)] py-12 md:py-16">
        <div class="mx-auto max-w-[1280px]">
          <div class="space-y-10">
              <dl class="divide-y divide-border max-w-5xl">
                {project.role && (
                  <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                    <dt class="font-mono-label text-foreground">Role</dt>
                    <dd class="text-body-lg leading-[1.55] text-foreground/85">
                      {project.role}
                    </dd>
                  </div>
                )}

                {project.year && (
                  <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                    <dt class="font-mono-label text-foreground">Timeline</dt>
                    <dd class="text-body-lg leading-[1.55] text-foreground/85 font-mono text-[14px]">
                      {project.year}
                    </dd>
                  </div>
                )}

                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                  <dt class="font-mono-label text-foreground">Background</dt>
                  <dd class="text-body-lg leading-[1.55] text-foreground/85">
                    {project.summary}
                  </dd>
                </div>

                {paragraphs[0] && (
                  <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                    <dt class="font-mono-label text-foreground">Problem</dt>
                    <dd class="text-body-lg leading-[1.55] text-foreground/85">{paragraphs[0]}</dd>
                  </div>
                )}

                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                  <dt class="font-mono-label text-foreground">Approach</dt>
                  <dd class="text-body-lg leading-[1.55] text-foreground/85">
                    {paragraphs[1] || project.tags.join(" · ")}
                  </dd>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                  <dt class="font-mono-label text-foreground">Outcome</dt>
                  <dd class="text-body-lg leading-[1.55] text-foreground/85">
                    {paragraphs[2] || "Successfully executed strategy and delivered high performance growth."}
                  </dd>
                </div>

                {project.link && (
                  <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                    <dt class="font-mono-label text-foreground">Live Site</dt>
                    <dd class="text-body-lg leading-[1.55] text-foreground/85">
                      <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 underline underline-offset-4 hover:text-accent transition-colors">
                        <span>{projectLinkLabel}</span>
                        <ExternalLink size={13} strokeWidth={1.8} />
                      </a>
                    </dd>
                  </div>
                )}
              </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT SECTION -->
    <div class="px-[var(--page-gutter)]">
      <div class="mx-auto max-w-[1280px]">
        <!-- MAIN BODY CONTENT -->
        <div>
          {performanceComparison && <BeforeAfterPerformance client:load {...performanceComparison} />}

          <!-- EXTRA IMAGES SHOWCASE GALLERY -->
          <section id="showcase" class="py-20 border-b border-border/40 last:border-0 scroll-mt-20">
            <div>
              <p class="font-mono-label text-accent">Showcase</p>
              {(project.slug.includes("workflow") || project.slug.includes("tomato")) && (
                <h2 class="mt-3 font-display text-display-xs leading-[1.2] tracking-[-0.02em] text-foreground">
                  Project Visuals
                </h2>
              )}
            </div>

            <ShowcasePassGate {...showcaseGate}>
              <div class="mt-10 space-y-6">
                {project.images && project.images.length > 0 ? (
                  project.images.map((imgUrl, idx) => (
                    <div class="w-full rounded-xl overflow-hidden bg-secondary border border-border p-4">
                      <img
                        src={imgUrl}
                        alt={`${project.title} image ${idx + 1}`}
                        loading="lazy"
                        decoding="async"
                        class="block w-full h-auto object-contain rounded-lg"
                      />
                    </div>
                  ))
                ) : (
                  <div class="w-full rounded-xl overflow-hidden bg-secondary border border-border p-8 text-center text-muted-foreground font-mono text-sm">
                    Visual assets protected and available upon request.
                  </div>
                )}
              </div>
            </ShowcasePassGate>
          </section>
        </div>

      </div>

      <!-- MORE CASE STUDIES SECTION -->
      {otherProjects.length > 0 && (
        <div class="mx-auto max-w-[1280px]">
          <div>
            <section class="py-16 mt-8">
              <p class="font-mono-label text-muted-foreground mb-5">More case studies</p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {otherProjects.map((item) => (
                <a
                  href={`/work/${item.slug}`}
                  class="more-case-card group block rounded-[6px] border border-border bg-card overflow-hidden transition-all duration-300"
                >
                  <div class="w-full aspect-[16/9] max-h-[180px] bg-secondary overflow-hidden flex items-center justify-center p-2.5">
                    {item.coverImage ? (
                      <img
                        src={item.coverImage}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover rounded-[6px]"
                      />
                    ) : item.images && item.images[0] ? (
                      <img
                        src={item.images[0]}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover rounded-[6px]"
                      />
                    ) : (
                      <div class="w-full h-full bg-secondary flex items-center justify-center text-muted font-mono text-xs">
                        {item.client}
                      </div>
                    )}
                  </div>
                  <div class="p-4">
                    <h3 class="font-display more-case-title mb-1 text-foreground group-hover:text-accent transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-caption more-case-excerpt text-muted-foreground leading-relaxed line-clamp-2">
                      {item.summary}
                    </p>
                  </div>
                </a>
              ))}
              </div>
            </section>
          </div>
        </div>
      )}
    </div>

  </main>
</Layout>

<style>
  .case-study-page {
    background-color: var(--bg);
    color: var(--text);
    padding-top: calc(var(--hdr-h) + 64px);
    padding-bottom: 120px;
  }

  .font-mono-label {
    font-family: var(--mono);
    font-size: var(--type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .font-display {
    font-family: var(--serif);
    font-weight: 400;
  }

  .text-display-lg {
    font-size: var(--type-display-lg);
    line-height: 1.04;
  }

  .text-display-md {
    font-size: var(--type-display);
    line-height: 1.08;
  }

  .text-display-sm {
    font-size: var(--type-section-title);
    line-height: 1.1;
  }

  .text-display-xs {
    font-size: var(--type-card-title);
    line-height: 1.15;
  }

  .text-caption {
    font-family: var(--mono);
    font-size: var(--type-micro);
  }

  .text-body-lg {
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: var(--leading-prose);
  }

  .bg-secondary {
    background-color: color-mix(in srgb, var(--bg) 92%, #e2e2dd);
  }

  .more-case-card {
    background: color-mix(in srgb, var(--bg) 95%, #ffffff);
    border: 1px solid var(--divider);
    border-radius: 6px;
    text-decoration: none;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .more-case-card img {
    border-radius: 6px;
  }

  .more-case-title {
    font-family: var(--serif);
    font-size: 24px !important;
    font-weight: 400 !important;
    line-height: 1.25;
  }

  .more-case-excerpt {
    font-size: 12px !important;
  }

  .more-case-card:hover {
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.14), 0 0 24px -4px rgba(0, 0, 0, 0.06);
  }

</style>
