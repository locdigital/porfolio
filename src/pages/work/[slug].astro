---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getProjects } from "../../lib/cms";
import BeforeAfterPerformance from "../../components/ui/BeforeAfterPerformance.astro";
import ShowcasePassGate from "../../components/ui/ShowcasePassGate.astro";
import BrandPositioningFeed from "../../components/ui/BrandPositioningFeed.astro";
import { 
  ArrowLeft, 
  ExternalLink
} from "../../components/icons/majesticons";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const allProjects = await getProjects();
const project = Astro.props.project ?? allProjects.find((p) => p.slug === Astro.params.slug);

if (!project) {
  return Astro.redirect("/work");
}

const otherProjects = allProjects.filter((p) => p.slug !== project.slug).slice(0, 3);

// Content paragraphs
const descriptionParagraphs = Array.isArray(project.description) 
  ? project.description 
  : project.description
      .split(/\n{2,}/)
      .map((paragraph: string) => paragraph.trim())
      .filter(Boolean);

// Pre-configured comparison data for interactive Before/After module
let comparisonData: any = null;

if (project.slug === "playah") {
  comparisonData = {
    badge: "",
    heading: "From Static Brand Awareness to +10x TikTok Shop GMV",
    description: "Multi-layered comparison: scaling from tens of millions to >1B VND monthly revenue while maintaining ROAS > 10.",
    categoryLabel: "TikTok Shop Acceleration",
    beforeLabel: "Baseline (Th07/2025)",
    afterLabel: "Scaled Engine (Th08/2025)",
    beforeImage: {
      src: "/images/playah/playah-before.png",
      alt: "PlayAh! Doanh thu & GMV TikTok Shop trước tối ưu (Tháng 7/2025 — 125 triệu)",
    },
    afterImage: {
      src: "/images/playah/playah-after.png",
      alt: "PlayAh! Doanh thu & GMV TikTok Shop sau tối ưu (Tháng 8/2025 — 1.46 tỷ)",
    },
    beforePanel: {
      eyebrow: "Initial Phase",
      title: "Isolated Ad Spend",
      description: "Static Facebook ad sets without automated affiliate seeding, erratic CPA, and unintegrated conversion tracking.",
      metrics: [
        { label: "Monthly GMV", value: "30-50M" },
        { label: "Blended ROAS", value: "1.8x" },
        { label: "Affiliate Creators", value: "None" }
      ]
    },
    afterPanel: {
      eyebrow: "Optimized Phase",
      title: "1B+ / Month System",
      description: "Automated TikTok Shop affiliate engine + Meta conversion funnels maintaining >10 ROAS across product catalogs.",
      metrics: [
        { label: "Monthly GMV", value: "> 1,000M" },
        { label: "Blended ROAS", value: "> 10x" },
        { label: "Affiliate GMV", value: "65%" }
      ]
    },
    highlights: [
      { title: "Direct Affiliate Seeding", description: "Hundreds of creator samples routed automatically based on category GMV potential." },
      { title: "Server-Side Tracking", description: "Meta CAPI + TikTok Events API deduplication for near 100% purchase attribution." }
    ]
  };
}
---

<DashboardLayout
  title={`${project.title} | Case Study — Phuc Loc Nguyen`}
  pageTitle={project.title}
  description={project.summary}
  breadcrumbs={[
    { label: "Workspace", href: "/" },
    { label: "Work", href: "/work" },
    { label: project.title }
  ]}
  maxWidthVariant="default"
>
  <!-- Back to work & External link bar -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-6); font-size: 0.8125rem;">
    <a 
      href="/work" 
      class="dash-link"
      style="display: inline-flex; align-items: center; gap: 4px; color: var(--dash-muted);"
    >
      <ArrowLeft size={14} aria-hidden="true" />
      <span>All case studies</span>
    </a>

    {project.link && (
      <a 
        href={project.link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="dash-link"
        style="color: var(--dash-accent); display: inline-flex; align-items: center; gap: 4px;"
      >
        <span>{project.linkLabel || "Live project"}</span>
        <ExternalLink size={12} aria-hidden="true" />
      </a>
    )}
  </div>

  <!-- Page Introduction (Open document surface) -->
  <header class="page-header">
    <h1 class="page-title">{project.title}</h1>
    <p class="page-lead">{project.summary}</p>

    <!-- Properties List -->
    <div class="project-properties" role="list" aria-label="Project properties">
      <div class="project-property" role="listitem">
        <span class="project-property-label">Role</span>
        <span class="project-property-value project-property-value--strong">{project.role}</span>
      </div>
      <div class="project-property" role="listitem">
        <span class="project-property-label">Timeline</span>
        <span class="project-property-value">{project.year}</span>
      </div>
      <div class="project-property" role="listitem">
        <span class="project-property-label">Client / Platform</span>
        <span class="project-property-value">{project.client}</span>
      </div>
    </div>
  </header>

  <!-- Interactive Before / After Comparison -->
  {comparisonData && (
    <section class="page-section" aria-label="Performance comparison">
      <h2 class="section-title">Performance breakdown</h2>
      <p style="font-size: 0.875rem; color: var(--dash-muted); margin: 0 0 16px;">
        {comparisonData.description}
      </p>

      <BeforeAfterPerformance {...comparisonData} />
    </section>
  )}

  <!-- Strategic Narrative & Execution -->
  <section class="page-section work-narrative-section" aria-labelledby="heading-narrative">
    <h2 id="heading-narrative" class="section-title">Context, strategy & execution</h2>
    
    <div class="dash-prose work-narrative-prose">
      {descriptionParagraphs.map((para) => (
        <p>{para}</p>
      ))}
    </div>
  </section>

  <!-- Special Feed for WorkFlow Space -->
  {project.slug === "workflow-space" && (
    <section class="page-section" aria-label="Brand positioning and visual identity">
      <BrandPositioningFeed />
    </section>
  )}

  <!-- Confidential Pass Gate -->
  {project.password && (
    <ShowcasePassGate id={project.slug} password={project.password} />
  )}

  <!-- More Case Studies -->
  <section class="page-section more-work-section" aria-labelledby="heading-more-work" style="border-top: var(--dash-border-width, 0.9px) solid var(--dash-border); padding-top: calc(var(--space-8) * 1.1);">
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-4);">
      <h2 id="heading-more-work" class="section-title" style="margin: 0;">More case studies</h2>
      <a href="/work" class="dash-link" style="font-size: 0.8125rem;">
        View directory →
      </a>
    </div>

    <div class="more-work-grid">
      {otherProjects.map((op) => (
        <div class="folder-item">
          <a 
            href={`/work/${op.slug}`} 
            class="folder-wrapper"
            aria-label={`Open case study folder: ${op.title}`}
          >
            <!-- 3D MANILA FOLDER -->
            <div class="folder" data-folder-surface>
              <!-- 1. BACK FOLDER FLAP -->
              <div class="folder-back">
                <div class="folder-back-tab"></div>
              </div>

              <!-- 2. FRONT FOLDER FLAP -->
              <div class="folder-front">
                <div class="folder-front-tab"></div>
                <div class="folder-front-shine"></div>
              </div>

              <!-- 3. AMBIENT FLOOR SHADOW -->
              <div class="folder-floor-shadow"></div>
            </div>

            <!-- FOLDER CAPTION -->
            <div class="folder-caption">
              <span class="folder-title">{op.title}</span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>

</DashboardLayout>

<style>
  .work-narrative-section {
    width: 100%;
  }

  .project-properties {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    margin: 0;
    padding: 16px 0;
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
    justify-items: stretch;
    align-items: start;
    text-align: left;
    font-family: var(--sans);
    font-size: 0.8125rem;
  }

  .project-property {
    min-width: 0;
    justify-self: stretch;
    text-align: left;
  }

  .project-property-label,
  .project-property-value {
    display: block;
    text-align: left;
  }

  .project-property-label {
    margin-bottom: 2px;
    color: var(--dash-muted);
  }

  .project-property-value {
    color: var(--dash-text);
    overflow-wrap: anywhere;
  }

  .project-property-value--strong {
    font-weight: 600;
  }

  .more-work-section {
    width: 100%;
  }

  .work-narrative-prose {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    color: var(--dash-text);
    font-size: 0.9375rem;
    line-height: 1.68;
  }

  .work-narrative-prose p {
    max-width: none;
    width: 100%;
    margin: 0;
    text-align: left;
    text-wrap: pretty;
  }

  .more-work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 184px));
    column-gap: 28px;
    row-gap: 32px;
    padding: 16px 0 24px;
  }

  .more-work-grid .folder-item {
    justify-content: flex-start;
  }

  @media (max-width: 680px) {
    .more-work-grid {
      grid-template-columns: repeat(2, minmax(0, 184px));
      column-gap: 20px;
      row-gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .project-properties {
      grid-template-columns: 1fr;
      gap: 10px;
      padding-block: 14px;
    }

    .work-narrative-section,
    .work-narrative-prose {
      max-width: 100%;
    }

    .work-narrative-prose {
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    .work-narrative-prose p {
      text-align: left;
    }

    .more-work-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 8px;
      -webkit-overflow-scrolling: touch;
      gap: 18px;
      margin-inline: -8px;
      padding-inline: 8px;
      padding-top: 16px;
      padding-bottom: 24px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .more-work-grid::-webkit-scrollbar {
      display: none;
    }

    .more-work-grid .folder-item {
      flex: 0 0 158px;
      width: 158px;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 440px) {
    .more-work-grid {
      gap: 16px;
    }

    .more-work-grid .folder-item {
      flex-basis: 150px;
      width: 150px;
    }
  }
</style>
