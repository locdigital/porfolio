---
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/cms";
import BlurFade from "../../components/ui/BlurFade.astro";
import { absoluteUrl, pageSchema } from "../../lib/seo";
import { ExternalLink } from "lucide-react";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const projects = await getProjects();
const project = projects.find((p) => p.slug === slug);

if (!project) {
  return Astro.redirect("/work");
}

const otherProjects = projects.filter((p) => p.slug !== slug).slice(0, 2);

// Split description into paragraphs
const paragraphs = project.description.split("\n\n").filter(Boolean);
const projectUrl = absoluteUrl(`/work/${project.slug}`);
const projectLinkLabel = project.linkLabel?.replace(/\s*->\s*$/, "") ?? "Visit site";
const creativeWorkSchema = {
  "@type": "CreativeWork",
  "@id": `${projectUrl}#case-study`,
  name: project.title,
  description: project.summary,
  ...(project.coverImage ? { image: absoluteUrl(project.coverImage) } : {}),
  url: projectUrl,
  dateCreated: project.year,
  creator: { "@id": `${absoluteUrl("/")}#person` },
  keywords: project.tags,
  mentions: {
    "@type": "Organization",
    name: project.client,
    url: project.link,
  },
};
---

<Layout
  title={`${project.title} | Phuc Loc Nguyen`}
  description={project.summary}
  schema={[
    pageSchema({
      url: projectUrl,
      title: `${project.title} | Phuc Loc Nguyen`,
      description: project.summary,
      type: "WebPage",
    }),
    creativeWorkSchema,
  ]}
>
  <main class="min-h-screen bg-background text-foreground case-study-page">

    <!-- HERO TITLE SECTION -->
    <div class="relative overflow-hidden px-6 sm:px-12 md:px-20 pt-0 pb-16 border-b border-border">
      <div class="relative z-10 mx-auto max-w-[1100px]">
        <div>
          <p class="font-mono-label text-accent mb-4">Case study · {project.client}</p>
          
          <BlurFade>
            <h1 class="font-display text-display-sm sm:text-display-md md:text-display-lg leading-[1.05] tracking-[-0.025em] text-foreground">
              {project.title}
            </h1>
          </BlurFade>
        </div>
      </div>
    </div>

    <!-- TL;DR SECTION -->
    <div class="border-b border-border">
      <div class="px-6 sm:px-12 md:px-20 py-12 md:py-16">
        <div class="mx-auto max-w-[1100px]">
          <div class="md:grid md:grid-cols-[200px_1fr] md:gap-16">
            <div>
              <p class="font-mono-label text-foreground">TL;DR</p>
            </div>
            <div class="mt-4 md:mt-0 space-y-10">
              <dl class="divide-y divide-border max-w-3xl">
                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                  <dt class="font-mono-label text-foreground">Background</dt>
                  <dd class="text-body-lg leading-[1.55] text-foreground/85">
                    {project.client} ({project.year}). {project.summary}
                  </dd>
                </div>

                {paragraphs[0] && (
                  <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                    <dt class="font-mono-label text-foreground">Problem</dt>
                    <dd class="text-body-lg leading-[1.55] text-foreground/85">{paragraphs[0]}</dd>
                  </div>
                )}

                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                  <dt class="font-mono-label text-foreground">Approach</dt>
                  <dd class="text-body-lg leading-[1.55] text-foreground/85">
                    {paragraphs[1] || project.tags.join(" · ")}
                  </dd>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                  <dt class="font-mono-label text-foreground">Outcome</dt>
                  <dd class="text-body-lg leading-[1.55] text-foreground/85">
                    {paragraphs[2] || "Successfully executed strategy and delivered high performance growth."}
                  </dd>
                </div>

                {project.link && (
                  <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4 py-4 first:pt-0 last:pb-0">
                    <dt class="font-mono-label text-foreground">Live Site</dt>
                    <dd class="text-body-lg leading-[1.55] text-foreground/85">
                      <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 underline underline-offset-4 hover:text-accent transition-colors">
                        <span>{projectLinkLabel}</span>
                        <ExternalLink size={13} strokeWidth={1.8} />
                      </a>
                    </dd>
                  </div>
                )}
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT & SIDEBAR GRID SECTION -->
    <div class="px-6 sm:px-12 md:px-20">
      <div class="mx-auto max-w-[1100px] md:grid md:grid-cols-[200px_1fr] md:gap-16">
        
        <!-- STICKY TOC NAV -->
        <nav aria-label="Section navigation" class="hidden md:block pt-20 pb-20">
          <div class="sticky top-24">
            <ul class="space-y-3">
              <li>
                <a href="#overview" class="block text-body font-sans transition-colors text-foreground font-semibold">
                  Overview
                </a>
              </li>
              {project.images && project.images.length > 0 && (
                <li>
                  <a href="#showcase" class="block text-body font-sans transition-colors text-muted-foreground hover:text-foreground">
                    Showcase
                  </a>
                </li>
              )}
            </ul>
          </div>
        </nav>

        <!-- MAIN BODY CONTENT -->
        <div>
          <section id="overview" class="py-20 border-b border-border/40 last:border-0 scroll-mt-20">
            <div>
              <p class="font-mono-label text-accent">Overview</p>
              <h2 class="mt-3 font-display text-display-xs leading-[1.2] tracking-[-0.02em] text-foreground">
                {project.title}
              </h2>
            </div>

            <div class="mt-6 text-body sm:text-body-lg leading-[1.7] text-muted-foreground">
              <p set:html={project.summary} />

              <!-- 3 NUMBERED CARDS (01, 02, 03) -->
              {paragraphs.length > 0 && (
                <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-3">
                  {paragraphs.slice(0, 3).map((para, idx) => (
                    <div class="p-5 rounded-xl border border-border bg-secondary">
                      <div class="font-mono-label mb-3 text-accent">0{idx + 1}</div>
                      <p class="text-body-lg leading-[1.55] text-foreground" set:html={para} />
                    </div>
                  ))}
                </div>
              )}

              <div class="mt-6 space-y-4">
                {paragraphs.slice(3).map((para) => (
                  <p class="text-body sm:text-body-lg leading-[1.7] text-muted-foreground" set:html={para} />
                ))}
              </div>
            </div>
          </section>

          <!-- EXTRA IMAGES SHOWCASE GALLERY -->
          {project.images && project.images.length > 0 && (
            <section id="showcase" class="py-20 border-b border-border/40 last:border-0 scroll-mt-20">
              <div>
                <p class="font-mono-label text-accent">Showcase</p>
                <h2 class="mt-3 font-display text-display-xs leading-[1.2] tracking-[-0.02em] text-foreground">
                  Project Visuals
                </h2>
              </div>

              <div class="mt-10 space-y-6">
                {project.images.map((imgUrl, idx) => (
                  <div class="w-full rounded-xl overflow-hidden bg-secondary border border-border p-4">
                    <img
                      src={imgUrl}
                      alt={`${project.title} image ${idx + 1}`}
                      loading="lazy"
                      decoding="async"
                      class="block w-full h-auto object-contain rounded-lg"
                    />
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

      </div>

      <!-- MORE CASE STUDIES SECTION (Outside sticky TOC container so TOC stops scrolling above it) -->
      {otherProjects.length > 0 && (
        <div class="mx-auto max-w-[1100px] md:grid md:grid-cols-[200px_1fr] md:gap-16">
          <div class="hidden md:block"></div>
          <div>
            <section class="py-16 border-t border-border mt-8">
              <p class="font-mono-label text-muted-foreground mb-5">More case studies</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {otherProjects.map((item) => (
                <a
                  href={`/work/${item.slug}`}
                  class="more-case-card group block rounded-xl border border-border bg-card overflow-hidden transition-all duration-300"
                >
                  <div class="w-full aspect-[16/9] max-h-[180px] bg-secondary overflow-hidden flex items-center justify-center p-2.5">
                    {item.coverImage ? (
                      <img
                        src={item.coverImage}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover rounded-lg"
                      />
                    ) : item.images && item.images[0] ? (
                      <img
                        src={item.images[0]}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover rounded-lg"
                      />
                    ) : (
                      <div class="w-full h-full bg-secondary flex items-center justify-center text-muted font-mono text-xs">
                        {item.client}
                      </div>
                    )}
                  </div>
                  <div class="p-4">
                    <h3 class="font-display more-case-title mb-1 text-foreground group-hover:text-accent transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-caption text-muted-foreground leading-relaxed line-clamp-2">
                      {item.summary}
                    </p>
                  </div>
                </a>
              ))}
              </div>
            </section>
          </div>
        </div>
      )}
    </div>

  </main>
</Layout>

<style>
  .case-study-page {
    background-color: var(--bg);
    color: var(--text);
    padding-top: calc(var(--hdr-h) + 64px);
    padding-bottom: 120px;
  }

  .font-mono-label {
    font-family: var(--mono);
    font-size: var(--type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .font-display {
    font-family: var(--serif);
    font-weight: 400;
  }

  .text-display-lg {
    font-size: var(--type-display-lg);
    line-height: 1.04;
  }

  .text-display-md {
    font-size: var(--type-display);
    line-height: 1.08;
  }

  .text-display-sm {
    font-size: var(--type-section-title);
    line-height: 1.1;
  }

  .text-display-xs {
    font-size: var(--type-card-title);
    line-height: 1.15;
  }

  .text-caption {
    font-family: var(--mono);
    font-size: var(--type-micro);
  }

  .text-body-lg {
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: var(--leading-prose);
  }

  .bg-secondary {
    background-color: color-mix(in srgb, var(--bg) 92%, #e2e2dd);
  }

  .more-case-card {
    background: color-mix(in srgb, var(--bg) 95%, #ffffff);
    border: 1px solid var(--divider);
    border-radius: 14px;
    text-decoration: none;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .more-case-title {
    font-family: var(--serif);
    font-size: 18px !important;
    font-weight: 400 !important;
    line-height: 1.25;
  }

  .more-case-card:hover {
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.14), 0 0 24px -4px rgba(0, 0, 0, 0.06);
  }

</style>
