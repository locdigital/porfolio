---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";

const pageTitle = "Nguyen Phuc Loc | Classic Portfolio View";
const pageDescription = "Senior Performance Marketing Executive scaling multi-channel paid media, TikTok Shop GMV, SEO growth, and AI-powered conversion funnels.";
---
<Layout
  title={pageTitle}
  description={pageDescription}
  schema={[
    pageSchema({
      url: absoluteUrl("/classic"),
      title: pageTitle,
      description: pageDescription,
      type: "ProfilePage",
    }),
  ]}
>
  <!-- Notice Bar to switch back to the New Workspace Dashboard -->
  <div style="background:#0075DE;color:#FFFFFF;padding:0.6rem 1rem;font-size:0.8125rem;text-align:center;font-family:var(--sans);position:sticky;top:0;z-index:9999;display:flex;align-items:center;justify-content:center;gap:0.75rem;">
    <span>Viewing <strong>Classic Editorial Layout</strong>. Compare with the new personal workspace:</span>
    <a href="/" style="background:#FFFFFF;color:#0075DE;padding:0.25rem 0.75rem;border-radius:4px;font-weight:600;text-decoration:none;font-size:0.75rem;">
      Return to Workspace Dashboard ↗
    </a>
  </div>

  <main style="display:flex;flex-direction:column;min-height:85vh;justify-content:center;">

    <!-- CAREER MAP -->
    <section class="career-map toki-r" data-d="1" aria-label="Past, current, and future work">
      <div class="container career-map-container">
        <div class="career-map-intro career-map-intro--horizontal t-stagger">
          <div class="career-map-statement">
            <h1 class="career-map-title career-map-title--typing t-stagger-line t-stagger-line--1" style="line-height: 0.96 !important;">
              <span class="typing-line" style="--steps: 14; --target: 14ch; --typing-delay: 0ms;">Design Better.</span>
              <span class="typing-line" style="--steps: 15; --target: 15ch; --typing-delay: 820ms;">Market Smarter.</span>
              <span class="typing-line" style="--steps: 13; --target: 13ch; --typing-delay: 1640ms;">Scale Faster.</span>
            </h1>
            <p class="career-map-description t-stagger-line t-stagger-line--2">
              Senior Performance Marketing Executive scaling multi-channel paid media, TikTok Shop GMV, and landing page funnels&mdash;connecting creative production with full-funnel analytics to turn ad spend into measurable revenue.
            </p>
          </div>

          <div class="career-map-copy">
            <div class="career-map-copy-item career-map-copy-item--current">
              <span>Now</span>
              <p>
                Exploring what’s next.<br />Open to new opportunities in performance marketing, e-commerce growth, and digital strategy.
              </p>
            </div>
            <div class="career-map-copy-item">
              <span>Systems</span>
              <p>
                Connecting the growth engine.<br />Turning media spend into measurable revenue across TikTok Shop, Shopee, Meta, Google, and conversion-focused landing pages.
              </p>
            </div>
            <div class="career-map-copy-item">
              <span>Focus</span>
              <p>
                Growth beyond the click.<br />Scaling GMV, improving acquisition efficiency, and building creative testing systems that drive business outcomes. <a href="mailto:hi@loc.digital?subject=Hi%20Loc">Let’s talk.</a>
              </p>
            </div>
            <small>SAIGON, VIETNAM / PERFORMANCE MARKETING, TIKTOK SHOP, AI FUNNELS</small>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
