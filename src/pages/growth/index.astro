---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getGrowthPlaybooks, getProjects } from "../../lib/content";
import { canonicalUrl, collectionPageSchema } from "../../lib/seo";
import { ChevronLeft, ChevronRight } from "../../components/icons/phosphor";
import Heroicon from "../../components/icons/Heroicon.astro";
import ContributionSkyline from "../../components/ui/contribution-skyline";

export const prerender = true;

const projects = await getProjects();
const playbooks = await getGrowthPlaybooks();

const projectBySlug = new Map(projects.map((p) => [p.slug, p]));

const clusters = [
  {
    id: "meta-ads-scaling",
    title: "Meta Ads Scaling & Creative Testing",
    summary:
      "Campaign structure, creative hook testing, horizontal versus vertical scaling readiness, funnel segmentation, delivery diagnostics, and incrementality guardrails.",
    caseSlugs: ["workflow-space", "playah", "tomato-childrens-home"],
    topics: [
      "Campaign structure & consolidation",
      "Creative testing systems & fatigue",
      "Horizontal vs. vertical scaling",
      "Server-side CAPI & attribution checks",
    ],
  },
  {
    id: "tiktok-shop-gmv",
    title: "TikTok Shop GMV Scaling",
    summary:
      "Decomposing TikTok Shop GMV across paid Spark Ads, creator/KOC affiliate seeding, live commerce, product assortment, conversion rate, and margin discipline.",
    caseSlugs: ["playah"],
    topics: [
      "GMV decomposition & unit economics",
      "Affiliate & KOC creator pipelines",
      "TikTok Shop Ads vs. blended MER",
      "Commission, returns & contribution margin",
    ],
  },
  {
    id: "google-ads",
    title: "Google Ads & Search / Performance Max",
    summary:
      "Intent-led Search architecture, Performance Max asset & feed hygiene, brand vs. non-brand separation, and offline/server conversion quality.",
    caseSlugs: ["workflow-space", "playah"],
    topics: [
      "Search intent segmentation",
      "Performance Max & Shopping feeds",
      "Brand vs. non-brand incrementality",
      "Enhanced conversions & lead quality",
    ],
  },
  {
    id: "unit-economics",
    title: "Unit Economics & Measurement",
    summary:
      "Connecting platform metrics (ROAS, CPA, CPL) with blended business health (MER, CAC, LTV, payback period, and contribution profit before scaling budget).",
    caseSlugs: ["playah", "tomato-childrens-home", "sony"],
    topics: [
      "ROAS vs. MER vs. Contribution Profit",
      "Break-even ROAS & margin thresholds",
      "CAC payback & cohort retention",
      "Scenario modeling & budget pacing",
    ],
  },
  {
    id: "growth-architecture",
    title: "Growth Architecture, Technical SEO & Automation",
    summary:
      "Full-funnel acquisition systems connecting fast web experiences, CRO, GA4 server-side instrumentation, and AI-assisted marketing workflows.",
    caseSlugs: ["pops-worldwide", "sony", "education-communities"],
    topics: [
      "Technical SEO & organic scale",
      "Landing page CRO & booking flows",
      "GA4 & server-side event schemas",
      "CRM & AI workflow automation",
    ],
  },
];

const growthUrl = canonicalUrl("/growth");
const growthSchema = collectionPageSchema({
  url: growthUrl,
  title: "Growth & Performance Marketing Hub — Phuc Loc Nguyen",
  description:
    "Practical performance marketing architecture, unit economics formulas, topic clusters, and verified case studies by Phuc Loc Nguyen.",
  items: [
    {
      name: "Performance Marketing Formula Library",
      url: "/growth/metrics",
      description:
        "Definitions, assumptions, and limitations for ROAS, MER, CAC, CVR, AOV, Break-even ROAS, and Contribution Profit.",
    },
    ...projects.map((p) => ({
      name: p.title,
      url: `/work/${p.slug}`,
      description: p.summary,
    })),
    ...playbooks.map((pb) => ({
      name: pb.data.title,
      url: `/growth/${pb.slug}`,
      description: pb.data.summary,
    })),
  ],
  breadcrumbId: `${growthUrl}#breadcrumbs`,
});
---

<DashboardLayout
  title="Growth & Performance Marketing Hub — Phuc Loc Nguyen"
  pageTitle="Growth Hub"
  description="Practical growth systems, unit economics formulas, topic clusters, and field-tested case studies across Meta Ads, TikTok Shop, Google Ads, SEO, and CRO by Phuc Loc Nguyen."
  breadcrumbs={[{ label: "Workspace", href: "/" }, { label: "Growth Hub" }]}
  maxWidthVariant="default"
  schema={growthSchema}
>
  <header class="page-header">
    <h1 class="page-title">Growth & Performance Marketing</h1>
    <p class="page-lead">
      Structured methodologies, unit economics formulas, and campaign evidence by <a href="/about" class="dash-link" data-astro-prefetch>Phuc Loc Nguyen</a>—focused on turning ad spend and creative output into contribution profit rather than vanity platform numbers.
    </p>
  </header>

  <section class="page-section" aria-label="Contribution activity heatmap">
    <ContributionSkyline
      client:load
      title="Contribution activity · last 12 months"
      className="!border-0 !p-0"
      unit="activity"
      unitPlural="activities"
      palette="ocean"
      defaultView="2d"
      showToggle={false}
      showStats={false}
      orbit={false}
      footer="Hover a day or use the arrow keys to explore."
      seed={19}
    />
  </section>

  <section class="page-section" aria-labelledby="heading-clusters">
    <h2 id="heading-clusters" class="section-title">Five core topic clusters</h2>
    <div id="growth-clusters-track" class="growth-clusters-grid" tabindex="0" role="region" aria-label="Topic clusters carousel">
      {clusters.map((cluster) => (
        <article id={cluster.id} class="dash-card growth-cluster-card">
          <h3 class="growth-cluster-title">{cluster.title}</h3>
          <p class="growth-cluster-summary">{cluster.summary}</p>
          <ul class="growth-topic-list">
            {cluster.topics.map((topic) => (
              <li>
                <span class="dash-bullet" aria-hidden="true"></span>
                <span>{topic}</span>
              </li>
            ))}
          </ul>
          <div class="growth-cluster-links">
            <span class="growth-cluster-links-label">Related case studies:</span>
            <div class="growth-cluster-links-row">
              {cluster.caseSlugs.map((slug) => {
                const project = projectBySlug.get(slug);
                return project ? (
                  <a href={`/work/${project.slug}`} class="dash-link growth-case-link" data-astro-prefetch>
                    <Heroicon name="link" variant="outline" size={14} class="growth-case-link-icon" />
                    <span>{project.client}</span>
                  </a>
                ) : null;
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="growth-carousel-controls" aria-label="Topic clusters navigation">
      <button
        type="button"
        id="growth-carousel-prev"
        class="growth-carousel-btn"
        aria-label="Previous topic cluster"
        disabled
      >
        <ChevronLeft size={16} aria-hidden="true" />
      </button>
      <button
        type="button"
        id="growth-carousel-next"
        class="growth-carousel-btn"
        aria-label="Next topic cluster"
      >
        <ChevronRight size={16} aria-hidden="true" />
      </button>
    </div>
  </section>

  {playbooks.length > 0 && (
    <section class="page-section page-section--divided" aria-labelledby="heading-playbooks">
      <h2 id="heading-playbooks" class="section-title">Published playbooks</h2>
      <div class="growth-playbooks-list">
        {playbooks.map((pb) => (
          <article class="dash-card growth-playbook-card">
            <h3 class="growth-cluster-title">
              <a href={`/growth/${pb.slug}`} class="dash-link" data-astro-prefetch>
                {pb.data.title}
              </a>
            </h3>
            <p class="growth-cluster-summary">{pb.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="page-section page-section--divided" aria-labelledby="heading-reference-library">
    <h2 id="heading-reference-library" class="section-title">Marketing metrics</h2>
    <div class="dash-card" style="padding: 16px 20px;">
      <h3 class="item-title" style="font-size: calc(var(--text-h4) + 3px); margin: 0 0 6px;">
        <a href="/growth/metrics" class="dash-link growth-case-link" data-astro-prefetch>
          <Heroicon name="link" variant="outline" size={16} class="growth-case-link-icon" />
          <span>Formula library: ROAS, MER, CAC &amp; profit</span>
        </a>
      </h3>
      <p style="margin: 0; font-size: var(--text-body-sm); line-height: var(--leading-body); color: var(--dash-muted);">
        Definitions, assumptions, and guardrails for key growth metrics.
      </p>
    </div>
  </section>
</DashboardLayout>

<style>
  .growth-clusters-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 2px 2px 8px;
    margin: -2px -2px 0;
    cursor: grab;
  }

  .growth-clusters-grid::-webkit-scrollbar {
    display: none;
  }

  .growth-clusters-grid.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .growth-cluster-card,
  .growth-playbook-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .growth-cluster-card {
    flex: 0 0 clamp(300px, 38vw, 370px);
    scroll-snap-align: start;
  }

  .growth-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 10px;
  }

  .growth-carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    background: var(--dash-surface);
    color: var(--dash-text);
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, opacity 150ms ease;
  }

  .growth-carousel-btn:hover:not(:disabled) {
    background: var(--dash-hover);
    border-color: var(--dash-border-strong);
  }

  .growth-carousel-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 768px) {
    .growth-clusters-grid {
      gap: 14px;
      margin-inline: calc(var(--mobile-page-edge, 20px) * -1);
      padding-inline: var(--mobile-page-edge, 20px);
      scroll-padding-inline: var(--mobile-page-edge, 20px);
    }

    .growth-carousel-btn {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 640px) {
    .growth-cluster-card {
      flex: 0 0 min(85vw, 336px);
      padding: 18px 16px;
    }
  }

  .growth-cluster-title {
    margin: 0;
    font-size: calc(var(--text-h4) + 3px);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    color: var(--dash-text);
  }

  .growth-cluster-summary {
    margin: 0;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--dash-muted);
  }

  .growth-topic-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .growth-topic-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    color: var(--dash-text);
  }

  .growth-cluster-links {
    margin-top: auto;
    padding-top: 12px;
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
    font-size: var(--text-caption);
  }

  .growth-cluster-links-label {
    display: block;
    color: var(--dash-muted);
    margin-bottom: 4px;
  }

  .growth-cluster-links-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-size: var(--text-body-sm);
  }

  .growth-case-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .growth-case-link span {
    text-decoration: underline;
    text-decoration-color: var(--dash-underline, #858580);
    text-underline-offset: 1px;
    text-decoration-thickness: 0.5px;
    transition: text-decoration-color 150ms ease;
  }

  .growth-case-link:hover span {
    text-decoration-color: currentColor;
  }

  .growth-case-link-icon {
    flex: none;
  }

  .growth-playbooks-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }
</style>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const track = document.getElementById("growth-clusters-track");
    const prevBtn = document.getElementById("growth-carousel-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("growth-carousel-next") as HTMLButtonElement | null;
    if (!track || !prevBtn || !nextBtn) return;

    const getStep = () => {
      const card = track.querySelector<HTMLElement>(".growth-cluster-card");
      if (!card) return 340;
      const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || "16") || 16;
      return card.getBoundingClientRect().width + gap;
    };

    const syncButtons = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 2;
      nextBtn.disabled = maxScroll <= 2 || track.scrollLeft >= maxScroll - 2;
    };

    prevBtn.addEventListener(
      "click",
      () => {
        track.scrollBy({ left: -getStep(), behavior: "smooth" });
      },
      { signal },
    );

    nextBtn.addEventListener(
      "click",
      () => {
        track.scrollBy({ left: getStep(), behavior: "smooth" });
      },
      { signal },
    );

    track.addEventListener("scroll", syncButtons, { passive: true, signal });
    window.addEventListener("resize", syncButtons, { passive: true, signal });

    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;
    let dragged = false;

    track.addEventListener(
      "mousedown",
      (e) => {
        if ((e.target as HTMLElement).closest("a, button")) return;
        isDown = true;
        dragged = false;
        startX = e.pageX - track.offsetLeft;
        startScrollLeft = track.scrollLeft;
        track.classList.add("is-dragging");
      },
      { signal },
    );

    window.addEventListener(
      "mousemove",
      (e) => {
        if (!isDown) return;
        const x = e.pageX - track.offsetLeft;
        const walk = x - startX;
        if (Math.abs(walk) > 4) dragged = true;
        track.scrollLeft = startScrollLeft - walk;
      },
      { signal },
    );

    window.addEventListener(
      "mouseup",
      () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove("is-dragging");
      },
      { signal },
    );

    track.addEventListener(
      "click",
      (e) => {
        if (dragged) {
          e.preventDefault();
          dragged = false;
        }
      },
      { capture: true, signal },
    );

    syncButtons();
  });
</script>
