---
import type { CollectionEntry } from "astro:content";
import GrowthPlaybookPage from "../../components/growth/GrowthPlaybookPage.astro";
import { getGrowthPlaybooks } from "../../lib/content";

export const prerender = true;

export async function getStaticPaths() {
  const playbooks = await getGrowthPlaybooks();
  return playbooks.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"growth">;
}

const { entry } = Astro.props;
---

<GrowthPlaybookPage entry={entry} />
