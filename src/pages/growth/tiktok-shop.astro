---
import GrowthPillarPage from "../../components/growth/GrowthPillarPage.astro";
import { getGrowthPillarBySlug } from "../../data/growth-pillars";

export const prerender = true;

const pillar = getGrowthPillarBySlug("tiktok-shop");
if (!pillar) {
  throw new Error("Missing growth pillar config for tiktok-shop");
}
---

<GrowthPillarPage pillar={pillar} />
