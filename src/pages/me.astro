---
import Layout from "../layouts/Layout.astro";
import CursorAvatar from "../components/ui/CursorAvatar";
import { absoluteUrl, pageSchema } from "../lib/seo";

export const prerender = true;

const pageTitle = "Me | Phuc Loc Nguyen";
const pageDescription =
  "A more personal page for Phuc Loc Nguyen: work rhythm, current focus, photography, and a cursor-reactive avatar.";

const avatarImages = {
  center: "/images/avatar-poses/center.png",
  left: "/images/avatar-poses/left.png",
  right: "/images/avatar-poses/right.png",
  up: "/images/avatar-poses/up.png",
  down: "/images/avatar-poses/down.png",
  upLeft: "/images/avatar-poses/upLeft.png",
  upRight: "/images/avatar-poses/upRight.png",
  downLeft: "/images/avatar-poses/downLeft.png",
  downRight: "/images/avatar-poses/downRight.png",
};

const experiences = [
  {
    company: "AnyMind Group",
    role: "Senior Media Account Executive",
    when: "2026 - Present",
    logo: "/assets/logos/logo-anymind.png",
  },
  {
    company: "Sony",
