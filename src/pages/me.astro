    when: "2021 - Present",
    logo: "/assets/logos/logo-community.png",
  },
  {
    company: "PlayAh!",
    role: "Performance Senior Executive",
    when: "2024 - Present",
    logo: "/assets/logos/logo-playah.webp",
  },
  {
    company: "Asia Strategic Holdings",
    role: "Performance Marketing",
    when: "2025 - 2026",
    logo: "/assets/logos/logo-asia-strategic.png",
  },
  {
    company: "Vinh Cara",
    role: "Digital Marketing Specialist",
    when: "2024 - 2025",
    logo: "/assets/logos/logo-vinhcara.png",
  },
  {
    company: "TOMATO Children's Home",
    role: "Digital Marketing Executive",
