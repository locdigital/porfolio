    role: "Search Engine Optimization Executive",
    when: "2022 - 2023",
    logo: "/assets/logos/logo-pops.webp",
  },
];

const freeTimeActivities = [
  {
    title: "Landscape & Street Photography",
    tag: "Photography",
    src: "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59hj4IxMk94KrOISaFPdMJw9ClQ8qRiYZespBUG",
  },
  {
    title: "Community & Youth Mentorship",
    tag: "Community",
    src: "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59hAVQfosXpDBZJUeuLCSt3Mgn5FsKqXWk62HaE",
  },
  {
    title: "Highland Trails & Nature Exploration",
    tag: "Exploration",
    src: "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59haKIMPIyOH490TilXyexRchUNGmAMZLwKkFvI",
  },
  {
    title: "Slow Coffee & Morning Quiet",
    tag: "Mindfulness",
    src: "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59h6JYpl3Mgx3rw7LHmJhekT2K4Uy81ajfobtSv",
  },
  {
    title: "AI Workflows & Automation Experiments",
    tag: "Tech & Growth",
    src: "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59hivUo2ZwbmU9pOiYE6G824a0BWCXcl37yufzH",
  },
  {
    title: "Documenting Local Stories & Scenes",
    tag: "Storytelling",
    src: "https://65wv0vnolo.ufs.sh/f/0DwDtVjMS59hVTAtSgGiW6tUiNOoXB108SdsMHZayFfJrLGk",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema({
    url: absoluteUrl("/me"),
    title: pageTitle,
    description: pageDescription,
    type: "ProfilePage",
  })}
>
  <main class="gear-page bg-background text-foreground">
    <div class="gear-container">
      <section class="gear-hero me-about-hero pb-12 md:pb-16 border-b border-border" aria-label="Introduction">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_300px] lg:grid-cols-[1fr_340px] gap-10 md:gap-12 lg:gap-16 items-center">
          <div>
            <div class="page-kicker-wrapper">
              <span class="page-kicker-text">Me</span>
            </div>

            <h1 class="font-display text-display-md sm:text-display-lg leading-[1.08] tracking-[-0.02em] text-foreground">
              Hi there, I&rsquo;m Loc.
            </h1>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-5 text-caption font-mono text-muted-foreground">
              <span class="inline-flex items-center gap-2">
                <svg viewBox="0 0 12.65 18.185" class="w-3 h-4 fill-current text-accent" aria-hidden="true">
                  <path d="M 9.488 7.907 C 9.488 6.159 8.073 4.744 6.325 4.744 C 4.578 4.744 3.163 6.159 3.163 7.907 C 3.163 9.654 4.578 11.069 6.325 11.069 C 8.073 11.069 9.488 9.654 9.488 7.907 Z M 4.744 7.907 C 4.744 7.037 5.455 6.325 6.325 6.325 C 7.195 6.325 7.906 7.037 7.906 7.907 C 7.906 8.776 7.195 9.488 6.325 9.488 C 5.455 9.488 4.744 8.776 4.744 7.907 Z"/>
                  <path d="M 5.867 18.012 C 6.001 18.121 6.167 18.185 6.325 18.185 C 6.483 18.185 6.649 18.13 6.784 18.012 C 7.021 17.812 12.674 13.132 12.65 7.27 C 12.65 3.263 9.812 0 6.325 0 C 2.838 0 0 3.263 0 7.27 C -0.024 13.123 5.629 17.812 5.867 18.012 Z M 6.325 1.827 C 8.942 1.827 11.069 4.271 11.069 7.279 C 11.085 11.314 7.598 14.94 6.325 16.131 C 5.052 14.94 1.566 11.323 1.581 7.279 C 1.581 4.271 3.708 1.827 6.325 1.827 Z"/>
                </svg>
                Ho Chi Minh City, Vietnam 🇻🇳
              </span>
              <span class="inline-flex items-center gap-2">
                <svg viewBox="0 0 18 18" class="w-4 h-4 stroke-current fill-none text-accent" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M 9 1 L 1 5 L 9 9 L 17 5 L 9 1 Z"/>
                  <path d="M 4 6.6 V 11 C 4 12.3 6.2 13.4 9 13.4 C 11.8 13.4 14 12.3 14 11 V 6.6"/>
                  <path d="M 17 5 V 9.5"/>
                </svg>
                Digital Marketing · FPT University (Honors 🎓)
              </span>
            </div>

            <div class="mt-6 space-y-4 text-body leading-[1.75] text-muted-foreground">
              <p>
                I&rsquo;ve always enjoyed the sensation of making things, whether scaling multi-channel paid media, designing conversion landing pages, or building automated marketing funnels. My early growth experiments sparked a deep interest in crafting campaign systems that feel intentional, high-converting, and joyful.
              </p>
              <p>
                Today, I focus on designing accessible, data-driven growth strategies for e-commerce, education, and brand platforms. My approach bridges creative production with full-funnel analytics to turn ad spend into measurable, long-term ROI.
              </p>
            </div>
          </div>

          <div class="w-full flex justify-center md:justify-end">
            <div class="me-avatar-shell">
              <CursorAvatar
                {...avatarImages}
                className="me-avatar"
                style={{ width: "100%", height: "100%" }}
                alt="3D illustrated avatar of Phuc Loc"
                ariaLabel="Interactive 3D avatar of Phuc Loc"
                trackingRadius={420}
                springStiffness={150}
                springDamping={20}
                trackingStrength={1.15}
                directionThreshold={0.16}
                hysteresis={0.07}
                subtleMotion={false}
                client:load
              />
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 border-b border-border" aria-label="Experiences">
        <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8 md:gap-16 items-start">
          <div class="pt-1">
            <h2 class="font-sans font-medium text-2xl text-foreground tracking-tight">Experiences</h2>
          </div>

          <div class="w-full overflow-x-auto">
            <table class="w-full border-collapse font-sans text-body">
              <tbody>
                {experiences.map((item) => (
                  <tr class="border-b border-border first:border-t">
                    <td class="py-6 w-10 align-middle">
                      <div class="w-[25px] h-[25px] grid place-items-center overflow-hidden rounded-full bg-secondary/40 border border-border/50 shrink-0">
                        {item.logo ? (
                          <img
                            src={item.logo}
                            alt={`${item.company} logo`}
                            class="w-full h-full object-cover rounded-full"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <div class="w-full h-full rounded-full bg-secondary border border-border flex items-center justify-center font-mono text-xs font-medium text-foreground">
                            {item.company.slice(0, 2).toUpperCase()}
                          </div>
                        )}
                      </div>
                    </td>
                    <td class="py-6 font-medium text-foreground w-48 sm:w-56 align-middle tracking-tight">
                      {item.company}
                    </td>
                    <td class="py-6 text-muted-foreground align-middle">
                      {item.role}
                    </td>
                    <td class="py-6 text-right font-mono text-caption text-muted-foreground whitespace-nowrap w-36 sm:w-40 align-middle tracking-wider">
                      {item.when}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="py-16 border-b border-border" aria-label="Free time pursuits">
        <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8 md:gap-16 items-start">
          <div class="pt-1">
            <h2 class="font-sans font-medium text-2xl text-foreground tracking-tight">
              In My Free Time, I...
            </h2>
          </div>

          <div class="w-full">
            <div class="free-time-accordion flex items-center gap-2.5 h-[380px] sm:h-[420px] w-full overflow-hidden">
              {freeTimeActivities.map((item) => (
                <div
                  class="accordion-card relative group h-full rounded-2xl overflow-hidden cursor-pointer border border-border/40 shadow-sm"
                >
                  <img
                    src={item.src}
                    alt={item.title}
                    class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="accordion-overlay absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex flex-col justify-end p-4 text-left">
                    <span class="text-xs font-mono uppercase tracking-wider text-amber-300 font-semibold">
                      {item.tag}
                    </span>
                    <h3 class="text-white font-sans font-medium text-base sm:text-lg leading-tight mt-1">
                      {item.title}
                    </h3>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .me-about-hero {
    max-width: 100%;
  }

  .me-avatar-shell {
    width: min(100%, 320px);
    aspect-ratio: 1;
    border-radius: 8px;
  }

  .me-avatar {
    border-radius: 8px;
    border: 1px solid rgba(0, 117, 222, 0.22);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.72);
    overflow: hidden !important;
    transition:
      border-color 220ms var(--ease-out),
      filter 280ms var(--ease-out);
  }

  .me-avatar .cursor-avatar-image {
    border-radius: 0 !important;
    object-position: 50% 50%;
    filter: drop-shadow(0 10px 10px rgba(28, 28, 28, 0.12));
    transition: filter 260ms var(--ease-out), opacity 260ms var(--ease-out);
  }

  .me-avatar:hover,
  .me-avatar:focus-visible {
    border-color: color-mix(in srgb, var(--accent-solid) 36%, transparent);
    filter: saturate(1.04) contrast(1.02);
  }

  .me-avatar:focus-visible {
    outline: 2px solid var(--accent-solid);
    outline-offset: 6px;
  }

  .free-time-accordion .accordion-card {
    flex: 1;
    min-width: 0;
    transition: flex 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .free-time-accordion .accordion-overlay {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .free-time-accordion .accordion-card:first-child {
    flex: 3.5;
  }

  .free-time-accordion .accordion-card:first-child .accordion-overlay {
    opacity: 1;
  }

  .free-time-accordion:hover .accordion-card:first-child {
    flex: 1;
  }

  .free-time-accordion:hover .accordion-card:first-child .accordion-overlay {
    opacity: 0;
  }

  .free-time-accordion .accordion-card:hover {
    flex: 3.5 !important;
  }

  .free-time-accordion .accordion-card:hover .accordion-overlay {
    opacity: 1 !important;
  }

  @media (max-width: 640px) {
    .me-avatar-shell {
      width: min(100%, 300px);
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .me-avatar,
    .me-avatar .cursor-avatar-image,
    .free-time-accordion .accordion-card,
    .free-time-accordion .accordion-overlay,
    .free-time-accordion img {
      transition: none !important;
    }
  }
</style>
