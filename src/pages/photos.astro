---
import Layout from "../layouts/Layout.astro";
import { getPhotoLocations } from "../lib/cms";
import { PHOTO_GRID_SIZES, optimizePhoto } from "../lib/photo-assets";

const sourceLocations = await getPhotoLocations();
const optimizedLocations = await Promise.all(
  sourceLocations.map(async (loc) => ({
    ...loc,
    photos: await Promise.all(
      loc.photos.map(async (photo) => {
        if (!photo.src.startsWith("/assets/photos/")) {
          return {
            ...photo,
            previewSrc: photo.src,
            previewSrcSet: "",
            webpSrcSet: "",
            previewSizes: PHOTO_GRID_SIZES,
            previewWidth: photo.w,
            previewHeight: photo.h,
            fullSrc: photo.src,
            fullWidth: photo.w,
            fullHeight: photo.h,
          };
        }

        return optimizePhoto(photo, {
          previewWidth: 720,
          previewWidths: [240, 400, 640, 960],
          previewSizes: PHOTO_GRID_SIZES,
          fullQuality: 78,
          withWebpFallback: true,
        });
      }),
    ),
  })),
);
const totalPhotosCount = optimizedLocations.reduce((sum, loc) => sum + loc.photos.length, 0);
---

<Layout title="Photos — Phuc Loc Nguyen">

  <main class="photos-page">

    <!-- PAGE HERO -->
    <section class="photos-hero" aria-label="Photos introduction">
      <div class="container">
        <div class="sh r">
          <span class="sh-title" data-parallax=".1">Photos</span>
          <span class="sh-number" data-parallax=".3">{String(totalPhotosCount).padStart(2, '0')}</span>
        </div>
        <h1 class="photos-heading r" data-d="1">
          Places I've<br><em>wandered.</em>
        </h1>
        <p class="photos-subtext r" data-d="2">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </p>
      </div>
    </section>

    <!-- QUICK NAV -->
    <div class="photos-nav-wrapper">
      <div class="container">
        <nav class="photos-nav" aria-label="Locations navigation">
          <ul class="photos-nav-list">
            {optimizedLocations.map((loc, i) => (
              <li>
                <a href={`#${loc.slug}`} class={`photos-nav-link ${i === 0 ? 'active' : ''}`} data-nav-target={loc.slug}>
                  {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/gallery" class="photos-nav-link photos-nav-gallery-btn">
                Gallery <span class="photos-gallery-arrow">→</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {optimizedLocations.map((loc, locIdx) => (
      <section
        class="loc-section"
        id={loc.slug}
        aria-label={`Photos from ${loc.name}`}
      >
        <div class="container">
          <!-- Location header -->
          <div class="loc-header r" data-d="1">
            <div class="loc-meta">
              <span class="loc-index">{String(locIdx + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="loc-name">{loc.name}</h2>
                <p class="loc-desc">{loc.description}</p>
              </div>
            </div>
            <span class="loc-count">{loc.photos.length} photos</span>
          </div>
        </div>

        <!-- Photo grid — full-bleed inside container -->
        <div class="container">
          <div class="loc-grid" data-gallery={`gallery-${loc.slug}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => (
              <div
                class={`loc-photo-item r ${photo.h > photo.w ? 'loc-photo-tall' : ''}`}
                data-d={String((i % 5) + 1)}
                data-pswp-width={photo.fullWidth}
                data-pswp-height={photo.fullHeight}
                aria-label={photo.alt}
              >
                {photo.previewSrcSet ? (
                  <picture>
                    <source
                      type="image/avif"
                      srcset={photo.previewSrcSet}
                      sizes={photo.previewSizes}
                    />
                    {photo.webpSrcSet && (
                      <source
                        type="image/webp"
                        srcset={photo.webpSrcSet}
                        sizes={photo.previewSizes}
                      />
                    )}
                    <img
                      src={photo.previewSrc}
                      width={photo.previewWidth}
                      height={photo.previewHeight}
                      alt={photo.alt}
                      loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                    />
                  </picture>
                ) : (
                  <img
                    src={photo.previewSrc}
                    width={photo.previewWidth}
                    height={photo.previewHeight}
                    alt={photo.alt}
                    loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                  />
                )}
                <div class="loc-photo-overlay" aria-hidden="true">
                  <span class="loc-photo-index">{String(i + 1).padStart(2, '0')}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}



  </main>

</Layout>

<style>
  /* ── Page ── */
  .photos-page {
    padding-top: var(--hdr-h);
  }

  /* ── Hero ── */
  .photos-hero {
    padding: 80px 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: clamp(42px, 6.5vw, 90px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 0;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: 15px;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
  }

  .photos-nav-wrapper {
    position: sticky;
    top: -1px; /* slightly offset to trigger intersection or top <= 0 consistently */
    z-index: 50;
    background: transparent;
    padding: 28px 0;
    margin-bottom: 40px;
    margin-top: -1px;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease;
  }

  .photos-nav-wrapper.is-stuck {
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05), inset 0 -1px 0 rgba(255, 255, 255, 0.5);
    padding: 20px 0; /* slightly thinner when stuck */
  }

  @supports (backdrop-filter: blur(10px)) {
    .photos-nav-wrapper.is-stuck {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.4) 100%);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
    }
  }

  .photos-nav-list {
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photos-nav-list:active {
    cursor: grabbing;
  }

  .photos-nav-list::-webkit-scrollbar {
    display: none;
  }

  .photos-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 15px;
    font-family: var(--sans, system-ui, -apple-system, sans-serif);
    color: var(--text);
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .photos-nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  @media (prefers-color-scheme: dark) {
    .photos-nav-link:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }

  .photos-nav-count {
    color: var(--muted);
    font-size: 11px;
    font-family: var(--mono, monospace);
    transform: translateY(-30%);
    display: inline-block;
  }

  /* Active state */
  .photos-nav-link.active {
    background: var(--text);
    color: var(--bg);
  }

  .photos-nav-link.active .photos-nav-count {
    color: var(--bg);
    opacity: 0.7;
  }

  .photos-nav-gallery-btn {
    opacity: 0.85;
  }

  .photos-gallery-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .photos-nav-gallery-btn:hover .photos-gallery-arrow {
    transform: translateX(3px);
  }

  /* ── Location section ── */
  .loc-section {
    padding: clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
  }

  .loc-section:not(:first-of-type) {
    border-top: 1px solid var(--divider);
  }

  .loc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .loc-meta {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .loc-index {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: .08em;
    padding-top: 10px;
    flex-shrink: 0;
  }

  .loc-name {
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .loc-desc {
    font-size: 13px;
    color: var(--muted);
    max-width: 380px;
    line-height: 1.6;
  }

  .loc-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 6px;
    letter-spacing: .06em;
  }

  /* ── Image Grid ── */
  /*
    Masonry layout to display photos in full size / original aspect ratio
  */
  .loc-grid {
    column-count: 3;
    column-gap: 4px;
    content-visibility: auto;
    contain-intrinsic-size: auto 1200px;
  }

  .loc-photo-item {
    display: block;
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
    margin-bottom: 4px;
    break-inside: avoid;
    transform: translateZ(0); /* Prevent column break glitches */
  }

  .loc-photo-item img {
    display: block;
    width: 100%;
    height: auto; /* Maintains original aspect ratio */
    transition: transform .65s var(--ease-out, ease);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Overlay: appears on hover */
  .loc-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.3) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    padding: 12px 14px;
  }

  .loc-photo-item:hover .loc-photo-overlay {
    opacity: 1;
  }

  .loc-photo-index {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255,255,255,.7);
    letter-spacing: .1em;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .loc-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .loc-grid {
      column-count: 1;
    }
    .loc-photo-item {
      margin-bottom: 8px; /* Slightly more gap on mobile stack */
    }
    .loc-header {
      gap: 16px;
    }
  }
</style>

<script is:inline>
  // PhotoSwipe per-gallery init
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      // Re-use IO from layout for .r elements on this page
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -32px 0px' });
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      // Active state for sticky nav buttons
      const sections = document.querySelectorAll('.loc-section');
      const navLinks = document.querySelectorAll('.photos-nav-link');

      let spyTicking = false;
      const updateSpy = () => {
        let activeId = null;
        // header offset is around 100px or so
        const offset = 150; 
        
        sections.forEach(sec => {
          const rect = sec.getBoundingClientRect();
          if (rect.top <= offset && rect.bottom > offset) {
            activeId = sec.id;
          }
        });

        // Fallback: if we scrolled all the way to the bottom, the last section should be active
        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 50) {
           if (sections.length > 0) activeId = sections[sections.length - 1].id;
        }

        if (activeId) {
          navLinks.forEach(link => {
            if (link.getAttribute('data-nav-target') === activeId) {
              if (!link.classList.contains('active')) {
                link.classList.add('active');
                // Scroll the nav link into view horizontally if needed
                link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
              }
            } else {
              link.classList.remove('active');
            }
          });
        }
        spyTicking = false;
      };

      window.addEventListener('scroll', () => {
        if (!spyTicking) {
          window.requestAnimationFrame(updateSpy);
          spyTicking = true;
        }
      }, { passive: true });
      
      // Run once on load
      updateSpy();
      
      // Smooth scroll on click for nav links
      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          const targetId = this.getAttribute('href');
          if (targetId && targetId.startsWith('#')) {
            e.preventDefault();
            const targetEl = document.querySelector(targetId);
            if (targetEl) {
              targetEl.scrollIntoView({ behavior: 'smooth' });
              // Update URL hash without jumping
              history.pushState(null, null, targetId);
            }
          }
        });
      });

      // Sticky nav glassmorphism effect
      const navWrapper = document.querySelector('.photos-nav-wrapper');
      if (navWrapper) {
        window.addEventListener('scroll', () => {
          // It's stuck when it hits top: -1px
          if (navWrapper.getBoundingClientRect().top <= 0) {
            navWrapper.classList.add('is-stuck');
          } else {
            navWrapper.classList.remove('is-stuck');
          }
        }, { passive: true });
      }

      // Drag-to-scroll for nav list
      const navList = document.querySelector('.photos-nav-list');
      if (navList) {
        let isDown = false;
        let startX;
        let scrollLeft;
        let hasDragged = false;

        navList.addEventListener('mousedown', (e) => {
          isDown = true;
          hasDragged = false;
          startX = e.pageX - navList.offsetLeft;
          scrollLeft = navList.scrollLeft;
        });

        navList.addEventListener('mouseleave', () => {
          isDown = false;
        });

        navList.addEventListener('mouseup', () => {
          isDown = false;
        });

        navList.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - navList.offsetLeft;
          const walk = (x - startX) * 2; // scroll speed multiplier
          if (Math.abs(walk) > 5) hasDragged = true;
          navList.scrollLeft = scrollLeft - walk;
        });

        // Prevent click if dragging
        navList.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopImmediatePropagation();
            }
          });
          // Prevent ghost drag
          link.addEventListener('dragstart', (e) => e.preventDefault());
        });
      }
    });
  })();
</script>
