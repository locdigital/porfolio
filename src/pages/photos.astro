---
import Layout from "../layouts/Layout.astro";
import { getPhotoLocations } from "../lib/cms";
import { PHOTO_GRID_SIZES, optimizePhoto } from "../lib/photo-assets";
import { generateSlug } from "../lib/writing/slug";

export const prerender = true;

const sourceLocations = await getPhotoLocations();
const anchorFor = (loc: (typeof sourceLocations)[number]) =>
  generateSlug(loc.location || loc.name || loc.slug) || loc.slug;
const optimizedLocations = await Promise.all(
  sourceLocations.map(async (loc) => ({
    ...loc,
    anchorId: anchorFor(loc),
    photos: await Promise.all(
      loc.photos.map(async (photo) => {
        if (!photo.src.startsWith("/assets/photos/")) {
          return {
            ...photo,
            previewSrc: photo.src,
            previewSrcSet: "",
            webpSrcSet: "",
            previewSizes: PHOTO_GRID_SIZES,
            previewWidth: photo.w,
            previewHeight: photo.h,
            fullSrc: photo.src,
            fullWidth: photo.w,
            fullHeight: photo.h,
          };
        }

        return optimizePhoto(photo, {
          previewWidth: 720,
          previewWidths: [240, 400, 640, 960],
          previewSizes: PHOTO_GRID_SIZES,
          fullQuality: 78,
          withWebpFallback: true,
        });
      }),
    ),
  })),
);
const photosHeadline = "Places I've <em>wandered.</em>";
type PhotoLocationView = Omit<Awaited<ReturnType<typeof getPhotoLocations>>[number], "photos"> & {
  photos?: unknown[];
};

function enabledBlock(loc: PhotoLocationView, type: string) {
  const blocks = Array.isArray(loc.blocks) ? loc.blocks : [];
  if (blocks.length === 0) return true;
  return blocks.some((block) => block.type === type && block.enabled);
}

function factsFor(loc: PhotoLocationView) {
  const budget = formatBudget(loc);
  return [
    { label: "Place", value: loc.province || loc.city || loc.country, icon: "📍" },
    { label: "Stay", value: loc.recommendedStay, icon: "🕒" },
    { label: "Season", value: loc.bestMonths || loc.bestTime, icon: "🗓️" },
    { label: "Budget", value: budget, icon: "💵" },
    { label: "Best for", value: (loc.suitableFor ?? []).join(" / "), icon: "✨" },
  ].filter((fact) => fact.value);
}

function formatBudget(loc: PhotoLocationView) {
  const min = typeof loc.budgetMin === "number" ? loc.budgetMin : 0;
  const max = typeof loc.budgetMax === "number" ? loc.budgetMax : 0;
  const amount = min && max
    ? `${formatMoney(min)} - ${formatMoney(max)}`
    : min || max
      ? formatMoney(min || max)
      : "";
  return amount || loc.budgetNote || "";
}

function formatMoney(value: number) {
  return `$${value.toLocaleString("en-US")}`;
}

function reviewSectionsFor(loc: PhotoLocationView): Array<[string, string[]]> {
  const overview = loc.overview || loc.shortDescription || loc.description || loc.introduction;
  return overview ? [["Overview", overview.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean)]] : [];
}

function goodToKnowChipsFor(loc: PhotoLocationView) {
  return [...(loc.bestTimeOfDay ?? []), ...(loc.travelTips ?? [])].filter(Boolean);
}

function hasDetailsFor(loc: PhotoLocationView) {
  return (
    (enabledBlock(loc, "quick-facts") && factsFor(loc).length > 0) ||
    (enabledBlock(loc, "editorial-review") && reviewSectionsFor(loc).length > 0) ||
    (enabledBlock(loc, "tips") && goodToKnowChipsFor(loc).length > 0) ||
    (enabledBlock(loc, "related-articles") && (loc.relatedArticles ?? []).length > 0) ||
    (enabledBlock(loc, "cta") && Boolean(loc.website || loc.bookingUrl || loc.instagram))
  );
}
---

<Layout title="Photos | Phuc Loc Nguyen">

  <main class="gear-page photos-page">
    <div class="gear-container">
      <!-- PAGE HERO -->
      <section class="gear-hero photos-hero-copy" aria-label="Photos introduction">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">My photos</span>
        </div>
        <h1 class="gear-hero-title" set:html={photosHeadline} />
        <p class="gear-intro">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </p>
      </section>
    </div>

    <!-- QUICK NAV -->
    <div id="photos-nav-sentinel"></div>
    <div class="photos-nav-wrapper">
      <div class="container">
        <nav class="photos-nav" aria-label="Locations navigation">
          <div class="photos-nav-list">
            {optimizedLocations.map((loc, i) => (
              <button
                type="button"
                class={`photos-nav-link ${i === 0 ? 'active' : ''}`}
                data-target={loc.anchorId}
                data-slug={loc.slug}
                aria-current={i === 0 ? "true" : undefined}
                aria-controls={loc.anchorId}
              >
                {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
              </button>
            ))}
            <span class="photos-nav-active-line" aria-hidden="true"></span>
          </div>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {optimizedLocations.map((loc, locIdx) => (
      <section
        class={`loc-section ${locIdx === 0 ? 'active' : ''}`}
        id={loc.anchorId}
        data-slug={loc.slug}
        aria-label={`Photos from ${loc.name}`}
        hidden={locIdx !== 0}
      >
        <div class="container">
          <!-- Location header -->
          <div class="loc-header">
            <div class="loc-meta">
              <div>
                <h2 class="loc-name">{loc.headline || loc.name}</h2>
                <p class="loc-desc">{loc.description}</p>
              </div>
            </div>
            <span class="loc-count">{loc.photos.length} photos</span>
          </div>

          {hasDetailsFor(loc) && (
            <div class="loc-cms-detail" aria-label={`${loc.name} travel details`}>
              {enabledBlock(loc, "quick-facts") && factsFor(loc).length > 0 && (
                <section class="loc-info-section loc-quick-facts">
                  <h3>Quick Facts</h3>
                  <div class="loc-facts">
                    {factsFor(loc).map(({ label, value, icon }) => (
                      <span class="loc-fact-pill">
                        <span class="loc-fact-label">
                          <span class="loc-meta-icon" aria-hidden="true">{icon}</span>
                          {label}
                        </span>
                        <strong>{value}</strong>
                      </span>
                    ))}
                  </div>
                </section>
              )}

              {enabledBlock(loc, "editorial-review") && reviewSectionsFor(loc).length > 0 && (
                <section class="loc-info-section loc-rich">
                  {reviewSectionsFor(loc).map(([label, paragraphs]) => (
                    <>
                      <h3>{label}</h3>
                      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                    </>
                  ))}
                </section>
              )}

              {enabledBlock(loc, "tips") && goodToKnowChipsFor(loc).length > 0 && (
                <section class="loc-info-section loc-good-to-know">
                  <h3>Good To Know</h3>
                  <ul class="loc-pill-list">
                    {goodToKnowChipsFor(loc).map((item) => (
                      <li>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {enabledBlock(loc, "related-articles") && (loc.relatedArticles ?? []).length > 0 && (
                <section class="loc-info-section">
                  <h3>Related Articles</h3>
                  <div class="loc-link-list">
                    {(loc.relatedArticles ?? []).map((article) => (
                      <a href={`/blog/${article.slug}`}>{article.title || article.slug}</a>
                    ))}
                  </div>
                </section>
              )}

              {enabledBlock(loc, "cta") && (loc.website || loc.bookingUrl || loc.instagram) && (
                <section class="loc-info-section">
                  <h3>Links</h3>
                  <div class="loc-link-list">
                    {loc.website && <a href={loc.website} target="_blank" rel="noopener noreferrer">Website</a>}
                    {loc.bookingUrl && <a href={loc.bookingUrl} target="_blank" rel="noopener noreferrer">Booking</a>}
                    {loc.instagram && <a href={loc.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
                  </div>
                </section>
              )}
            </div>
          )}
        </div>

        <!-- Responsive Image Gallery (Efferd inspired) -->
        <div class="container">
          <div class="efferd-gallery" data-gallery={`gallery-${loc.anchorId}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => {
              const isTall = photo.previewHeight > photo.previewWidth;
              const captionText = ("caption" in photo && typeof photo.caption === "string") ? photo.caption : "";
              return (
                <div
                  class={`efferd-gallery-item ${isTall ? 'is-tall' : 'is-wide'}`}
                  data-pswp-width={photo.fullWidth}
                  data-pswp-height={photo.fullHeight}
                  aria-label={photo.alt}
                  style={`transition-delay: ${(i % 6) * 0.06}s;`}
                >
                  <div class="efferd-card-inner">
                    {photo.previewSrcSet ? (
                      <picture class="efferd-picture">
                        <source
                          type="image/avif"
                          srcset={photo.previewSrcSet}
                          sizes={photo.previewSizes}
                        />
                        {photo.webpSrcSet && (
                          <source
                            type="image/webp"
                            srcset={photo.webpSrcSet}
                            sizes={photo.previewSizes}
                          />
                        )}
                        <img
                          src={photo.previewSrc}
                          width={photo.previewWidth}
                          height={photo.previewHeight}
                          alt={photo.alt || `${loc.name} photo ${i + 1}`}
                          loading={locIdx === 0 && i < 4 ? "eager" : "lazy"}
                          decoding="async"
                          fetchpriority={locIdx === 0 && i < 2 ? "high" : "auto"}
                          class="efferd-img"
                          onerror="this.style.opacity='0'; this.closest('.efferd-card-inner').style.backgroundColor='#e5e7eb';"
                        />
                      </picture>
                    ) : (
                      <img
                        src={photo.previewSrc}
                        width={photo.previewWidth}
                        height={photo.previewHeight}
                        alt={photo.alt || `${loc.name} photo ${i + 1}`}
                        loading={locIdx === 0 && i < 4 ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={locIdx === 0 && i < 2 ? "high" : "auto"}
                        class="efferd-img"
                        onerror="this.style.opacity='0'; this.closest('.efferd-card-inner').style.backgroundColor='#e5e7eb';"
                      />
                    )}
                    <div class="efferd-overlay" aria-hidden="true">
                      <span class="efferd-badge">{String(i + 1).padStart(2, '0')}</span>
                      {captionText && <span class="efferd-caption">{captionText}</span>}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    ))}



  </main>

</Layout>

<script>
  function initPhotoTabs() {
    const tablist = document.querySelector(".photos-nav-list");
    if (!(tablist instanceof HTMLElement) || tablist.dataset.tabsReady) return;
    tablist.dataset.tabsReady = "true";

    const tabs = Array.from(tablist.querySelectorAll(".photos-nav-link[data-target]"));
    const panels = Array.from(document.querySelectorAll(".loc-section"));
    const line = tablist.querySelector(".photos-nav-active-line");

    const moveLine = (tab: Element | null) => {
      if (!(line instanceof HTMLElement) || !(tab instanceof HTMLElement)) return;
      line.style.width = `${tab.offsetWidth}px`;
      line.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const activate = (id?: string) => {
      const nextTab = tabs.find((tab) => (
        tab.getAttribute("data-target") === id ||
        tab.getAttribute("data-slug") === id
      )) || tabs[0];
      const nextId = nextTab?.getAttribute("data-target");
      if (!nextId) return;
      const scrollX = window.scrollX;
      const scrollY = window.scrollY;

      tabs.forEach((tab) => {
        const isActive = tab === nextTab;
        tab.classList.toggle("active", isActive);
        tab.toggleAttribute("aria-current", isActive);
      });

      panels.forEach((panel) => {
        const isActive = panel.id === nextId;
        panel.classList.toggle("active", isActive);
        panel.toggleAttribute("hidden", !isActive);
      });

      if (location.hash.slice(1) !== nextId) {
        history.replaceState(null, "", `${location.pathname}${location.search}#${nextId}`);
      }

      moveLine(nextTab);
      if (nextTab instanceof HTMLElement) {
        const left = nextTab.offsetLeft - (tablist.clientWidth - nextTab.offsetWidth) / 2;
        tablist.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
      }
      requestAnimationFrame(() => window.scrollTo(scrollX, scrollY));
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.getAttribute("data-target") || undefined));
    });

    activate(location.hash.slice(1));
    window.addEventListener("resize", () => {
      moveLine(tablist.querySelector(".photos-nav-link.active"));
    });
    window.addEventListener("hashchange", () => activate(location.hash.slice(1)));
  }

  function initGalleryInView() {
    const items = document.querySelectorAll(".efferd-gallery-item");
    if (!items.length) return;

    if (!("IntersectionObserver" in window)) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: "80px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  }

  document.addEventListener("astro:page-load", () => {
    initPhotoTabs();
    initGalleryInView();
  });
  initPhotoTabs();
  initGalleryInView();
</script>

<style>
  :global(.photos-page .reveal),
  :global(.photos-page .r),
  :global(.photos-page .toki-r),
  :global(.photos-page .animated-card),
  :global(.photos-page .reveal.in),
  :global(.photos-page .r.in),
  :global(.photos-page .toki-r.in),
  :global(.photos-page .animated-card.card-in) {
    filter: none !important;
  }

  /* ------ Page ------ */
  /* ------ Hero ------ */
  .photos-hero {
    padding: 80px 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: var(--type-display-xl);
    font-weight: 400;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-normal);
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 0;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: var(--type-body);
    color: var(--muted);
    max-width: 480px;
    line-height: var(--leading-body);
  }

  #photos-nav-sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
    opacity: 0;
  }

  /* ------ Nav wrapper ------ */
  .photos-nav-wrapper {
    position: relative;
    z-index: 20;
    background: transparent;
    padding: 24px 0 0;
    margin-bottom: 52px;
    margin-top: -1px;
  }

  /* ------ Nav ------ */
  .photos-nav {
    border-bottom: 1px solid var(--divider);
    padding-bottom: 0;
  }

  .photos-nav-list {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-y: none;
    scrollbar-width: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photos-nav-list:active { cursor: grabbing; }
  .photos-nav-list::-webkit-scrollbar { display: none; }



  /* Active underline */
  .photos-nav-active-line {
    position: absolute;
    bottom: -1px;
    height: 2px;
    background: var(--text);
    pointer-events: none;
    z-index: 2;
    left: 0;
    width: 0;
    transform: translateX(0);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
                width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Tab links */
  .photos-nav-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    height: 36px;
    border-radius: 6px;
    font-size: var(--type-body);
    font-family: var(--sans);
    font-weight: 500;
    color: color-mix(in srgb, var(--text) 72%, var(--muted));
    text-decoration: none;
    white-space: nowrap;
    border: 0;
    background: transparent;
    transition: color 0.2s ease;
    cursor: pointer;
    user-select: none;
  }

  .photos-nav-link.active {
    color: var(--text);
  }

  .photos-nav-link:hover {
    color: var(--accent);
  }

  .photos-nav-count {
    color: inherit;
    font-size: var(--type-caption);
    font-family: var(--mono, monospace);
    opacity: 0.55;
    transform: translateY(-30%);
    display: inline-block;
  }

  /* ------ Location section ------ */
  .loc-section {
    --loc-prose-size: 0.875rem;
    --loc-prose-leading: 1.7;
    --loc-sidebar-size: 0.875rem;
    --loc-sidebar-leading: 1.65;
    --loc-prose-measure: 68ch;
    --loc-sidebar-measure: 34ch;
    --loc-heading-gap: var(--space-2);
    --loc-copy-gap: var(--space-3);
    --loc-rich-block-gap: 2rem;
    --loc-section-gap: var(--space-6);
    display: none;
    opacity: 1;
    overflow-anchor: none;
    padding: clamp(32px, 5.2vw, 52px) 0 clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
    content-visibility: visible;
  }

  .gear-page > .loc-section {
    content-visibility: visible;
  }

  .loc-section.active {
    display: block;
    opacity: 1;
    animation: photos-tab-in 0.28s ease both;
  }

  @keyframes photos-tab-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .loc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .loc-meta {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .loc-name {
    font-family: var(--serif);
    font-size: var(--type-display);
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-normal);
    color: var(--text);
    margin-bottom: var(--loc-heading-gap);
  }

  .loc-desc {
    max-width: var(--loc-prose-measure);
    font-family: var(--sans);
    font-size: var(--type-body);
    line-height: var(--loc-prose-leading);
    color: #6e6e6e;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .loc-count {
    font-family: var(--mono);
    font-size: var(--type-caption);
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 6px;
    letter-spacing: .06em;
  }

  /* ------ Efferd Image Gallery ------ */
  .efferd-gallery {
    column-count: 3;
    column-gap: 16px;
    margin-top: clamp(24px, 4vw, 40px);
    width: 100%;
  }

  .efferd-gallery-item {
    break-inside: avoid;
    margin-bottom: 16px;
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .efferd-gallery-item.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .efferd-card-inner {
    position: relative;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 6%, transparent);
    box-shadow:
      0 4px 20px -2px rgba(0, 0, 0, 0.08),
      0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }

  .efferd-gallery-item:hover .efferd-card-inner {
    box-shadow:
      0 12px 32px -4px rgba(0, 0, 0, 0.16),
      0 0 0 1px color-mix(in srgb, var(--text) 15%, transparent);
  }

  .efferd-picture {
    display: block;
    width: 100%;
  }

  .efferd-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    backface-visibility: hidden;
  }

  .efferd-gallery-item:hover .efferd-img {
    transform: scale(1.035);
  }

  .efferd-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 14px 16px;
  }

  .efferd-gallery-item:hover .efferd-overlay {
    opacity: 1;
  }

  .efferd-badge {
    font-family: var(--mono);
    font-size: var(--type-caption);
    color: rgba(255, 255, 255, 0.95);
    letter-spacing: 0.1em;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .efferd-caption {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 65%;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
  }

  /* ------ CMS location details ------ */
  .loc-cms-detail {
    display: grid;
    grid-template-columns: minmax(12rem, 0.72fr) minmax(38ch, 1.48fr) minmax(14rem, 0.8fr);
    gap: clamp(var(--space-5), 3vw, var(--space-10));
    min-width: 0;
    margin: var(--space-1) 0 clamp(var(--space-8), 4vw, var(--space-12));
    padding-top: var(--space-6);
    border-top: 1px solid var(--divider);
  }

  .loc-info-section {
    display: grid;
    gap: var(--loc-copy-gap);
    align-content: start;
    min-width: 0;
  }

  .loc-info-section + .loc-info-section {
    padding-left: clamp(var(--space-4), 2vw, var(--space-6));
    border-left: 1px solid color-mix(in srgb, var(--divider) 72%, transparent);
  }

  .loc-info-section h3,
  .loc-rich h3,
  .loc-rich h4 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text);
  }

  .loc-info-section h3,
  .loc-rich h3 {
    font-size: 1.5rem;
    line-height: 1;
    margin: 0;
    text-wrap: balance;
