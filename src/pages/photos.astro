---
import Layout from "../layouts/Layout.astro";
import { getPhotoLocations } from "../lib/cms";
import { PHOTO_GRID_SIZES, optimizePhoto } from "../lib/photo-assets";

const sourceLocations = await getPhotoLocations();
const optimizedLocations = await Promise.all(
  sourceLocations.map(async (loc) => ({
    ...loc,
    photos: await Promise.all(
      loc.photos.map(async (photo) => {
        if (!photo.src.startsWith("/assets/photos/")) {
          return {
            ...photo,
            previewSrc: photo.src,
            previewSrcSet: "",
            webpSrcSet: "",
            previewSizes: PHOTO_GRID_SIZES,
            previewWidth: photo.w,
            previewHeight: photo.h,
            fullSrc: photo.src,
            fullWidth: photo.w,
            fullHeight: photo.h,
          };
        }

        return optimizePhoto(photo, {
          previewWidth: 720,
          previewWidths: [240, 400, 640, 960],
          previewSizes: PHOTO_GRID_SIZES,
          fullQuality: 78,
          withWebpFallback: true,
        });
      }),
    ),
  })),
);
const totalPhotosCount = optimizedLocations.reduce((sum, loc) => sum + loc.photos.length, 0);
---

<Layout title="Photos — Phuc Loc Nguyen">

  <main class="gear-page">
    <div class="gear-container">
      <!-- PAGE HERO -->
      <section class="gear-hero toki-r" data-d="1" aria-label="Photos introduction">
        <p class="gear-kicker">My photos</p>
        <h1>Places I've <em>wandered.</em></h1>
        <p class="gear-intro">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </p>
      </section>
    </div>

    <!-- QUICK NAV -->
    <div class="photos-nav-wrapper">
      <div class="container">
        <nav class="photos-nav" aria-label="Locations navigation">
          <ul class="photos-nav-list">
            <li class="photos-nav-indicator" aria-hidden="true"></li>
            {optimizedLocations.map((loc, i) => (
              <li>
                <a href={`#${loc.slug}`} class={`photos-nav-link ${i === 0 ? 'active' : ''}`} data-nav-target={loc.slug}>
                  {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/gallery" class="photos-nav-link photos-nav-gallery-btn">
                Gallery <span class="photos-gallery-arrow">→</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {optimizedLocations.map((loc, locIdx) => (
      <section
        class="loc-section"
        id={loc.slug}
        aria-label={`Photos from ${loc.name}`}
      >
        <div class="container">
          <!-- Location header -->
          <div class="loc-header r" data-d="1">
            <div class="loc-meta">
              <span class="loc-index">{String(locIdx + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="loc-name">{loc.name}</h2>
                <p class="loc-desc">{loc.description}</p>
              </div>
            </div>
            <span class="loc-count">{loc.photos.length} photos</span>
          </div>
        </div>

        <!-- Photo grid — full-bleed inside container -->
        <div class="container">
          <div class="loc-grid" data-gallery={`gallery-${loc.slug}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => (
              <div
                class={`loc-photo-item r ${photo.h > photo.w ? 'loc-photo-tall' : ''}`}
                data-d={String((i % 5) + 1)}
                data-pswp-width={photo.fullWidth}
                data-pswp-height={photo.fullHeight}
                aria-label={photo.alt}
              >
                {photo.previewSrcSet ? (
                  <picture>
                    <source
                      type="image/avif"
                      srcset={photo.previewSrcSet}
                      sizes={photo.previewSizes}
                    />
                    {photo.webpSrcSet && (
                      <source
                        type="image/webp"
                        srcset={photo.webpSrcSet}
                        sizes={photo.previewSizes}
                      />
                    )}
                    <img
                      src={photo.previewSrc}
                      width={photo.previewWidth}
                      height={photo.previewHeight}
                      alt={photo.alt}
                      loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                    />
                  </picture>
                ) : (
                  <img
                    src={photo.previewSrc}
                    width={photo.previewWidth}
                    height={photo.previewHeight}
                    alt={photo.alt}
                    loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                  />
                )}
                <div class="loc-photo-overlay" aria-hidden="true">
                  <span class="loc-photo-index">{String(i + 1).padStart(2, '0')}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}



  </main>

</Layout>

<style>
  /* ── Page ── */
  .photos-page {
    padding-top: var(--hdr-h);
  }

  /* ── Hero ── */
  .photos-hero {
    padding: 80px 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: clamp(42px, 6.5vw, 90px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 0;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: 15px;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
  }

  .photos-nav-wrapper {
    position: sticky;
    top: -1px; /* slightly offset to trigger intersection or top <= 0 consistently */
    z-index: 50;
    background: transparent;
    padding: 28px 0;
    margin-bottom: 40px;
    margin-top: -1px;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease;
  }

  .photos-nav-wrapper.is-stuck {
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05), inset 0 -1px 0 rgba(255, 255, 255, 0.5);
    padding: 20px 0; /* slightly thinner when stuck */
  }

  @supports (backdrop-filter: blur(10px)) {
    .photos-nav-wrapper.is-stuck {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.4) 100%);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
    }
  }

  .photos-nav-list {
    position: relative; /* Anchor absolute indicator */
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photos-nav-list:active {
    cursor: grabbing;
  }

  .photos-nav-list::-webkit-scrollbar {
    display: none;
  }

  .photos-nav-indicator {
    position: absolute;
    background: var(--text);
    border-radius: 40px;
    top: 0;
    left: 0;
    height: 0;
    width: 0;
    pointer-events: none;
    z-index: 1; /* Below text */
    opacity: 0;
    transition: transform 0.38s cubic-bezier(0.25, 1, 0.5, 1),
                width 0.38s cubic-bezier(0.25, 1, 0.5, 1),
                height 0.38s cubic-bezier(0.25, 1, 0.5, 1),
                background-color 0.3s ease,
                opacity 0.25s ease;
  }

  .photos-nav-indicator.is-active-indicator {
    background-color: var(--text);
    opacity: 1;
  }

  .photos-nav-indicator.is-hover-indicator {
    background-color: var(--text);
    opacity: 0.08;
  }

  @media (prefers-color-scheme: dark) {
    .photos-nav-indicator.is-hover-indicator {
      opacity: 0.15;
    }
  }

  .photos-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 15px;
    font-family: var(--sans, system-ui, -apple-system, sans-serif);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    z-index: 2; /* Sit on top of the indicator */
    transition: color 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Fallback active styling when JS is not enabled */
  .photos-nav-link.active {
    background: var(--text);
    color: var(--bg);
  }
  .photos-nav-link.active .photos-nav-count {
    color: var(--bg);
    opacity: 0.7;
  }

  /* Disable hover background when JS-managed indicator is enabled */
  .photos-nav-list.js-active-nav .photos-nav-link {
    background: transparent !important;
  }

  /* Text color logic when JS indicator is active */
  .photos-nav-list.js-active-nav:not(.is-hovering) .photos-nav-link.active {
    color: var(--bg);
  }
  .photos-nav-list.js-active-nav:not(.is-hovering) .photos-nav-link.active .photos-nav-count {
    color: var(--bg);
    opacity: 0.7;
  }

  .photos-nav-list.js-active-nav.is-hovering .photos-nav-link {
    color: var(--text);
  }
  .photos-nav-list.js-active-nav.is-hovering .photos-nav-link .photos-nav-count {
    color: var(--muted);
    opacity: 1;
  }

  .photos-nav-count {
    color: var(--muted);
    font-size: 11px;
    font-family: var(--mono, monospace);
    transform: translateY(-30%);
    display: inline-block;
    transition: color 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .photos-nav-gallery-btn {
    opacity: 0.85;
  }

  .photos-gallery-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .photos-nav-gallery-btn:hover .photos-gallery-arrow {
    transform: translateX(3px);
  }

  /* ── Location section ── */
  .loc-section {
    display: none;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s var(--ease-out, ease), transform 0.5s var(--ease-out, ease);
    padding: clamp(24px, 4vw, 40px) 0 clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
  }

  .loc-section.active {
    display: block;
  }

  .loc-section.active.fade-in {
    opacity: 1;
    transform: translateY(0);
  }

  .loc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .loc-meta {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .loc-index {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: .08em;
    padding-top: 10px;
    flex-shrink: 0;
  }

  .loc-name {
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .loc-desc {
    font-size: 13px;
    color: var(--muted);
    max-width: 380px;
    line-height: 1.6;
  }

  .loc-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 6px;
    letter-spacing: .06em;
  }

  /* ── Image Grid ── */
  /*
    Masonry layout to display photos in full size / original aspect ratio
  */
  .loc-grid {
    column-count: 3;
    column-gap: 4px;
    content-visibility: auto;
    contain-intrinsic-size: auto 1200px;
  }

  .loc-photo-item {
    display: block;
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
    margin-bottom: 4px;
    break-inside: avoid;
    transform: translateZ(0); /* Prevent column break glitches */
  }

  .loc-photo-item img {
    display: block;
    width: 100%;
    height: auto; /* Maintains original aspect ratio */
    transition: transform .65s var(--ease-out, ease);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Overlay: appears on hover */
  .loc-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.3) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    padding: 12px 14px;
  }

  .loc-photo-item:hover .loc-photo-overlay {
    opacity: 1;
  }

  .loc-photo-index {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255,255,255,.7);
    letter-spacing: .1em;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .loc-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .loc-grid {
      column-count: 1;
    }
    .loc-photo-item {
      margin-bottom: 8px; /* Slightly more gap on mobile stack */
    }
    .loc-header {
      gap: 16px;
    }
  }
</style>

<script is:inline>
  // PhotoSwipe per-gallery init
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      // Re-use IO from layout for .r elements on this page
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -32px 0px' });
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      // Active state for sticky nav buttons and sliding indicator
      const sections = document.querySelectorAll('.loc-section');
      const navLinks = document.querySelectorAll('.photos-nav-link');
      const navList = document.querySelector('.photos-nav-list');
      const indicator = document.querySelector('.photos-nav-indicator');
      let currentActiveLink = null;

      const updateIndicator = (targetLink, isHover = false) => {
        if (!targetLink || !indicator || !navList) return;
        navList.classList.add('js-active-nav');
        
        const linkRect = targetLink.getBoundingClientRect();
        const listRect = navList.getBoundingClientRect();
        
        const offsetLeft = linkRect.left - listRect.left + navList.scrollLeft;
        const offsetTop = linkRect.top - listRect.top + navList.scrollTop;
        
        indicator.style.width = `${linkRect.width}px`;
        indicator.style.height = `${linkRect.height}px`;
        indicator.style.transform = `translate3d(${offsetLeft}px, ${offsetTop}px, 0)`;
        
        if (isHover) {
          indicator.classList.remove('is-active-indicator');
          indicator.classList.add('is-hover-indicator');
        } else {
          indicator.classList.remove('is-hover-indicator');
          indicator.classList.add('is-active-indicator');
        }
      };

      // Tab switcher function
      const activateTab = (slug) => {
        const targetSection = document.getElementById(slug);
        if (!targetSection) {
          // If hash is invalid, default to the first section
          if (sections.length > 0 && !slug) {
            activateTab(sections[0].id);
          }
          return;
        }

        // Hide other sections and deactivate links
        sections.forEach(sec => {
          if (sec.id !== slug) {
            sec.classList.remove('active', 'fade-in');
            sec.style.display = 'none';
          }
        });

        // Show active section
        targetSection.style.display = 'block';
        // Force reflow
        targetSection.offsetHeight;
        targetSection.classList.add('active');
        
        // Wait a frame to trigger transition
        requestAnimationFrame(() => {
          targetSection.classList.add('fade-in');
        });

        // Update nav links active class
        let matchedLink = null;
        navLinks.forEach(link => {
          const target = link.getAttribute('data-nav-target');
          if (target === slug) {
            link.classList.add('active');
            matchedLink = link;
          } else {
            link.classList.remove('active');
          }
        });

        if (matchedLink) {
          currentActiveLink = matchedLink;
          if (navList && !navList.classList.contains('is-hovering')) {
            updateIndicator(matchedLink, false);
          }
          // Scroll the nav link into view horizontally if needed
          matchedLink.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        // Reset and trigger entrance animations for elements inside the active tab
        targetSection.querySelectorAll('.r').forEach(el => {
          el.classList.remove('in');
          io.observe(el);
        });
      };

      // Reposition indicator on window resize
      window.addEventListener('resize', () => {
        if (currentActiveLink && navList && !navList.classList.contains('is-hovering')) {
          updateIndicator(currentActiveLink, false);
        }
      });

      // Hover effects
      navLinks.forEach(link => {
        link.addEventListener('mouseenter', () => {
          updateIndicator(link, true);
          navLinks.forEach(l => {
            if (l === link) {
              l.classList.add('is-hovered-active');
            } else {
              l.classList.remove('is-hovered-active');
            }
          });
          if (navList) navList.classList.add('is-hovering');
        });
      });

      if (navList) {
        navList.addEventListener('mouseleave', () => {
          navList.classList.remove('is-hovering');
          navLinks.forEach(l => l.classList.remove('is-hovered-active'));
          if (currentActiveLink) {
            updateIndicator(currentActiveLink, false);
          }
        });
      }
      
      // Tab switcher clicks
      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            const slug = href.substring(1);
            
            // Update URL hash without causing a page jump
            history.pushState(null, null, href);
            activateTab(slug);
            
            // Scroll to the nav list wrapper if the user has scrolled past it
            const navWrapper = document.querySelector('.photos-nav-wrapper');
            if (navWrapper) {
              const navRect = navWrapper.getBoundingClientRect();
              if (navRect.top < 0) {
                window.scrollTo({
                  top: window.scrollY + navRect.top - 20,
                  behavior: 'smooth'
                });
              }
            }
          }
        });
      });

      // Handle browser back/forward buttons (history popstate)
      window.addEventListener('popstate', () => {
        const hash = window.location.hash;
        if (hash) {
          activateTab(hash.substring(1));
        } else if (sections.length > 0) {
          activateTab(sections[0].id);
        }
      });

      // Initial tab activation based on current hash, default to first tab
      const initHash = window.location.hash;
      if (initHash) {
        activateTab(initHash.substring(1));
      } else if (sections.length > 0) {
        activateTab(sections[0].id);
      }

      // Sticky nav glassmorphism effect
      const navWrapper = document.querySelector('.photos-nav-wrapper');
      if (navWrapper) {
        window.addEventListener('scroll', () => {
          // It's stuck when it hits top: -1px
          if (navWrapper.getBoundingClientRect().top <= 0) {
            navWrapper.classList.add('is-stuck');
          } else {
            navWrapper.classList.remove('is-stuck');
          }
        }, { passive: true });
      }

      // Drag-to-scroll for nav list
      if (navList) {
        let isDown = false;
        let startX;
        let scrollLeft;
        let hasDragged = false;

        navList.addEventListener('mousedown', (e) => {
          isDown = true;
          hasDragged = false;
          startX = e.pageX - navList.offsetLeft;
          scrollLeft = navList.scrollLeft;
        });

        navList.addEventListener('mouseleave', () => {
          isDown = false;
        });

        navList.addEventListener('mouseup', () => {
          isDown = false;
        });

        navList.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - navList.offsetLeft;
          const walk = (x - startX) * 2; // scroll speed multiplier
          if (Math.abs(walk) > 5) hasDragged = true;
          navList.scrollLeft = scrollLeft - walk;
        });

        // Prevent click if dragging
        navList.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopImmediatePropagation();
            }
          });
          // Prevent ghost drag
          link.addEventListener('dragstart', (e) => e.preventDefault());
        });
      }
    });
  })();
</script>
