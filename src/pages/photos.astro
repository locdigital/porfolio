---
import Layout from "../layouts/Layout.astro";
import { getPhotoLocations } from "../lib/cms";
import BlurText from "../components/ui/BlurText.astro";
import { PHOTO_GRID_SIZES, optimizePhoto } from "../lib/photo-assets";

const sourceLocations = await getPhotoLocations();
const optimizedLocations = await Promise.all(
  sourceLocations.map(async (loc) => ({
    ...loc,
    photos: await Promise.all(
      loc.photos.map(async (photo) => {
        if (!photo.src.startsWith("/assets/photos/")) {
          return {
            ...photo,
            previewSrc: photo.src,
            previewSrcSet: "",
            webpSrcSet: "",
            previewSizes: PHOTO_GRID_SIZES,
            previewWidth: photo.w,
            previewHeight: photo.h,
            fullSrc: photo.src,
            fullWidth: photo.w,
            fullHeight: photo.h,
          };
        }

        return optimizePhoto(photo, {
          previewWidth: 720,
          previewWidths: [240, 400, 640, 960],
          previewSizes: PHOTO_GRID_SIZES,
          fullQuality: 78,
          withWebpFallback: true,
        });
      }),
    ),
  })),
);
const photosHeadline = "Places I've <em>wandered.</em>";
const photosHeadlineText = "Places I've wandered.";
type PhotoLocationView = Omit<Awaited<ReturnType<typeof getPhotoLocations>>[number], "photos"> & {
  photos?: unknown[];
};

function enabledBlock(loc: PhotoLocationView, type: string) {
  const blocks = Array.isArray(loc.blocks) ? loc.blocks : [];
  if (blocks.length === 0) return true;
  return blocks.some((block) => block.type === type && block.enabled);
}

function factsFor(loc: PhotoLocationView) {
  const budget = formatBudget(loc);
  return [
    { label: "Place", value: loc.province || loc.city || loc.country, icon: "📍" },
    { label: "Stay", value: loc.recommendedStay, icon: "🕒" },
    { label: "Season", value: loc.bestMonths || loc.bestTime, icon: "🗓️" },
    { label: "Budget", value: budget, icon: "💵" },
    { label: "Best for", value: (loc.suitableFor ?? []).join(" / "), icon: "✨" },
  ].filter((fact) => fact.value);
}

function formatBudget(loc: PhotoLocationView) {
  const min = typeof loc.budgetMin === "number" ? loc.budgetMin : 0;
  const max = typeof loc.budgetMax === "number" ? loc.budgetMax : 0;
  const amount = min && max
    ? `${formatMoney(min)} - ${formatMoney(max)}`
    : min || max
      ? formatMoney(min || max)
      : "";
  return amount;
}

function formatMoney(value: number) {
  return `$${value.toLocaleString("en-US")}`;
}

function reviewSectionsFor(loc: PhotoLocationView) {
  const overview = loc.overview || loc.shortDescription || loc.description || loc.introduction;
  return overview ? [["Overview", overview]] : [];
}

function goodToKnowChipsFor(loc: PhotoLocationView) {
  return [...(loc.bestTimeOfDay ?? []), ...(loc.travelTips ?? [])].filter(Boolean);
}

function hasDetailsFor(loc: PhotoLocationView) {
  return (
    (enabledBlock(loc, "quick-facts") && factsFor(loc).length > 0) ||
    (enabledBlock(loc, "editorial-review") && reviewSectionsFor(loc).length > 0) ||
    (enabledBlock(loc, "tips") && goodToKnowChipsFor(loc).length > 0) ||
    (enabledBlock(loc, "related-articles") && (loc.relatedArticles ?? []).length > 0) ||
    (enabledBlock(loc, "cta") && Boolean(loc.website || loc.bookingUrl || loc.instagram))
  );
}
---

<Layout title="Photos | Phuc Loc Nguyen">

  <main class="gear-page">
    <div class="gear-container">
      <!-- PAGE HERO -->
      <section class="gear-hero photos-hero-copy" aria-label="Photos introduction">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">My photos</span>
        </div>
        <h1 class="sr-only" set:html={photosHeadline} />
        <BlurText
          text={photosHeadlineText}
          animateBy="words"
          direction="top"
          delay={70}
          stepDuration={0.42}
          className="gear-hero-title"
        />
        <p class="gear-intro">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </p>
      </section>
    </div>

    <!-- QUICK NAV -->
    <div id="photos-nav-sentinel"></div>
    <div class="photos-nav-wrapper">
      <div class="container">
        <nav class="photos-nav" aria-label="Locations navigation">
          <div class="photos-nav-list">
            {optimizedLocations.map((loc, i) => (
              <button
                type="button"
                class={`photos-nav-link ${i === 0 ? 'active' : ''}`}
                data-target={loc.slug}
                aria-current={i === 0 ? "true" : undefined}
                aria-controls={loc.slug}
              >
                {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
              </button>
            ))}
            <span class="photos-nav-active-line" aria-hidden="true"></span>
          </div>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {optimizedLocations.map((loc, locIdx) => (
      <section
        class={`loc-section ${locIdx === 0 ? 'active' : ''}`}
        id={loc.slug}
        aria-label={`Photos from ${loc.name}`}
        hidden={locIdx !== 0}
      >
        <div class="container">
          <!-- Location header -->
          <div class="loc-header">
            <div class="loc-meta">
              <div>
                <h2 class="loc-name">{loc.headline || loc.name}</h2>
                <p class="loc-desc">{loc.description}</p>
              </div>
            </div>
            <span class="loc-count">{loc.photos.length} photos</span>
          </div>

          {hasDetailsFor(loc) && (
            <div class="loc-cms-detail" aria-label={`${loc.name} travel details`}>
              {enabledBlock(loc, "quick-facts") && factsFor(loc).length > 0 && (
                <section class="loc-info-section loc-quick-facts">
                  <h3>Quick Facts</h3>
                  <div class="loc-facts">
                    {factsFor(loc).map(({ label, value, icon }) => (
                      <span class="loc-fact-pill">
                        <span class="loc-fact-label">
                          <span class="loc-meta-icon" aria-hidden="true">{icon}</span>
                          {label}
                        </span>
                        <strong>{value}</strong>
                      </span>
                    ))}
                  </div>
                </section>
              )}

              {enabledBlock(loc, "editorial-review") && reviewSectionsFor(loc).length > 0 && (
                <section class="loc-info-section loc-rich">
                  {reviewSectionsFor(loc).map(([label, value]) => (
                    <>
                      <h3>{label}</h3>
                      <p>{value}</p>
                    </>
                  ))}
                </section>
              )}

              {enabledBlock(loc, "tips") && goodToKnowChipsFor(loc).length > 0 && (
                <section class="loc-info-section loc-good-to-know">
                  <h3>Good To Know</h3>
                  <ul class="loc-pill-list">
                    {goodToKnowChipsFor(loc).map((item) => (
                      <li>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {enabledBlock(loc, "related-articles") && (loc.relatedArticles ?? []).length > 0 && (
                <section class="loc-info-section">
                  <h3>Related Articles</h3>
                  <div class="loc-link-list">
                    {(loc.relatedArticles ?? []).map((article) => (
                      <a href={`/blog/${article.slug}`}>{article.title || article.slug}</a>
                    ))}
                  </div>
                </section>
              )}

              {enabledBlock(loc, "cta") && (loc.website || loc.bookingUrl || loc.instagram) && (
                <section class="loc-info-section">
                  <h3>Links</h3>
                  <div class="loc-link-list">
                    {loc.website && <a href={loc.website} target="_blank" rel="noopener noreferrer">Website</a>}
                    {loc.bookingUrl && <a href={loc.bookingUrl} target="_blank" rel="noopener noreferrer">Booking</a>}
                    {loc.instagram && <a href={loc.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
                  </div>
                </section>
              )}
            </div>
          )}
        </div>

        <!-- Photo grid --- full-bleed inside container -->
        <div class="container">
          <div class="loc-grid" data-gallery={`gallery-${loc.slug}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => (
              <div
                class={`loc-photo-item ${photo.h > photo.w ? 'loc-photo-tall' : ''}`}
                data-pswp-width={photo.fullWidth}
                data-pswp-height={photo.fullHeight}
                aria-label={photo.alt}
                style={`aspect-ratio: ${photo.previewWidth} / ${photo.previewHeight};`}
              >
                {photo.previewSrcSet ? (
                  <picture>
                    <source
                      type="image/avif"
                      srcset={photo.previewSrcSet}
                      sizes={photo.previewSizes}
                    />
                    {photo.webpSrcSet && (
                      <source
                        type="image/webp"
                        srcset={photo.webpSrcSet}
                        sizes={photo.previewSizes}
                      />
                    )}
                    <img
                      src={photo.previewSrc}
                      width={photo.previewWidth}
                      height={photo.previewHeight}
                      alt={photo.alt}
                      loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                      onerror="this.style.opacity='0'; this.closest('.loc-photo-item').style.backgroundColor='#e5e7eb';"
                    />
                  </picture>
                ) : (
                  <img
                    src={photo.previewSrc}
                    width={photo.previewWidth}
                    height={photo.previewHeight}
                    alt={photo.alt}
                    loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                    onerror="this.style.opacity='0'; this.closest('.loc-photo-item').style.backgroundColor='#e5e7eb';"
                  />
                )}
                <div class="loc-photo-overlay" aria-hidden="true">
                  <span class="loc-photo-index">{String(i + 1).padStart(2, '0')}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}



  </main>

</Layout>

<script>
  function initPhotoTabs() {
    const tablist = document.querySelector(".photos-nav-list");
    if (!(tablist instanceof HTMLElement) || tablist.dataset.tabsReady) return;
    tablist.dataset.tabsReady = "true";

    const tabs = Array.from(tablist.querySelectorAll(".photos-nav-link[data-target]"));
    const panels = Array.from(document.querySelectorAll(".loc-section"));
    const line = tablist.querySelector(".photos-nav-active-line");

    const moveLine = (tab: Element | null) => {
      if (!(line instanceof HTMLElement) || !(tab instanceof HTMLElement)) return;
      line.style.width = `${tab.offsetWidth}px`;
      line.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const activate = (id?: string) => {
      const nextTab = tabs.find((tab) => tab.getAttribute("data-target") === id) || tabs[0];
      const nextId = nextTab?.getAttribute("data-target");
      if (!nextId) return;
      const scrollX = window.scrollX;
      const scrollY = window.scrollY;

      tabs.forEach((tab) => {
        const isActive = tab === nextTab;
        tab.classList.toggle("active", isActive);
        tab.toggleAttribute("aria-current", isActive);
      });

      panels.forEach((panel) => {
        const isActive = panel.id === nextId;
        panel.classList.toggle("active", isActive);
        panel.toggleAttribute("hidden", !isActive);
      });

      if (location.hash.slice(1) !== nextId) {
        history.replaceState(null, "", `${location.pathname}${location.search}#${nextId}`);
      }

      moveLine(nextTab);
      if (nextTab instanceof HTMLElement) {
        const left = nextTab.offsetLeft - (tablist.clientWidth - nextTab.offsetWidth) / 2;
        tablist.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
      }
      requestAnimationFrame(() => window.scrollTo(scrollX, scrollY));
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.getAttribute("data-target") || undefined));
    });

    activate(location.hash.slice(1));
    window.addEventListener("resize", () => {
      moveLine(tablist.querySelector(".photos-nav-link.active"));
    });
    window.addEventListener("hashchange", () => activate(location.hash.slice(1)));
  }

  document.addEventListener("astro:page-load", initPhotoTabs);
  initPhotoTabs();
</script>

<style>
  /* ------ Page ------ */
  .photos-page {
    padding-top: var(--hdr-h);
  }

  /* ------ Hero ------ */
  .photos-hero {
    padding: 80px 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: var(--type-display-xl);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 0;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: var(--type-body);
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
  }

  #photos-nav-sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
    opacity: 0;
  }

  /* ------ Nav wrapper ------ */
  .photos-nav-wrapper {
    position: relative;
    z-index: 50;
    background: transparent;
    padding: 24px 0 0;
    margin-bottom: 40px;
    margin-top: -1px;
  }

  /* ------ Nav ------ */
  .photos-nav {
    border-bottom: 1px solid var(--divider);
    padding-bottom: 0;
  }

  .photos-nav-list {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-y: none;
    scrollbar-width: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photos-nav-list:active { cursor: grabbing; }
  .photos-nav-list::-webkit-scrollbar { display: none; }



  /* Active underline */
  .photos-nav-active-line {
    position: absolute;
    bottom: -1px;
    height: 2px;
    background: var(--text);
    pointer-events: none;
    z-index: 2;
    left: 0;
    width: 0;
    transform: translateX(0);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
                width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Tab links */
  .photos-nav-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    height: 36px;
    border-radius: 6px;
    font-size: var(--type-body);
    font-family: var(--sans);
    font-weight: 500;
    color: color-mix(in srgb, var(--text) 72%, var(--muted));
    text-decoration: none;
    white-space: nowrap;
    border: 0;
    background: transparent;
    transition: color 0.2s ease;
    cursor: pointer;
    user-select: none;
  }

  .photos-nav-link.active {
    color: var(--text);
  }

  .photos-nav-link:hover {
    color: var(--accent);
  }

  .photos-nav-count {
    color: inherit;
    font-size: var(--type-caption);
    font-family: var(--mono, monospace);
    opacity: 0.55;
    transform: translateY(-30%);
    display: inline-block;
  }

  /* ------ Location section ------ */
  .loc-section {
    --loc-prose-size: 0.875rem;
    --loc-prose-leading: 1.7;
    --loc-sidebar-size: 0.875rem;
    --loc-sidebar-leading: 1.65;
    --loc-prose-measure: 68ch;
    --loc-sidebar-measure: 34ch;
    --loc-heading-gap: var(--space-2);
    --loc-copy-gap: var(--space-3);
    --loc-rich-block-gap: 2rem;
    --loc-section-gap: var(--space-6);
    display: none;
    opacity: 1;
    overflow-anchor: none;
    padding: clamp(24px, 4vw, 40px) 0 clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
    content-visibility: visible;
  }

  .gear-page > .loc-section {
    content-visibility: visible;
  }

  .loc-section.active {
    display: block;
    opacity: 1;
    animation: photos-tab-in 0.28s ease both;
  }

  @keyframes photos-tab-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .loc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .loc-meta {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .loc-name {
    font-family: var(--serif);
    font-size: var(--type-display);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: var(--loc-heading-gap);
  }

  .loc-desc {
    max-width: var(--loc-prose-measure);
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: var(--loc-prose-leading);
    color: #6e6e6e;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .loc-count {
    font-family: var(--mono);
    font-size: var(--type-caption);
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 6px;
    letter-spacing: .06em;
  }

  .loc-grid {
    display: block;
    column-count: 3;
    column-gap: 8px;
  }

  .loc-photo-item {
    display: block;
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
    margin-bottom: 8px;
    border-radius: 6px;
    break-inside: avoid;
    aspect-ratio: auto !important;
    transform: translateZ(0);
  }

  .loc-photo-item picture::after {
    display: none;
  }

  .loc-photo-item picture {
    display: block;
    width: 100%;
  }

  .loc-photo-item img {
    display: block;
    width: 100%;
    height: auto;
    backface-visibility: hidden;
  }

  /* Overlay: appears on hover */
  .loc-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.3) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    padding: 12px 14px;
  }

  .loc-photo-item:hover .loc-photo-overlay {
    opacity: 1;
  }

  .loc-photo-index {
    font-family: var(--mono);
    font-size: var(--type-caption);
    color: rgba(255,255,255,.82);
    letter-spacing: .1em;
  }

  /* ------ CMS location details ------ */
  .loc-cms-detail {
    display: grid;
    grid-template-columns: minmax(12rem, 0.72fr) minmax(38ch, 1.48fr) minmax(14rem, 0.8fr);
    gap: clamp(var(--space-5), 3vw, var(--space-10));
    min-width: 0;
    margin: var(--space-1) 0 clamp(var(--space-8), 4vw, var(--space-12));
    padding-top: var(--space-6);
    border-top: 1px solid var(--divider);
  }

  .loc-info-section {
    display: grid;
    gap: var(--loc-copy-gap);
    align-content: start;
    min-width: 0;
  }

  .loc-info-section + .loc-info-section {
    padding-left: clamp(var(--space-4), 2vw, var(--space-6));
    border-left: 1px solid color-mix(in srgb, var(--divider) 72%, transparent);
  }

  .loc-info-section h3,
  .loc-rich h3,
  .loc-rich h4 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text);
  }

  .loc-info-section h3,
  .loc-rich h3 {
    font-size: 1.5rem;
    line-height: 1;
    margin: 0;
    text-wrap: balance;
  }

  :global(.loc-cms-detail h3) {
    font-size: 1.5rem;
  }

  .loc-rich h4 {
    font-size: var(--type-subhead);
    line-height: 1.12;
    margin-top: var(--space-2);
    text-wrap: balance;
  }

.loc-rich,
  .loc-rich p,
  .loc-rich li,
  .loc-muted {
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: var(--loc-prose-leading);
    color: #6e6e6e;
  }

  .loc-rich {
    display: grid;
    gap: var(--loc-rich-block-gap);
    max-width: var(--loc-prose-measure);
  }

  .loc-quick-facts,
  .loc-good-to-know {
    gap: var(--loc-rich-block-gap);
  }

  .loc-rich > :not(:first-child):is(h3, h4) {
    margin-top: 0;
  }

  .loc-rich p,
  .loc-rich ul,
  .loc-rich blockquote {
    max-width: var(--loc-prose-measure);
    min-width: 0;
  }

  .loc-rich ul {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1em;
  }

  .loc-rich blockquote {
    margin: 2px 0;
    padding-left: 16px;
    border-left: 2px solid var(--text);
    color: var(--muted);
    font-style: italic;
  }

  .loc-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    max-width: var(--loc-sidebar-measure);
  }

  .loc-fact-pill,
  .loc-fact-pill span,
  .loc-fact-pill strong,
  .loc-text-link,
  .loc-link-list a {
    font-family: var(--sans);
    font-size: var(--loc-sidebar-size);
  }

  .loc-fact-pill {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    flex: 0 1 auto;
    gap: var(--space-1);
    min-width: 0;
    min-height: 58px;
    max-width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--divider);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--text);
    line-height: 1.4;
  }

  .loc-fact-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-size: var(--type-caption);
    font-weight: 500;
  }

  .loc-meta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.1em;
    font-size: 0.95rem;
    line-height: 1;
  }

  .loc-fact-pill strong {
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: normal;
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--text);
  }

  .loc-pill-list,
  .loc-link-list,
  .loc-score-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .loc-pill-list li,
  .loc-text-link,
  .loc-link-list a,
  .loc-score-pill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
