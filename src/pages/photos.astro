---

<Layout title="Photos — Phuc Loc Nguyen">

  <main class="photos-page">

    <!-- PAGE HERO -->
    <section class="photos-hero" aria-label="Photos introduction">
      <div class="container">
        <div class="sh r">
          <span class="sh-title" data-parallax=".1">Photos</span>
          <span class="sh-number" data-parallax=".3">—</span>
        </div>
        <h1 class="photos-heading r" data-d="1">
          Places I've<br><em>wandered.</em>
        </h1>
        <p class="photos-subtext r" data-d="2">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </p>
      </div>
    </section>

    <!-- QUICK NAV -->
    <div class="photos-nav-wrapper">
      <div class="container">
        <nav class="photos-nav" aria-label="Locations navigation">
          <ul class="photos-nav-list">
            {locations.map((loc, i) => (
              <li>
                <a href={`#${loc.slug}`} class={`photos-nav-link ${i === 0 ? 'active' : ''}`} data-nav-target={loc.slug}>
                  {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {locations.map((loc, locIdx) => (
      <section
        class="loc-section"
        id={loc.slug}
        aria-label={`Photos from ${loc.name}`}
      >
        <div class="container">
          <!-- Location header -->
          <div class="loc-header r" data-d="1">
            <div class="loc-meta">
              <span class="loc-index">{String(locIdx + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="loc-name">{loc.name}</h2>
                <p class="loc-desc">{loc.description}</p>
              </div>
            </div>
            <span class="loc-count">{loc.photos.length} photos</span>
          </div>
        </div>

        <!-- Photo grid — full-bleed inside container -->
        <div class="container">
          <div class="loc-grid" data-gallery={`gallery-${loc.slug}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => (
              <a
                href={photo.src}
                class={`loc-photo-item r ${photo.h > photo.w ? 'loc-photo-tall' : ''}`}
                data-d={String((i % 5) + 1)}
                data-pswp-width={photo.w}
                data-pswp-height={photo.h}
                aria-label={photo.alt}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading={locIdx === 0 && i < 2 ? "eager" : "lazy"}
                />
                <div class="loc-photo-overlay" aria-hidden="true">
                  <span class="loc-photo-index">{String(i + 1).padStart(2, '0')}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}



  </main>

</Layout>

<style>
  /* ── Page ── */
  .photos-page {
    padding-top: var(--hdr-h);
  }

  /* ── Hero ── */
  .photos-hero {
    padding: clamp(56px, 8vw, 100px) 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 28px;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: clamp(14px, 1.5vw, 16px);
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
  }

  .photos-nav-wrapper {
    position: sticky;
    top: -1px; /* slightly offset to trigger intersection or top <= 0 consistently */
    z-index: 50;
    background: transparent;
    padding: 28px 0;
    margin-bottom: 40px;
    margin-top: -1px;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease;
  }

  .photos-nav-wrapper.is-stuck {
    background: rgba(250, 250, 247, 0.85);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05), inset 0 -1px 0 rgba(255, 255, 255, 0.5);
    padding: 20px 0; /* slightly thinner when stuck */
  }

  @supports (backdrop-filter: blur(10px)) {
    .photos-nav-wrapper.is-stuck {
      background: linear-gradient(135deg, rgba(250, 250, 247, 0.7) 0%, rgba(250, 250, 247, 0.4) 100%);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
    }
  }

  .photos-nav-list {
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .photos-nav-list::-webkit-scrollbar {
    display: none;
  }

  .photos-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 15px;
    font-family: var(--sans, system-ui, -apple-system, sans-serif);
    color: var(--text);
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .photos-nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  @media (prefers-color-scheme: dark) {
    .photos-nav-link:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }

  .photos-nav-count {
    color: var(--muted);
    font-size: 11px;
    font-family: var(--mono, monospace);
    transform: translateY(-30%);
    display: inline-block;
  }

  /* Active state */
  .photos-nav-link.active {
    background: var(--text);
    color: var(--bg);
  }

  .photos-nav-link.active .photos-nav-count {
    color: var(--bg);
    opacity: 0.7;
  }

  /* ── Location section ── */
  .loc-section {
    padding: clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
  }

  .loc-section:not(:first-of-type) {
    border-top: 1px solid var(--divider);
  }

  .loc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .loc-meta {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .loc-index {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: .08em;
    padding-top: 10px;
    flex-shrink: 0;
  }

  .loc-name {
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .loc-desc {
    font-size: 13px;
    color: var(--muted);
    max-width: 380px;
    line-height: 1.6;
  }

  .loc-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 6px;
    letter-spacing: .06em;
  }

  /* ── Image Grid ── */
  /*
    Grid layout matching reference:
    - Fixed aspect ratios to align bottoms perfectly
    - Tall photos span 2 rows
    - Dense flow fills gaps
  */
  .loc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    gap: 4px;
  }

  .loc-photo-item {
    display: block;
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
    aspect-ratio: 4 / 3;
  }

  .loc-photo-tall {
    grid-row: span 2;
    aspect-ratio: unset;
    height: 100%;
  }

  .loc-photo-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .65s var(--ease-out, ease);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Overlay: appears on hover */
  .loc-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.3) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    padding: 12px 14px;
  }

  .loc-photo-item:hover .loc-photo-overlay {
    opacity: 1;
  }

  .loc-photo-index {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255,255,255,.7);
    letter-spacing: .1em;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .loc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .loc-photo-tall {
      grid-row: span 1;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 600px) {
    .loc-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3px;
    }

    .loc-header {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>

<script is:inline>
  // PhotoSwipe per-gallery init
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      // Re-use IO from layout for .r elements on this page
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -32px 0px' });
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      // Active state for sticky nav buttons
      const sections = document.querySelectorAll('.loc-section');
      const navLinks = document.querySelectorAll('.photos-nav-link');

      const navIo = new IntersectionObserver(entries => {
        let activeId = null;
        // Find the topmost intersecting section
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
          }
        });
        
        if (activeId) {
          navLinks.forEach(link => {
            if (link.getAttribute('data-nav-target') === activeId) {
              link.classList.add('active');
              // Scroll the nav link into view horizontally if needed
              link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
              link.classList.remove('active');
            }
          });
        }
      }, { threshold: 0.2, rootMargin: '-100px 0px -40% 0px' });

      sections.forEach(sec => navIo.observe(sec));
      
      // Smooth scroll on click for nav links
      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          const targetId = this.getAttribute('href');
          if (targetId && targetId.startsWith('#')) {
            e.preventDefault();
            const targetEl = document.querySelector(targetId);
            if (targetEl) {
              targetEl.scrollIntoView({ behavior: 'smooth' });
              // Update URL hash without jumping
              history.pushState(null, null, targetId);
            }
          }
        });
      });

      // Sticky nav glassmorphism effect
      const navWrapper = document.querySelector('.photos-nav-wrapper');
      if (navWrapper) {
        window.addEventListener('scroll', () => {
          // It's stuck when it hits top: -1px
          if (navWrapper.getBoundingClientRect().top <= 0) {
            navWrapper.classList.add('is-stuck');
          } else {
            navWrapper.classList.remove('is-stuck');
          }
        }, { passive: true });
      }
    });
  })();
</script>

<script type="module" is:inline>
  import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.min.js';

  // One lightbox instance covering all galleries on the page
  const lb = new PhotoSwipeLightbox({
    gallery: '[data-gallery]',
    children: 'a',
    pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.esm.min.js'),
    showHideAnimationType: 'zoom',
    bgOpacity: 0.95,
    padding: { top: 20, bottom: 40, left: 20, right: 20 },
    preloaderDelay: 0,
  });

  // Caption: show alt text
  lb.on('uiRegister', () => {
    lb.pswp?.ui?.registerElement?.({
      name: 'caption', order: 9, isButton: false, appendTo: 'root',
      onInit: (el, pswp) => {
        el.style.cssText = 'position:absolute;bottom:0;left:0;right:0;padding:12px 20px;font-family:\'DM Mono\',monospace;font-size:11px;color:rgba(255,255,255,.55);text-align:center;letter-spacing:.06em;pointer-events:none;';
        pswp.on('change', () => { el.textContent = pswp.currSlide.data.element?.querySelector('img')?.alt || ''; });
      }
    });
  });

  lb.init();
</script>
