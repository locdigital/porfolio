---
import Layout from "../layouts/Layout.astro";
import { getPhotoLocations } from "../lib/cms";
import { PHOTO_GRID_SIZES, optimizePhoto } from "../lib/photo-assets";
import AnimatedPageHeadline, { AnimatedPageDescription } from "../components/ui/animated-page-headline";
import BlurFade from "../components/ui/BlurFade.astro";
import { Images } from "lucide-react";

const sourceLocations = await getPhotoLocations();
const optimizedLocations = await Promise.all(
  sourceLocations.map(async (loc) => ({
    ...loc,
    photos: await Promise.all(
      loc.photos.map(async (photo) => {
        if (!photo.src.startsWith("/assets/photos/")) {
          return {
            ...photo,
            previewSrc: photo.src,
            previewSrcSet: "",
            webpSrcSet: "",
            previewSizes: PHOTO_GRID_SIZES,
            previewWidth: photo.w,
            previewHeight: photo.h,
            fullSrc: photo.src,
            fullWidth: photo.w,
            fullHeight: photo.h,
          };
        }

        return optimizePhoto(photo, {
          previewWidth: 720,
          previewWidths: [240, 400, 640, 960],
          previewSizes: PHOTO_GRID_SIZES,
          fullQuality: 78,
          withWebpFallback: true,
        });
      }),
    ),
  })),
);
---

<Layout title="Photos --- Phuc Loc Nguyen">

  <main class="gear-page">
    <div class="gear-container">
      <!-- PAGE HERO -->
      <section class="gear-hero about-reveal-hero toki-r" data-d="1" aria-label="Photos introduction">
        <div class="page-kicker-wrapper">
          <span class="page-kicker-text">My photos</span>
        </div>
        <AnimatedPageHeadline client:load headline="Places I've <em>wandered.</em>" />
        <AnimatedPageDescription client:load className="gear-intro">
          Shot on whatever was in my pocket. These are the places that stayed with me.
        </AnimatedPageDescription>
      </section>
    </div>

    <!-- QUICK NAV -->
    <div id="photos-nav-sentinel"></div>
    <div class="photos-nav-wrapper toki-r" data-d="2">
      <div class="container">
            <nav class="photos-nav" aria-label="Locations navigation">
          <div class="photos-nav-list">
            <!-- Active underline -->
            <div class="photos-nav-active-line" id="photos-active-line"></div>

            {optimizedLocations.map((loc, i) => (
              <a href="/photos" class={`photos-nav-link ${i === 0 ? 'active' : ''}`} data-nav-target={loc.slug}>
                {loc.name} <span class="photos-nav-count">{loc.photos.length}</span>
              </a>
            ))}
            <a href="/gallery" class="photos-nav-link photos-nav-gallery-btn">
              Gallery <Images className="photos-gallery-icon" size={15} strokeWidth={1.8} aria-hidden="true" />
            </a>
          </div>
        </nav>
      </div>
    </div>

    <!-- LOCATION SECTIONS -->
    {optimizedLocations.map((loc, locIdx) => (
      <section
        class="loc-section"
        id={loc.slug}
        aria-label={`Photos from ${loc.name}`}
      >
        <div class="container">
          <!-- Location header -->
          <div class="loc-header r" data-d="1">
            <div class="loc-meta">
              <span class="loc-index">{String(locIdx + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="loc-name">{loc.name}</h2>
                <p class="loc-desc">{loc.description}</p>
              </div>
            </div>
            <span class="loc-count">{loc.photos.length} photos</span>
          </div>
        </div>

        <!-- Photo grid --- full-bleed inside container -->
        <div class="container">
          <div class="loc-grid" data-gallery={`gallery-${loc.slug}`} aria-label={`${loc.name} gallery`}>
            {loc.photos.map((photo, i) => (
              <BlurFade
                delay={(i % 5) * 0.08}
                className="break-inside-avoid mb-[4px]"
              >
                <div
                  class={`loc-photo-item ${photo.h > photo.w ? 'loc-photo-tall' : ''}`}
                  data-pswp-width={photo.fullWidth}
                  data-pswp-height={photo.fullHeight}
                  aria-label={photo.alt}
                  style={`aspect-ratio: ${photo.previewWidth} / ${photo.previewHeight};`}
                >
                  {photo.previewSrcSet ? (
                    <picture>
                      <source
                        type="image/avif"
                        srcset={photo.previewSrcSet}
                        sizes={photo.previewSizes}
                      />
                      {photo.webpSrcSet && (
                        <source
                          type="image/webp"
                          srcset={photo.webpSrcSet}
                          sizes={photo.previewSizes}
                        />
                      )}
                      <img
                        src={photo.previewSrc}
                        width={photo.previewWidth}
                        height={photo.previewHeight}
                        alt={photo.alt}
                        loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                        onerror="this.style.opacity='0'; this.closest('.loc-photo-item').style.backgroundColor='#e5e7eb';"
                      />
                    </picture>
                  ) : (
                    <img
                      src={photo.previewSrc}
                      width={photo.previewWidth}
                      height={photo.previewHeight}
                      alt={photo.alt}
                      loading={locIdx === 0 && i < 3 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={locIdx === 0 && i === 0 ? "high" : "auto"}
                      onerror="this.style.opacity='0'; this.closest('.loc-photo-item').style.backgroundColor='#e5e7eb';"
                    />
                  )}
                  <div class="loc-photo-overlay" aria-hidden="true">
                    <span class="loc-photo-index">{String(i + 1).padStart(2, '0')}</span>
                  </div>
                </div>
              </BlurFade>
            ))}
          </div>
        </div>
      </section>
    ))}



  </main>

</Layout>

<style>
  /* ------ Page ------ */
  .photos-page {
    padding-top: var(--hdr-h);
  }

  /* ------ Hero ------ */
  .photos-hero {
    padding: 80px 0 clamp(32px, 4vw, 52px);
  }

  .photos-heading {
    font-family: var(--serif);
    font-size: clamp(42px, 6.5vw, 90px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 20px;
    margin-top: 0;
  }

  .photos-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .photos-subtext {
    font-size: 15px;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
  }

  #photos-nav-sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
    opacity: 0;
  }

  /* ------ Nav wrapper ------ */
  .photos-nav-wrapper {
    position: relative;
    z-index: 50;
    background: transparent;
    padding: 24px 0 0;
    margin-bottom: 40px;
    margin-top: -1px;
  }

  /* ------ Nav ------ */
  .photos-nav {
    border-bottom: 1px solid var(--divider);
    padding-bottom: 0;
  }

  .photos-nav-list {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photos-nav-list:active { cursor: grabbing; }
  .photos-nav-list::-webkit-scrollbar { display: none; }



  /* Active underline */
  .photos-nav-active-line {
    position: absolute;
    bottom: -1px;
    height: 2px;
    background: var(--text);
    pointer-events: none;
    z-index: 2;
    transition: left 0.3s cubic-bezier(0.25, 1, 0.5, 1),
                width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Tab links */
  .photos-nav-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    height: 36px;
    border-radius: 6px;
    font-size: 14px;
    font-family: var(--sans, system-ui, sans-serif);
    font-weight: 500;
    color: rgba(14, 15, 17, 0.6);
    text-decoration: none;
    white-space: nowrap;
    background: transparent;
    transition: color 0.2s ease;
    cursor: pointer;
    user-select: none;
  }

  .photos-nav-link.active {
    color: var(--text);
  }

  .photos-nav-link:hover {
    color: var(--accent);
  }

  .photos-nav-count {
    color: inherit;
    font-size: 10px;
    font-family: var(--mono, monospace);
    opacity: 0.55;
    transform: translateY(-30%);
    display: inline-block;
  }

  .photos-nav-gallery-btn {
    margin-left: 10px;
    color: rgba(14, 15, 17, 0.5);
  }

  .photos-gallery-icon {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .photos-nav-gallery-btn:hover .photos-gallery-icon {
    transform: translateX(3px);
  }

  /* ------ Location section ------ */
  .loc-section {
    display: none;
    opacity: 0;
    padding: clamp(24px, 4vw, 40px) 0 clamp(60px, 8vw, 100px) 0;
    scroll-margin-top: calc(var(--hdr-h, 80px) + 70px);
  }

  .loc-section.active {
    display: block;
    opacity: 1;
  }

  .loc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  :global(.nav-is-stuck) .loc-header {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  .loc-meta {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .loc-index {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: .08em;
    padding-top: 10px;
    flex-shrink: 0;
  }

  .loc-name {
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .loc-desc {
    font-size: 13px;
    color: var(--muted);
    max-width: 380px;
    line-height: 1.6;
  }

  .loc-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 6px;
    letter-spacing: .06em;
  }

  /* ------ Image Grid ------ */
  /*
    Masonry layout to display photos in full size / original aspect ratio
  */
  .loc-grid {
    column-count: 3;
    column-gap: 4px;
  }

  .loc-photo-item {
    display: block;
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
    margin-bottom: 4px;
    break-inside: avoid;
    transform: translateZ(0); /* Prevent column break glitches */
  }

  .loc-photo-item img {
    display: block;
    width: 100%;
    height: auto; /* Maintains original aspect ratio */
    transition: transform .65s var(--ease-out, ease);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Overlay: appears on hover */
  .loc-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.3) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    padding: 12px 14px;
  }

  .loc-photo-item:hover .loc-photo-overlay {
    opacity: 1;
  }

  .loc-photo-index {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255,255,255,.7);
    letter-spacing: .1em;
  }

  /* ------ Responsive ------ */
  @media (max-width: 900px) {
    .loc-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .loc-grid {
      column-count: 1;
    }
    .loc-photo-item {
      margin-bottom: 8px; /* Slightly more gap on mobile stack */
    }
    .loc-header {
      gap: 16px;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  // PhotoSwipe per-gallery init
  (function () {
    document.addEventListener('astro:page-load', () => {
      // Re-use IO from layout for .r elements on this page
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -32px 0px' });
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      // ------ Vercel-style tabs: active underline ------
      const navLinks = document.querySelectorAll('.photos-nav-link[data-nav-target]');
      const activeLine = document.getElementById('photos-active-line');
      const navList   = document.querySelector('.photos-nav-list');
      let currentActiveLink = navLinks[0] || null;

      function getOffset(el) {
        if (!el || !navList) return { left: 0, width: 0 };
        const elRect   = el.getBoundingClientRect();
        const listRect = navList.getBoundingClientRect();
        return {
          left:  elRect.left - listRect.left + navList.scrollLeft,
          width: elRect.width,
        };
      }

      function moveActiveLine(link) {
        if (!activeLine || !link) return;
        const { left, width } = getOffset(link);
        activeLine.style.left  = `${left}px`;
        activeLine.style.width = `${width}px`;
      }



      // Tab switcher
      const sections = document.querySelectorAll('.loc-section');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeSlug = '';
      let tabTween = null;

      function getSectionPieces(section) {
        if (!section) return [];
        return gsap.utils.toArray(section.querySelectorAll('.loc-header, .loc-photo-item'));
      }

      function setSectionVisible(section, isVisible, { keepMinHeight = false } = {}) {
        if (!section) return;
        section.classList.toggle('active', isVisible);
        section.style.display = isVisible ? 'block' : 'none';
        section.style.opacity = isVisible ? '1' : '0';
        if (!keepMinHeight) {
          section.style.minHeight = '';
        }

        section.querySelectorAll('.r').forEach(el => {
          el.classList.toggle('in', isVisible);
        });
      }

      function settleTab(slug, { keepActiveMinHeight = false } = {}) {
        sections.forEach(sec => {
          const isActiveSection = sec.id === slug;
          setSectionVisible(sec, isActiveSection, { keepMinHeight: isActiveSection && keepActiveMinHeight });
          gsap.set(sec, { clearProps: 'transform,scale,opacity,visibility' });
          gsap.set(getSectionPieces(sec), { clearProps: 'transform,scale,opacity,visibility' });
        });
      }

      function measureHiddenSectionHeight(section) {
        if (!section) return 0;
        const previousDisplay = section.style.display;
        const previousOpacity = section.style.opacity;
        const previousVisibility = section.style.visibility;
        const previousPosition = section.style.position;
        const previousPointerEvents = section.style.pointerEvents;
        const previousWidth = section.style.width;
        const previousLeft = section.style.left;

        section.style.display = 'block';
        section.style.opacity = '0';
        section.style.visibility = 'hidden';
        section.style.position = 'absolute';
        section.style.pointerEvents = 'none';
        section.style.width = `${section.parentElement?.getBoundingClientRect().width || document.documentElement.clientWidth}px`;
        section.style.left = '0';

        const height = section.scrollHeight;

        section.style.display = previousDisplay;
        section.style.opacity = previousOpacity;
        section.style.visibility = previousVisibility;
        section.style.position = previousPosition;
        section.style.pointerEvents = previousPointerEvents;
        section.style.width = previousWidth;
        section.style.left = previousLeft;

        return height;
      }

      function ensureScrollRoom(section, desiredScrollY, activeSection = document.querySelector('.loc-section.active')) {
        if (!section) return 0;
        const referenceSection = activeSection || section;
        const sectionTop = referenceSection.getBoundingClientRect().top + window.scrollY;
        const minHeightForViewport = Math.ceil(desiredScrollY + window.innerHeight - sectionTop + 2);
        const targetHeight = section.offsetHeight || measureHiddenSectionHeight(section);
        const currentHeight = Math.max(referenceSection.offsetHeight, referenceSection.scrollHeight, targetHeight);

        const lockHeight = Math.max(currentHeight, minHeightForViewport, 0);
        referenceSection.style.minHeight = `${lockHeight}px`;
        section.style.minHeight = `${lockHeight}px`;

        return lockHeight;
      }

      function restoreScrollY(scrollY) {
        window.scrollTo({ top: scrollY, left: window.scrollX, behavior: 'auto' });
        requestAnimationFrame(() => {
          window.scrollTo({ top: scrollY, left: window.scrollX, behavior: 'auto' });
          requestAnimationFrame(() => {
            window.scrollTo({ top: scrollY, left: window.scrollX, behavior: 'auto' });
          });
        });
      }

      function clearLocationHash() {
        if (!window.location.hash) return;
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
      }

      const activateTab = (slug, options = {}) => {
        const targetSection = document.getElementById(slug);
        if (!targetSection) return;
        if (slug === activeSlug && targetSection.classList.contains('active')) return;

        const shouldPreserveScroll = options.preserveScroll === true;
        const previousScrollY = window.scrollY;
        const activeSection = document.querySelector('.loc-section.active');
        const outgoingPieces = getSectionPieces(activeSection);
        const incomingPieces = getSectionPieces(targetSection);
        const flipState = reduceMotion || !activeSection ? null : Flip.getState(outgoingPieces);

        if (tabTween) {
          tabTween.kill();
          tabTween = null;
        }

        if (shouldPreserveScroll) {
          ensureScrollRoom(targetSection, previousScrollY, activeSection);
        }

        if (reduceMotion || !activeSection || activeSection === targetSection) {
          settleTab(slug, { keepActiveMinHeight: shouldPreserveScroll });
        } else {
          setSectionVisible(activeSection, true, { keepMinHeight: shouldPreserveScroll });
          setSectionVisible(targetSection, false, { keepMinHeight: shouldPreserveScroll });

          tabTween = gsap.timeline({
            onComplete: () => {
              tabTween = null;
              settleTab(slug, { keepActiveMinHeight: shouldPreserveScroll });
              if (shouldPreserveScroll) {
                restoreScrollY(previousScrollY);
              }
            },
          });

          tabTween
            .add(Flip.from(flipState, {
              targets: outgoingPieces,
              duration: 0.6,
              scale: true,
              ease: 'power1.inOut',
              stagger: 0.05,
              absolute: true,
              prune: true,
            }), 0)
            .to(outgoingPieces, {
              opacity: 0,
              scale: 0,
              duration: 0.8,
              ease: 'power1.inOut',
              stagger: 0.05,
              overwrite: true,
            }, 0)
            .set(activeSection, { display: 'none', opacity: 0 }, 0.42)
            .set(targetSection, { display: 'block', opacity: 1 }, 0.42)
            .fromTo(incomingPieces, {
              opacity: 0,
              scale: 0,
            }, {
              opacity: 1,
              scale: 1,
              duration: 0.8,
              ease: 'power1.inOut',
              stagger: 0.05,
              overwrite: true,
            }, 0.42);
        }

        activeSlug = slug;

        navLinks.forEach(link => {
          if (link.getAttribute('data-nav-target') === slug) {
            link.classList.add('active');
            currentActiveLink = link;
            moveActiveLine(link);
            link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            link.classList.remove('active');
          }
        });

        targetSection.querySelectorAll('.r').forEach(el => {
          el.classList.add('in');
          io.observe(el);
        });

        if (shouldPreserveScroll) {
          restoreScrollY(previousScrollY);
        }
      };

      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          const slug = this.getAttribute('data-nav-target');
          if (slug) {
            e.preventDefault();
            activateTab(slug, { preserveScroll: true });
            clearLocationHash();
          }
        });
      });

      const onPopState = () => {
        const hash = window.location.hash;
        if (hash) {
          activateTab(hash.substring(1));
          clearLocationHash();
        } else if (sections.length > 0) {
          activateTab(sections[0].id);
        }
      };
      const photosWindow = window;
      if (photosWindow._photosOnPopState) {
        window.removeEventListener('popstate', photosWindow._photosOnPopState);
      }
      photosWindow._photosOnPopState = onPopState;
      window.addEventListener('popstate', photosWindow._photosOnPopState);

      // Reposition on resize
      const onResize = () => {
        if (currentActiveLink) moveActiveLine(currentActiveLink);
      };
      if (photosWindow._photosOnResize) {
        window.removeEventListener('resize', photosWindow._photosOnResize);
      }
      photosWindow._photosOnResize = onResize;
      window.addEventListener('resize', photosWindow._photosOnResize);

      // Init
      const initHash = window.location.hash;
      if (initHash) {
        activateTab(initHash.substring(1));
        clearLocationHash();
      } else if (sections.length > 0) {
        activateTab(sections[0].id);
      }
      // Init active line position after first paint
      requestAnimationFrame(() => moveActiveLine(currentActiveLink));

      // Navigation scroll effect (toggles body class when scrolled past sentinel)
      const sentinel = document.getElementById('photos-nav-sentinel');
      if (sentinel) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              document.body.classList.add('nav-is-stuck');
            } else {
              document.body.classList.remove('nav-is-stuck');
            }
          });
        }, {
          threshold: [0],
          rootMargin: '-1px 0px 0px 0px'
        });
        observer.observe(sentinel);
      }

      // Drag-to-scroll for nav list
      if (navList) {
        let isDown = false;
        let startX;
        let scrollLeft;
        let hasDragged = false;

        navList.addEventListener('mousedown', (e) => {
          isDown = true;
          hasDragged = false;
          startX = e.pageX - navList.offsetLeft;
          scrollLeft = navList.scrollLeft;
        });

        navList.addEventListener('mouseleave', () => {
          isDown = false;
        });

        navList.addEventListener('mouseup', () => {
          isDown = false;
        });

        navList.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - navList.offsetLeft;
          const walk = (x - startX) * 2; // scroll speed multiplier
          if (Math.abs(walk) > 5) hasDragged = true;
          navList.scrollLeft = scrollLeft - walk;
        });

        // Prevent click if dragging
        navList.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopImmediatePropagation();
            }
          });
          // Prevent ghost drag
          link.addEventListener('dragstart', (e) => e.preventDefault());
        });
      }
    });
  })();
</script>
