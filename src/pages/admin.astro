---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAFAF7" />
    <title>Loc Digital CMS</title>
    <link rel="icon" type="image/svg+xml" href="/admin/favicon.svg" />
    <link rel="preconnect" href="https://identity.netlify.com" />
    <link rel="preconnect" href="https://unpkg.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Imbue:opsz,wght@10..100,100..900&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=DM+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <style is:global>
      :root {
        --bg: #fafaf7;
        --text: #1c1c1c;
        --muted: #6e6e6e;
        --line: #e8e8e2;
        --accent: #0075de;
        --serif: "Imbue", Georgia, serif;
        --sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
        --mono: "DM Mono", "Courier New", monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(0, 117, 222, 0.08), transparent 34rem),
          linear-gradient(180deg, #fff 0%, var(--bg) 42%);
        color: var(--text);
        font-family: var(--sans);
      }

      body::before {
        content: "Loc Digital CMS";
        position: fixed;
        top: 18px;
        left: clamp(18px, 3vw, 40px);
        z-index: 20;
        color: var(--text);
        font-family: var(--serif);
        font-size: clamp(28px, 4vw, 46px);
        font-weight: 400;
        line-height: 1;
        pointer-events: none;
      }

      body::after {
        content: "Content studio for writing, work, photos, gear";
        position: fixed;
        top: 68px;
        left: clamp(18px, 3vw, 40px);
        z-index: 20;
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.02em;
        pointer-events: none;
      }

      #nc-root {
        min-height: 100vh;
        padding-top: 116px;
      }

      [class*="AppHeader"],
      [class*="ToolbarContainer"] {
        border-color: var(--line) !important;
        box-shadow: none !important;
      }

      [class*="AppHeader"] {
        background: rgba(250, 250, 247, 0.84) !important;
        backdrop-filter: blur(18px) saturate(160%);
      }

      [class*="SidebarContainer"],
      [class*="CollectionTopContainer"],
      [class*="EditorContainer"],
      [class*="PreviewPaneContainer"],
      [class*="Card"] {
        border-color: var(--line) !important;
      }

      [class*="SidebarContainer"],
      [class*="CollectionContainer"],
      [class*="EditorContainer"] {
        background: transparent !important;
      }

      a,
      button {
        border-radius: 6px !important;
        font-family: var(--sans) !important;
      }

      input,
      textarea,
      select {
        border-radius: 6px !important;
        border-color: var(--line) !important;
        font-family: var(--sans) !important;
      }

      input:focus,
      textarea:focus,
      select:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px rgba(0, 117, 222, 0.12) !important;
      }

      [class*="Button"],
      [class*="StyledButton"] {
        border-radius: 999px !important;
        font-weight: 600 !important;
      }

      [class*="ControlPaneContainer"],
      [class*="EditorControlBar"] {
        background: rgba(250, 250, 247, 0.94) !important;
      }

      @media (max-width: 760px) {
        body::before {
          font-size: 30px;
        }

        body::after {
          display: none;
        }

        #nc-root {
          padding-top: 84px;
        }
      }
    </style>
    <link rel="stylesheet" href="/admin/shell.css" />
  </head>
  <body>
    <script is:inline>
      (function ensureShellTheme() {
        const href = "/admin/shell.css";
        const existing = document.querySelector(`link[href="${href}"]`);
        const link = existing || document.createElement("link");
        link.rel = "stylesheet";
        link.href = href;
        link.id = "loc-cms-shell-theme";
        document.head.appendChild(link);
      })();
    </script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
    <script is:inline src="https://unpkg.com/decap-cms@^3.8.0/dist/decap-cms.js"></script>
    <script is:inline src="/admin/preview.js"></script>
    <script is:inline src="/admin/shell.js"></script>
  </body>
</html>
