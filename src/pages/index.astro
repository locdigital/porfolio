---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Phuc Loc Nguyen | Digital Marketing Specialist">




  <!-- ============================================================
       MAIN
  ============================================================ -->
  <main style="display:flex;flex-direction:column;">

    <!-- HERO ––––––––––––––––––––––––––––––––––– -->
    <section class="hero" id="hero" aria-label="Introduction">
      <div class="container hero-container">
        <div class="hero-layout">

          <div>
            <h1 class="hero-title">
              <span class="hero-line hero-line-1">Performance.</span>
              <span class="hero-line hero-line-2">Strategy.</span>
              <span class="hero-line hero-line-3"><em>Scaling revenue</em></span>
              <span class="hero-line hero-line-4"><em>with data.</em></span>
            </h1>
          </div>

          <div class="hero-aside">
            <p>Performance-driven Digital Marketer with 4+ years of experience scaling e-commerce, education, and consumer brands.</p>
            <p>I specialize in multi-channel paid media (TikTok, Meta, Google), SEO, and AI-automated funnels with a rigorous focus on ROAS and scalable profitability.</p>
            <p>If you're building something and need a marketer who delivers measurable growth, let's <a
                href="mailto:hi@loc.digital">talk</a>.</p>
            <div class="location">
              <span class="loc-dot" aria-hidden="true"></span>
              Ho Chi Minh City, Vietnam
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- EXPERIENCE ––––––––––––––––––––––––––––– -->
    <section class="work" id="work" aria-label="Work experience">
      <div class="container">
        <div class="sh r">
          <span class="sh-title" data-parallax=".1">Experience</span>
          <span class="sh-number" data-parallax=".3">01</span>
        </div>

        <ul>
          <li class="timeline-row r" data-d="1">
            <div class="tl-left">
              <div class="tl-logo" aria-hidden="true"><img src="assets/logos/logo-workflow.png" alt="WorkFlow Space"
                  loading="lazy"></div>
              <div class="tl-info">
                <span class="tl-company"><a href="https://www.workflowspace.vn/" target="_blank" rel="noopener">WorkFlow
                    Space</a></span>
                <span class="tl-desc">Digital Marketing Specialist — content, ads &amp; community growth.</span>
              </div>
            </div>
            <span class="tl-dates">2024–Present</span>
          </li>
          <li class="timeline-row r" data-d="2">
            <div class="tl-left">
              <div class="tl-logo" aria-hidden="true"><img src="assets/logos/logo-playah.png" alt="PlayAh!"
                  loading="lazy"></div>
              <div class="tl-info">
                <span class="tl-company"><a href="https://playahvietnam.com/" target="_blank"
                    rel="noopener">PlayAh!</a></span>
                <span class="tl-desc">Digital Marketing Specialist — brand campaigns &amp; performance.</span>
              </div>
            </div>
            <span class="tl-dates">2024–Present</span>
          </li>
          <li class="timeline-row r" data-d="3">
            <div class="tl-left">
              <div class="tl-logo" aria-hidden="true"><img src="assets/logos/logo-pops.jpg" alt="POPS Worldwide"
                  loading="lazy"></div>
              <div class="tl-info">
                <span class="tl-company"><a href="https://pops.vn/" target="_blank" rel="noopener">POPS
                    Worldwide</a></span>
                <span class="tl-desc">SEO Executive — search strategy &amp; organic growth.</span>
              </div>
            </div>
            <span class="tl-dates">2023–2024</span>
          </li>
          <li class="timeline-row r" data-d="4">
            <div class="tl-left">
              <div class="tl-logo" aria-hidden="true"><img src="assets/logos/logo-pnj.png" alt="PNJ" loading="lazy">
              </div>
              <div class="tl-info">
                <span class="tl-company"><a href="https://www.pnj.com.vn/" target="_blank" rel="noopener">PNJ</a></span>
                <span class="tl-desc">Digital Marketing Specialist — e-commerce &amp; retail campaigns.</span>
              </div>
            </div>
            <span class="tl-dates">2022–2023</span>
          </li>
          <li class="timeline-row r" data-d="5">
            <div class="tl-left">
              <div class="tl-logo" aria-hidden="true"><img src="assets/logos/logo-sony.jpg" alt="Sony" loading="lazy">
              </div>
              <div class="tl-info">
                <span class="tl-company"><a href="https://www.sony.com.vn/" target="_blank"
                    rel="noopener">Sony</a></span>
                <span class="tl-desc">Digital Marketing Specialist — brand awareness &amp; lead gen.</span>
              </div>
            </div>
            <span class="tl-dates">2021–2022</span>
          </li>
        </ul>
      </div>
    </section>



    <!-- PHOTOGRAPHY –––––––––––––––––––––––––––– -->
    <section class="gallery" id="photography" aria-label="Photography">
      <div class="container">
        <div class="sh r">
          <span class="sh-title" data-parallax=".1">Photos</span>
          <span class="sh-number" data-parallax=".3">02</span>
        </div>
      </div>

      <div class="gallery-scroll-wrapper">
        <button class="gallery-arrow gallery-arrow--left" aria-label="Scroll left" disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>

        <div class="gallery-fade-wrapper">
          <!-- Fade gradients: right always visible, left appears after scrolling -->
          <div class="gallery-fade-right" aria-hidden="true"></div>
          <div class="gallery-fade-left" aria-hidden="true"></div>
          <div class="gallery-strip-outer">

            <div class="gallery-strip" data-gallery aria-label="Photo gallery">
              <div class="gallery-row">
                <a href="assets/photos/photo-1.jpg" class="gallery-item r" data-d="1" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 1">
                  <img src="assets/photos/photo-1.jpg" alt="Photo 1" loading="lazy">
                </a>
                <a href="assets/photos/photo-2.jpg" class="gallery-item r" data-d="2" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 2">
                  <img src="assets/photos/photo-2.jpg" alt="Photo 2" loading="lazy">
                </a>
                <a href="assets/photos/photo-3.jpg" class="gallery-item r" data-d="3" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 3">
                  <img src="assets/photos/photo-3.jpg" alt="Photo 3" loading="lazy">
                </a>
                <a href="assets/photos/photo-4.jpg" class="gallery-item w-wide r" data-d="4" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 4">
                  <img src="assets/photos/photo-4.jpg" alt="Photo 4" loading="lazy">
                </a>
                <a href="assets/photos/photo-5.jpg" class="gallery-item r" data-d="5" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 5">
                  <img src="assets/photos/photo-5.jpg" alt="Photo 5" loading="lazy">
                </a>
                <a href="assets/photos/photo-6.jpg" class="gallery-item w-wide r" data-d="1" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 6">
                  <img src="assets/photos/photo-6.jpg" alt="Photo 6" loading="lazy">
                </a>
                <a href="assets/photos/photo-7.jpg" class="gallery-item w-wide r" data-d="2" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 7">
                  <img src="assets/photos/photo-7.jpg" alt="Photo 7" loading="lazy">
                </a>
                <a href="assets/photos/photo-8.jpg" class="gallery-item r" data-d="3" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 8">
                  <img src="assets/photos/photo-8.jpg" alt="Photo 8" loading="lazy">
                </a>
              </div>
              <div class="gallery-row">
                <a href="assets/photos/photo-9.jpg" class="gallery-item w-wide r" data-d="4" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 9">
                  <img src="assets/photos/photo-9.jpg" alt="Photo 9" loading="lazy">
                </a>
                <a href="assets/photos/photo-10.jpg" class="gallery-item w-wide r" data-d="5" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 10">
                  <img src="assets/photos/photo-10.jpg" alt="Photo 10" loading="lazy">
                </a>
                <a href="assets/photos/photo-11.jpg" class="gallery-item w-wide r" data-d="1" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 11">
                  <img src="assets/photos/photo-11.jpg" alt="Photo 11" loading="lazy">
                </a>
                <a href="assets/photos/photo-12.jpg" class="gallery-item w-wide r" data-d="2" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 12">
                  <img src="assets/photos/photo-12.jpg" alt="Photo 12" loading="lazy">
                </a>
                <a href="assets/photos/photo-13.jpg" class="gallery-item w-wide r" data-d="3" data-pswp-width="1920" data-pswp-height="1280" aria-label="Photo 13">
                  <img src="assets/photos/photo-13.jpg" alt="Photo 13" loading="lazy">
                </a>
                <a href="assets/photos/photo-14.jpg" class="gallery-item r" data-d="4" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 14">
                  <img src="assets/photos/photo-14.jpg" alt="Photo 14" loading="lazy">
                </a>
                <a href="assets/photos/photo-15.jpg" class="gallery-item r" data-d="5" data-pswp-width="1280" data-pswp-height="1920" aria-label="Photo 15">
                  <img src="assets/photos/photo-15.jpg" alt="Photo 15" loading="lazy">
                </a>
              </div>
            </div>

          </div><!-- /.gallery-strip-outer -->
        </div><!-- /.gallery-fade-wrapper -->

        <button class="gallery-arrow gallery-arrow--right" aria-label="Scroll right">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </section>

    <!-- WRITING –––––––––––––––––––––––––––––––– -->
    <section class="writing" id="writing" aria-label="Writing">
      <div class="container">
        <div class="sh r">
          <span class="sh-title" data-parallax=".1">Writing</span>
          <span class="sh-number" data-parallax=".3">03</span>
        </div>

        <div class="post-list">
          <a href="#" class="post-item r" data-d="1" aria-label="Read: SEO for Vietnamese brands">
            <span class="post-date">May 2026</span>
            <span class="post-title">SEO for Vietnamese brands — why local search intent changes everything</span>
          </a>
          <a href="#" class="post-item r" data-d="2" aria-label="Read: D2C Marketing strategy">
            <span class="post-date">Mar 2026</span>
            <span class="post-title">D2C Marketing playbook: lessons from running campaigns for SONY Vietnam</span>
          </a>
          <a href="#" class="post-item r" data-d="3" aria-label="Read: Social media growth">
            <span class="post-date">Jan 2026</span>
            <span class="post-title">Growing a community from 0 — the WorkFlow Space social media story</span>
          </a>
          <a href="#" class="post-item r" data-d="4" aria-label="Read: Meta Ads optimization">
            <span class="post-date">Oct 2025</span>
            <span class="post-title">Meta Ads optimization: how I cut CPL by 40% for an education brand</span>
          </a>
          <a href="#" class="post-item r" data-d="5" aria-label="Read: Full-funnel digital marketing">
            <span class="post-date">Aug 2025</span>
            <span class="post-title">Full-funnel thinking: why most marketers focus on the wrong stage</span>
          </a>
        </div>

        <a href="#" class="see-all">All writing →</a>
      </div>
    </section>

  </main>




  <!-- ============================================================
       SCRIPTS
  ============================================================ -->

</Layout>
