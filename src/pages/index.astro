---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getPhotoLocations } from "../lib/content";
import { PERSON_ID, canonicalUrl, pageSchema } from "../lib/seo";

const publishedLocations = await getPhotoLocations();
const galleryCount = publishedLocations.length;
const homeUrl = canonicalUrl("/");
const homeSchema = pageSchema({
  url: homeUrl,
  title: "Phuc Loc Nguyen — Performance Marketing & Travel Photography",
  description: "Phuc Loc Nguyen (Loc / Henry) workspace: performance marketing frameworks, TikTok Shop GMV scaling, paid media case studies, and first-hand travel photography across Vietnam and Southeast Asia.",
  type: "WebPage",
  mainEntity: { "@id": PERSON_ID },
});

// Experience summary items:
const experienceHighlights = [
  {
    company: "SONY",
    logo: "/assets/logos/logo-sony.webp",
    logoBg: "#000000",
    logoFit: "contain",
    logoScale: 1.55,
    role: "SONY D2C Marketing",
    period: "2025 — 2026",
    focus: "Direct-to-consumer marketing, e-commerce operations, Adobe Analytics, A/B testing, and CRM coordination."
  },
  {
    company: "PlayAh!",
    logo: "/assets/logos/logo-playah.webp",
    logoBg: "#f7f7f7",
    logoFit: "contain",
    logoScale: 1.9,
    role: "Performance Senior Executive",
    period: "2024 — 2026",
    focus: "TikTok Shop GMV acceleration, creator affiliate network, and automated retention."
  },
  {
    company: "Asia Strategic Holdings",
    logo: "/assets/logos/logo-asia-strategic.png",
    logoBg: "#ffffff",
    logoFit: "contain",
    logoScale: 0.92,
    role: "Performance Marketing",
    period: "2025 — 2026",
    focus: "Growth marketing, customer acquisition modeling, and multi-channel attribution."
  },
  {
    company: "POPS Worldwide",
    logo: "/assets/logos/logo-pops.webp",
    logoBg: "#ea500e",
    logoFit: "cover",
    logoScale: 1.35,
    role: "SEO Executive",
    period: "2022 — 2023",
    focus: "Technical SEO roadmap scaling organic traffic to 2.5M MAU across regional platforms."
  }
];

// Services preview (6 core offerings):
const servicesPreview = [
  {
    title: "Performance Ads & Attribution",
    summary: "Meta, Google PMax & TikTok Ads backed by Server-Side CAPI and GA4 audit."
  },
  {
    title: "Organic Seeding & Advocacy",
    summary: "High-trust community discussions, sentiment management, and authentic creator advocacy."
  },
  {
    title: "Strategic Brand Positioning",
    summary: "Market positioning, messaging architecture, and visual identity guidelines."
  },
  {
    title: "DTC Storefront Optimization",
    summary: "Conversion rate optimization, catalog feeds, and lifecycle retention funnels."
  },
  {
    title: "Headless Web Engineering",
    summary: "Ultra-fast Astro & React builds targeting strict Core Web Vitals and technical SEO."
  },
  {
    title: "AI Funnels & Automation",
    summary: "Make/Zapier CRM integrations, automated lead routing, and programmatic content engines."
  }
];
---

<DashboardLayout 
  title="Phuc Loc Nguyen — Workspace"
  description="Phuc Loc Nguyen (Loc / Henry) workspace: scaling multi-channel paid media, TikTok Shop GMV, unit economics, SEO, and first-hand travel photography across Vietnam and Southeast Asia."
  breadcrumbs={[{ label: "Overview" }]}
  maxWidthVariant="default"
  schema={homeSchema}
>
  <!-- ============================================================
       1. IDENTITY & INTRODUCTION (Directly on document surface)
       ============================================================ -->
  <header class="page-header">
    <div style="max-width: 76ch;">
      <h1 class="page-title" style="margin-bottom: var(--space-1);">Phuc Loc Nguyen</h1>
      <div style="font-size: var(--text-body-sm); line-height: var(--leading-compact); color: var(--dash-muted); margin-bottom: var(--space-3); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span style="font-weight: 500;">Senior Performance Marketing Executive</span>
      </div>
      <p class="page-lead" style="margin: 0;">
        I design and scale full-funnel digital acquisition engines—connecting paid media, TikTok Shop GMV acceleration, attribution modeling, and fast web experiences to turn marketing investments into sustainable revenue.
      </p>
    </div>
  </header>

  <!-- ============================================================
       ABOUT (Concise Company / Role / Date Rows)
       ============================================================ -->
  <section class="page-section home-experience-section" aria-labelledby="heading-experience">
    <div class="section-header-row">
      <h2 id="heading-experience" class="section-title" style="margin: 0;">Work</h2>
    </div>

    <div class="home-experience-list" style="border-top: var(--dash-border-width, 1px) solid var(--dash-border);">
      {experienceHighlights.map((exp) => (
        <div class="dash-row home-exp-row">
          <div class="home-exp-logo" style={`background: ${exp.logoBg};`} aria-hidden="true">
            <img
              src={exp.logo}
              alt=""
              width="44"
              height="44"
              loading="lazy"
              decoding="async"
              style={`object-fit: ${exp.logoFit}; transform: scale(${exp.logoScale});`}
            />
          </div>
          <div class="home-exp-body">
            <div class="home-exp-head">
              <h3 class="item-title home-exp-company">
                {exp.company}
              </h3>
              <span class="home-exp-period">
                {exp.period}
              </span>
            </div>
            <div class="home-exp-role">
              {exp.role}
            </div>
            <div class="content-description home-exp-focus">
              {exp.focus}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       5. CAPABILITIES SUMMARY (Linked to Services)
       ============================================================ -->
  <section class="page-section" aria-labelledby="heading-capabilities">
    <div class="section-header-row">
      <h2 id="heading-capabilities" class="section-title" style="margin: 0;">Services & capabilities</h2>
    </div>

    <div class="capabilities-grid capabilities-grid--scroll">
      {servicesPreview.map((svc) => (
        <div class="dash-card capability-card">
          <h3 class="capability-title">
            {svc.title}
          </h3>
          <p class="capability-desc">
            {svc.summary}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       6. KNOWLEDGE PILLARS (Growth & Travel Hubs)
       ============================================================ -->
  <section class="page-section" aria-labelledby="heading-pillars">
    <div class="section-header-row">
      <h2 id="heading-pillars" class="section-title" style="margin: 0;">Knowledge & archives</h2>
    </div>

    <div class="capabilities-grid">
      <article class="dash-card capability-card">
        <h3 class="capability-title">Growth & Performance Marketing</h3>
        <p class="capability-desc">
          Experience-backed paid media playbooks, unit economics formulas (ROAS, MER, CAC, Break-even ROAS), and campaign case studies across TikTok Shop, Meta, Google, and SEO.
        </p>
      </article>

      <article class="dash-card capability-card">
        <h3 class="capability-title">Travel & Photography</h3>
        <p class="capability-desc">
          First-hand field journals, shooting notes, and {galleryCount} destination galleries across Vietnam and Southeast Asia—from Hà Giang and Tràng An to Mỹ Tho and Bù Gia Mập.
        </p>
      </article>
    </div>
  </section>

</DashboardLayout>

<style>
  /* Section Header Row */
  .section-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: var(--space-4);
  }

  .home-experience-list .dash-row {
    border-radius: 0;
    transition: none;
    padding-block: calc(var(--space-3) * 1.3);
  }

  .home-exp-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .home-exp-logo {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    margin-top: 2px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 4px;
    border: 1px solid rgba(10, 10, 10, 0.08);
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.06);
  }

  .home-exp-logo img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-position: center;
  }

  .home-exp-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .home-exp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .home-exp-company {
    font-size: calc(var(--text-body) + 3px);
    line-height: var(--leading-compact);
    margin: 0;
    color: #0075de;
  }

  .home-exp-period {
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .home-exp-role {
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    font-weight: var(--font-weight-medium);
    color: #454545;
    margin-top: 2px;
  }

  .home-exp-focus {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    margin-top: 4px;
  }

  .home-experience-list .dash-row:hover {
    background: transparent;
    padding-left: 0;
    padding-right: 0;
  }

  @media (max-width: 640px) {
    .home-exp-row {
      gap: 12px;
    }

    .home-exp-logo {
      flex-basis: 38px;
      width: 38px;
      height: 38px;
    }
  }

  /* Capabilities Section */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  .capability-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .capability-title {
    font-size: calc(var(--text-body) + 3px);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-subheading);
    color: var(--dash-text);
    margin: 0 0 6px;
  }

  .capability-desc {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--dash-muted);
    margin: 0;
  }

  @media (max-width: 860px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 768px) {
    .capabilities-grid--scroll {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      touch-action: pan-x pan-y;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--mobile-page-edge, 16px);
      gap: 12px;
      margin-inline: calc(var(--mobile-page-edge, 16px) * -1);
      padding-inline: var(--mobile-page-edge, 16px);
      padding-block: 2px 6px;
      scrollbar-width: none;
    }

    .capabilities-grid--scroll::-webkit-scrollbar {
      display: none;
    }

    .capabilities-grid--scroll .capability-card {
      flex: 0 0 min(78vw, 280px);
      scroll-snap-align: start;
      padding: 16px 18px;
    }
  }

  @media (max-width: 560px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .capability-card {
      padding: 14px 16px;
    }
  }
</style>
