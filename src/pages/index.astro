---
import DashboardLayout from "../layouts/DashboardLayout.astro";

// Experience summary items:
const experienceHighlights = [
  {
    company: "WorkFlow Space",
    role: "Digital Marketing Executive",
    period: "2024 — 2026",
    focus: "Full-funnel performance marketing & branch launches across Ho Chi Minh City."
  },
  {
    company: "PlayAh!",
    role: "Performance Senior Executive",
    period: "2024 — 2026",
    focus: "TikTok Shop GMV acceleration, creator affiliate network, and automated retention."
  },
  {
    company: "Asia Strategic Holdings",
    role: "Performance Marketing",
    period: "2025 — 2026",
    focus: "Growth marketing, customer acquisition modeling, and multi-channel attribution."
  },
  {
    company: "POPS Worldwide",
    role: "SEO Executive",
    period: "2022 — 2023",
    focus: "Technical SEO roadmap scaling organic traffic to 2.5M MAU across regional platforms."
  }
];

// Services preview (6 core offerings):
const servicesPreview = [
  {
    title: "Performance Ads & Attribution",
    summary: "Meta, Google PMax & TikTok Ads backed by Server-Side CAPI and GA4 audit."
  },
  {
    title: "Organic Seeding & Advocacy",
    summary: "High-trust community discussions, sentiment management, and authentic creator advocacy."
  },
  {
    title: "Strategic Brand Positioning",
    summary: "Market positioning, messaging architecture, and visual identity guidelines."
  },
  {
    title: "DTC Storefront Optimization",
    summary: "Conversion rate optimization, catalog feeds, and lifecycle retention funnels."
  },
  {
    title: "Headless Web Engineering",
    summary: "Ultra-fast Astro & React builds targeting strict Core Web Vitals and technical SEO."
  },
  {
    title: "AI Funnels & Automation",
    summary: "Make/Zapier CRM integrations, automated lead routing, and programmatic content engines."
  }
];
---

<DashboardLayout 
  title="Phuc Loc Nguyen — Workspace"
  description="Senior Performance Marketing Executive workspace: scaling multi-channel paid media, TikTok Shop GMV, SEO, and web engineering."
  breadcrumbs={[{ label: "Overview" }]}
  maxWidthVariant="default"
>
  <!-- ============================================================
       1. IDENTITY & INTRODUCTION (Directly on document surface)
       ============================================================ -->
  <header class="page-header">
    <div style="max-width: 76ch;">
      <h1 class="page-title" style="margin-bottom: var(--space-1);">Phuc Loc Nguyen</h1>
      <div style="font-size: var(--text-body-sm); line-height: var(--leading-compact); color: var(--dash-muted); margin-bottom: var(--space-3); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span style="font-weight: 500;">Senior Performance Marketing Executive</span>
      </div>
      <p class="page-lead" style="margin: 0;">
        I design and scale full-funnel digital acquisition engines—connecting paid media, TikTok Shop GMV acceleration, attribution modeling, and fast web experiences to turn marketing investments into sustainable revenue.
      </p>
    </div>
  </header>

  <!-- ============================================================
       ABOUT (Concise Company / Role / Date Rows)
       ============================================================ -->
  <section class="page-section home-experience-section" aria-labelledby="heading-experience">
    <div class="section-header-row">
      <h2 id="heading-experience" class="section-title" style="margin: 0;">About</h2>
      <a href="/about" class="dash-link section-header-link">
        About & timeline →
      </a>
    </div>

    <div class="home-experience-list" style="border-top: var(--dash-border-width, 1px) solid var(--dash-border);">
      {experienceHighlights.map((exp) => (
        <div class="dash-row" style="display: block;">
          <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px;">
            <h3 class="item-title" style="font-size: var(--text-body); line-height: var(--leading-compact); margin: 0; color: #0075de;">
              {exp.company}
            </h3>
            <span style="font-size: var(--text-body-sm); font-weight: 500; line-height: var(--leading-compact); color: var(--dash-muted); white-space: nowrap; font-variant-numeric: tabular-nums; flex-shrink: 0;">
              {exp.period}
            </span>
          </div>
          <div style="font-size: var(--text-body-sm); line-height: var(--leading-compact); font-weight: 500; color: #454545; margin-top: 2px;">
            {exp.role}
          </div>
          <div style="font-size: var(--text-body-sm); line-height: var(--leading-body); color: var(--dash-muted); margin-top: 4px;">
            {exp.focus}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       5. CAPABILITIES SUMMARY (Linked to Services)
       ============================================================ -->
  <section class="page-section" aria-labelledby="heading-capabilities">
    <div class="section-header-row">
      <h2 id="heading-capabilities" class="section-title" style="margin: 0;">Services & capabilities</h2>
      <a href="/services" class="dash-link section-header-link">
        Scope & retainers →
      </a>
    </div>

    <div class="capabilities-grid">
      {servicesPreview.map((svc) => (
        <div class="dash-card capability-card">
          <h3 class="capability-title">
            {svc.title}
          </h3>
          <p class="capability-desc">
            {svc.summary}
          </p>
        </div>
      ))}
    </div>
  </section>

</DashboardLayout>

<style>


  /* Section Header Row (Headline and Action button aligned vertically center) */
  .section-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: var(--space-4);
  }

  .section-header-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-body-sm);
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1;
  }

  .home-experience-list .dash-row {
    border-radius: 0;
    transition: none;
  }

  .home-experience-list .dash-row:hover {
    background: transparent;
    padding-left: 0;
    padding-right: 0;
  }

  /* Photography Folder Grid */
  .home-photo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-column-gap: 16px;
    grid-row-gap: 32px;
    padding: 16px 0 24px;
  }

  .home-photo-grid .folder-item {
    justify-content: flex-start;
  }

  @media (max-width: 840px) and (min-width: 769px) {
    .home-photo-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-column-gap: 16px;
      grid-row-gap: 28px;
    }
  }

  @media (max-width: 768px) {
    .home-photo-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: visible;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--mobile-page-edge, 16px);
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      margin-inline: calc(var(--mobile-page-edge, 16px) * -1);
      padding-inline: var(--mobile-page-edge, 16px);
      padding-top: 56px;
      padding-bottom: 16px;
      margin-top: -36px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .home-photo-grid::-webkit-scrollbar {
      display: none;
    }

    .home-photo-grid .folder-item {
      flex: 0 0 clamp(136px, 38vw, 156px);
      width: clamp(136px, 38vw, 156px);
      scroll-snap-align: start;
    }
  }

  /* Capabilities Section */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--docs-space-grid-gap, 16px);
  }

  .capability-card {
    padding: var(--docs-space-card-padding, 24px);
    display: flex;
    flex-direction: column;
  }

  .capability-title {
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-subheading);
    color: var(--dash-text);
    margin: 0 0 6px;
  }

  .capability-desc {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--dash-muted);
    margin: 0;
  }

  @media (max-width: 860px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 560px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .capability-card {
      padding: 14px 16px;
    }
  }

</style>

<script>
  import "../scripts/folder-previews";
</script>
