---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";

const pageTitle = "Nguyen Phuc Loc | Senior Performance Marketing Executive";
const pageDescription = "Senior Performance Marketing Executive scaling multi-channel paid media, TikTok Shop GMV, SEO growth, and AI-powered conversion funnels.";
---
<Layout
  title={pageTitle}
  description={pageDescription}
  schema={[
    pageSchema({
      url: absoluteUrl("/"),
      title: pageTitle,
      description: pageDescription,
      type: "ProfilePage",
    }),
  ]}
>




  <!-- ============================================================
       MAIN
  ============================================================ -->
  <main style="display:flex;flex-direction:column;">

    <!-- CAREER ---------------------------------- -->
    <section class="career-map toki-r" data-d="1" aria-label="Past, current, and future work">
      <div class="container career-map-container">
        <div class="career-map-intro career-map-intro--horizontal t-stagger">
          <div class="career-map-statement">
            <h1 class="career-map-title career-map-title--typing t-stagger-line t-stagger-line--1" style="line-height: 0.96 !important;">
              <span class="typing-line" style="--steps: 14; --target: 14ch; --typing-delay: 0ms;">Design Better.</span>
              <span class="typing-line" style="--steps: 15; --target: 15ch; --typing-delay: 820ms;">Market Smarter.</span>
              <span class="typing-line" style="--steps: 13; --target: 13ch; --typing-delay: 1640ms;">Scale Faster.</span>
            </h1>
            <p class="career-map-description t-stagger-line t-stagger-line--2">
              Senior Performance Marketing Executive scaling multi-channel paid media, TikTok Shop GMV, and landing page funnels&mdash;connecting creative production with full-funnel analytics to turn ad spend into measurable revenue.
            </p>
          </div>

          <div class="career-map-copy">
            <div class="career-map-copy-item career-map-copy-item--current">
              <span>Now</span>
              <p>
                Building performance acquisition &amp; branch growth at <strong>WorkFlow Space</strong>.
              </p>
            </div>
            <div class="career-map-copy-item">
              <span>Systems</span>
              <p>
                Turning media spend into measurable revenue across TikTok Shop, Meta, Google Ads, SEO, and conversion landing pages.
              </p>
            </div>
            <div class="career-map-copy-item">
              <span>Focus</span>
              <p>
                E-commerce GMV scaling, branch expansion, KOC booking, and rapid creative testing systems. <a href="mailto:hi@loc.digital?subject=Hi%20Loc">Let’s talk.</a>
              </p>
            </div>
            <small>SAIGON, VIETNAM / PERFORMANCE MARKETING, TIKTOK SHOP, AI FUNNELS</small>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
