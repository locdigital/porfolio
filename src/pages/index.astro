---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, pageSchema } from "../lib/seo";
import DraggableCollage from "../components/ui/draggable-collage";
import MobileAboutPanel from "../components/ui/MobileAboutPanel.astro";

const pageTitle = "Nguyen Phuc Loc | Senior Performance Marketing Executive";
const pageDescription = "Senior Performance Marketing Executive scaling multi-channel paid media, TikTok Shop GMV, SEO growth, and AI-powered conversion funnels.";
const heroAbout = { src: "/himmel-vua.jpeg" };
---
<Layout
  title={pageTitle}
  description={pageDescription}
  schema={[
    pageSchema({
      url: absoluteUrl("/"),
      title: pageTitle,
      description: pageDescription,
      type: "ProfilePage",
    }),
  ]}
>




  <!-- ============================================================
       MAIN
  ============================================================ -->
  <main style="display:flex;flex-direction:column;">

    <!-- CAREER ---------------------------------- -->
    <section class="career-map toki-r" data-d="1" aria-label="Past, current, and future work">
      <div class="container">
        <div class="career-map-intro career-map-intro--horizontal">
          <div class="career-map-statement">
            <h1 class="career-map-title career-map-title--typing">
              <span class="typing-line" style="--steps: 14; --target: 14ch; --typing-delay: 0ms;">Design Better.</span>
              <span class="typing-line" style="--steps: 15; --target: 15ch; --typing-delay: 820ms;">Market Smarter.</span>
              <span class="typing-line" style="--steps: 13; --target: 13ch; --typing-delay: 1640ms;">Scale Faster.</span>
            </h1>
            <p class="career-map-description">
              loc.digital helps businesses grow through modern websites, strategic social media, digital marketing, and AI automation&mdash;creating systems that save time, attract customers, and deliver measurable results.
            </p>
          </div>

          <div class="career-map-copy">
            <div class="career-map-copy-item career-map-copy-item--current">
              <span>Now</span>
              <p>
                Building growth at <strong>AnyMind Group</strong>.
              </p>
            </div>
            <div class="career-map-copy-item">
              <span>Systems</span>
              <p>
                Media spend into measurable revenue across TikTok Shop, Meta, Google, SEO, landing pages, and AI-assisted funnels.
              </p>
            </div>
            <div class="career-map-copy-item">
              <span>Focus</span>
              <p>
                Commerce scaling, branch launches, and creative testing systems in Vietnam. <a href="mailto:hi@loc.digital">Let’s talk.</a>
              </p>
            </div>
            <small>SAIGON, VIETNAM / PERFORMANCE, SEO, AI FUNNELS</small>
          </div>
        </div>
      </div>
    </section>

    <!-- PLAYGROUND ------------------------------ -->
    <section class="relative w-full h-auto md:h-[100dvh] overflow-visible md:overflow-hidden toki-r" data-d="5" aria-label="Interactive collage">
      <MobileAboutPanel portraitSrc={heroAbout.src} />
      <div class="hidden md:block h-full w-full">
        <DraggableCollage client:idle portraitSrc={heroAbout.src} />
      </div>
    </section>

  </main>
</Layout>
