---
import WritingArchive from "../../../components/writing/WritingArchive.astro";
import { getWritingEntries, writingArchiveCategories, writingCategorySlug } from "../../../lib/writing";

export const prerender = true;

export async function getStaticPaths() {
  const categories = writingArchiveCategories(await getWritingEntries());
  return categories.map(category => ({ params: { category: writingCategorySlug(category) }, props: { category } }));
}

interface Props { category: string; }
const { category } = Astro.props;
---

<WritingArchive category={category} />
