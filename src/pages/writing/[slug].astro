---
import type { CollectionEntry } from "astro:content";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ResponsiveImage from "../../components/ui/ResponsiveImage.astro";
import { getWritingEntries } from "../../lib/writing";
import { articleSchema, canonicalUrl } from "../../lib/seo";

export const prerender = true;

export async function getStaticPaths() {
  return (await getWritingEntries())
    .filter(entry => entry.data.linkable !== false)
    .map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"writing">; }
const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 0;

function articleDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "Asia/Ho_Chi_Minh",
  }).format(date);
}

const postUrl = canonicalUrl(`/writing/${entry.slug}`);
const publishedIso = entry.data.date.toISOString();
const modifiedIso = (entry.data.updatedAt ?? entry.data.date).toISOString();
const coverUrl = entry.data.coverImage ? new URL(entry.data.coverImage.src, Astro.site || "https://loc.digital").href : undefined;
const postSchema = articleSchema({
  url: postUrl,
  title: entry.data.title,
  description: entry.data.description,
  type: "BlogPosting",
  image: coverUrl,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  articleSection: entry.data.category,
  lang: entry.data.lang,
});
---

<DashboardLayout
  title={`${entry.data.title} — Writing — Phuc Loc Nguyen`}
  pageTitle="Writing"
  description={entry.data.description}
  ogImage={coverUrl}
  ogImageAlt={entry.data.coverImage?.alt || entry.data.title}
  ogType="article"
  datePublished={publishedIso}
  dateModified={modifiedIso}
  lang={entry.data.lang}
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Writing", href: "/writing" }, { label: entry.data.title }]}
  schema={postSchema}
>
  <div class="writing-article-shell">
    <article class:list={["writing-article", hasToc && "writing-article--with-toc"]}>
      <header class="writing-article-header">
        <h1 class="page-title">{entry.data.title}</h1>
        <time datetime={publishedIso} class="writing-article-date">
          <span class="writing-article-date-bar" aria-hidden="true"></span>
          <span class="writing-article-date-text">{articleDate(entry.data.date)}</span>
        </time>
        <p class="page-lead">{entry.data.description}</p>
      </header>

      {hasToc && (
        <aside class="formula-toc-aside" aria-label="Article table of contents">
          <nav class="formula-toc" aria-label="Article table of contents" data-writing-toc>
            <ol class="formula-toc-list">
              {tocHeadings.map((h, index) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      "formula-toc-link",
                      h.depth === 3 && "is-subhead",
                      index === 0 && "is-active",
                    ]}
                    data-toc-link={h.slug}
                    aria-current={index === 0 ? "location" : undefined}
                  >
                    <span class="formula-toc-dot" aria-hidden="true"></span>
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <div class="writing-article-body">
        {entry.data.coverImage && (
          <figure class="writing-cover">
            <div class="writing-cover-media">
              <ResponsiveImage
                src={entry.data.coverImage.src}
                alt={entry.data.coverImage.alt}
                width={entry.data.coverImage.width}
                height={entry.data.coverImage.height}
                widths={[640, 750, 828, 1080, 1200, 1600]}
                sizes="(min-width: 768px) 42rem, 100vw"
                loading="eager"
                fetchpriority="high"
                data-motion-share={`writing-${entry.slug}`}
                style="view-transition-class: workspace-shared-image"
              />
            </div>
            {entry.data.coverImage.caption && <figcaption>{entry.data.coverImage.caption}</figcaption>}
          </figure>
        )}

        <div class="writing-prose">
          <Content />
        </div>
      </div>
    </article>
  </div>
</DashboardLayout>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";
  import { initTocSpy } from "../../scripts/toc-spy";

  onPageLoad((signal) => {
    initTocSpy({ tocSelector: "[data-writing-toc]", signal });
  });
</script>

<style>
  /* Allow wider document rail on desktop so the main column stays roomy beside the right TOC. */
  @media (min-width: 1024px) {
    :global(.workspace-content:has(.writing-article--with-toc)) {
      max-width: 1160px;
    }
  }

  .writing-article-shell {
    width: 100%;
    padding-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .writing-article-shell {
      padding-top: var(--space-10);
    }
  }

  .writing-article {
    width: 100%;
    max-width: 42rem;
    margin-inline: 0;
  }

  .writing-article--with-toc {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 232px;
    grid-template-areas:
      "header toc"
      "content toc";
    column-gap: 36px;
    align-items: start;
  }

  .writing-article-header {
    grid-area: header;
    min-width: 0;
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .writing-article-body {
    grid-area: content;
    min-width: 0;
    max-width: 42rem;
  }

  .formula-toc-aside {
    grid-area: toc;
    position: sticky;
    top: 8px;
    min-width: 0;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    padding-left: 20px;
    border-left: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .formula-toc {
    padding: 2px 0;
  }

  .formula-toc-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .formula-toc-link {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 7px 10px;
    margin-left: -10px;
    border-radius: var(--radius-control);
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-snug);
    transition: color 160ms ease, background-color 160ms ease;
  }

  .formula-toc-link.is-subhead {
    padding-left: 20px;
    font-size: var(--text-caption);
  }

  .formula-toc-link:hover,
  .formula-toc-link:focus-visible {
    color: var(--dash-text);
    background: var(--dash-hover);
  }

  .formula-toc-link.is-active {
    color: var(--dash-accent);
    background: var(--dash-accent-soft);
    font-weight: var(--font-weight-medium);
  }

  .formula-toc-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    margin-top: 0.45em;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.45;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .formula-toc-link:hover .formula-toc-dot,
  .formula-toc-link.is-active .formula-toc-dot {
    opacity: 1;
  }

  .writing-article-date {
    order: -1;
    display: flex;
    align-items: center;
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    font-variant-numeric: tabular-nums;
  }

  .writing-article-date-bar {
    display: inline-block;
    flex-shrink: 0;
    width: 2px;
    height: 16px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--dash-text) 20%, transparent);
  }

  .writing-article-date-text {
    margin-left: 12px;
  }

  .writing-article-header .page-title {
    margin: 24px 0 0;
    max-width: none;
    text-wrap: pretty;
  }

  .writing-article-header .page-lead {
    margin: 24px 0 0;
    max-width: none;
  }

  .writing-cover {
    margin: 32px 0 0;
  }

  .writing-cover-media {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--dash-surface-subtle);
  }

  .writing-cover-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: inherit;
  }

  .writing-cover figcaption {
    margin-top: 12px;
    font-size: var(--text-caption);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .writing-prose {
    margin-top: 32px;
    min-width: 0;
    max-width: none;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--dash-text);
    overflow-wrap: break-word;
  }

  .writing-prose > :global(:first-child) {
    margin-top: 0;
  }

  .writing-prose > :global(:last-child) {
    margin-bottom: 0;
  }

  .writing-prose :global(p) {
    margin: 20px 0;
    max-width: none;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .writing-prose :global(h2) {
    margin: 2em 0 1em;
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-subheading);
    scroll-margin-top: 24px;
  }

  .writing-prose :global(h3) {
    margin: 1.6em 0 0.6em;
    font-size: var(--text-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    scroll-margin-top: 24px;
  }

  .writing-prose :global(h4) {
    margin: 1.5em 0 0.5em;
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    scroll-margin-top: 24px;
  }

  .writing-prose :global(:is(h2, h3, h4, hr) + *) {
    margin-top: 0;
  }

  .writing-prose :global(ul),
  .writing-prose :global(ol) {
    margin: 20px 0;
    padding-left: 26px;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .writing-prose :global(ul) {
    list-style: disc;
  }

  .writing-prose :global(ol) {
    list-style: decimal;
  }

  .writing-prose :global(li) {
    margin: 8px 0;
    padding-left: 6px;
    max-width: none;
  }

  .writing-prose :global(li::marker) {
    color: var(--dash-muted);
  }

  .writing-prose :global(li > p) {
    margin: 12px 0;
  }

  .writing-prose :global(li > p:first-child) {
    margin-top: 0;
  }

  .writing-prose :global(li > p:last-child) {
    margin-bottom: 0;
  }

  .writing-prose :global(strong) {
    font-weight: var(--font-weight-medium);
  }

  .writing-prose :global(figure),
  .writing-prose :global(p:has(> img:only-child)) {
    margin: 32px 0;
  }

  .writing-prose :global(figure > *) {
    margin-top: 0;
    margin-bottom: 0;
  }

  .writing-prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .writing-prose :global(figcaption) {
    margin-top: 12px;
    font-size: var(--text-caption);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .writing-prose :global(figcaption p) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .writing-prose :global(blockquote) {
    margin: 28px 0;
    padding: 16px 20px;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--color-ivory, var(--dash-surface-subtle));
  }

  .writing-prose :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .writing-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .writing-prose :global(pre) {
    margin: 28px 0;
    padding: 16px 20px;
    overflow-x: auto;
    border-radius: var(--radius-card-sm);
    background: var(--dash-surface-subtle);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
  }

  .writing-prose :global(code) {
    font-size: var(--text-body-sm);
  }

  .writing-prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: var(--radius-tag);
    background: var(--dash-surface-subtle);
  }

  .writing-prose :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: var(--text-body-sm);
    overflow-wrap: anywhere;
  }

  .writing-prose :global(th),
  .writing-prose :global(td) {
    padding: 12px 10px;
    text-align: left;
    vertical-align: top;
    border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .writing-prose :global(th) {
    background: var(--color-ivory, var(--dash-surface-subtle));
    font-weight: var(--font-weight-medium);
  }

  .writing-prose :global(hr) {
    margin: 48px 0;
    border: 0;
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  @media (max-width: 1199px) {
    .writing-article--with-toc {
      grid-template-columns: minmax(0, 1fr) 204px;
      column-gap: 24px;
    }

    .formula-toc-aside {
      padding-left: 16px;
    }
  }

  @container workspace-window (max-width: 860px) {
    .writing-article--with-toc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "header"
        "toc"
        "content";
      row-gap: 24px;
    }

    .writing-article--with-toc .writing-article-body > :first-child {
      margin-top: 0;
    }

    .formula-toc-aside {
      max-width: 42rem;
      position: static;
      max-height: none;
      overflow: visible;
      padding: 14px 16px;
      border: var(--dash-border-width, 0.9px) solid var(--dash-border);
      border-radius: 12px;
      background: var(--dash-surface);
    }

    .formula-toc-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2px 16px;
    }

    .formula-toc-link {
      margin-left: 0;
      min-height: 38px;
      align-items: center;
    }

    .formula-toc-link.is-subhead {
      padding-left: 18px;
    }

    .formula-toc-dot {
      margin-top: 0;
    }
  }

  @container workspace-window (max-width: 640px) {
    .formula-toc-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1023px) {
    .writing-article--with-toc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "header"
        "toc"
        "content";
      row-gap: 24px;
    }

    .writing-article--with-toc .writing-article-body > :first-child {
      margin-top: 0;
    }

    .formula-toc-aside {
      max-width: 42rem;
      position: static;
      max-height: none;
      overflow: visible;
      padding: 14px 16px;
      border: var(--dash-border-width, 0.9px) solid var(--dash-border);
      border-radius: 12px;
      background: var(--dash-surface);
    }

    .formula-toc-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2px 16px;
    }

    .formula-toc-link {
      margin-left: 0;
      min-height: 38px;
      align-items: center;
    }

    .formula-toc-link.is-subhead {
      padding-left: 18px;
    }

    .formula-toc-dot {
      margin-top: 0;
    }

    .writing-prose :global(:is(h2, h3, h4)) {
      scroll-margin-top: calc(var(--mobile-topbar-h, 56px) + env(safe-area-inset-top, 0px) + 16px);
    }
  }

  @media (max-width: 720px) {
    .formula-toc-list {
      grid-template-columns: 1fr;
    }
  }
</style>
