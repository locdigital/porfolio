---
import type { CollectionEntry } from "astro:content";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ResponsiveImage from "../../components/ui/ResponsiveImage.astro";
import { getWritingEntries } from "../../lib/writing";
import { articleSchema, canonicalUrl } from "../../lib/seo";

export const prerender = true;

export async function getStaticPaths() {
  return (await getWritingEntries())
    .filter(entry => entry.data.linkable !== false)
    .map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"writing">; }
const { entry } = Astro.props;
const { Content } = await entry.render();

function articleDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "Asia/Ho_Chi_Minh",
  }).format(date);
}

const postUrl = canonicalUrl(`/writing/${entry.slug}`);
const publishedIso = entry.data.date.toISOString();
const modifiedIso = (entry.data.updatedAt ?? entry.data.date).toISOString();
const coverUrl = entry.data.coverImage ? new URL(entry.data.coverImage.src, Astro.site || "https://loc.digital").href : undefined;
const postSchema = articleSchema({
  url: postUrl,
  title: entry.data.title,
  description: entry.data.description,
  type: "BlogPosting",
  image: coverUrl,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  articleSection: entry.data.category,
  lang: entry.data.lang,
});
---

<DashboardLayout
  title={`${entry.data.title} — Writing — Phuc Loc Nguyen`}
  pageTitle="Writing"
  description={entry.data.description}
  ogImage={coverUrl}
  ogImageAlt={entry.data.coverImage?.alt || entry.data.title}
  ogType="article"
  datePublished={publishedIso}
  dateModified={modifiedIso}
  lang={entry.data.lang}
  breadcrumbs={[{ label: "Personal", href: "/" }, { label: "Writing", href: "/writing" }, { label: entry.data.title }]}
  schema={postSchema}
>
  <div class="writing-article-shell">
    <article class="writing-article">
      <header class="writing-article-header">
        <h1 class="page-title">{entry.data.title}</h1>
        <time datetime={publishedIso} class="writing-article-date">
          <span class="writing-article-date-bar" aria-hidden="true"></span>
          <span class="writing-article-date-text">{articleDate(entry.data.date)}</span>
        </time>
        <p class="page-lead">{entry.data.description}</p>
      </header>

      <div class="writing-article-body">
        {entry.data.coverImage && (
          <figure class="writing-cover">
            <div class="writing-cover-media">
              <ResponsiveImage
                src={entry.data.coverImage.src}
                alt={entry.data.coverImage.alt}
                width={entry.data.coverImage.width}
                height={entry.data.coverImage.height}
                widths={[640, 750, 828, 1080, 1200, 1600]}
                sizes="(min-width: 768px) 42rem, 100vw"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            {entry.data.coverImage.caption && <figcaption>{entry.data.coverImage.caption}</figcaption>}
          </figure>
        )}

        <div class="writing-prose">
          <Content />
        </div>
      </div>
    </article>
  </div>
</DashboardLayout>

<style>
  .writing-article-shell {
    width: 100%;
    padding-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .writing-article-shell {
      padding-top: var(--space-10);
    }
  }

  .writing-article {
    width: 100%;
    max-width: 42rem;
    margin-inline: 0;
  }

  .writing-article-header {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .writing-article-date {
    order: -1;
    display: flex;
    align-items: center;
    color: var(--dash-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
    font-variant-numeric: tabular-nums;
  }

  .writing-article-date-bar {
    display: inline-block;
    flex-shrink: 0;
    width: 2px;
    height: 16px;
    border-radius: 9999px;
    background: rgba(41, 41, 39, 0.2);
    background: color-mix(in srgb, var(--dash-text) 20%, transparent);
  }

  .writing-article-date-text {
    margin-left: 12px;
  }

  .writing-article-header .page-title {
    margin: 24px 0 0;
    max-width: none;
    text-wrap: pretty;
  }

  .writing-article-header .page-lead {
    margin: 24px 0 0;
    max-width: none;
  }

  .writing-cover {
    margin: 32px 0 0;
  }

  .writing-cover-media {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--dash-surface-subtle);
  }

  .writing-cover-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: inherit;
  }

  .writing-cover figcaption {
    margin-top: 12px;
    font-size: var(--text-caption);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .writing-prose {
    margin-top: 32px;
    min-width: 0;
    max-width: none;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--dash-text);
    overflow-wrap: break-word;
  }

  .writing-prose > :global(:first-child) {
    margin-top: 0;
  }

  .writing-prose > :global(:last-child) {
    margin-bottom: 0;
  }

  .writing-prose :global(p) {
    margin: 20px 0;
    max-width: none;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .writing-prose :global(h2) {
    margin: 2em 0 1em;
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-subheading);
    scroll-margin-top: 24px;
  }

  .writing-prose :global(h3) {
    margin: 1.6em 0 0.6em;
    font-size: var(--text-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    scroll-margin-top: 24px;
  }

  .writing-prose :global(h4) {
    margin: 1.5em 0 0.5em;
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    scroll-margin-top: 24px;
  }

  .writing-prose :global(:is(h2, h3, h4, hr) + *) {
    margin-top: 0;
  }

  .writing-prose :global(ul),
  .writing-prose :global(ol) {
    margin: 20px 0;
    padding-left: 26px;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .writing-prose :global(ul) {
    list-style: disc;
  }

  .writing-prose :global(ol) {
    list-style: decimal;
  }

  .writing-prose :global(li) {
    margin: 8px 0;
    padding-left: 6px;
    max-width: none;
  }

  .writing-prose :global(li::marker) {
    color: var(--dash-muted);
  }

  .writing-prose :global(li > p) {
    margin: 12px 0;
  }

  .writing-prose :global(li > p:first-child) {
    margin-top: 0;
  }

  .writing-prose :global(li > p:last-child) {
    margin-bottom: 0;
  }

  .writing-prose :global(strong) {
    font-weight: var(--font-weight-medium);
  }

  .writing-prose :global(figure),
  .writing-prose :global(p:has(> img:only-child)) {
    margin: 32px 0;
  }

  .writing-prose :global(figure > *) {
    margin-top: 0;
    margin-bottom: 0;
  }

  .writing-prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .writing-prose :global(figcaption) {
    margin-top: 12px;
    font-size: var(--text-caption);
    line-height: var(--leading-compact);
    color: var(--dash-muted);
  }

  .writing-prose :global(figcaption p) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .writing-prose :global(blockquote) {
    margin: 28px 0;
    padding: 16px 20px;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--color-ivory, var(--dash-surface-subtle));
  }

  .writing-prose :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .writing-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .writing-prose :global(pre) {
    margin: 28px 0;
    padding: 16px 20px;
    overflow-x: auto;
    border-radius: var(--radius-card-sm);
    background: var(--dash-surface-subtle);
    border: var(--dash-border-width, 0.9px) solid var(--dash-border);
    font-size: var(--text-body-sm);
    line-height: var(--leading-compact);
  }

  .writing-prose :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
  }

  .writing-prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: var(--radius-tag);
    background: var(--dash-surface-subtle);
  }

  .writing-prose :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: var(--text-body-sm);
    overflow-wrap: anywhere;
  }

  .writing-prose :global(th),
  .writing-prose :global(td) {
    padding: 12px 10px;
    text-align: left;
    vertical-align: top;
    border-bottom: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .writing-prose :global(th) {
    background: var(--color-ivory, var(--dash-surface-subtle));
    font-weight: var(--font-weight-medium);
  }

  .writing-prose :global(hr) {
    margin: 48px 0;
    border: 0;
    border-top: var(--dash-border-width, 0.9px) solid var(--dash-border);
  }

  .writing-prose :global(a) {
    text-decoration: none;
  }
</style>
