---
import WritingDetailPage from "../../components/writing/WritingDetailPage.astro";
import { getWritingEntries, type WritingEntry } from "../../lib/writing";

export const prerender = true;

export async function getStaticPaths() {
  return (await getWritingEntries())
    .filter((entry) => entry.data.linkable !== false)
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: WritingEntry;
}
const { entry } = Astro.props;
---

<WritingDetailPage entry={entry} />
