<!DOCTYPE html>
<html lang="en" style="background:#FAFAF7">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-visual">
  <meta name="description"
    content="Digital Marketing Specialist based in Ho Chi Minh City. Helping brands grow through SEO, social media, paid ads, and full-funnel campaigns.">
  <title>Phuc Loc Nguyen | Digital Marketing Specialist</title>
  <meta name="theme-color" content="#FAFAF7">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,400&family=DM+Mono:wght@400&display=swap"
    rel="stylesheet">

  <!-- PhotoSwipe CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.min.css">

  <style>
    /* ============================================================
       DESIGN TOKENS
    ============================================================ */
    :root {
      --bg: #FAFAF7;
      --text: #1C1C1C;
      --muted: #6E6E6E;
      --divider: #E8E8E2;
      --accent: #2D6A4F;
      --hdr-h: 60px;

      --serif: 'Instrument Serif', 'Georgia', serif;
      --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --mono: 'DM Mono', 'Courier New', monospace;

      --max: 1160px;
      --px: clamp(20px, 4vw, 56px);

      --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* ============================================================
       RESET
    ============================================================ */
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--sans);
      font-size: 15px;
      line-height: 1.65;
      color: var(--text);
      background: var(--bg);
      overflow-x: hidden;
      /* Page-load fade */
      opacity: 0;
      transition: opacity 0.45s ease;
    }

    body.ready {
      opacity: 1;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 2px;
    }

    img {
      display: block;
      max-width: 100%;
    }

    ul {
      list-style: none;
    }

    button {
      font: inherit;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: inherit;
    }

    ::selection {
      background: var(--accent);
      color: #fff;
    }

    /* ============================================================
       SCROLL PROGRESS — floating indicator
    ============================================================ */
    #scbar {
      position: fixed;
      top: 0;
      right: 0;
      width: 2px;
      height: 0%;
      background: var(--accent);
      z-index: 9998;
      transform: translateX(4px);
      /* drifts when idle */
      transition: transform 1.2s ease;
      border-radius: 0 0 2px 2px;
    }

    #scbar.scrolling {
      transform: translateX(0);
    }

    /* ============================================================
       HEADER
    ============================================================ */
    #site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--hdr-h);
      z-index: 100;
      /* Antigravity entrance: drops from above */
      transform: translateY(-100%);
      opacity: 0;
      transition: transform .95s var(--spring), opacity .65s ease,
        background .4s ease, box-shadow .4s ease;
    }

    #site-header.in {
      transform: translateY(0);
      opacity: 1;
    }

    #site-header.is-scrolled {
      background: rgba(250, 250, 247, .88);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 1px 0 var(--divider);
    }

    .header-inner {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--px);
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Name — collapses middle spans on small screens */
    .header-name {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: .01em;
      color: var(--text);
      transition: color .25s ease;
    }

    .header-name:hover {
      color: var(--accent);
    }

    .n-collapse {
      transition: opacity .3s ease;
    }

    /* Desktop nav */
    .header-nav-desktop ul {
      display: flex;
      gap: 28px;
    }

    .header-nav-desktop a {
      font-size: 13px;
      color: var(--muted);
      transition: color .25s ease;
    }

    .header-nav-desktop a:hover {
      color: var(--text);
    }

    /* Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      width: 24px;
      padding: 4px;
      cursor: pointer;
    }

    .hamburger-line {
      display: block;
      height: 1.5px;
      background: var(--text);
      width: 100%;
      border-radius: 2px;
      transition: transform .3s ease, opacity .3s ease;
      transform-origin: center;
    }

    .hamburger.is-open .hamburger-line--top {
      transform: translateY(6.5px) rotate(45deg);
    }

    .hamburger.is-open .hamburger-line--mid {
      opacity: 0;
      transform: scaleX(0);
    }

    .hamburger.is-open .hamburger-line--bottom {
      transform: translateY(-6.5px) rotate(-45deg);
    }

    /* Mobile menu */
    .mobile-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .18);
      z-index: 98;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s ease;
    }

    .mobile-backdrop.is-open {
      opacity: 1;
      pointer-events: all;
    }

    .mobile-menu {
      position: fixed;
      top: var(--hdr-h);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--bg);
      z-index: 99;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-10px);
      transition: opacity .3s ease, transform .3s ease;
    }

    .mobile-menu.is-open {
      opacity: 1;
      pointer-events: all;
      transform: translateY(0);
    }

    .mobile-nav {
      padding: 36px var(--px);
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .mobile-nav a {
      font-family: var(--serif);
      font-size: clamp(28px, 8vw, 44px);
      display: block;
      padding: 10px 0;
      border-bottom: 1px solid var(--divider);
      transition: color .25s ease;
    }

    .mobile-nav a:hover {
      color: var(--accent);
    }

    /* ============================================================
       CONTAINER
    ============================================================ */
    .container {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--px);
    }

    /* ============================================================
       SECTION HEADER — sh
    ============================================================ */
    .sh {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--divider);
      margin-bottom: 44px;
    }

    .sh-title {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .sh-number {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
    }

    /* ============================================================
       SCROLL REVEAL
    ============================================================ */
    .r {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity .75s var(--ease-out), transform .75s var(--ease-out);
    }

    .r.in {
      opacity: 1;
      transform: translateY(0);
    }

    .r[data-d="1"] {
      transition-delay: .05s;
    }

    .r[data-d="2"] {
      transition-delay: .10s;
    }

    .r[data-d="3"] {
      transition-delay: .15s;
    }

    .r[data-d="4"] {
      transition-delay: .20s;
    }

    .r[data-d="5"] {
      transition-delay: .25s;
    }

    /* ============================================================
       HERO
    ============================================================ */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-top: var(--hdr-h);
      overflow: hidden;
    }

    .hero-container {
      position: relative;
      z-index: 1;
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 55% 1fr;
      gap: 52px;
      align-items: center;
    }

    /* h1 lines — fly up on load, then float */
    .hero-title {
      display: flex;
      flex-direction: column;
    }

    .hero-line {
      display: block;
      font-family: var(--serif);
      font-size: clamp(42px, 6.5vw, 90px);
      font-weight: 400;
      line-height: 1.06;
      letter-spacing: -.025em;
      color: var(--text);
      /* Antigravity entrance */
      opacity: 0;
      transform: translateY(64px);
      transition: opacity .95s var(--ease-out), transform .95s var(--ease-out);
      will-change: transform;
    }

    .hero-line.in {
      opacity: 1;
      transform: translateY(0);
    }

    .hero-line-2 {
      transition-delay: .14s;
    }

    .hero-line-3 {
      transition-delay: .26s;
    }

    .hero-line-4 {
      transition-delay: .36s;
    }

    .hero-line em {
      font-style: italic;
      color: var(--accent);
    }

    /* Continuous float after entrance */
    .hero-line.floating {
      animation: hfloat 5.2s ease-in-out infinite;
    }

    .hero-line-2.floating {
      animation-duration: 4.5s;
      animation-delay: .6s;
    }

    .hero-line-3.floating,
    .hero-line-4.floating {
      animation-name: hfloatW;
      animation-duration: 5.7s;
      animation-delay: 1.1s;
    }

    @keyframes hfloat {

      0%,
      100% {
        transform: translateY(0)
      }

      50% {
        transform: translateY(-7px)
      }
    }

    @keyframes hfloatW {

      0%,
      100% {
        transform: translateY(0)
      }

      50% {
        transform: translateY(-12px)
      }
    }

    /* Hero aside — bio */
    .hero-aside {
      display: flex;
      flex-direction: column;
      gap: 14px;
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .95s var(--ease-out) .5s, transform .95s var(--ease-out) .5s;
    }

    .hero-aside.in {
      opacity: 1;
      transform: translateY(0);
    }

    .hero-aside p {
      font-size: 15px;
      line-height: 1.72;
    }

    .hero-aside a {
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color .25s ease;
    }

    .hero-aside a:hover {
      color: var(--accent);
    }

    .location {
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--muted);
      font-family: var(--mono);
    }

    .loc-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #52B788;
      animation: pulse 2.6s ease-in-out infinite;
      flex-shrink: 0;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1)
      }

      50% {
        opacity: .3;
        transform: scale(.65)
      }
    }

    /* ============================================================
       SECTIONS — vertical rhythm
    ============================================================ */
    .work,
    .about,
    .gallery,
    .writing {
      padding: clamp(72px, 9vw, 112px) 0;
    }

    /* ============================================================
       EXPERIENCE — timeline rows, simple card hover like luke.ac
    ============================================================ */
    .timeline-row {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 28px 0;
      border-bottom: 1px solid var(--divider);
    }

    .timeline-row:first-child {
      border-top: 1px solid var(--divider);
    }

    .tl-left {
      display: flex;
      align-items: center;
      gap: 20px;
      flex: 1;
      min-width: 0;
    }

    .tl-logo {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: transparent;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      font-size: 17px;
      overflow: hidden;
    }

    .tl-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .tl-info {
      min-width: 0;
    }

    .tl-company {
      display: block;
      font-size: 19px;
      font-family: var(--serif);
      font-weight: 400;
    }

    .tl-company a {
      text-decoration: none;
      border-bottom: 1px solid var(--divider);
      padding-bottom: 1px;
      transition: all .25s ease;
    }

    .tl-company a:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .tl-desc {
      display: block;
      font-size: 14px;
      color: var(--muted);
      margin-top: 6px;
    }

    .tl-dates {
      font-size: 12px;
      color: var(--muted);
      font-family: var(--mono);
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ============================================================
       ABOUT — two-column grid layout
    ============================================================ */
    .about-layout {
      display: grid;
      grid-template-columns: 1fr 220px;
      gap: 52px;
      align-items: start;
    }

    .about-photo {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 10px;
      transition: transform .7s var(--ease-out);
    }

    .about-photo:hover {
      transform: scale(1.03);
    }

    .about-prose p {
      font-size: 15px;
      line-height: 1.78;
      margin-bottom: 15px;
    }

    .about-prose a {
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color .25s ease;
    }

    .about-prose a:hover {
      color: var(--accent);
    }

    .about-prose em {
      font-style: italic;
    }

    /* ============================================================
       PHOTOGRAPHY — masonry gallery + arrows
    ============================================================ */
    /* Gallery outer — position:relative so pseudo-elements overlay the strip */
    .gallery-scroll-wrapper {
      display: flex;
      align-items: center;
      padding: 0 var(--px);
      gap: 14px;
    }

    /* Strip outer: clip + relative so the fade pseudo sits on top */
    .gallery-fade-wrapper {
      position: relative;
      flex: 1;
      min-width: 0;
    }

    .gallery-strip-outer {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-behavior: smooth;
    }

    .gallery-strip-outer::-webkit-scrollbar {
      display: none;
    }

    /*
     * Right-edge fade gradient — matches luke.ac
     * Positioned relative to .gallery-strip-outer so it scrolls with nothing
     * but sits on top of the images via pointer-events:none.
     */
    .gallery-fade-right,
    .gallery-fade-left {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }

    .gallery-fade-right {
      right: 0;
      background: linear-gradient(to right, transparent, var(--bg) 90%);
    }

    .gallery-fade-left {
      left: 0;
      background: linear-gradient(to left, transparent, var(--bg) 90%);
      opacity: 0;
      /* hidden until user has scrolled right */
      transition: opacity .4s ease;
    }

    .gallery-fade-left.visible {
      opacity: 1;
    }

    /* Two-row absolute-positioned masonry */
    .gallery-strip {
      position: relative;
      /* width + height set via inline style */
    }

    .gallery-strip a {
      position: absolute;
      display: block;
      border-radius: 6px;
      overflow: hidden;
    }

    .gallery-strip a img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .6s var(--ease-out);
    }

    .gallery-strip a:hover img {
      transform: scale(1.04);
    }

    /* Mobile strip hidden by default */
    .gallery-strip--mobile {
      display: none;
    }

    /* Gallery arrow buttons */
    .gallery-arrow {
      flex-shrink: 0;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--divider);
      background: rgba(250, 250, 247, .85);
      backdrop-filter: blur(8px);
      display: grid;
      place-items: center;
      font-size: 14px;
      cursor: pointer;
      color: var(--text);
      transition: background .2s ease, border-color .2s ease, opacity .3s ease;
    }

    .gallery-arrow:hover:not(:disabled) {
      background: #fff;
      border-color: var(--text);
    }

    .gallery-arrow:disabled {
      opacity: .25;
      cursor: default;
    }

    /* ============================================================
       WRITING — date + title row layout
    ============================================================ */
    .post-list {}

    /* Writing rows — simple underline hover like luke.ac, no block background */
    .post-item {
      display: flex;
      align-items: baseline;
      gap: 20px;
      padding: 18px 0;
      border-bottom: 1px solid var(--divider);
      color: var(--text);
    }

    .post-item:first-child {
      border-top: 1px solid var(--divider);
    }

    .post-date {
      font-size: 12px;
      color: var(--muted);
      font-family: var(--mono);
      min-width: 88px;
      flex-shrink: 0;
    }

    .post-title {
      font-size: clamp(16px, 1.8vw, 20px);
      font-family: var(--serif);
      font-weight: 400;
      line-height: 1.35;
      transition: color .25s ease;
    }

    /* Hover: only the title text turns accent green — like luke.ac */
    .post-item:hover .post-title {
      color: var(--accent);
    }

    .see-all {
      display: inline-block;
      margin-top: 24px;
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: color .25s ease;
    }

    .see-all:hover {
      color: var(--accent);
    }

    /* ============================================================
       FOOTER
    ============================================================ */
    .footer-divider {
      border-top: 1px solid var(--divider);
      margin-top: clamp(56px, 7vw, 88px);
    }

    .footer {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      padding: 36px 0 22px;
    }

    .footer-contact {
      font-size: 15px;
      color: var(--muted);
    }

    /* Email copy button */
    .email-copy {
      font-size: 15px;
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
      position: relative;
      transition: color .25s ease;
    }

    .email-copy:hover {
      color: var(--accent);
    }

    .email-copy::after {
      content: attr(data-tip);
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--text);
      color: #fff;
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 4px;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease;
      font-family: var(--mono);
    }

    .email-copy.copied::after {
      opacity: 1;
    }

    .footer-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-items: center;
    }

    .footer-links a {
      font-size: 13px;
      color: var(--muted);
      transition: color .25s ease;
    }

    .footer-links a:hover {
      color: var(--text);
    }

    .colophon {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0 30px;
      border-top: 1px solid var(--divider);
      font-size: 12px;
      color: var(--muted);
      font-family: var(--mono);
      gap: 12px;
    }

    /* ============================================================
       RESPONSIVE — mobile
    ============================================================ */
    @media (max-width: 768px) {
      body {
        cursor: auto;
      }

      #c-dot,
      #c-ring {
        display: none;
      }

      .header-nav-desktop {
        display: none;
      }

      .hamburger {
        display: flex;
      }

      .n-collapse {
        display: none;
      }

      .hero-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .hero-line {
        font-size: clamp(36px, 10vw, 54px);
      }

      .about-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .about-photo {
        width: 140px;
        height: 140px;
        aspect-ratio: unset;
      }

      .gallery-strip--desktop {
        display: none;
      }

      .gallery-strip--mobile {
        display: block;
      }

      .footer {
        flex-direction: column;
        gap: 20px;
      }

      .footer-links {
        justify-content: flex-start;
      }

      .colophon {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
      }
    }

    /* ============================================================
       REDUCED MOTION
    ============================================================ */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }

      .hero-line,
      .hero-aside,
      #site-header,
      .r {
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</head>

<body>

  <!-- Scroll Progress -->
  <div id="scbar" aria-hidden="true"></div>

  <!-- ============================================================
       HEADER
  ============================================================ -->
  <header id="site-header">
    <div class="header-inner">
      <a href="#hero" class="header-name" aria-label="Phuc Loc Nguyen — back to top">
        <span class="n-keep">P</span><span class="n-collapse">huc</span><span class="n-collapse">&nbsp;</span><span
          class="n-keep">L</span><span class="n-collapse">oc</span>
      </a>

      <nav class="header-nav-desktop" aria-label="Main navigation">
        <ul>
          <li><a href="#work">Experience</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#photography">Photos</a></li>
          <li><a href="#writing">Writing</a></li>
        </ul>
      </nav>

      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
