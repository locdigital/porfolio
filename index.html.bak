  <!-- ============================================================
       SCRIPTS
  ============================================================ -->

  <!-- Main JS -------------------------------------------------- -->
  <script>
    (function () {
      'use strict';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = () => window.innerWidth < 768;

      /* ── Page load ── */
      window.addEventListener('DOMContentLoaded', () => {
        document.body.classList.add('ready');

        // Nav: drop from above (spring CSS handles overshoot)
        setTimeout(() => document.getElementById('site-header').classList.add('in'), 80);

        // Hero lines: staggered fly-up
        document.querySelectorAll('.hero-line').forEach((line, i) => {
          setTimeout(() => {
            line.classList.add('in');
            if (!reduced) setTimeout(() => line.classList.add('floating'), 980);
          }, 280 + i * 130);
        });

        // Hero aside
        setTimeout(() => document.querySelector('.hero-aside')?.classList.add('in'), 620);
      });

      /* ── IntersectionObserver: section reveals ── */
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.07, rootMargin: '0px 0px -36px 0px' });
      document.querySelectorAll('.r').forEach(el => io.observe(el));

      /* ── Scroll: nav bg + progress bar + parallax ── */
      const header = document.getElementById('site-header');
      const scbar = document.getElementById('scbar');
      const parallax = document.querySelectorAll('[data-parallax]');
      let ticking = false, idleTimer;

      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const sy = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;

          header.classList.toggle('is-scrolled', sy > 50);

          // Progress bar + drift
          scbar.style.height = (max > 0 ? sy / max * 100 : 0) + '%';
          scbar.classList.add('scrolling');
          clearTimeout(idleTimer);
          idleTimer = setTimeout(() => scbar.classList.remove('scrolling'), 1500);

          // Parallax gravity inversion
          if (!reduced && !isMobile()) {
            parallax.forEach(el => {
              const speed = parseFloat(el.dataset.parallax) || 0.1;
              const mid = el.getBoundingClientRect().top + el.offsetHeight / 2;
              el.style.transform = `translateY(${(mid - window.innerHeight / 2) * speed * -1}px)`;
            });
          }

          ticking = false;
        });
      }, { passive: true });

      /* ── Hamburger / mobile menu ── */
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-backdrop');
      let menuOpen = false, lockScrollY = 0;

      function toggleMenu() {
        menuOpen = !menuOpen;
        hamburger.setAttribute('aria-expanded', String(menuOpen));
        hamburger.classList.toggle('is-open', menuOpen);
        mobileMenu.classList.toggle('is-open', menuOpen);
        mobileMenu.setAttribute('aria-hidden', String(!menuOpen));
        backdrop.classList.toggle('is-open', menuOpen);

        if (menuOpen) {
          lockScrollY = window.scrollY;
          document.body.style.cssText = `position:fixed;top:-${lockScrollY}px;width:100%;`;
        } else {
          document.body.style.cssText = '';
          window.scrollTo(0, lockScrollY);
        }
      }

      hamburger?.addEventListener('click', toggleMenu);
      backdrop?.addEventListener('click', () => menuOpen && toggleMenu());
      mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menuOpen && toggleMenu()));
      document.addEventListener('keydown', e => e.key === 'Escape' && menuOpen && toggleMenu());

      /* ── Smooth scroll for anchor links ── */
      document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
          const t = document.querySelector(a.getAttribute('href'));
          if (!t) return;
          e.preventDefault();
          window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 56, behavior: 'smooth' });
        });
      });

      /* ── Gallery arrows ── */
      const stripOuter = document.querySelector('.gallery-strip-outer');
      const arrowL = document.querySelector('.gallery-arrow--left');
      const arrowR = document.querySelector('.gallery-arrow--right');

      if (stripOuter && arrowL && arrowR) {
        const fadeR = stripOuter.parentElement.querySelector('.gallery-fade-right');
        const fadeL = stripOuter.parentElement.querySelector('.gallery-fade-left');

        const updateArrows = () => {
          const atStart = stripOuter.scrollLeft <= 4;
          const atEnd = stripOuter.scrollLeft >= stripOuter.scrollWidth - stripOuter.clientWidth - 4;
          arrowL.disabled = atStart;
          arrowR.disabled = atEnd;
          // Left fade: show only after scrolling away from start
          fadeL?.classList.toggle('visible', !atStart);
          // Right fade: hide when fully scrolled to end
          if (fadeR) fadeR.style.opacity = atEnd ? '0' : '1';
        };
        const step = () => stripOuter.clientWidth * 0.7;
        arrowL.addEventListener('click', () => stripOuter.scrollBy({ left: -step(), behavior: 'smooth' }));
        arrowR.addEventListener('click', () => stripOuter.scrollBy({ left: step(), behavior: 'smooth' }));
        stripOuter.addEventListener('scroll', updateArrows, { passive: true });
        updateArrows();

        // Drag-to-scroll with momentum
        let down = false, startX, startSL, vel = 0, lastX, lastT, rafG;
        const beginDrag = x => {
          down = true; startX = x; startSL = stripOuter.scrollLeft;
          vel = 0; lastX = x; lastT = Date.now();
          cancelAnimationFrame(rafG);
        };
        const moveDrag = x => {
          if (!down) return;
          stripOuter.scrollLeft = startSL - (x - startX) * 1.3;
          const now = Date.now(), dt = now - lastT || 1;
          vel = (lastX - x) / dt; lastX = x; lastT = now;
        };
        const endDrag = () => {
          if (!down) return; down = false;
          (function glide() { vel *= 0.92; stripOuter.scrollLeft += vel * 14; if (Math.abs(vel) > 0.05) rafG = requestAnimationFrame(glide); })();
        };
        stripOuter.addEventListener('mousedown', e => { e.preventDefault(); beginDrag(e.pageX); });
        window.addEventListener('mousemove', e => moveDrag(e.pageX));
        window.addEventListener('mouseup', () => endDrag());
        stripOuter.addEventListener('touchstart', e => beginDrag(e.touches[0].pageX), { passive: true });
        stripOuter.addEventListener('touchmove', e => moveDrag(e.touches[0].pageX), { passive: true });
        stripOuter.addEventListener('touchend', () => endDrag());
      }

      /* ── Email copy ── */
      const copyBtn = document.getElementById('copy-email');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('hi@phucloc.digital');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = 'hello@locnguyen.dev';
          ta.style.cssText = 'position:fixed;opacity:0;';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
        }
        copyBtn.dataset.tip = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => { copyBtn.classList.remove('copied'); copyBtn.dataset.tip = 'Copy'; }, 2200);
      });

    })();
  </script>

  <!-- PhotoSwipe -------------------------------------------- -->
  <script type="module">
    import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.min.js';

    const lightbox = new PhotoSwipeLightbox({
      gallery: '[data-gallery]',
      children: 'a',
      pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.esm.min.js'),
      showHideAnimationType: 'zoom',
      bgOpacity: 0.95,
      padding: { top: 20, bottom: 40, left: 20, right: 20 },
      preloaderDelay: 0,
    });

    // Caption
    lightbox.on('uiRegister', () => {
      lightbox.pswp.ui.registerElement({
        name: 'caption', order: 9, isButton: false, appendTo: 'root',
        onInit: (el, pswp) => {
          el.style.cssText = 'position:absolute;bottom:0;left:0;right:0;padding:12px 20px;font-family:\'DM Mono\',monospace;font-size:11px;color:rgba(255,255,255,.55);text-align:center;letter-spacing:.06em;pointer-events:none;';
          pswp.on('change', () => { el.textContent = pswp.currSlide.data.element?.querySelector('img')?.alt || ''; });
        }
      });
    });

    lightbox.init();
  </script>



</body>

</html>