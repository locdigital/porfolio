{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-node-20.mjs",
    "predev": "node scripts/ensure-node-20.mjs",
    "dev": "astro dev",
    "icons:generate": "node scripts/generate-phosphor-icons.mjs",
    "prestart": "node scripts/ensure-node-20.mjs",
    "start": "astro dev",
    "prebuild": "node scripts/ensure-node-20.mjs && node scripts/sync-photo-updates.mjs",
    "build": "astro check && astro build && node scripts/patch-vercel-runtime.mjs && node scripts/build-agent-content.mjs && node scripts/prune-deploy-assets.mjs",
    "precheck": "node scripts/ensure-node-20.mjs",
    "check": "astro check",
    "pretest": "node scripts/ensure-node-20.mjs",
    "test": "vitest run",
    "geo:audit": "node scripts/geo-audit.mjs",
    "assets:audit": "node scripts/audit-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:migrate:r2": "node scripts/migrate-assets-to-r2.mjs",
    "assets:migrate:r2:dry": "node scripts/migrate-assets-to-r2.mjs --dry-run",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "astro": "^5.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.75.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.11.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "parse5": "7.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
