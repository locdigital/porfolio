# Gemini AI — for the /question chat page and CMS AI helpers
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Decap CMS GitHub OAuth — for /admin login on Vercel
# GitHub OAuth callback URL: https://loc.digital/api/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Local private CMS (/login and /cms are disabled in production)
CMS_USERNAME=admin
CMS_PASSWORD=change_this_local_password
CMS_SESSION_SECRET=change_this_long_random_session_secret

# UploadThing — stores uploaded image files.
UPLOADTHING_TOKEN=

# Supabase CMS storage — stores CMS metadata/content on the server.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to client-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
