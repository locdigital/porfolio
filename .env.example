# =============================================================================
# Cloudflare R2 Object Storage (Server-side & CLI migration scripts ONLY)
# Never prefix private credentials with PUBLIC_ or commit real values to Git.
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=loc-digital-assets

# Public R2 custom domain (safe for client/build-time URL resolution)
PUBLIC_ASSET_BASE_URL=https://assets.loc.digital

# =============================================================================
# Cloudflare Web Analytics (Optional — leave empty to disable)
# Create a Web Analytics site for loc.digital in Cloudflare Dashboard -> Analytics
# =============================================================================
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# =============================================================================
# Cloudflare Turnstile (Optional — for future contact/booking form endpoints)
# Site key is public; secret key is server-only.
# =============================================================================
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Legacy UploadThing (Optional — used only by scripts/upload-photo-assets.mjs)
# Public pages read local files in src/content and require no credentials.
# =============================================================================
UPLOADTHING_TOKEN=
