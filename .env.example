# Gemini AI — for the /question chat page and CMS AI helpers
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Decap CMS GitHub OAuth — for /admin login on Vercel
# GitHub OAuth callback URL: https://loc.digital/api/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Local private CMS (/login and /cms are disabled in production)
CMS_USERNAME=admin
CMS_PASSWORD=change_this_local_password
CMS_SESSION_SECRET=change_this_long_random_session_secret

# UploadThing — stores uploaded image files.
UPLOADTHING_TOKEN=

# Supabase CMS/booking storage — server-side only database access.
# SUPABASE_SECRET_KEY must never be exposed to client-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallback if your Supabase project still uses service_role keys:
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Approval-based booking calendar
# Public booking page: /booking · owner dashboard: /booking/admin
BOOKING_ADMIN_TOKEN=change_this_long_owner_only_token
BOOKING_TOKEN_ENCRYPTION_KEY=change_this_32_plus_character_secret
BOOKING_OWNER_EMAIL=hi@loc.digital
BOOKING_EMAIL_FROM="Loc Digital <hi@loc.digital>"
BOOKING_CRON_SECRET=change_this_cron_secret

# Google Calendar OAuth (server-side only)
# Local redirect: http://localhost:4321/api/booking/admin/google/callback
# Production redirect: https://loc.digital/api/booking/admin/google/callback
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4321/api/booking/admin/google/callback

# Email provider for booking receipts and approval/rejection notices
RESEND_API_KEY=your_resend_api_key
