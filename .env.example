# Gemini AI — for the /question chat page and CMS AI helpers
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Decap CMS GitHub OAuth — for /admin login on Vercel
# GitHub OAuth callback URL: https://loc.digital/api/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Local private CMS (/login and /cms are disabled in production)
CMS_USERNAME=admin
CMS_PASSWORD=change_this_local_password
CMS_SESSION_SECRET=change_this_long_random_session_secret

# MongoDB storage for the writing CMS.
# If omitted, local development falls back to data/writing-posts/*.json.
MONGODB_URI=
MONGODB_DB=portfolio
