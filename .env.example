# WordPress REST API source for /blog
# Example: https://your-wordpress-site.com
PUBLIC_WP_URL=your_wordpress_url_here

# Gemini AI — for the /question chat page
# Get your free key at: https://aistudio.google.com/app/apikey
PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional server-side key for CMS Gear AI fill.
# If omitted, CMS still uses a local fallback generator.
GEMINI_API_KEY=your_gemini_api_key_here

# Decap CMS GitHub OAuth — for /admin login on Vercel
# GitHub OAuth callback URL: https://loc.digital/api/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Local private CMS (/login and /cms are disabled in production)
CMS_USERNAME=admin
CMS_PASSWORD=change_this_local_password
CMS_SESSION_SECRET=change_this_long_random_session_secret
